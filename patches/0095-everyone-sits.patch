+// Everyone rides seated. Only the player (or another device's) stands up,
+// by walking off; nobody else's walk takes a rider out of their chair.
+bool ScummEngine::scummverseKeepsSeat(int id) const {
+ return scummverseSeated(id) && id!=VAR(VAR_EGO) && !scummverseRemoteActor(id) && _actors[id]->_room==56;
+}
+static const int kSeatWalkLimit = 600;
+// Someone else in the cabin without a chair (in by another way, or left
+// standing by the player who switched to someone else) walks to theirs, or
+// to a free one, and sits. False when the cabin is full.
+bool ScummEngine::scummverseTakeSeat(int id) {
+ // (Legacy flights over six, not yet migrated, are left as they are.)
+ if(!_scummVars[724] || !_scummVars[526] || id==VAR(VAR_EGO) || scummverseRemoteActor(id) || scummverseSeated(id)) return false;
+ int &seat=_scummVars[501+id];
+ if(seat<-6 || seat>6) seat=0;
+ if(!seat) {
+  // A free chair: held by no one aboard, and nobody (another device's
+  // player) sitting in it.
+  unsigned taken=0;
+  for(int n=1;n<25;++n) {
+   if(n==id) continue;
+   const Actor *o=_actors[n];
+   const int held=ABS(_scummVars[501+n]);
+   if(held>=1 && held<=6 && (o->_room==56 || (_scummVars[725] & (1u<<n)))) taken|=1u<<(held-1);
+   if(o->_room==56 && o->getElevation()==-4 && o->getRealPos().y==52)
+    for(int k=0;k<6;++k) if(ABS(o->getRealPos().x-ScummverseZakPlane::seatX[k])<=1) taken|=1u<<k;
+  }
+  for(int s=0;s<6 && !seat;++s) if(!(taken & (1u<<s))) seat=-(s+1);
+  if(!seat) return false;
+  _scummVars[725]|=1u<<id;
+ }
+ Actor *a=derefActor(id,"seat taker");
+ Roamer &r=_scummverseRoamers[id];
+ if(r.room!=56) { r=Roamer(); r.room=56; } // Counting from here.
+ const int x=ScummverseZakPlane::seatX[ABS(seat)-1];
+ // Walking there (or sat down at once if the way is blocked for long).
+ if(_currentRoom==56 && ++r.elapsed<kSeatWalkLimit) {
+  const AdjustBoxResult aisle=a->adjustXYToBeInBox(x,55);
+  if(a->_moving) return true;
+  if(ABS(a->getRealPos().x-aisle.x)>1 || ABS(a->getRealPos().y-aisle.y)>1) { a->startWalkActor(aisle.x,aisle.y,-1); return true; }
+ }
+ seat=ABS(seat); r=Roamer();
+ if(_currentRoom==56) a->scummverseSeatAt(x,52);
+ return true;
+}
