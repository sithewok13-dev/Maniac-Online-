+// Light added: each channel summed, at most full.
+static uint32_t added(uint32_t under, uint32_t light) {
+	uint32_t out = 0xFF000000u;
+	for (int shift = 0; shift < 24; shift += 8) out |= (uint32_t)std::min(255u, ((under >> shift) & 0xFF) + ((light >> shift) & 0xFF)) << shift;
+	return out;
+}
