+// (or has just landed).
+static const int kWorldHopTicks = 24;
+static bool worldHop(int &hop, bool moving, int delta) {
+	if (!moving && !hop) return false;
+	hop += delta;
+	if (hop >= kWorldHopTicks) hop = moving ? hop % kWorldHopTicks : 0;
+	return true;
