+// The "cast" check's stand-in for the iPhone's character screen: the boxes
+// (slot, title, how much of its face is drawn) and people it is given.
+namespace FakeCast {
+struct Box { int slot; Common::String title; int face; Common::Array<byte> rgba; };
+struct Member { int slot; Common::String name; int request; };
+static Common::Array<Box> boxes;
+static Common::Array<Member> members;
+static int shown = 0;
+static void game(int slot, const char *title, const char *, const unsigned char *rgba) {
+	if (slot == 0) { boxes.clear(); members.clear(); } // (as the screen's: afresh)
+	int face = 0;
+	for (int i = 0; rgba && i < 64 * 64; ++i) face += rgba[i * 4 + 3] != 0;
+	boxes.push_back({slot, title, face, rgba ? Common::Array<byte>(rgba, 64 * 64 * 4) : Common::Array<byte>()});
+}
+static void member(int slot, const char *name, int request) { members.push_back({slot, name, request}); }
+static void show() { ++shown; }
+} // End of namespace FakeCast
+
+// The character screen with a stand-in, from the Worlds menu's request: a box
+// for every game (the mansion's slot 0 first, Zak's 1, the others 2 + their
+// number), each game's lead's face where they are installed (and none where
+// not), its people installed, the lead first, once each by name; then, in
+// each game, the lead and the last of them chosen as the screen sends it:
+// played (and on the stage once), where they live (else the game's first
+// place), kept in the state; a request in its range that is no one's
+// changes nothing.
+Common::Error SandboxEngine::castTest() {
+	_phone.castGame = FakeCast::game; _phone.castMember = FakeCast::member; _phone.castShow = FakeCast::show;
+	_wanderers = false;
+	int failed = 0, faces = 0, listed = 0, played = 0, expected = 0;
+	auto fail = [&](const char *what, const char *where) { ++failed; warning("SCUMMVERSE sandbox cast: %s: %s", where, what); };
+	int game, room;
+	Common::String problem;
+	if (!startPlace(game, room) || !someoneToPlay(game) || !enter(game, room, 0, problem)) return Common::Error(Common::kNoGameDataFoundError, "sandbox selftest: nothing installed");
+	request(kCastRequest);
+	if (FakeCast::shown != 1) fail("not shown", "screen");
+	if ((int)FakeCast::boxes.size() != worldGameCount() || FakeCast::boxes.empty() || FakeCast::boxes[0].slot != 0) fail("not a box for each game, the mansion's first", "screen");
+	const Common::Array<FakeCast::Member> members = FakeCast::members;
+	for (int g = 0; g < worldGameCount(); ++g) {
+		const char *id = kWorldGames[g].gameid;
+		const int slot = !strcmp(id, "maniac") ? 0 : !strcmp(id, "zak") ? 1 : 2 + g;
+		int lead = -1, boxes = 0, face = 0;
+		for (const WorldLead &l : kWorldLeads) if (l.game == g) lead = l.costume;
+		for (const FakeCast::Box &b : FakeCast::boxes) if (b.slot == slot) { ++boxes; face = b.face; if (b.title != kWorldGames[g].title) fail("titled otherwise", id); }
+		if (boxes != 1) { fail("not one box", id); continue; }
+		const bool here = lead >= 0 && hasCharacter(worldAppearanceKey(g, lead));
+		if (here != (face > 0)) fail(here ? "the lead's face not drawn" : "a face for a game not here", id);
+		faces += face > 0;
+		Common::Array<FakeCast::Member> people;
+		for (const FakeCast::Member &m : members) if (m.slot == slot) people.push_back(m);
+		if (!here && !people.empty()) fail("people for a game not here", id);
+		if (people.empty()) continue;
+		listed += people.size();
+		for (uint i = 0; i < people.size(); ++i) {
+			const int key = people[i].request - kWorldCastRequest;
+			if (worldAppearanceGame(key) != g || !hasCharacter(key)) fail("someone listed not installed", id);
+			for (uint j = 0; j < i; ++j) if (people[j].name == people[i].name) fail("listed twice", id);
+		}
+		for (const WorldCastGuest &cast : kWorldCast)
+			if (cast.game == g && cast.guest.costume == lead) { if (people[0].name != cast.guest.name) fail("the lead not first", id); break; }
+		// The lead, then the last of them, chosen as the screen sends it.
+		for (uint pick : {0u, people.size() - 1}) {
+			if (pick && people.size() < 2) break;
+			++expected;
+			const int key = people[pick].request - kWorldCastRequest;
+			request(people[pick].request);
+			step(1);
+			int home = -1, first = -1;
+			for (const WorldCastGuest &cast : kWorldCast)
+				if (home < 0 && cast.game == g && cast.guest.costume == worldAppearanceCostume(key) && installed(g, cast.room) && walkable(g, cast.room)) home = cast.room;
+			if (home < 0) firstPlace(g, first);
+			int times = 0;
+			for (int k : _onStage) times += k == key;
+			if (_playerKey != key || _game != g || _room != (home >= 0 ? home : first) || _onStage.empty() || _onStage[_player] != key || times != 1) { fail("not played where they live", people[pick].name.c_str()); continue; }
+			++played;
+		}
+	}
+	// Kept; and a request in the screen's range that is no one's (the chat's
+	// scene token) changes nothing.
+	const int key = _playerKey, atGame = _game, atRoom = _room;
+	// (The chat's Arrive in place key 10033, Monkey Island's room 33: its
+	// token is the place times 32 plus the one played, shifted a byte.)
+	const int token = ((10000 + 33) * 32 + kTalkPlayer) << 8;
+	if (token < kWorldCastRequest || token >= kWorldCastActorRequest) fail("the token not in the screen's range (the check is out of date)", "screen");
+	request(token | 24);
+	if (_playerKey != key || _game != atGame || _room != atRoom) fail("played by a request that is no one's", "screen");
+	saveState();
+	double x, y;
+	if (!loadState(game, room, x, y) || _playerKey != key || game != atGame || room != atRoom) fail("not kept", "state");
+	// A picture of the faces, in the boxes' order, three times their size.
+	if (ConfMan.hasKey("scummverse_shots")) {
+		for (uint i = 0; i < _frame.size(); ++i) _frame[i] = 0xFF140320;
+		for (uint b = 0; b < FakeCast::boxes.size(); ++b) {
+			const Common::Array<byte> &f = FakeCast::boxes[b].rgba;
+			for (int y = 0; !f.empty() && y < 192; ++y)
+				for (int x = 0; x < 192; ++x) {
+					const byte *p = &f[((y / 3) * 64 + x / 3) * 4];
+					const int sx = 16 + (b % 6) * 208 + x, sy = 16 + (b / 6) * 208 + y;
+					if (p[3] && sx < _width && sy < _height) _frame[sy * _width + sx] = 0xFF000000u | p[0] << 16 | p[1] << 8 | p[2];
+				}
+		}
+		shot("cast.png");
+	}
+	g_system->updateScreen();
+	warning("SCUMMVERSE sandbox selftest cast: %d boxes (%d faces), %d people listed, %d of %d played where they live, %d failed", (int)FakeCast::boxes.size(), faces, listed, played, expected, failed);
+	if (failed || !faces || !listed || played != expected || played < 2) return Common::Error(Common::kUnknownError, "sandbox selftest failed");
+	warning("SCUMMVERSE sandbox selftest PASS");
+	return Common::kNoError;
+}
