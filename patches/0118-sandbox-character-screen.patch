+// The mansion's box first (the screen starts afresh with slot 0), Zak's
+// second, then the other games' (2 + their number), as Maniac's screen.
+void SandboxEngine::castOffer() {
+	Common::Array<int> order;
+	for (const char *home : {"maniac", "zak"})
+		for (int g = 0; g < worldGameCount(); ++g) if (!strcmp(kWorldGames[g].gameid, home)) order.push_back(g);
+	for (int g = 0; g < worldGameCount(); ++g) if (!worldHome(g)) order.push_back(g);
+	for (uint i = 0; i < order.size(); ++i) {
+		const int g = order[i], slot = worldHome(g) ? (int)i : 2 + g;
+		int lead = -1;
+		for (const WorldLead &l : kWorldLeads) if (l.game == g) lead = l.costume;
+		// Its lead's face from their own file (none: the game is not here).
+		byte face[64 * 64 * 4];
+		Common::Array<byte> data;
+		const bool here = lead >= 0 && hasCharacter(worldAppearanceKey(g, lead)) &&
+			read(Common::String::format("%s-c%d.svc", kWorldGames[g].gameid, lead), data) && WorldBridge::spritePortrait(data.data(), data.size(), 64, face);
+		_phone.castGame(slot, kWorldGames[g].title, kWorldGames[g].folder, here ? face : nullptr);
+		if (!here) continue;
+		// The lead first, then everyone of the game installed, once each by name.
+		Common::Array<Common::String> named;
+		auto add = [&](int costume, const char *name) {
+			const int key = worldAppearanceKey(g, costume);
+			for (const Common::String &n : named) if (n == name) return;
+			if (!hasCharacter(key)) return;
+			named.push_back(name);
+			_phone.castMember(slot, name, kWorldCastRequest + key);
+		};
+		for (const WorldCastGuest &cast : kWorldCast) if (cast.game == g && cast.guest.costume == lead) { add(lead, cast.guest.name); break; }
+		for (const WorldCastGuest &cast : kWorldCast) if (cast.game == g) add(cast.guest.costume, cast.guest.name);
+	}
+	_phone.castShow();
+}
+
+// Where they live (their place in the cast, else their game's first), as
+// them. (The wanderers carry on: whoever is played is passed by when people
+// come on the stage, so never shown twice.)
+bool SandboxEngine::castChoose(int key) {
+	const WorldGuest *who = worldAppearance(key);
+	if (!who || !hasCharacter(key) || _broken.contains(key)) return false;
+	const int game = worldAppearanceGame(key), costume = worldAppearanceCostume(key);
+	int room = -1;
+	for (const WorldCastGuest &cast : kWorldCast)
+		if (room < 0 && cast.game == game && cast.guest.costume == costume && installed(game, cast.room) && walkable(game, cast.room)) room = cast.room;
+	if (room < 0 && !firstPlace(game, room)) return false;
+	const int fromGame = _game, fromRoom = _room, fromKey = _playerKey;
+	_playerKey = key;
+	Common::String problem;
+	if (enter(game, room, 0, problem)) {
+		if (!_testing) g_system->displayMessageOnOSD(Common::U32String(Common::String::format("You are playing %s.", who->name)));
+		return true;
+	}
+	warning("SCUMMVERSE sandbox: %s-%d not shown as %s (%s)", kWorldGames[game].gameid, room, who->name, problem.c_str());
+	_playerKey = fromKey;
+	if (fromGame >= 0) enter(fromGame, fromRoom, 0, problem);
+	return false;
+}
