+
+namespace Scummverse {
+
+// The sandbox: a place from one of the player's games on the whole screen
+// in true colour, its own people there, the game's lead walking where the
+// player taps (common/scummverse_stage.h does the work).
+class SandboxEngine : public Engine {
+public:
+	SandboxEngine(OSystem *syst, const ADGameDescription *desc);
+	~SandboxEngine() override;
+
+	Common::Error run() override;
+	bool hasFeature(EngineFeature f) const override;
+
+private:
+	// A file of the worlds cache (scenes are gzip-compressed; both read).
+	bool read(const Common::String &name, Common::Array<byte> &data) const;
+	bool installed(int game, int room) const;
+	bool startPlace(int &game, int &room) const;
+	// Puts a game's room on stage: its people, and the game's lead to play.
+	bool enter(int game, int room, Common::String &problem);
+	void tap(int screenX, int screenY);
+	// Leaves the sandbox: back to the game it was opened from (Maniac, where
+	// it was saved), else the app ends as Maniac's own quit does.
+	void back();
+	void present();
+	bool shot(const Common::String &name) const;
+	// Checks without anyone at the screen (scummverse_selftest): "walk" in
+	// the start place, "all" through every place installed, "back" walks
+	// then leaves as the menu's Back to Maniac Mansion does.
+	Common::Error selfTest(const Common::String &mode);
+
+	const ADGameDescription *_desc;
+	Common::FSNode _folder;
+	Graphics::PixelFormat _format;
+	int _width = 1280, _height = 720;
+	Common::Array<uint32> _frame;   // the stage, 0xAARRGGBB
+	Common::Array<byte> _converted; // the same in the screen's format
+	int _game = -1, _room = 0, _player = -1, _people = 0;
+};
+
+} // End of namespace Scummverse
