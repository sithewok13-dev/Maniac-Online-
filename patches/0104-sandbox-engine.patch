diff --git a/common/scummverse_stage.cpp b/common/scummverse_stage.cpp
new file mode 100644
index 00000000..7295b3bf
--- /dev/null
+++ b/common/scummverse_stage.cpp
@@ -0,0 +1,412 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Scummverse sandbox stage (see scummverse_stage.h). Plain C++, unit-tested by
+// tools/test_stage.cpp.
+#include "common/scummverse_stage.h"
+#include "common/scummverse_stage_engine.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <cstring>
+#include <utility>
+
+namespace Scummverse {
+namespace Stage {
+
+View View::fit(int sourceWidth, int sourceHeight, double pixelAspect, int gameScreenWidth, int screenWidth, int screenHeight) {
+	View v;
+	v.screenWidth = screenWidth; v.screenHeight = screenHeight;
+	if (sourceWidth <= 0 || sourceHeight <= 0 || screenWidth <= 0 || screenHeight <= 0) return v;
+	const double aspect = pixelAspect > 0 ? pixelAspect : 1;
+	v.rowScale = std::min((double)screenHeight / sourceHeight, screenWidth * aspect / std::max(1, gameScreenWidth));
+	v.colScale = v.rowScale / aspect;
+	v.width = (int)std::lround(sourceWidth * v.colScale);
+	v.height = (int)std::lround(sourceHeight * v.rowScale);
+	v.left = std::max(0, (screenWidth - v.width) / 2);
+	v.top = std::max(0, (screenHeight - v.height) / 2);
+	return v;
+}
+
+void View::follow(double sourceX) {
+	const int most = std::max(0, width - screenWidth);
+	camera = std::max(0, std::min(most, (int)std::lround(sourceX * colScale - screenWidth / 2.0)));
+}
+
+Point View::toScene(int screenX, int screenY) const {
+	Point p;
+	p.x = colScale > 0 ? (screenX - left + camera) / colScale : 0;
+	p.y = rowScale > 0 ? (screenY - top) / rowScale : 0;
+	return p;
+}
+
+Point View::toScreen(double sourceX, double sourceY) const {
+	Point p;
+	p.x = sourceX * colScale - camera + left;
+	p.y = sourceY * rowScale + top;
+	return p;
+}
+
+static double cross(Point a, Point b, Point p) { return (b.x - a.x) * (p.y - a.y) - (b.y - a.y) * (p.x - a.x); }
+static double distance(Point a, Point b) { return std::hypot(a.x - b.x, a.y - b.y); }
+static Point onSegment(Point a, Point b, Point p) {
+	const double dx = b.x - a.x, dy = b.y - a.y, length = dx * dx + dy * dy;
+	double t = length > 0 ? ((p.x - a.x) * dx + (p.y - a.y) * dy) / length : 0;
+	t = std::max(0.0, std::min(1.0, t));
+	Point q; q.x = a.x + t * dx; q.y = a.y + t * dy;
+	return q;
+}
+
+static bool strictlyInside(const Box &box, Point p) {
+	bool negative = false, positive = false;
+	for (int i = 0; i < 4; ++i) {
+		const double c = cross(box.corner[i], box.corner[(i + 1) % 4], p);
+		negative = negative || c < 0; positive = positive || c > 0;
+	}
+	// (A flat box, a line or a point, holds nothing strictly: its edges do.)
+	return (negative || positive) && !(negative && positive);
+}
+
+Point closest(const Box &box, Point p) {
+	if (strictlyInside(box, p)) return p;
+	Point best = box.corner[0];
+	for (int i = 0; i < 4; ++i) {
+		const Point q = onSegment(box.corner[i], box.corner[(i + 1) % 4], p);
+		if (distance(q, p) < distance(best, p)) best = q;
+	}
+	return best;
+}
+
+bool inside(const Box &box, Point p, double slack) { return distance(closest(box, p), p) <= slack; }
+
+int boxAt(const std::vector<Box> &boxes, Point p) {
+	int best = -1; double near = 0;
+	for (size_t i = 0; i < boxes.size(); ++i) {
+		const double d = distance(closest(boxes[i], p), p);
+		if (d <= 0.5) return (int)i;
+		if (best < 0 || d < near) { best = (int)i; near = d; }
+	}
+	return best;
+}
+
+static double segmentGap(Point a, Point b, Point c, Point d) {
+	// (Crossing segments meet.)
+	const double d1 = cross(c, d, a), d2 = cross(c, d, b), d3 = cross(a, b, c), d4 = cross(a, b, d);
+	if (((d1 > 0) != (d2 > 0)) && ((d3 > 0) != (d4 > 0)) && d1 && d2 && d3 && d4) return 0;
+	return std::min(std::min(distance(onSegment(c, d, a), a), distance(onSegment(c, d, b), b)),
+		std::min(distance(onSegment(a, b, c), c), distance(onSegment(a, b, d), d)));
+}
+
+bool touching(const Box &a, const Box &b) {
+	for (int i = 0; i < 4; ++i) if (strictlyInside(b, a.corner[i]) || strictlyInside(a, b.corner[i])) return true;
+	for (int i = 0; i < 4; ++i)
+		for (int j = 0; j < 4; ++j)
+			if (segmentGap(a.corner[i], a.corner[(i + 1) % 4], b.corner[j], b.corner[(j + 1) % 4]) <= 1.0) return true;
+	return false;
+}
+
+// Where to cross from box `from` into box `into`: a point of `into` within a
+// pixel of `from`, the best on the way from `at` to `goal`.
+static Point crossing(const Box &from, const Box &into, Point at, Point goal) {
+	Point best = closest(into, at);
+	double score = -1;
+	for (int i = 0; i < 4; ++i)
+		for (int k = 0; k <= 32; ++k) {
+			const Point a = into.corner[i], b = into.corner[(i + 1) % 4];
+			Point q; q.x = a.x + (b.x - a.x) * k / 32.0; q.y = a.y + (b.y - a.y) * k / 32.0;
+			if (!inside(from, q, 1.5)) continue;
+			const double s = distance(at, q) + distance(q, goal);
+			if (score < 0 || s < score) { score = s; best = q; }
+		}
+	return best;
+}
+
+std::vector<Point> path(const std::vector<Box> &boxes, Point from, Point to) {
+	std::vector<Point> route;
+	if (boxes.empty()) return route;
+	const int start = boxAt(boxes, from);
+	int end = boxAt(boxes, to);
+	// Breadth first over boxes that meet.
+	const int n = (int)boxes.size();
+	std::vector<int> came(n, -2), queue(1, start);
+	came[start] = -1;
+	for (size_t q = 0; q < queue.size() && came[end] == -2; ++q)
+		for (int j = 0; j < n; ++j)
+			if (came[j] == -2 && touching(boxes[queue[q]], boxes[j])) { came[j] = queue[q]; queue.push_back(j); }
+	// Cut off: as near as they can get, in the box they can reach nearest it.
+	if (came[end] == -2)
+		for (int b : queue)
+			if (came[end] == -2 || distance(closest(boxes[b], to), to) < distance(closest(boxes[end], to), to)) end = b;
+	to = closest(boxes[end], to);
+	std::vector<int> chain;
+	for (int b = end; b != -1; b = came[b]) chain.insert(chain.begin(), b);
+	Point at = from;
+	for (size_t i = 1; i < chain.size(); ++i) {
+		at = crossing(boxes[chain[i - 1]], boxes[chain[i]], at, to);
+		route.push_back(at);
+	}
+	route.push_back(to);
+	return route;
+}
+
+int scaleAt(const std::vector<Box> &boxes, Point p) {
+	const int b = boxAt(boxes, p);
+	if (b < 0) return 255;
+	const Box &box = boxes[b];
+	double top = box.corner[0].y, bottom = box.corner[0].y;
+	for (const Point &c : box.corner) { top = std::min(top, c.y); bottom = std::max(bottom, c.y); }
+	const double t = bottom > top ? std::max(0.0, std::min(1.0, (p.y - top) / (bottom - top))) : 1;
+	return std::max(1, std::min(255, (int)std::lround(box.scaleTop + (box.scaleBottom - box.scaleTop) * t)));
+}
+
+std::vector<Box> boxesOf(const World::SourceScene &scene) {
+	std::vector<Box> boxes;
+	for (const World::SourceBox &s : scene.boxes) {
+		if (s.flags & 0x80) continue; // (switched off)
+		// The games' placeholder box, far off at -32000 (nowhere to walk).
+		bool nowhere = false;
+		for (int i = 0; i < 4; ++i) nowhere = nowhere || std::abs(s.x[i]) > 8192 || std::abs(s.y[i]) > 8192;
+		if (nowhere) continue;
+		Box b;
+		for (int i = 0; i < 4; ++i) { b.corner[i].x = s.x[i]; b.corner[i].y = s.y[i]; }
+		b.scaleTop = s.scaleTop; b.scaleBottom = s.scaleBottom;
+		boxes.push_back(b);
+	}
+	return boxes;
+}
+
+bool Scene::load(const uint8_t *data, size_t size, double pixelAspect, int gameScreenWidth, int screenWidth, int screenHeight, std::string &error) {
+	World::SourceScene source;
+	if (!World::parseScene(data, size, source, error)) return false;
+	_source = source; _boxes = boxesOf(_source); _actors.clear(); _follow = -1;
+	_view = View::fit(_source.width, _source.height, pixelAspect, gameScreenWidth, screenWidth, screenHeight);
+	uint32_t colors[256];
+	for (int c = 0; c < 256; ++c)
+		colors[c] = 0xFF000000u | (uint32_t)_source.palette[c * 3] << 16 | (uint32_t)_source.palette[c * 3 + 1] << 8 | _source.palette[c * 3 + 2];
+	_scaled.assign((size_t)_view.width * _view.height, 0xFF000000u);
+	std::vector<int> columns(_view.width);
+	for (int x = 0; x < _view.width; ++x) columns[x] = std::min(_source.width - 1, (int)(x / _view.colScale));
+	for (int y = 0; y < _view.height; ++y) {
+		const uint8_t *row = &_source.pixels[(size_t)std::min(_source.height - 1, (int)(y / _view.rowScale)) * _source.width];
+		uint32_t *out = &_scaled[(size_t)y * _view.width];
+		for (int x = 0; x < _view.width; ++x) out[x] = colors[row[columns[x]]];
+	}
+	return true;
+}
+
+int Scene::addActor(const uint8_t *data, size_t size, double height, double pixelAspect, std::string &error) {
+	Actor a;
+	if (!World::parseSprite(data, size, a.sprite, error)) return -1;
+	a.height = height > 0 ? height : 1; a.pixelAspect = pixelAspect > 0 ? pixelAspect : 1;
+	for (int c = 0; c < 256; ++c)
+		a.colors[c] = 0xFF000000u | (uint32_t)a.sprite.palette[c * 3] << 16 | (uint32_t)a.sprite.palette[c * 3 + 1] << 8 | a.sprite.palette[c * 3 + 2];
+	if (!_boxes.empty()) a.at = closest(_boxes[boxAt(_boxes, a.at)], a.at);
+	_actors.push_back(a);
+	return (int)_actors.size() - 1;
+}
+
+void Scene::place(int n, Point at) {
+	if (n < 0 || n >= (int)_actors.size()) return;
+	Actor &a = _actors[n];
+	a.at = _boxes.empty() ? at : closest(_boxes[boxAt(_boxes, at)], at);
+	a.route.clear(); a.moving = false;
+}
+
+void Scene::walkTo(int n, Point to) {
+	if (n < 0 || n >= (int)_actors.size()) return;
+	Actor &a = _actors[n];
+	a.route = path(_boxes, a.at, to);
+	a.moving = !a.route.empty();
+}
+
+void Scene::follow(int n) { _follow = n; if (n >= 0 && n < (int)_actors.size()) _view.follow(_actors[n].at.x); }
+
+void Scene::update(int ticks) {
+	for (Actor &a : _actors) {
+		a.tick += ticks;
+		if (!a.moving) continue;
+		// Slower where smaller (further away), but never crawling.
+		double step = kWalkSpeed * ticks * std::max(kSlowest, scaleAt(_boxes, a.at) / 255.0);
+		while (step > 0 && !a.route.empty()) {
+			const Point goal = a.route.front();
+			const double dx = goal.x - a.at.x, dy = goal.y - a.at.y, left = std::hypot(dx, dy);
+			if (left > 0.01) a.dir = std::fabs(dx) >= std::fabs(dy) * 1.2 ? (dx < 0 ? 0 : 1) : (dy < 0 ? 3 : 2);
+			if (left <= step) { a.at = goal; a.route.erase(a.route.begin()); step -= left; continue; }
+			a.at.x += dx / left * step; a.at.y += dy / left * step; step = 0;
+		}
+		if (a.route.empty()) a.moving = false;
+	}
+	if (_follow >= 0 && _follow < (int)_actors.size()) _view.follow(_actors[_follow].at.x);
+}
+
+// The frame to show: that facing, pose and step, else the nearest there is.
+static const World::SourceFrame *pick(const World::SourceSprite &s, int dir, int kind, int tick) {
+	int count = 0;
+	for (const World::SourceFrame &f : s.frames) count += f.dir == dir && f.kind == kind;
+	if (count) {
+		const int index = kind == 1 ? (tick / 6) % count : 0;
+		int k = 0;
+		for (const World::SourceFrame &f : s.frames) if (f.dir == dir && f.kind == kind && k++ == index) return &f;
+	}
+	const int facings[] = {dir, dir == 0 ? 1 : dir == 1 ? 0 : 2, 2, 1, 0, 3};
+	for (int d : facings) for (const World::SourceFrame &f : s.frames) if (f.dir == d && f.kind == 0) return &f;
+	return s.frames.empty() ? nullptr : &s.frames.front();
+}
+
+// Where an actor's frame lands: its top left and size on screen, and the
+// screen pixels per frame pixel down and across.
+struct Placement { const World::SourceFrame *frame = nullptr; double x0 = 0, y0 = 0, down = 0, across = 0; };
+static Placement placeOf(const Actor &a, const View &v, const std::vector<Box> &boxes) {
+	Placement p;
+	p.frame = pick(a.sprite, a.dir, a.moving ? 1 : 0, a.tick);
+	if (!p.frame) return p;
+	p.down = v.rowScale * a.height * scaleAt(boxes, a.at) / 255.0;
+	p.across = p.down / a.pixelAspect;
+	const Point feet = v.toScreen(a.at.x, a.at.y);
+	p.x0 = feet.x + p.frame->dx * p.across; p.y0 = feet.y + p.frame->dy * p.down;
+	return p;
+}
+
+bool Scene::drawnRect(int n, int &x0, int &y0, int &x1, int &y1) const {
+	if (n < 0 || n >= (int)_actors.size()) return false;
+	const Placement p = placeOf(_actors[n], _view, _boxes);
+	if (!p.frame) return false;
+	x0 = std::max(0, (int)std::floor(p.x0)); y0 = std::max(0, (int)std::floor(p.y0));
+	x1 = std::min(_view.screenWidth, (int)std::ceil(p.x0 + p.frame->width * p.across));
+	y1 = std::min(_view.screenHeight, (int)std::ceil(p.y0 + p.frame->height * p.down));
+	return x0 < x1 && y0 < y1;
+}
+
+void Scene::render(uint32_t *pixels, int pitch) const {
+	const View &v = _view;
+	for (int y = 0; y < v.screenHeight; ++y) std::fill(pixels + (size_t)y * pitch, pixels + (size_t)y * pitch + v.screenWidth, 0xFF000000u);
+	const int shown = std::min(v.width - v.camera, v.screenWidth - v.left);
+	for (int y = 0; y < std::min(v.height, v.screenHeight - v.top) && shown > 0; ++y)
+		std::memcpy(pixels + (size_t)(y + v.top) * pitch + v.left, &_scaled[(size_t)y * v.width + v.camera], shown * sizeof(uint32_t));
+	std::vector<int> order(_actors.size());
+	for (size_t i = 0; i < order.size(); ++i) order[i] = (int)i;
+	std::stable_sort(order.begin(), order.end(), [&](int a, int b) { return _actors[a].at.y < _actors[b].at.y; });
+	for (int n : order) {
+		const Actor &a = _actors[n];
+		const Placement p = placeOf(a, v, _boxes);
+		int x0, y0, x1, y1;
+		if (!p.frame || !drawnRect(n, x0, y0, x1, y1)) continue;
+		const World::SourceFrame &f = *p.frame;
+		for (int y = y0; y < y1; ++y) {
+			const int row = std::min(f.height - 1, (int)((y - p.y0) / p.down));
+			if (row < 0) continue;
+			uint32_t *out = pixels + (size_t)y * pitch;
+			for (int x = x0; x < x1; ++x) {
+				const int col = std::min(f.width - 1, (int)((x - p.x0) / p.across));
+				if (col < 0) continue;
+				const size_t i = (size_t)row * f.width + col;
+				if (f.mask[i]) out[x] = a.colors[f.pixels[i]];
+			}
+		}
+	}
+}
+
+std::vector<Point> Scene::spots(int n) const {
+	std::vector<Point> candidates, chosen;
+	for (const Box &b : _boxes)
+		for (int i = 1; i <= 3; ++i)
+			for (int j = 1; j <= 3; ++j) {
+				// Across the box (top edge to bottom edge), a quarter in from the sides.
+				const double s = i / 4.0, t = j / 4.0;
+				Point top, bottom, p;
+				top.x = b.corner[0].x + (b.corner[1].x - b.corner[0].x) * s; top.y = b.corner[0].y + (b.corner[1].y - b.corner[0].y) * s;
+				bottom.x = b.corner[3].x + (b.corner[2].x - b.corner[3].x) * s; bottom.y = b.corner[3].y + (b.corner[2].y - b.corner[3].y) * s;
+				p.x = top.x + (bottom.x - top.x) * t; p.y = top.y + (bottom.y - top.y) * t;
+				candidates.push_back(p);
+			}
+	if (candidates.empty()) { Point p; p.x = _source.width / 2.0; p.y = _source.height * 0.8; candidates.push_back(p); }
+	// The roomiest first (the middle of the biggest box), then each the
+	// farthest from those chosen.
+	double biggest = -1; size_t first = 0;
+	for (size_t b = 0; b < _boxes.size(); ++b) {
+		const Box &x = _boxes[b];
+		const double area = std::fabs(cross(x.corner[0], x.corner[1], x.corner[2])) + std::fabs(cross(x.corner[0], x.corner[2], x.corner[3]));
+		if (area > biggest) { biggest = area; first = b * 9 + 4; }
+	}
+	chosen.push_back(candidates[std::min(first, candidates.size() - 1)]);
+	while ((int)chosen.size() < n) {
+		double far = -1; Point best;
+		for (const Point &c : candidates) {
+			double near = 1e18;
+			for (const Point &d : chosen) near = std::min(near, distance(c, d));
+			if (near > far) { far = near; best = c; }
+		}
+		chosen.push_back(best);
+	}
+	chosen.resize(std::max(0, n));
+	return chosen;
+}
+
+} // End of namespace Stage
+
+// ---- The engine's one place on stage ----
+namespace StageBridge {
+namespace {
+Stage::Scene &stage() { static Stage::Scene s; return s; }
+void report(const std::string &problem, char *error, int capacity) {
+	if (!error || capacity <= 0) return;
+	const size_t n = std::min(problem.size(), (size_t)capacity - 1);
+	std::memcpy(error, problem.data(), n); error[n] = 0;
+}
+bool valid(int n) { return n >= 0 && n < stage().actorCount(); }
+} // End of anonymous namespace
+
+bool load(const unsigned char *data, size_t size, double pixelAspect, int gameScreenWidth, int screenWidth, int screenHeight,
+		char *error, int capacity) {
+	std::string problem;
+	Stage::Scene next;
+	if (!next.load(data, size, pixelAspect, gameScreenWidth, screenWidth, screenHeight, problem)) { report(problem, error, capacity); return false; }
+	stage() = std::move(next);
+	return true;
+}
+int addActor(const unsigned char *data, size_t size, double height, double pixelAspect, char *error, int capacity) {
+	std::string problem;
+	const int n = stage().addActor(data, size, height, pixelAspect, problem);
+	if (n < 0) report(problem, error, capacity);
+	return n;
+}
+int actorCount() { return stage().actorCount(); }
+void place(int actor, double x, double y) { stage().place(actor, {x, y}); }
+void walkTo(int actor, double x, double y) { stage().walkTo(actor, {x, y}); }
+bool moving(int actor) { return valid(actor) && stage().actor(actor).moving; }
+bool busy() {
+	for (int n = 0; n < stage().actorCount(); ++n) if (stage().actor(n).moving) return true;
+	return false;
+}
+bool heading(int actor, double &x, double &y) {
+	if (!moving(actor) || stage().actor(actor).route.empty()) return false;
+	x = stage().actor(actor).route.back().x; y = stage().actor(actor).route.back().y;
+	return true;
+}
+void position(int actor, double &x, double &y) {
+	x = y = 0;
+	if (valid(actor)) { x = stage().actor(actor).at.x; y = stage().actor(actor).at.y; }
+}
+void follow(int actor) { stage().follow(actor); }
+void update(int ticks) { stage().update(ticks); }
+static_assert(sizeof(unsigned int) == sizeof(uint32_t), "the bridge's pixels are 32 bits");
+void render(unsigned int *pixels, int pitch) { if (pixels) stage().render(reinterpret_cast<uint32_t *>(pixels), pitch); }
+void toScene(int screenX, int screenY, double &x, double &y) {
+	const Stage::Point p = stage().view().toScene(screenX, screenY);
+	x = p.x; y = p.y;
+}
+void toScreen(double x, double y, int &screenX, int &screenY) {
+	const Stage::Point p = stage().view().toScreen(x, y);
+	screenX = (int)std::floor(p.x); screenY = (int)std::floor(p.y);
+}
+int spots(int n, double *xs, double *ys) {
+	const std::vector<Stage::Point> found = stage().spots(n);
+	for (size_t i = 0; i < found.size(); ++i) { xs[i] = found[i].x; ys[i] = found[i].y; }
+	return (int)found.size();
+}
+int sceneWidth() { return stage().source().width; }
+int sceneHeight() { return stage().source().height; }
+int boxCount() { return (int)stage().boxes().size(); }
+int camera() { return stage().view().camera; }
+bool drawnRect(int actor, int &x0, int &y0, int &x1, int &y1) { return stage().drawnRect(actor, x0, y0, x1, y1); }
+} // End of namespace StageBridge
+} // End of namespace Scummverse
