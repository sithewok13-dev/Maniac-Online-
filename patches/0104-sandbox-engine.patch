+// The Scummverse sandbox: a game of its own inside ScummVM, made for the
+// sandbox (the user: "no character limit, the iPhone's full resolution, full
+// color; everyone is equal"). It shows the places and characters exported
+// from the player's own copies of the SCUMM games (the worlds cache, .svw
+// scenes and .svc characters) at the screen's full size in true colour.
+
+#ifndef SCUMMVERSE_DETECTION_H
+#define SCUMMVERSE_DETECTION_H
+
+#include "engines/advancedDetector.h"
+
+namespace Scummverse {
+
+extern const PlainGameDescriptor sandboxGames[];
+extern const ADGameDescription gameDescriptions[];
+
+} // End of namespace Scummverse
+
+class ScummverseMetaEngineDetection : public AdvancedMetaEngineDetection<ADGameDescription> {
+public:
+	ScummverseMetaEngineDetection();
+	~ScummverseMetaEngineDetection() override {}
+
+	const char *getName() const override {
+		return "scummverse";
+	}
+
+	const char *getEngineName() const override {
+		return "Scummverse sandbox";
+	}
+
+	const char *getOriginalCopyright() const override {
+		return "Scummverse sandbox (C) its contributors; the scenes and characters are the player's own games'";
+	}
+
+protected:
+	// A folder of exported scenes (the worlds cache) is the sandbox.
+	ADDetectedGame fallbackDetect(const FileMap &allFiles, const Common::FSList &fslist, ADDetectedGameExtraInfo **extra) const override;
+};
+
+#endif // SCUMMVERSE_DETECTION_H
