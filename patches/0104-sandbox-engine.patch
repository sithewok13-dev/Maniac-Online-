+namespace Scummverse {
+
+const PlainGameDescriptor sandboxGames[] = {
+	{ "sandbox", "Scummverse sandbox" },
+	{ nullptr, nullptr }
+};
+
+// No file names its own: a folder holding exported scenes is the sandbox
+// (fallbackDetect). The table only holds the description it returns.
+static const ADGameDescription sandboxDescription = {
+	"sandbox",
+	nullptr,
+	AD_ENTRY1("scummverse-sandbox.none", nullptr),
+	Common::UNK_LANG,
+	Common::kPlatformUnknown,
+	ADGF_NO_FLAGS,
+	GUIO1(GUIO_NOLAUNCHLOAD)
+};
+
+const ADGameDescription gameDescriptions[] = {
+	sandboxDescription,
+	AD_TABLE_END_MARKER
+};
+
+} // End of namespace Scummverse
+
+ScummverseMetaEngineDetection::ScummverseMetaEngineDetection() : AdvancedMetaEngineDetection(
+	Scummverse::gameDescriptions, Scummverse::sandboxGames) {
+}
+
+ADDetectedGame ScummverseMetaEngineDetection::fallbackDetect(const FileMap &allFiles, const Common::FSList &fslist, ADDetectedGameExtraInfo **extra) const {
+	for (const Common::FSNode &file : fslist)
+		if (!file.isDirectory() && file.getName().hasSuffixIgnoreCase(".svw"))
+			return ADDetectedGame(&Scummverse::gameDescriptions[0]);
+	return ADDetectedGame();
+}
+
+REGISTER_PLUGIN_STATIC(SCUMMVERSE_DETECTION, PLUGIN_TYPE_ENGINE_DETECTION, ScummverseMetaEngineDetection);
