new file mode 100644
index 00000000..4bd46d47
--- /dev/null
+++ b/common/scummverse_stage.h
@@ -0,0 +1,121 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Scummverse sandbox stage: the new sandbox engine's view of a place (the
+// user: "a new game inside ScummVM, written just for the sandbox ... no
+// character limit, the iPhone's full resolution, full color, everyone is
+// equal"). A scene exported from the player's own copy of a game (".svw",
+// common/scummverse_world.h) is shown at full detail on a screen of any size
+// in true colour, its characters (".svc") drawn at their own detail and a
+// person's height wherever they stand, walking along the scene's walk boxes.
+// Plain C++ (no game data, no engine); the engine reaches it through
+// common/scummverse_stage_engine.h.
+#ifndef COMMON_SCUMMVERSE_STAGE_H
+#define COMMON_SCUMMVERSE_STAGE_H
+
+#include "common/scummverse_world.h"
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace Scummverse {
+namespace Stage {
+
+struct Point {
+	double x, y;
+	Point(double px = 0, double py = 0) : x(px), y(py) {}
+};
+
+// How a scene's pixels land on the screen: each source row is rowScale
+// screen pixels tall, each column colScale wide (art drawn for 320x200
+// screens has pixels 1.2 times taller than wide). The scene is as tall as
+// the screen allows, no wider than its own game's screen at that size;
+// wider rooms scroll (camera, the scaled scene's left edge).
+struct View {
+	int screenWidth = 0, screenHeight = 0;
+	double rowScale = 1, colScale = 1;
+	int width = 0, height = 0;   // the scaled scene
+	int left = 0, top = 0;       // where it starts on screen when narrower or shorter
+	int camera = 0;
+	// pixelAspect: a source pixel's height over its width; gameScreenWidth:
+	// the width of the game's own screen in source pixels.
+	static View fit(int sourceWidth, int sourceHeight, double pixelAspect, int gameScreenWidth, int screenWidth, int screenHeight);
+	void follow(double sourceX);           // the camera centred there, within the scene
+	Point toScene(int screenX, int screenY) const;
+	Point toScreen(double sourceX, double sourceY) const;
+};
+
+// Walk boxes (quadrilaterals in source pixels, any winding) and paths along
+// them.
+struct Box {
+	Point corner[4];
+	int scaleTop = 255, scaleBottom = 255; // the game's own character scale at its top and bottom (1..255)
+};
+bool inside(const Box &box, Point p, double slack = 0.5);
+Point closest(const Box &box, Point p);
+// The box a point is in, else the nearest (-1: no boxes).
+int boxAt(const std::vector<Box> &boxes, Point p);
+// Boxes that meet (an edge along another's, within a pixel).
+bool touching(const Box &a, const Box &b);
+// From `from` to `to` (moved into the nearest box): the points to walk
+// through, ending at the destination, or as near to it as the boxes that
+// can be reached allow; empty when there are no boxes.
+std::vector<Point> path(const std::vector<Box> &boxes, Point from, Point to);
+// The game's character scale at a point (1..255; 255 without boxes).
+int scaleAt(const std::vector<Box> &boxes, Point p);
+// The scene's walkable boxes (not those switched off, nor the placeholder
+// some games keep far off at -32000).
+std::vector<Box> boxesOf(const World::SourceScene &scene);
+
+// A character on stage.
+struct Actor {
+	World::SourceSprite sprite;
+	double height = 1;      // its size against the scene's people (1: as tall as the scene's lead)
+	double pixelAspect = 1; // as the view's, for its own art
+	Point at;               // feet, source pixels of the scene
+	std::vector<Point> route;
+	int dir = 2;            // 0 left, 1 right, 2 front, 3 back
+	int tick = 0;
+	bool moving = false;
+	uint32_t colors[256] = {}; // its palette as 0xAARRGGBB
+};
+
+// The place on stage: the scene drawn once at the view's size, its people.
+class Scene {
+public:
+	bool load(const uint8_t *data, size_t size, double pixelAspect, int gameScreenWidth, int screenWidth, int screenHeight, std::string &error);
+	int addActor(const uint8_t *data, size_t size, double height, double pixelAspect, std::string &error); // its number, -1 on error
+	void place(int actor, Point at);
+	void walkTo(int actor, Point to);
+	void update(int ticks);              // walking and animation (60 ticks a second)
+	void follow(int actor);              // the camera keeps this one in view
+	// The screen (0xAARRGGBB, `pitch` pixels a row): the scene and everyone,
+	// far ones first.
+	void render(uint32_t *pixels, int pitch) const;
+	const View &view() const { return _view; }
+	const std::vector<Box> &boxes() const { return _boxes; }
+	const World::SourceScene &source() const { return _source; }
+	const Actor &actor(int n) const { return _actors[n]; }
+	int actorCount() const { return (int)_actors.size(); }
+	// Spots for people: inside the boxes, spread out (n of them).
+	std::vector<Point> spots(int n) const;
+	// The screen rectangle an actor covers (false when off screen).
+	bool drawnRect(int actor, int &x0, int &y0, int &x1, int &y1) const;
+
+private:
+	View _view;
+	World::SourceScene _source;
+	std::vector<Box> _boxes;
+	std::vector<uint32_t> _scaled; // the scene at the view's size
+	std::vector<Actor> _actors;
+	int _follow = -1;
+};
+
+// Walking speed: source pixels a tick for someone at full scale; far away,
+// smaller, slower, but never below kSlowest of it.
+static const double kWalkSpeed = 1.6;
+static const double kSlowest = 0.25;
+
+} // End of namespace Stage
+} // End of namespace Scummverse
+
+#endif
