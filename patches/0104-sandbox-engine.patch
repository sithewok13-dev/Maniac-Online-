+// SPDX-License-Identifier: GPL-3.0-or-later
+// Scummverse sandbox stage: engine-facing bridge (plain types only) for the
+// sandbox engine (engines/scummverse). Holds the one place on stage. See
+// common/scummverse_stage.h.
+#ifndef COMMON_SCUMMVERSE_STAGE_ENGINE_H
+#define COMMON_SCUMMVERSE_STAGE_ENGINE_H
+
+#include <stddef.h>
+
+namespace Scummverse {
+namespace StageBridge {
+
+// A scene (bytes of one .svw file, uncompressed) on a screen of that size;
+// pixelAspect: a source pixel's height over its width (1.2 for art made for
+// 320x200 screens); gameScreenWidth: the source game's screen width in its
+// own pixels. Everyone on stage leaves. False (with `error`) when malformed.
+bool load(const unsigned char *data, size_t size, double pixelAspect, int gameScreenWidth, int screenWidth, int screenHeight,
+	char *error, int capacity);
+// A character (bytes of a .svc file) `height` times the scene's people's
+// height; its number, -1 when malformed.
+int addActor(const unsigned char *data, size_t size, double height, double pixelAspect, char *error, int capacity);
+int actorCount();
+void place(int actor, double x, double y);     // feet, source pixels (moved into the walk boxes)
+void walkTo(int actor, double x, double y);
+bool moving(int actor);
+bool busy();                                   // anyone walking
+// Where a walking actor is going (the end of its way); false when standing.
+bool heading(int actor, double &x, double &y);
+void position(int actor, double &x, double &y);
+void follow(int actor);
+void update(int ticks);                        // 60 ticks a second
+// The screen as 0xAARRGGBB, `pitch` pixels a row.
+void render(unsigned int *pixels, int pitch);
+void toScene(int screenX, int screenY, double &x, double &y);
+void toScreen(double x, double y, int &screenX, int &screenY);
+// Spots for n people, spread over the walk boxes; returns how many.
+int spots(int n, double *xs, double *ys);
+int sceneWidth();
+int sceneHeight();
+int boxCount();
+int camera();                                  // the scaled scene's left edge on screen
+bool drawnRect(int actor, int &x0, int &y0, int &x1, int &y1);
+
+} // End of namespace StageBridge
+} // End of namespace Scummverse
+
+#endif
