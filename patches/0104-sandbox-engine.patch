@@ -80,6 +80,40 @@ Common::Path ScummEngine::scummverseWorldCache() const {
 	return Common::Path("worlds");
 }
 
+// The sandbox engine (engines/scummverse, preview), from the Worlds menu:
+// Maniac is saved to the temporary slot and comes back where it was when the
+// sandbox is left (chained, as Day of the Tentacle's Maniac Mansion easter
+// egg does).
+void ScummEngine::scummverseOpenSandbox() {
+	static const char *const kSandboxTarget = "scummverse-sandbox";
+	if (!ChainedGamesMan.empty()) return; // (on its way already)
+	// Not in a WiFi game or the tour (leaving would end them), nor before
+	// another game's places are installed (the sandbox shows only those).
+	bool installed = false;
+	for (int g = 0; g < worldGameCount() && !installed; ++g)
+		for (int i = 0; i < kWorldGames[g].sceneCount && !installed; ++i)
+			installed = scummverseWorldSceneInstalled(g, kWorldGames[g].scenes[i].room);
+	const char *refusal = _scummverseNetOn ? "Not during a WiFi game." : _scummverseTouring ? "Not during the tour." :
+		!installed ? "I need another game in Documents first, like monkey." : nullptr;
+	// Saved now, so Maniac comes back exactly here.
+	Common::String file;
+	if (!refusal && !saveState(100, true, file)) refusal = "I couldn't save, so I'll stay here.";
+	if (refusal) {
+		scummverseSay(VAR(VAR_EGO), refusal);
+		return;
+	}
+	if (!ConfMan.hasGameDomain(kSandboxTarget)) ConfMan.addGameDomain(kSandboxTarget);
+	ConfMan.set("engineid", "scummverse", kSandboxTarget);
+	ConfMan.set("gameid", "sandbox", kSandboxTarget);
+	ConfMan.set("description", "Scummverse sandbox", kSandboxTarget);
+	ConfMan.setPath("path", scummverseWorldCache(), kSandboxTarget);
+	ChainedGamesMan.push(kSandboxTarget);
+	ChainedGamesMan.push(ConfMan.getActiveDomainName(), 100);
+	Common::Event event;
+	event.type = Common::EVENT_RETURN_TO_LAUNCHER;
+	_system->getEventManager()->pushEvent(event);
+}
+
