+
+namespace Scummverse {
+
+using namespace WorldCatalog;
+
+// The stage's pixels: 0xAARRGGBB in a native 32-bit word.
+static const Graphics::PixelFormat kStageFormat(4, 8, 8, 8, 8, 16, 8, 0, 24);
+
+SandboxEngine::SandboxEngine(OSystem *syst, const ADGameDescription *desc) : Engine(syst), _desc(desc) {
+}
+
+SandboxEngine::~SandboxEngine() {
+}
+
+bool SandboxEngine::hasFeature(EngineFeature f) const {
+	return f == kSupportsReturnToLauncher;
+}
+
+bool SandboxEngine::read(const Common::String &name, Common::Array<byte> &data) const {
+	data.clear();
+	const Common::FSNode node = _folder.getChild(name);
+	Common::ScopedPtr<Common::SeekableReadStream> in(node.exists() ? Common::wrapCompressedReadStream(node.createReadStream()) : nullptr);
+	if (!in || in->size() <= 0) return false;
+	data.resize(in->size());
+	return in->read(data.data(), data.size()) == data.size();
+}
+
+bool SandboxEngine::installed(int game, int room) const {
+	if (game < 0 || game >= worldGameCount() || room <= 0) return false;
+	// (An empty scene is a room a later export found no place in.)
+	const Common::FSNode node = _folder.getChild(Common::String::format("%s-%d.svw", kWorldGames[game].gameid, room));
+	Common::ScopedPtr<Common::SeekableReadStream> in(node.exists() ? node.createReadStream() : nullptr);
+	return in && in->size() > 0;
+}
+
+// scummverse_place ("monkey-33"), else the first named place installed.
+bool SandboxEngine::startPlace(int &game, int &room) const {
+	const Common::String asked = ConfMan.hasKey("scummverse_place") ? ConfMan.get("scummverse_place") : Common::String();
+	for (game = 0; game < worldGameCount() && !asked.empty(); ++game) {
+		const Common::String prefix = Common::String(kWorldGames[game].gameid) + "-";
+		if (asked.hasPrefix(prefix) && (room = atoi(asked.c_str() + prefix.size())) > 0 && installed(game, room)) return true;
+	}
+	if (!asked.empty()) warning("SCUMMVERSE sandbox: %s is not installed", asked.c_str());
+	for (game = 0; game < worldGameCount(); ++game)
+		for (int i = 0; i < kWorldGames[game].sceneCount; ++i)
+			if (installed(game, room = kWorldGames[game].scenes[i].room)) return true;
+	return false;
+}
+
+bool SandboxEngine::enter(int game, int room, Common::String &problem) {
+	const WorldGame &g = kWorldGames[game];
+	// Curse of Monkey Island draws square pixels at 640x480; the others drew
+	// for 320x200 screens, whose pixels are 1.2 times taller than wide.
+	const double aspect = g.version >= 8 ? 1.0 : 1.2;
+	Common::Array<byte> data;
+	char error[128];
+	if (!read(Common::String::format("%s-%d.svw", g.gameid, room), data)) { problem = "not installed"; return false; }
+	if (!StageBridge::load(data.data(), data.size(), aspect, g.version >= 8 ? 640 : 320, _width, _height, error, sizeof(error))) { problem = error; return false; }
+	_game = game; _room = room; _player = -1;
+	// Where the game shows its people as small figures on a map, so here.
+	const int kind = worldRoomKind(game, room);
+	const double figure = kind == kWorldMapRoom || kind == kWorldFloorPlan ? 0.3 : 1.0;
+	const WorldLead *lead = nullptr;
+	for (const WorldLead &l : kWorldLeads) if (l.game == game) lead = &l;
+	Common::Array<int> people;
+	for (const WorldCastGuest &cast : kWorldCast) {
+		if (cast.game != game || cast.room != room) continue;
+		if (!read(Common::String::format("%s-c%d.svc", g.gameid, cast.guest.costume), data)) continue;
+		const int n = StageBridge::addActor(data.data(), data.size(), figure, aspect, error, sizeof(error));
+		if (n < 0) { warning("SCUMMVERSE sandbox: %s not shown (%s)", cast.guest.name, error); continue; }
+		if (lead && cast.guest.costume == lead->costume) _player = n;
+		people.push_back(n);
+	}
+	if (_player < 0 && lead && read(Common::String::format("%s-c%d.svc", g.gameid, lead->costume), data)) {
+		_player = StageBridge::addActor(data.data(), data.size(), figure, aspect, error, sizeof(error));
+		if (_player >= 0) people.push_back(_player);
+	}
+	// Spread out, the one played in the roomiest spot.
+	for (uint i = 0; i < people.size(); ++i)
+		if (people[i] == _player) { people.remove_at(i); people.insert_at(0, _player); break; }
+	Common::Array<double> xs(people.size()), ys(people.size());
+	const int spots = people.empty() ? 0 : StageBridge::spots(people.size(), xs.data(), ys.data());
+	for (int i = 0; i < spots; ++i) StageBridge::place(people[i], xs[i], ys[i]);
+	_people = people.size();
+	StageBridge::follow(_player);
+	return true;
+}
+
+void SandboxEngine::tap(int screenX, int screenY) {
+	if (_player < 0) return;
+	double x, y;
+	StageBridge::toScene(screenX, screenY, x, y);
+	StageBridge::walkTo(_player, x, y);
+}
+
+void SandboxEngine::back() {
+	Common::Event event;
+	event.type = Common::EVENT_RETURN_TO_LAUNCHER;
+	g_system->getEventManager()->pushEvent(event);
+}
+
+void SandboxEngine::present() {
+	StageBridge::render(_frame.data(), _width);
+	if (_format == kStageFormat) {
+		g_system->copyRectToScreen(_frame.data(), _width * 4, 0, 0, _width, _height);
+		return;
+	}
+	Graphics::crossBlit(_converted.data(), (const byte *)_frame.data(), _width * _format.bytesPerPixel, _width * 4, _width, _height, _format, kStageFormat);
+	g_system->copyRectToScreen(_converted.data(), _width * _format.bytesPerPixel, 0, 0, _width, _height);
+}
+
+// A picture of the screen into scummverse_shots (PNG), for checks.
+bool SandboxEngine::shot(const Common::String &name) const {
+#ifdef USE_PNG
+	if (!ConfMan.hasKey("scummverse_shots")) return false;
+	Graphics::Surface surface;
+	surface.init(_width, _height, _width * 4, const_cast<uint32 *>(_frame.data()), kStageFormat);
+	Common::DumpFile out;
+	if (!out.open(ConfMan.getPath("scummverse_shots").appendComponent(name), true)) return false;
+	return Image::writePNG(out, surface);
+#else
+	return false;
+#endif
+}
+
+// The iPhone's Worlds menu knows the sandbox is running while this lives.
+struct SandboxActive {
+	SandboxActive() { scummverseSandboxActive(true); }
+	~SandboxActive() { scummverseSandboxActive(false); }
+};
+
+Common::Error SandboxEngine::run() {
+	const SandboxActive active;
+	_folder = Common::FSNode(ConfMan.getPath("path"));
+	// The device's own pixels, held sideways (at most 1440 rows; below 720,
+	// 1280x720); scummverse_screen ("WxH") overrides.
+	if (ConfMan.hasKey("scummverse_screen")) {
+		int w = 0, h = 0;
+		if (sscanf(ConfMan.get("scummverse_screen").c_str(), "%dx%d", &w, &h) == 2 && w >= 320 && h >= 200 && w <= 4096 && h <= 4096) { _width = w; _height = h; }
+	} else {
+		const int ow = g_system->getOverlayWidth(), oh = g_system->getOverlayHeight();
+		if (MIN(ow, oh) >= 720) {
+			_width = MAX(ow, oh); _height = MIN(ow, oh);
+			if (_height > 1440) { _width = _width * 1440 / _height; _height = 1440; }
+			_width &= ~1; _height &= ~1;
+		}
+	}
+	// True colour: the stage's own format where the screen has it, else the
+	// richest it offers.
+	_format = Graphics::PixelFormat();
+	const Common::List<Graphics::PixelFormat> formats = g_system->getSupportedFormats();
+	for (const Graphics::PixelFormat &f : formats) if (f == kStageFormat) _format = f;
+	for (const Graphics::PixelFormat &f : formats) if (_format.bytesPerPixel < 2 && f.bytesPerPixel == 4) _format = f;
+	for (const Graphics::PixelFormat &f : formats) if (_format.bytesPerPixel < 2 && f.bytesPerPixel >= 2) _format = f;
+	if (_format.bytesPerPixel < 2) return Common::Error(Common::kUnsupportedColorMode, "the sandbox needs a true-colour screen");
+	initGraphics(_width, _height, &_format);
+	if (g_system->getScreenFormat() != _format) return Common::Error(Common::kUnsupportedColorMode, "the screen did not take true colour");
+	_frame.resize(_width * _height);
+	_converted.resize(_width * _height * _format.bytesPerPixel);
+
+	if (ConfMan.hasKey("scummverse_selftest")) return selfTest(ConfMan.get("scummverse_selftest"));
+
+	int game, room;
+	Common::String problem;
+	if (!startPlace(game, room)) return Common::Error(Common::kNoGameDataFoundError, "no places are installed yet (add your games to Documents)");
+	if (!enter(game, room, problem)) return Common::Error(Common::kReadingFailed, problem);
+	uint32 last = g_system->getMillis();
+	int carry = 0;
+	bool changed = true;
+	while (!shouldQuit()) {
+		Common::Event event;
+		while (g_system->getEventManager()->pollEvent(event))
+			if (event.type == Common::EVENT_LBUTTONDOWN) { tap(event.mouse.x, event.mouse.y); changed = true; }
+		// The Worlds menu (iPhone): Back to Maniac Mansion.
+		if (scummverseWorldPoll() == kWorldSandboxRequest + 1) back();
+		const uint32 now = g_system->getMillis();
+		carry += (int)MIN<uint32>(now - last, 500) * 60; last = now;
+		if (carry >= 1000) {
+			// (Drawn again only while someone walks, and once when they stop.)
+			changed = changed || StageBridge::busy();
+			StageBridge::update(carry / 1000);
+			carry %= 1000;
+		}
+		if (changed) present();
+		changed = false;
+		g_system->updateScreen();
+		g_system->delayMillis(10);
+	}
+	return Common::kNoError;
+}
+
+
+Common::Error SandboxEngine::selfTest(const Common::String &mode) {
+	Common::Array<Common::String> places;
+	int game, room;
+	if (mode == "all") {
+		Common::FSList files;
+		_folder.getChildren(files, Common::FSNode::kListFilesOnly);
+		for (const Common::FSNode &file : files) if (file.getName().hasSuffix(".svw")) places.push_back(file.getName());
+		Common::sort(places.begin(), places.end());
+	} else if (startPlace(game, room)) { // "walk", "back"
+		places.push_back(Common::String::format("%s-%d.svw", kWorldGames[game].gameid, room));
+	}
+	int shown = 0, skipped = 0, failed = 0, people = 0, arrivedCount = 0, unreached = 0, colors = 0;
+	for (const Common::String &name : places) {
+		int g = -1, r = 0;
+		for (int i = 0; i < worldGameCount() && g < 0; ++i) {
+			const Common::String prefix = Common::String(kWorldGames[i].gameid) + "-";
+			if (name.hasPrefix(prefix) && (r = atoi(name.c_str() + prefix.size())) > 0) g = i;
+		}
+		if (g < 0 || !installed(g, r)) { ++skipped; continue; }
+		Common::String problem;
+		if (!enter(g, r, problem)) { warning("SCUMMVERSE sandbox: %s not shown (%s)", name.c_str(), problem.c_str()); ++failed; continue; }
+		++shown; people += _people;
+		present();
+		const bool one = places.size() == 1;
+		if (one) shot("sandbox-start.png");
+		// Walk to the spot farthest away, by tapping the screen there (the
+		// camera follows; the spot may be off screen at first: tap toward it).
+		if (_player >= 0) {
+			double fromX, fromY, x, y, toX = 0, toY = 0, best = -1;
+			StageBridge::position(_player, fromX, fromY);
+			double xs[16], ys[16];
+			const int n = StageBridge::spots(16, xs, ys);
+			for (int i = 0; i < n; ++i) {
+				const double d = (xs[i] - fromX) * (xs[i] - fromX) + (ys[i] - fromY) * (ys[i] - fromY);
+				if (d > best) { best = d; toX = xs[i]; toY = ys[i]; }
+			}
+			// Each tap: they walk all the way to where the boxes let them.
+			int ticks = 0;
+			bool stopped = false;
+			for (int leg = 0; leg < 8 && !stopped; ++leg) {
+				int sx, sy;
+				double endX = 0, endY = 0;
+				StageBridge::toScreen(toX, toY, sx, sy);
+				tap(CLIP(sx, 0, _width - 1), CLIP(sy, 0, _height - 1));
+				const bool going = StageBridge::heading(_player, endX, endY);
+				for (; StageBridge::moving(_player) && ticks < 20000; ++ticks) StageBridge::update(1);
+				StageBridge::position(_player, x, y);
+				if (going && (x - endX) * (x - endX) + (y - endY) * (y - endY) > 0.01) {
+					warning("SCUMMVERSE sandbox: %s: stopped at %.1f,%.1f on the way to %.1f,%.1f", name.c_str(), x, y, endX, endY);
+					stopped = true;
+				}
+				if ((x - toX) * (x - toX) + (y - toY) * (y - toY) < 2.25) break;
+			}
+			StageBridge::position(_player, x, y);
+			const bool arrived = (x - toX) * (x - toX) + (y - toY) * (y - toY) < 2.25;
+			arrivedCount += arrived; unreached += !arrived;
+			failed += stopped;
+			if (one) {
+				int x0, y0, x1, y1;
+				present();
+				shot("sandbox-walked.png");
+				warning("SCUMMVERSE sandbox walk: from %.1f,%.1f to %.1f,%.1f (asked %.1f,%.1f) in %d ticks; %s; drawn %s",
+					fromX, fromY, x, y, toX, toY, ticks, arrived ? "arrived" : "as near as it goes",
+					StageBridge::drawnRect(_player, x0, y0, x1, y1) ? "on screen" : "off screen");
+			}
+		}
+		if (one) {
+			// Colours on screen (true colour: more than one palette's worth
+			// where several characters stand in a scene).
+			Common::HashMap<uint32, bool> seen;
+			for (uint i = 0; i < _frame.size(); ++i) seen[_frame[i]] = true;
+			colors = seen.size();
+		}
+		if (ConfMan.hasKey("scummverse_shots") && !one && worldLandmark(g, r)) shot(name + ".png");
+	}
+	g_system->updateScreen();
+	warning("SCUMMVERSE sandbox selftest %s: %d shown, %d people, %d walked across, %d as near as they go, %d skipped, %d failed, %d colours, screen %dx%d %s",
+		mode.c_str(), shown, people, arrivedCount, unreached, skipped, failed, colors, _width, _height, _format.toString().c_str());
+	if (!shown || failed) return Common::Error(Common::kUnknownError, "sandbox selftest failed");
+	warning("SCUMMVERSE sandbox selftest PASS");
+	if (mode == "back") {
+		back();
+		Common::Event event;
+		while (!shouldQuit() && g_system->getEventManager()->pollEvent(event)) {}
+		warning("SCUMMVERSE sandbox back: %s", shouldQuit() ? "leaving" : "still here");
+	}
+	return Common::kNoError;
+}
+
+} // End of namespace Scummverse
