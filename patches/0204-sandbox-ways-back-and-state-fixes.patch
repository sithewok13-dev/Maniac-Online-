+// From that place through its game's doors (a door shut, or kept shut by its
+// game until something is so, is one) to the other, or to a ride, a tram or
+// the van, which go on anywhere.
+bool SandboxEngine::reaches(int game, int from, int to) const {
+	const WorldMap *map = game >= 0 ? worldMap(game) : nullptr;
+	if (!map) return true;
+	Common::Array<int> queue;
+	Common::HashMap<int, bool> seen;
+	queue.push_back(from); seen[from] = true;
+	for (uint i = 0; i < queue.size(); ++i) {
+		const int room = queue[i];
+		int line, end;
+		if (room == to || worldTramStop(game, room, line, end) || _vanPlace == game * 1024 + room) return true;
+		for (const WorldRide &r : kWorldRides) if (r.game == game && r.room == room) return true;
+		for (int l = 0; l < map->linkCount; ++l) {
+			const WorldLink &link = map->links[l];
+			if (link.room != room || seen.contains(link.target) || !installed(game, link.target)) continue;
+			seen[link.target] = true;
+			queue.push_back(link.target);
+		}
 	}
 	return false;
 }
 
