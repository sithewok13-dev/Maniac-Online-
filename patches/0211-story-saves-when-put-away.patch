+// here next time).
+void ScummEngine::scummverseStoryBeforeMenu(const Common::KeyState &key) {
+	if (!_scummverseStory || !isUsingOriginalGUI() || !key.hasFlags(0) || (_game.features & GF_DEMO)) return;
