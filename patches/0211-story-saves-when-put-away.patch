+// A story's save written, in its story slot or as its autosave (any way:
+// the story's own, the game's menu, ScummVM's autosave): numbered after the
+// other, so the newer is known whatever the clock says; written to disk at
+// once, as the save is (the app may be stopped next).
+void ScummEngine::scummverseStoryCount(int slot) {
+	if (!_scummverseStory || (slot != kWorldStorySlot && slot != 0) || !ConfMan.hasGameDomain(_targetName)) return;
+	const int order = MAX(scummverseStoryOrder(_targetName, kWorldStorySlot), scummverseStoryOrder(_targetName, 0)) + 1;
+	ConfMan.setInt(Common::String::format("scummverse_story_order%d", slot), order, _targetName);
+	ConfMan.flushToDisk();
+}
