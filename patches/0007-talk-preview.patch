index 00000000..870e14ba
--- /dev/null
+++ b/backends/platform/ios7/scummverse_talk_ui.inc
@@ -0,0 +1,121 @@
+// Native, keyboard-aware conversation panel. GPL-3.0-or-later.
+@interface ScummverseTalkController : UIViewController <UITextFieldDelegate> {
+	NSInteger _actor;
+	UITextView *_transcript;
+	UITextField *_input;
+	UIButton *_send;
+	UILabel *_status;
+	NSTimer *_timer;
+	NSLayoutConstraint *_keyboardBottom;
+}
+- (id)initWithActor:(NSInteger)actor;
+- (void)sendMessage;
+- (void)closeTalk;
+- (void)refreshTalk;
+- (void)keyboardChanged:(NSNotification *)notification;
+@end
+@implementation ScummverseTalkController
+- (id)initWithActor:(NSInteger)actor {
+	if ((self = [super init])) { _actor = actor; self.modalPresentationStyle = UIModalPresentationOverFullScreen; }
+	return self;
+}
+- (void)viewDidLoad {
+	[super viewDidLoad];
+	self.view.backgroundColor = [UIColor colorWithWhite:0.05 alpha:0.97];
+	UIStackView *stack = [[[UIStackView alloc] init] autorelease];
+	stack.axis = UILayoutConstraintAxisVertical; stack.spacing = 6; stack.translatesAutoresizingMaskIntoConstraints = NO;
+	[self.view addSubview:stack];
+	_keyboardBottom = [stack.bottomAnchor constraintEqualToAnchor:self.view.safeAreaLayoutGuide.bottomAnchor constant:-8];
+	[NSLayoutConstraint activateConstraints:@[
+		[stack.topAnchor constraintEqualToAnchor:self.view.safeAreaLayoutGuide.topAnchor constant:8],
+		[stack.leadingAnchor constraintEqualToAnchor:self.view.safeAreaLayoutGuide.leadingAnchor constant:16],
+		[stack.trailingAnchor constraintEqualToAnchor:self.view.safeAreaLayoutGuide.trailingAnchor constant:-16], _keyboardBottom]];
+	UIStackView *header = [[[UIStackView alloc] init] autorelease]; header.spacing = 8;
+	UILabel *name = [[[UILabel alloc] init] autorelease];
+	name.text = [NSString stringWithFormat:@"Talk to %s", ScummverseLocalAI::actorName((int)_actor)];
+	name.textColor = UIColor.whiteColor; name.font = [UIFont boldSystemFontOfSize:18];
+	UIButton *close = [UIButton buttonWithType:UIButtonTypeSystem]; [close setTitle:@"Done" forState:UIControlStateNormal];
+	[close addTarget:self action:@selector(closeTalk) forControlEvents:UIControlEventTouchUpInside];
+	[header addArrangedSubview:name]; [header addArrangedSubview:close];
+	[close.widthAnchor constraintEqualToConstant:70].active = YES;
+	[header.heightAnchor constraintEqualToConstant:36].active = YES; [stack addArrangedSubview:header];
+	_transcript = [[[UITextView alloc] init] autorelease]; _transcript.editable = NO;
+	_transcript.backgroundColor = UIColor.clearColor; _transcript.textColor = UIColor.whiteColor;
+	_transcript.font = [UIFont systemFontOfSize:16];
+	_transcript.text = @"Say hello. Replies are generated on your phone. Conversation does not perform game actions.";
+	[stack addArrangedSubview:_transcript];
+	_status = [[[UILabel alloc] init] autorelease]; _status.textColor = UIColor.lightGrayColor;
+	_status.font = [UIFont systemFontOfSize:12]; _status.numberOfLines = 1;
+	[stack addArrangedSubview:_status];
+	UIStackView *composer = [[[UIStackView alloc] init] autorelease]; composer.spacing = 8;
+	_input = [[[UITextField alloc] init] autorelease]; _input.borderStyle = UITextBorderStyleRoundedRect;
+	_input.placeholder = @"Type a message..."; _input.delegate = self; _input.returnKeyType = UIReturnKeySend;
+	_input.accessibilityLabel = @"Message to character";
+	_send = [UIButton buttonWithType:UIButtonTypeSystem]; [_send setTitle:@"Send" forState:UIControlStateNormal];
+	[_send addTarget:self action:@selector(sendMessage) forControlEvents:UIControlEventTouchUpInside];
+	[composer addArrangedSubview:_input]; [composer addArrangedSubview:_send];
+	[_send.widthAnchor constraintEqualToConstant:64].active = YES;
+	[composer.heightAnchor constraintEqualToConstant:40].active = YES; [stack addArrangedSubview:composer];
+	[[NSNotificationCenter defaultCenter] addObserver:self selector:@selector(keyboardChanged:) name:UIKeyboardWillChangeFrameNotification object:nil];
+	_timer = [NSTimer scheduledTimerWithTimeInterval:0.2 target:self selector:@selector(refreshTalk) userInfo:nil repeats:YES];
+	[self refreshTalk];
+}
+- (void)keyboardChanged:(NSNotification *)notification {
+	CGRect frame = [self.view convertRect:[notification.userInfo[UIKeyboardFrameEndUserInfoKey] CGRectValue] fromView:nil];
+	CGFloat overlap = MAX(0, CGRectGetMaxY(self.view.bounds) - CGRectGetMinY(frame));
+	_keyboardBottom.constant = -8 - MAX(0, overlap - self.view.safeAreaInsets.bottom);
+	[self.view layoutIfNeeded];
+	if (_transcript.text.length) [_transcript scrollRangeToVisible:NSMakeRange(_transcript.text.length - 1, 1)];
+}
+- (BOOL)textField:(UITextField *)field shouldChangeCharactersInRange:(NSRange)range replacementString:(NSString *)text {
+	NSString *next = [field.text stringByReplacingCharactersInRange:range withString:text];
+	return next.length <= 160 && [next lengthOfBytesUsingEncoding:NSUTF8StringEncoding] <= 512;
+}
+- (BOOL)textFieldShouldReturn:(UITextField *)field { [self sendMessage]; return NO; }
+- (void)sendMessage {
+	NSString *text = [_input.text stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
+	if (!text.length) return;
+	if (!ScummverseLocalAI::runtime().sendTalk(text.UTF8String)) {
+		_status.text = @"Model not ready or busy. Check AI settings, or wait and retry."; return;
+	}
+	_transcript.text = [_transcript.text stringByAppendingFormat:@"\n\nYou: %@", text];
+	_input.text = @""; [self refreshTalk];
+}
+- (void)refreshTalk {
+	auto &runtime = ScummverseLocalAI::runtime();
+	std::string reply;
+	if (runtime.readTalk(reply)) {
+		_transcript.text = [_transcript.text stringByAppendingFormat:@"\n\n%s: %s", ScummverseLocalAI::actorName((int)_actor), reply.c_str()];
+		// Keep the visible transcript bounded as well as the inference history.
+		if (_transcript.text.length > 8000) _transcript.text = [_transcript.text substringFromIndex:_transcript.text.length - 6000];
+		[_transcript scrollRangeToVisible:NSMakeRange(_transcript.text.length - 1, 1)];
+	}
+	BOOL active = runtime.talkingTo() == _actor;
+	BOOL waiting = runtime.waitingForTalk();
+	_send.enabled = active && !waiting; _input.enabled = active && !waiting;
+	_status.text = !active ? @"Conversation ended. Close this panel to continue." : waiting ? @"Thinking of a reply... (up to 30 seconds)" : [NSString stringWithUTF8String:runtime.getStatus().c_str()];
+}
+- (void)closeTalk { [self.view endEditing:YES]; [self dismissViewControllerAnimated:YES completion:nil]; }
+- (void)viewDidDisappear:(BOOL)animated {
+	[super viewDidDisappear:animated]; [_timer invalidate]; _timer = nil;
+	[[NSNotificationCenter defaultCenter] removeObserver:self]; ScummverseLocalAI::runtime().endTalk();
+}
+@end
+
+static void scummverseShowTalk(UIView *view) {
+	UIResponder *responder = view;
+	while (responder && ![responder isKindOfClass:UIViewController.class]) responder = responder.nextResponder;
+	UIViewController *controller = (UIViewController *)responder;
+	if (!controller || controller.presentedViewController) return;
+	unsigned actors = ScummverseLocalAI::runtime().actorsInRoom();
+	UIAlertController *picker = [UIAlertController alertControllerWithTitle:@"Talk" message:actors ? @"Choose someone in this room." : @"Nobody to talk to here. Find a character, then tap Talk." preferredStyle:UIAlertControllerStyleAlert];
+	for (int actor = 1; actor < 25; ++actor) if (actors & (1u << actor)) {
+		[picker addAction:[UIAlertAction actionWithTitle:[NSString stringWithUTF8String:ScummverseLocalAI::actorName(actor)] style:UIAlertActionStyleDefault handler:^(UIAlertAction *) {
+			if (!ScummverseLocalAI::runtime().beginTalk(actor)) return;
+			ScummverseTalkController *panel = [[[ScummverseTalkController alloc] initWithActor:actor] autorelease];
+			[controller presentViewController:panel animated:YES completion:nil];
+		}]];
+	}
+	[picker addAction:[UIAlertAction actionWithTitle:@"Cancel" style:UIAlertActionStyleCancel handler:nil]];
+	[controller presentViewController:picker animated:YES completion:nil];
+}
