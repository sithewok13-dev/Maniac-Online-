diff --git a/backends/platform/ios7/scummverse_tour_ui.inc b/backends/platform/ios7/scummverse_tour_ui.inc
new file mode 100644
index 00000000..c93e8c81
--- /dev/null
+++ b/backends/platform/ios7/scummverse_tour_ui.inc
@@ -0,0 +1,110 @@
+// TOUR: the label over the game naming the stop being visited (its number,
+// code and name, to note down for bug reports; tap it for the tour's
+// controls) and the controls themselves, opened from the Worlds menu. The
+// game does the touring (engines/scumm/scummverse_tour.inc); requests and
+// the label pass through common/scummverse_tour.h. Manual reference
+// counting, like this file.
+
+#include "common/scummverse_tour.h"
+
+static void scummverseShowTour(UIViewController *controller);
+
+static UIViewController *scummverseTourController(UIView *view) {
+	UIResponder *responder = view;
+	while (responder && ![responder isKindOfClass:UIViewController.class]) responder = responder.nextResponder;
+	UIViewController *controller = (UIViewController *)responder;
+	return controller && !controller.presentedViewController ? controller : nil;
+}
+
+@interface ScummverseTourTapper : NSObject
+@property (nonatomic, assign) UIView *host;
+- (void)tap;
+@end
+@implementation ScummverseTourTapper
+- (void)tap {
+	if (UIViewController *controller = scummverseTourController(self.host)) scummverseShowTour(controller);
+}
+@end
+
+static UILabel *scummverseTourLabel;
+static ScummverseTourTapper *scummverseTourTapper;
+
+// Shows the label while touring, at the top left of the game.
+static void scummverseTourRefresh(UIView *view) {
+	bool running = false;
+	char text[200];
+	int next = 1, total = 0;
+	Scummverse::Tour::status(running, text, sizeof(text), next, total);
+	if (!running || !text[0]) { scummverseTourLabel.hidden = YES; return; }
+	if (!scummverseTourLabel) {
+		scummverseTourLabel = [[UILabel alloc] init];
+		scummverseTourLabel.textColor = UIColor.whiteColor;
+		scummverseTourLabel.backgroundColor = [UIColor colorWithWhite:0 alpha:0.6];
+		scummverseTourLabel.font = [UIFont monospacedDigitSystemFontOfSize:13 weight:UIFontWeightSemibold];
+		scummverseTourLabel.numberOfLines = 2;
+		scummverseTourLabel.layer.cornerRadius = 6;
+		scummverseTourLabel.clipsToBounds = YES;
+		scummverseTourLabel.userInteractionEnabled = YES;
+		scummverseTourLabel.accessibilityHint = @"Opens the tour's controls";
+		scummverseTourTapper = [[ScummverseTourTapper alloc] init];
+		UITapGestureRecognizer *tap = [[[UITapGestureRecognizer alloc] initWithTarget:scummverseTourTapper action:@selector(tap)] autorelease];
+		[scummverseTourLabel addGestureRecognizer:tap];
+	}
+	scummverseTourTapper.host = view;
+	if (scummverseTourLabel.superview != view) [view addSubview:scummverseTourLabel];
+	[view bringSubviewToFront:scummverseTourLabel];
+	NSString *label = [NSString stringWithFormat:@" %@ ", [NSString stringWithUTF8String:text] ?: @""];
+	if (![scummverseTourLabel.text isEqualToString:label]) scummverseTourLabel.text = label;
+	UIEdgeInsets safe = UIEdgeInsetsZero;
+	if (@available(iOS 11, *)) safe = view.safeAreaInsets;
+	// Clear of the buttons down the right side.
+	const CGFloat width = MAX(120, view.bounds.size.width - safe.left - safe.right - 72);
+	const CGSize fit = [scummverseTourLabel sizeThatFits:CGSizeMake(width, 40)];
+	scummverseTourLabel.frame = CGRectMake(safe.left + 6, safe.top + 4, MIN(width, fit.width + 8), fit.height + 6);
+	scummverseTourLabel.hidden = NO;
+}
+
+static void scummverseInstallTour(UIView *view) {
+	[NSTimer scheduledTimerWithTimeInterval:0.5 repeats:YES block:^(NSTimer *) { scummverseTourRefresh(view); }];
+}
+
+// "Go to stop…": a number.
+static void scummverseTourAskStop(UIViewController *controller, int total) {
+	UIAlertController *ask = [UIAlertController alertControllerWithTitle:@"Go to stop"
+		message:[NSString stringWithFormat:@"A stop's number, 1 to %d", total] preferredStyle:UIAlertControllerStyleAlert];
+	[ask addTextFieldWithConfigurationHandler:^(UITextField *field) { field.keyboardType = UIKeyboardTypeNumberPad; field.placeholder = @"Stop number"; }];
+	__block UIAlertController *asking = ask; // (not retained by its own action)
+	[ask addAction:[UIAlertAction actionWithTitle:@"Go" style:UIAlertActionStyleDefault handler:^(UIAlertAction *) {
+		const int stop = asking.textFields.firstObject.text.intValue;
+		if (stop >= 1 && stop <= total) Scummverse::Tour::request(Scummverse::Tour::kGoTo, stop);
+	}]];
+	[ask addAction:[UIAlertAction actionWithTitle:@"Cancel" style:UIAlertActionStyleCancel handler:nil]];
+	[controller presentViewController:ask animated:YES completion:nil];
+}
+
+static void scummverseShowTour(UIViewController *controller) {
+	bool running = false;
+	char text[200];
+	int next = 1, total = 0;
+	Scummverse::Tour::status(running, text, sizeof(text), next, total);
+	NSString *message = @"Your character goes on autopilot and visits every location of the twelve games in turn (Maniac Mansion, Zak McKracken, then every room of your other games), walking across each one and on through a door where one leads there; it warps only where none does. The label at the top names each stop: note its number or code to report a bug. Stopping brings your character back.";
+	if (running) message = [NSString stringWithFormat:@"%@\n\nNow: %@", message, [NSString stringWithUTF8String:text] ?: @""];
+	else if (total) message = [NSString stringWithFormat:@"%@\n\n%d stops; the next is stop %d.", message, total, next];
+	UIAlertController *menu = [UIAlertController alertControllerWithTitle:@"Tour every location" message:message preferredStyle:UIAlertControllerStyleAlert];
+	auto add = ^(NSString *title, int command) {
+		[menu addAction:[UIAlertAction actionWithTitle:title style:UIAlertActionStyleDefault handler:^(UIAlertAction *) { Scummverse::Tour::request(command); }]];
+	};
+	if (running) {
+		add(@"Next stop", Scummverse::Tour::kNext);
+		add(@"Previous stop", Scummverse::Tour::kPrevious);
+	} else {
+		add(next > 1 ? [NSString stringWithFormat:@"Start at stop %d", next] : @"Start the tour", Scummverse::Tour::kResume);
+		if (next > 1) add(@"Start over at stop 1", Scummverse::Tour::kRestart);
+	}
+	[menu addAction:[UIAlertAction actionWithTitle:@"Go to stop…" style:UIAlertActionStyleDefault handler:^(UIAlertAction *) {
+		[controller dismissViewControllerAnimated:YES completion:^{ scummverseTourAskStop(controller, total > 0 ? total : 1); }];
+	}]];
+	if (running) add(@"Stop the tour", Scummverse::Tour::kStop);
+	[menu addAction:[UIAlertAction actionWithTitle:@"Close" style:UIAlertActionStyleCancel handler:nil]];
+	[controller presentViewController:menu animated:YES completion:nil];
+}
