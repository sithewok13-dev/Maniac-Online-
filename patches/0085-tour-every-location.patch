diff --git a/common/scummverse_tour.cpp b/common/scummverse_tour.cpp
new file mode 100644
index 00000000..9fa8b263
--- /dev/null
+++ b/common/scummverse_tour.cpp
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Scummverse TOUR: portable part. See scummverse_tour.h.
+#define FORBIDDEN_SYMBOL_ALLOW_ALL
+
+#include "common/scummverse_tour.h"
+
+#include <algorithm>
+#include <cstring>
+#include <mutex>
+#include <string>
+
+namespace Scummverse {
+namespace Tour {
+
+static std::mutex g_mutex;
+static int g_command = kNone, g_stop = 0;
+static bool g_said = false, g_running = false;
+static std::string g_label;
+static int g_next = 1, g_total = 0;
+
+void request(int command, int stop) {
+	std::lock_guard<std::mutex> guard(g_mutex);
+	g_command = command; g_stop = stop;
+}
+
+bool takeRequest(int &command, int &stop) {
+	std::lock_guard<std::mutex> guard(g_mutex);
+	if (g_command == kNone) return false;
+	command = g_command; stop = g_stop;
+	g_command = kNone; g_stop = 0;
+	return true;
+}
+
+void publish(bool running, const char *label, int next, int total) {
+	std::lock_guard<std::mutex> guard(g_mutex);
+	g_said = true; g_running = running; g_label = label ? label : "";
+	g_next = next; g_total = total;
+}
+
+bool status(bool &running, char *label, int capacity, int &next, int &total) {
+	std::lock_guard<std::mutex> guard(g_mutex);
+	running = g_running; next = g_next; total = g_total;
+	if (label && capacity > 0) {
+		size_t n = std::min(g_label.size(), (size_t)capacity - 1);
+		// Whole characters only (UTF-8: never in the middle of one).
+		while (n > 0 && n < g_label.size() && ((unsigned char)g_label[n] & 0xC0) == 0x80) --n;
+		memcpy(label, g_label.data(), n);
+		label[n] = 0;
+	}
+	return g_said;
+}
+
+void reset() {
+	std::lock_guard<std::mutex> guard(g_mutex);
+	g_command = kNone; g_stop = 0;
+	g_said = false; g_running = false; g_label.clear(); g_next = 1; g_total = 0;
+}
+
+} // namespace Tour
+} // namespace Scummverse
diff --git a/common/scummverse_tour.h b/common/scummverse_tour.h
new file mode 100644
index 00000000..e133c824
--- /dev/null
+++ b/common/scummverse_tour.h
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Scummverse TOUR: a character on autopilot visits every location in turn
+// (Maniac Mansion's rooms, Zak's, then every room exported from the other
+// games), walking across each while the player watches for bugs; a label
+// names each stop: its number, its code and its name. The interface asks
+// (start, next, ...) and shows the label; the game does the touring
+// (engines/scumm/scummverse_tour.inc). Plain types only.
+#ifndef COMMON_SCUMMVERSE_TOUR_H
+#define COMMON_SCUMMVERSE_TOUR_H
+
+namespace Scummverse {
+namespace Tour {
+
+// ---- Requests (the interface's thread; taken by the game's) ----
+enum Command { kNone = 0, kResume, kRestart, kNext, kPrevious, kStop, kGoTo };
+// kGoTo takes the stop's number (1 = the first).
+void request(int command, int stop = 0);
+bool takeRequest(int &command, int &stop);
+
+// ---- What the game says (the game's thread; read by the interface) ----
+// running: touring now; label: the stop being visited ("" when not
+// touring); next: the stop a resumed tour starts at (1-based); total: stops.
+void publish(bool running, const char *label, int next, int total);
+// The latest: false until the game has said anything. Copies the label
+// (truncated to capacity, at a whole UTF-8 character).
+bool status(bool &running, char *label, int capacity, int &next, int &total);
+
+// Nothing waiting or said (a game starting or ending).
+void reset();
+
+} // namespace Tour
+} // namespace Scummverse
+
+#endif
