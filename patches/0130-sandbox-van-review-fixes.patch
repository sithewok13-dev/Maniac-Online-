+bool Scene::propHit(int n, int screenX, int screenY) const {
+	if (n < 0 || n >= (int)_props.size()) return false;
+	const Prop &prop = _props[n];
+	const Placement p = placeOf(prop.frame, prop.at, prop.rows, prop.pixelAspect, _view, _boxes);
+	int x0, y0, x1, y1;
+	if (!rectOf(p, _view, x0, y0, x1, y1) || screenX < x0 || screenX >= x1 || screenY < y0 || screenY >= y1) return false;
+	// (As render picks the pixel drawn there.)
+	const int row = std::min(prop.frame.height - 1, (int)((screenY - p.y0) / p.down));
+	const int col = std::min(prop.frame.width - 1, (int)((screenX - p.x0) / p.across));
+	return row >= 0 && col >= 0 && prop.frame.mask[(size_t)row * prop.frame.width + col];
+}
