+	const auto r = std::lower_bound(rooms.begin(), rooms.end(), room, [](const std::pair<int, std::vector<GameThing> > &a, int b) { return a.first < b; });
+	if (r == rooms.end() || r->first != room) return nullptr;
+	const auto t = std::lower_bound(r->second.begin(), r->second.end(), id, [](const GameThing &a, int b) { return a.id < b; });
+	return t != r->second.end() && t->id == id ? &*t : nullptr;
+}
+
+bool parseThings(const uint8_t *data, size_t size, GameThings &out, std::string &error) {
+	out = GameThings();
+	if (!data || size < 6 || std::memcmp(data, "SVO1", 4)) { error = "not a things file"; return false; }
+	Reader r(data + 4, data + size);
+	const int rooms = r.u16();
+	if (rooms > kMostThingRooms) { error = "too many rooms"; return false; }
+	for (int i = 0; i < rooms && r.ok; ++i) {
+		const int room = r.u16(), count = r.u16();
+		if (count > kMostThings) { out = GameThings(); error = "too many things"; return false; }
+		std::vector<GameThing> things;
+		for (int k = 0; k < count && r.ok; ++k) {
+			GameThing t;
+			t.id = r.u16(); t.picture = r.u8(); t.answers = r.u16();
+			things.push_back(t);
+		}
+		std::stable_sort(things.begin(), things.end(), [](const GameThing &a, const GameThing &b) { return a.id < b.id; });
+		out.rooms.push_back(std::make_pair(room, std::move(things)));
+	}
+	if (!r.ok || r.p != r.end) { out = GameThings(); error = "truncated things file"; return false; }
+	std::stable_sort(out.rooms.begin(), out.rooms.end(), [](const std::pair<int, std::vector<GameThing> > &a, const std::pair<int, std::vector<GameThing> > &b) { return a.first < b.first; });
