+// Maniac's rooms by their own numbers, as Maniac tells the chat; the other
+// games' as places.
+int SandboxEngine::talkRoom() const {
+	return _game < 0 ? 0 : !strcmp(kWorldGames[_game].gameid, "maniac") ? _room : worldPlaceKey(_game, _room);
+}
+
+void SandboxEngine::chatCommand(int command) {
+	const bool along = command >= 64 + kTalkVisitor && command < 64 + kTalkVisitor + kTalkSlots;
+	const bool stay = command >= 96 + kTalkVisitor && command < 96 + kTalkVisitor + kTalkSlots;
+	if (!along && !stay) return;
+	const int n = slotActor(command - (along ? 64 : 96) - kTalkVisitor, _player);
+	if (n >= (int)_onStage.size() || n == _player || _player < 0) return;
+	follow(_onStage[n], along);
+	if (along) StageBridge::stop(n);
+	sayAs(n, along ? "I'll come with you." : "See you around!");
+}
+
+bool SandboxEngine::following(int key) const {
+	if (_leader != _playerKey || key == _playerKey) return false;
+	for (int k : _followers) if (k == key) return true;
+	return false;
+}
+
+void SandboxEngine::follow(int key, bool on) {
+	if (_leader != _playerKey) { _followers.clear(); _leader = _playerKey; }
+	for (uint i = 0; i < _followers.size(); ++i) if (_followers[i] == key) { _followers.remove_at(i); break; }
+	if (on) _followers.push_back(key);
+	followersKeep();
+}
+
+// Who is far from the one played walks to beside them (now and then, not
+// while talking); one walking on is let be.
+void SandboxEngine::followStep(int ticks) {
+	if ((_followClock -= ticks) > 0 || _player < 0 || _followers.empty()) return;
+	_followClock = 20;
+	double px, py, x, y;
+	StageBridge::position(_player, px, py);
+	const double reach = 24.0 * screenWidthOf(_game) / 320;
+	int side = 0;
+	for (uint n = 0; n < _onStage.size(); ++n) {
+		if ((int)n == _player || !following(_onStage[n])) continue;
+		++side;
+		if (StageBridge::moving(n) || (actorSlot(n, _player) < kTalkSlots && (_chatting & (1ULL << (kTalkVisitor + actorSlot(n, _player)))))) continue;
+		StageBridge::position(n, x, y);
+		if ((x - px) * (x - px) + (y - py) * (y - py) > reach * reach) StageBridge::walkTo(n, px + (side % 2 ? -1 : 1) * reach * (0.5 + side / 2), py);
+	}
+}
+
+// Those following come along to wherever the one played arrives (shown
+// there among the wanderers too), beside them; someone else played, they
+// follow no one.
+void SandboxEngine::bringFollowers() {
+	if (_leader != _playerKey && !_followers.empty()) { _followers.clear(); followersKeep(); }
+	if (_followers.empty() || _player < 0) return;
+	double px, py;
+	StageBridge::position(_player, px, py);
+	const int here = place(_game, _room);
+	const double reach = 24.0 * screenWidthOf(_game) / 320;
+	int side = 0;
+	for (int key : _followers) {
+		if (key == _playerKey) continue;
+		if (_wanderers && here) WanderBridge::send(key, here);
+		int n = -1;
+		for (uint i = 0; i < _onStage.size(); ++i) if ((int)i != _player && _onStage[i] == key) n = i;
+		if (n < 0 && (n = addPerson(key)) >= 0) _onStage.push_back(key);
+		++side;
+		if (n >= 0) StageBridge::place(n, px + (side % 2 ? -1 : 1) * reach * (0.5 + side / 2), py);
+	}
+	_people = _onStage.size();
+}
+
+// (Kept as the one followed, a colon, then those following between commas.)
+Common::String SandboxEngine::followersKept() const {
+	if (_followers.empty()) return "";
+	Common::String kept = Common::String::format("%d:", _leader);
+	for (uint i = 0; i < _followers.size(); ++i) kept += Common::String::format(i ? ",%d" : "%d", _followers[i]);
+	return kept;
+}
+
+void SandboxEngine::followersRead(const Common::String &kept) {
+	_followers.clear(); _leader = 0;
+	const char *p = kept.c_str();
+	char *end;
+	const long leader = strtol(p, &end, 10);
+	if (end == p || *end != ':') return;
+	_leader = (int)leader;
+	p = end + 1;
+	while (*p) {
+		const long key = strtol(p, &end, 10);
+		if (end == p) break;
+		if (key > 0 && key != leader && hasCharacter((int)key)) _followers.push_back((int)key);
+		p = *end == ',' ? end + 1 : end;
+	}
+}
+
+void SandboxEngine::followersKeep() const {
+	if (_testing) return;
+	ConfMan.set(kFollowersKey, followersKept());
+	ConfMan.flushToDisk();
+}
