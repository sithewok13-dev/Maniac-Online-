+void Scene::setFlashlight(bool on, Point at, int width, int height) {
+	_beam = Beam();
+	if (!on || width <= 0 || height <= 0) return;
+	_beam.on = true;
+	_beam.w = std::min(width, _source.width); _beam.h = std::min(height, _source.height);
+	_beam.x = std::max(0, std::min(_source.width - _beam.w, ((int)std::floor(at.x) & ~7) - _beam.w / 2));
+	_beam.y = std::max(0, std::min(_source.height - _beam.h, ((int)std::floor(at.y) & ~1) - _beam.h / 2));
+}
+
+bool Scene::flashlight(int &x, int &y, int &width, int &height) const {
+	x = _beam.x; y = _beam.y; width = _beam.w; height = _beam.h;
+	return _beam.on;
+}
+
+bool Scene::beamShows(int sx, int sy) const {
+	const int px = sx - _beam.x, py = sy - _beam.y;
+	if (!_beam.on || px < 0 || py < 0 || px >= _beam.w || py >= _beam.h) return false;
+	// (Rounded within four pixels of each corner.)
+	const int r = 4, dx = r - std::min(px, _beam.w - 1 - px), dy = r - std::min(py, _beam.h - 1 - py);
+	return dx <= 0 || dy <= 0 || dx * dx + dy * dy <= r * r;
+}
