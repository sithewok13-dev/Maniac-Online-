+bool SandboxEngine::isFlashlight(const Carried &c) const {
+	Common::String name = c.name;
+	name.toLowercase();
+	return c.game >= 0 && c.game < worldGameCount() && !strcmp(kWorldGames[c.game].gameid, "maniac") && name.contains("flashlight");
+}
