diff --git a/engines/scumm/scummverse_camera.inc b/engines/scumm/scummverse_camera.inc
new file mode 100644
index 00000000..85bc6119
--- /dev/null
+++ b/engines/scumm/scummverse_camera.inc
@@ -0,0 +1,287 @@
+// Scummverse CAMERA, the game's side: photos of the screen and selfies.
+// The portable part (requests, whole-pixel enlarging, selfie framing,
+// poses, handing pictures over) is common/scummverse_camera.{h,cpp}; the
+// iPhone's button, flash, shutter and saving are in the iOS backend
+// (scummverse_camera_ui.inc). Included by scumm.cpp, which includes the
+// plain-types bridge (common/scummverse_camera_engine.h).
+
+namespace ScummverseCam = ::Scummverse::Camera;
+
+// What a selfie keeps to put back exactly (everyone's pose, the screen
+// strips they were drawn in, the other worlds' animation clocks), and how
+// far it has got. Each shot is posed afresh from how everyone was.
+struct ScummEngine::ScummverseSelfie {
+	struct Kept {
+		int id;
+		Actor::PoseState pose;
+	};
+	Common::Array<Kept> kept;
+	Common::Array<uint32> usage;
+	int guestTick[kScummverseGuestSlots], guestShown[kScummverseGuestSlots];
+	int avatarTick[kScummverseManiacActors], avatarShown[kScummverseManiacActors];
+	// A character drawn from exported frames: its pose this shot (-1: its own).
+	int spriteKind[kScummverseGuestActor + kScummverseGuestSlots], spriteIndex[kScummverseGuestActor + kScummverseGuestSlots];
+	int shots = 1, shot = 0;
+	bool showing = false; // the last shot taken, held on screen a moment
+	bool restored = false; // everything put back; the next step draws it
+	// The frame, set by the first shot and kept for the others (the camera
+	// held still while they pose afresh).
+	ScummverseCam::Rect frame;
+	uint32 seed = 0, due = 0;
+};
+
+// The first shot waits a moment once everyone is posed; each shot stays on
+// screen a little (the flash goes off over it); the last a little longer.
+static const uint32 kSelfieSettle = 400, kSelfieNext = 300, kSelfieShow = 900;
+
+bool ScummEngine::scummverseCameraStep() {
+	ScummverseCam::Request request;
+	if (_game.id != GID_MANIAC) {
+		if (ScummverseCam::takeRequest(request)) ScummverseCam::note("No camera in this game");
+		return false;
+	}
+	if (ScummverseCam::held()) return true;
+	if (_scummverseSelfie) {
+		ScummverseSelfie &s = *_scummverseSelfie;
+		// Put back last step: this one runs the game and draws it as it was
+		// (a photo waits a step, so it is not of the posed room).
+		if (s.restored) {
+			scummverseSelfieFree();
+			return false;
+		}
+		if ((int32)(_system->getMillis() - s.due) < 0) return true;
+		if (s.showing) {
+			scummverseSelfieEnd();
+			return true;
+		}
+		if (!scummverseSelfieShoot()) {
+			ScummverseCam::note(s.shot ? "Took only some of the selfie" : "Couldn't take the selfie");
+			s.showing = true; s.due = _system->getMillis();
+			return true;
+		}
+		if (++s.shot < s.shots) {
+			scummverseSelfiePose();
+			scummverseSelfieDraw();
+			s.due = _system->getMillis() + kSelfieNext;
+		} else {
+			s.showing = true;
+			s.due = _system->getMillis() + kSelfieShow;
+		}
+		return true;
+	}
+	if (!ScummverseCam::takeRequest(request)) return false;
+	if (request.kind == ScummverseCam::kSelfie) return scummverseSelfieBegin(request.shots);
+	if (!scummverseTakePhoto(request.kind)) ScummverseCam::note("Couldn't take the photo");
+	return false;
+}
+
+// The room as last drawn (CLEAN), or the whole screen as shown (FULL): the
+// room, the line above it and the verbs and inventory at their own lines
+// (not the hidden banner screen), the text over them (speech), and the
+// line's colors as the DOS V1 screen shows them (see drawStripToScreen).
+bool ScummEngine::scummverseCameraPicture(int kind, Common::Array<byte> &pixels, int &width, int &height, int &pitch) {
+	width = _screenWidth;
+	if (kind == ScummverseCam::kClean) {
+		const VirtScreen &main = _virtscr[kMainVirtScreen];
+		if (main.h <= 0 || !main.getPixels(0, 0)) return false;
+		height = main.h; pitch = _screenWidth;
+		pixels.resize(width * height);
+		for (int y = 0; y < height; ++y) memcpy(&pixels[y * pitch], main.getPixels(0, y), MIN<int>(width, main.w));
+		return true;
+	}
+	height = _screenHeight; pitch = _screenWidth;
+	pixels.resize(width * height);
+	memset(pixels.data(), 0, pixels.size());
+	const int screens[] = {kMainVirtScreen, kTextVirtScreen, kVerbVirtScreen};
+	for (int i : screens) {
+		const VirtScreen &vs = _virtscr[i];
+		if (vs.h <= 0 || !vs.getPixels(0, 0)) continue;
+		for (int y = 0; y < vs.h; ++y) {
+			const int row = vs.topline + y;
+			if (row >= 0 && row < height) memcpy(&pixels[row * pitch], vs.getPixels(0, y), MIN<int>(width, vs.w));
+		}
+	}
+	if (_textSurfaceMultiplier == 1 && _textSurface.getPixels() && _textSurface.w >= width && _textSurface.h >= height)
+		for (int y = 0; y < height; ++y) {
+			const byte *text = (const byte *)_textSurface.getBasePtr(0, y);
+			for (int x = 0; x < width; ++x)
+				if (text[x] != CHARSET_MASK_TRANSPARENCY) pixels[y * pitch + x] = text[x];
+		}
+	const VirtScreen &line = _virtscr[kTextVirtScreen];
+	if (_game.version == 1 && _game.platform == Common::kPlatformDOS && line.h > 0 && _renderMode != Common::kRenderCGA &&
+		_renderMode != Common::kRenderCGAComp && _renderMode != Common::kRenderHercA && _renderMode != Common::kRenderHercG)
+		for (int y = MAX<int>(0, line.topline); y < MIN<int>(height, line.topline + line.h); ++y)
+			for (int x = 0; x < width; ++x) {
+				byte &c = pixels[y * pitch + x];
+				if (c < 16) c = _gdi->remapColorToRenderMode(c);
+			}
+	return true;
+}
+
+bool ScummEngine::scummverseTakePhoto(int kind) {
+	Common::Array<byte> pixels;
+	int width, height, pitch;
+	if (!scummverseCameraPicture(kind, pixels, width, height, pitch)) return false;
+	ScummverseCam::Rect whole;
+	whole.w = width; whole.h = height;
+	return ScummverseCam::shoot(pixels.data(), pitch, width, height, _currentPalette, whole, kind, 0, 1);
+}
+
+// ---- Selfies ----
+
+bool ScummEngine::scummverseSelfieBegin(int shots) {
+	// (the sandbox's V1 edition: other editions' actors keep more state)
+	Actor *player = _scummverseRoaming && _game.version == 1 && VAR_EGO != 0xFF && VAR(VAR_EGO) > 0 && VAR(VAR_EGO) < _numActors ?
+		_actors[VAR(VAR_EGO)] : nullptr;
+	if (_currentRoom == 0 || !player || !player->isInCurrentRoom() || !player->_visible || !player->_costume) {
+		ScummverseCam::note("No selfie here");
+		return false;
+	}
+	ScummverseSelfie *s = new ScummverseSelfie();
+	for (int id = 1; id < _numActors; ++id) {
+		Actor *a = _actors[id];
+		if (!a->isInCurrentRoom() || !a->_visible || !a->_costume) continue;
+		ScummverseSelfie::Kept kept;
+		kept.id = id; kept.pose = a->getPoseState();
+		s->kept.push_back(kept);
+	}
+	s->usage.resize(ARRAYSIZE(gfxUsageBits));
+	memcpy(s->usage.data(), gfxUsageBits, sizeof(gfxUsageBits));
+	memcpy(s->guestTick, _scummverseGuestTick, sizeof(s->guestTick)); memcpy(s->guestShown, _scummverseGuestShown, sizeof(s->guestShown));
+	memcpy(s->avatarTick, _scummverseAvatarTick, sizeof(s->avatarTick)); memcpy(s->avatarShown, _scummverseAvatarShown, sizeof(s->avatarShown));
+	for (int &k : s->spriteKind) k = -1;
+	s->shots = CLIP(shots, 1, (int)ScummverseCam::kMaxSelfies);
+	s->seed = _system->getMillis() * 2654435761u ^ (uint32)_currentRoom * 40503u ^ (uint32)VAR(VAR_EGO);
+	_scummverseSelfie = s;
+	ScummverseCam::setBusy(true);
+	scummverseSelfiePose();
+	scummverseSelfieDraw();
+	s->due = _system->getMillis() + kSelfieSettle;
+	return true;
+}
+
+// Everyone faces the camera and strikes a pose from their own animations:
+// standing, mid-step or talking (now and then one hasn't noticed, or they
+// all stare at the player). Frames from other games pose likewise.
+void ScummEngine::scummverseSelfiePose() {
+	ScummverseSelfie &s = *_scummverseSelfie;
+	Common::Array<int> xs;
+	int player = -1;
+	for (const ScummverseSelfie::Kept &k : s.kept) {
+		Actor *a = _actors[k.id];
+		a->setPoseState(k.pose);
+		if (k.id == VAR(VAR_EGO)) player = (int)xs.size();
+		xs.push_back(a->getPos().x);
+	}
+	Common::Array<ScummverseCam::Choice> choices;
+	choices.resize(xs.size());
+	ScummverseCam::planShot(s.seed, s.shot, player, xs.data(), (int)xs.size(), choices.data());
+	for (uint i = 0; i < s.kept.size(); ++i) {
+		const int id = s.kept[i].id;
+		Actor *a = _actors[id];
+		const ScummverseCam::Choice &c = choices[i];
+		if (c.facing != ScummverseCam::kFaceAsIs)
+			a->setDirection(c.facing == ScummverseCam::kFaceLeft ? 270 : c.facing == ScummverseCam::kFaceRight ? 90 : 180);
+		const bool sprite = scummverseGuestSlot(a) >= 0 || (id < kScummverseManiacActors && _scummverseAvatarSprite[id]);
+		if (id < (int)ARRAYSIZE(s.spriteKind)) s.spriteKind[id] = -1;
+		if (c.pose == ScummverseCam::kAsIs) continue;
+		if (sprite) {
+			if (id < (int)ARRAYSIZE(s.spriteKind)) {
+				s.spriteKind[id] = c.pose == ScummverseCam::kStep ? 1 : c.pose == ScummverseCam::kTalk ? 2 : 0;
+				s.spriteIndex[id] = c.pose == ScummverseCam::kStand ? 0 : c.step * 2 + 1;
+			}
+			continue;
+		}
+		if (c.pose == ScummverseCam::kTalk) {
+			a->startAnimActor(a->_talkStartFrame);
+		} else if (c.pose == ScummverseCam::kStep) {
+			a->startAnimActor(a->_walkFrame);
+			_costumeLoader->loadCostume(a->_costume);
+			for (int n = 0; n <= c.step; ++n) _costumeLoader->increaseAnims(a);
+		} else {
+			a->startAnimActor(a->_standFrame);
+		}
+	}
+	for (const ScummverseSelfie::Kept &k : s.kept) _actors[k.id]->_needRedraw = true;
+}
+
+bool ScummEngine::scummverseSelfieSpritePose(const Actor *a, int &kind, int &index) const {
+	if (!_scummverseSelfie || a->_number >= (int)ARRAYSIZE(_scummverseSelfie->spriteKind)) return false;
+	const int k = _scummverseSelfie->spriteKind[a->_number];
+	if (k < 0) return false;
+	kind = k; index = _scummverseSelfie->spriteIndex[a->_number];
+	return true;
+}
+
+// The room and everyone in it, drawn as posed (no scripts, no walking).
+void ScummEngine::scummverseSelfieDraw() {
+	_fullRedraw = true;
+	redrawBGAreas();
+	scummLoop_handleActors();
+	_fullRedraw = false;
+	drawDirtyScreenParts();
+}
+
+// One shot: framed on the player and whoever is near, enlarged.
+bool ScummEngine::scummverseSelfieShoot() {
+	ScummverseSelfie &s = *_scummverseSelfie;
+	Common::Array<byte> pixels;
+	int width, height, pitch;
+	if (!scummverseCameraPicture(ScummverseCam::kClean, pixels, width, height, pitch)) return false;
+	if (s.frame.empty()) s.frame = scummverseSelfieFrame();
+	return ScummverseCam::shoot(pixels.data(), pitch, width, height, _currentPalette, s.frame, ScummverseCam::kSelfie, s.shot, s.shots);
+}
+
+ScummverseCam::Rect ScummEngine::scummverseSelfieFrame() {
+	const ScummverseSelfie &s = *_scummverseSelfie;
+	const VirtScreen &main = _virtscr[kMainVirtScreen];
+	ScummverseCam::Rect view;
+	view.w = _screenWidth; view.h = main.h;
+	ScummverseCam::Rect player;
+	Common::Array<ScummverseCam::Rect> others;
+	for (const ScummverseSelfie::Kept &k : s.kept) {
+		const Actor *a = _actors[k.id];
+		if (a->_top >= a->_bottom) continue;
+		// Across: the screen strips it was drawn in.
+		int left = -1, right = -1;
+		for (int strip = 0; strip < _gdi->_numStrips; ++strip)
+			if (testGfxUsageBit(_screenStartStrip + strip, k.id)) { if (left < 0) left = strip; right = strip; }
+		if (left < 0) continue;
+		ScummverseCam::Rect r;
+		r.x = left * 8; r.w = (right - left + 1) * 8;
+		r.y = a->_top; r.h = a->_bottom - a->_top;
+		r = ScummverseCam::intersect(r, view);
+		if (r.empty()) continue;
+		if (k.id == VAR(VAR_EGO)) player = r;
+		else others.push_back(r);
+	}
+	if (player.empty()) {
+		// Not drawn (behind something, or off the screen): around where they stand.
+		const Actor *a = _actors[VAR(VAR_EGO)];
+		player.x = a->getPos().x - main.xstart - 12; player.w = 24;
+		player.y = a->getPos().y - 60; player.h = 60;
+		player = ScummverseCam::intersect(player, view);
+		if (player.empty()) player = view;
+	}
+	return ScummverseCam::frameSelfie(player, others.data(), (int)others.size(), view);
+}
+
+// Everything as it was (drawn by the next step, which frees the selfie).
+void ScummEngine::scummverseSelfieEnd() {
+	ScummverseSelfie *s = _scummverseSelfie;
+	if (!s || s->restored) return;
+	for (const ScummverseSelfie::Kept &k : s->kept) _actors[k.id]->setPoseState(k.pose);
+	memcpy(gfxUsageBits, s->usage.data(), sizeof(gfxUsageBits));
+	memcpy(_scummverseGuestTick, s->guestTick, sizeof(s->guestTick)); memcpy(_scummverseGuestShown, s->guestShown, sizeof(s->guestShown));
+	memcpy(_scummverseAvatarTick, s->avatarTick, sizeof(s->avatarTick)); memcpy(_scummverseAvatarShown, s->avatarShown, sizeof(s->avatarShown));
+	_fullRedraw = true;
+	s->restored = true;
+	ScummverseCam::setBusy(false);
+}
+
+void ScummEngine::scummverseSelfieFree() {
+	if (!_scummverseSelfie) return;
+	delete _scummverseSelfie;
+	_scummverseSelfie = nullptr;
+	ScummverseCam::setBusy(false);
+}
