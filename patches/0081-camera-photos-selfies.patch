diff --git a/common/scummverse_camera.cpp b/common/scummverse_camera.cpp
new file mode 100644
index 00000000..9391cbc5
--- /dev/null
+++ b/common/scummverse_camera.cpp
@@ -0,0 +1,229 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Scummverse CAMERA: portable part. See scummverse_camera.h.
+#define FORBIDDEN_SYMBOL_ALLOW_ALL
+
+#include "common/scummverse_camera.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <cstdio>
+#include <mutex>
+
+namespace Scummverse {
+namespace Camera {
+
+// ---- Requests ----
+// One waiting request: 0 none, 1 clean, 2 full, 10 + n a selfie of n.
+static std::atomic<int> g_request(0);
+static std::atomic<bool> g_hold(false), g_busy(false);
+
+void requestPhoto(bool full) { g_request.store(full ? 2 : 1); }
+
+void requestSelfie(int shots) {
+	shots = shots <= 1 ? 1 : shots <= 3 ? 3 : kMaxSelfies;
+	g_request.store(10 + shots);
+}
+
+bool takeRequest(Request &request) {
+	const int r = g_request.exchange(0);
+	if (!r) return false;
+	request.kind = r >= 10 ? kSelfie : r == 2 ? kFull : kClean;
+	request.shots = r >= 10 ? r - 10 : 1;
+	return true;
+}
+
+void setHold(bool hold) { g_hold.store(hold); }
+bool held() { return g_hold.load(); }
+void setBusy(bool busy) { g_busy.store(busy); }
+bool busy() { return g_busy.load(); }
+
+static std::mutex g_noteMutex;
+static std::string g_note;
+
+void note(const char *text) {
+	std::lock_guard<std::mutex> guard(g_noteMutex);
+	g_note = text ? text : "";
+}
+
+void reset() {
+	g_request.store(0); g_hold.store(false); g_busy.store(false);
+	std::lock_guard<std::mutex> guard(g_noteMutex);
+	g_note.clear();
+}
+
+bool takeNote(std::string &text) {
+	std::lock_guard<std::mutex> guard(g_noteMutex);
+	if (g_note.empty()) return false;
+	text.swap(g_note); g_note.clear();
+	return true;
+}
+
+// ---- Pictures ----
+Rect intersect(const Rect &a, const Rect &b) {
+	Rect r;
+	r.x = std::max(a.x, b.x); r.y = std::max(a.y, b.y);
+	r.w = std::min(a.right(), b.right()) - r.x; r.h = std::min(a.bottom(), b.bottom()) - r.y;
+	if (r.w < 0) r.w = 0;
+	if (r.h < 0) r.h = 0;
+	return r;
+}
+
+Rect unite(const Rect &a, const Rect &b) {
+	if (a.empty()) return b;
+	if (b.empty()) return a;
+	Rect r;
+	r.x = std::min(a.x, b.x); r.y = std::min(a.y, b.y);
+	r.w = std::max(a.right(), b.right()) - r.x; r.h = std::max(a.bottom(), b.bottom()) - r.y;
+	return r;
+}
+
+void factors(int width, int height, int &kx, int &ky) {
+	int m = 1;
+	const int longer = std::max(width * 5, height * 6);
+	if (longer > 0) m = std::max(1, (int)std::ceil(kTarget / (double)longer));
+	while (m > 1 && (width * 5 * m > kMaxSide || height * 6 * m > kMaxSide)) --m;
+	kx = 5 * m; ky = 6 * m;
+}
+
+bool enlarge(const uint8_t *pixels, int pitch, int width, int height, const uint8_t *palette,
+             Rect crop, int kx, int ky, Picture &out) {
+	Rect whole; whole.w = width; whole.h = height;
+	crop = intersect(crop, whole);
+	if (!pixels || !palette || crop.empty() || kx < 1 || ky < 1) return false;
+	out.width = crop.w * kx; out.height = crop.h * ky;
+	out.rgba.assign((size_t)out.width * out.height * 4, 255);
+	std::vector<uint8_t> row((size_t)out.width * 4);
+	for (int y = 0; y < crop.h; ++y) {
+		const uint8_t *src = pixels + (size_t)(crop.y + y) * pitch + crop.x;
+		for (int x = 0; x < crop.w; ++x) {
+			const uint8_t *c = palette + src[x] * 3;
+			for (int i = 0; i < kx; ++i) {
+				uint8_t *d = &row[((size_t)x * kx + i) * 4];
+				d[0] = c[0]; d[1] = c[1]; d[2] = c[2]; d[3] = 255;
+			}
+		}
+		for (int j = 0; j < ky; ++j)
+			std::copy(row.begin(), row.end(), out.rgba.begin() + ((size_t)y * ky + j) * out.width * 4);
+	}
+	return true;
+}
+
+Rect frameSelfie(const Rect &player, const std::vector<Rect> &others, const Rect &view) {
+	return frameSelfie(player, others.data(), (int)others.size(), view);
+}
+
+Rect frameSelfie(const Rect &player, const Rect *others, int count, const Rect &view) {
+	Rect group = player;
+	const int reach = std::max(16, player.h * 3 / 4);
+	for (int i = 0; i < count; ++i) {
+		const Rect &o = others[i];
+		if (o.empty()) continue;
+		const int gap = std::max(o.x - player.right(), player.x - o.right());
+		if (gap <= reach) group = unite(group, o);
+	}
+	if (group.empty()) return intersect(view, view);
+	// Head room above, a little below the feet, some room either side.
+	const double h = std::max(group.h, 24);
+	double top = group.y - h * 0.22, bottom = group.bottom() + h * 0.08;
+	double left = group.x - h * 0.15, right = group.right() + h * 0.15;
+	// Shown rows are 1.2 times taller: keep 4:5 to 4:3 as seen.
+	const double shown = (right - left) / ((bottom - top) * 1.2);
+	if (shown < 0.8) {
+		const double grow = ((bottom - top) * 1.2 * 0.8 - (right - left)) / 2;
+		left -= grow; right += grow;
+	} else if (shown > 4.0 / 3) {
+		const double grow = ((right - left) / (4.0 / 3) / 1.2 - (bottom - top));
+		top -= grow * 0.75; bottom += grow * 0.25;
+	}
+	Rect r;
+	r.x = (int)std::floor(left); r.y = (int)std::floor(top);
+	r.w = (int)std::ceil(right) - r.x; r.h = (int)std::ceil(bottom) - r.y;
+	// Slid back inside the view, then cut to it.
+	if (r.w <= view.w) r.x = std::min(std::max(r.x, view.x), view.right() - r.w);
+	if (r.h <= view.h) r.y = std::min(std::max(r.y, view.y), view.bottom() - r.h);
+	return intersect(r, view);
+}
+
+// ---- Poses ----
+static uint32_t nextRandom(uint32_t &state) {
+	state ^= state << 13; state ^= state >> 17; state ^= state << 5;
+	return state;
+}
+
+int planShot(uint32_t seed, int shot, int player, const std::vector<int> &xs, std::vector<Choice> &out) {
+	out.assign(xs.size(), Choice());
+	return planShot(seed, shot, player, xs.data(), (int)xs.size(), out.data());
+}
+
+int planShot(uint32_t seed, int shot, int player, const int *xs, int count, Choice *out) {
+	uint32_t state = (seed ^ (uint32_t)(shot + 1) * 0x9E3779B9u) | 1;
+	for (int i = 0; i < 4; ++i) nextRandom(state);
+	for (int i = 0; i < count; ++i) out[i] = Choice();
+	for (int i = 0; i < count; ++i) {
+		const uint32_t r = nextRandom(state) % 10;
+		out[i].pose = r < 4 ? kStand : r < 7 ? kStep : kTalk;
+		out[i].step = (int)(nextRandom(state) % 4);
+	}
+	// A surprise in about one shot of four, when someone besides the player
+	// is there.
+	const int others = count - (player >= 0 && player < count ? 1 : 0);
+	if (others <= 0 || nextRandom(state) % 4) return kNoSurprise;
+	if (nextRandom(state) % 2) {
+		int pick = (int)(nextRandom(state) % others);
+		for (int i = 0; i < count; ++i) {
+			if (i == player) continue;
+			if (!pick--) { out[i].facing = kFaceAsIs; out[i].pose = kAsIs; break; }
+		}
+		return kNotNoticed;
+	}
+	for (int i = 0; i < count; ++i) {
+		if (i == player || player < 0 || player >= count) continue;
+		out[i].facing = xs[i] <= xs[player] ? kFaceRight : kFaceLeft;
+		out[i].pose = kStand;
+	}
+	return kStareAtPlayer;
+}
+
+bool shoot(const uint8_t *pixels, int pitch, int width, int height, const uint8_t *palette,
+           const Rect &crop, int kind, int shot, int shots) {
+	int kx, ky;
+	factors(crop.w, crop.h, kx, ky);
+	Picture picture;
+	return enlarge(pixels, pitch, width, height, palette, crop, kx, ky, picture) && deliver(picture, kind, shot, shots);
+}
+
+// ---- Names ----
+const char *kindName(int kind) {
+	return kind == kFull ? "full" : kind == kSelfie ? "selfie" : "clean";
+}
+
+std::string Namer::next(int year, int month, int day, int hour, int minute, int second, const char *kind) {
+	char base[64];
+	snprintf(base, sizeof(base), "SCUMMVERSE %04d-%02d-%02d %02d.%02d.%02d", year, month, day, hour, minute, second);
+	if (_last == base) ++_same;
+	else { _last = base; _same = 1; }
+	std::string name = base;
+	if (_same > 1) name += "-" + std::to_string(_same);
+	return name + " " + (kind ? kind : "clean") + ".png";
+}
+
+// ---- Delivery ----
+static std::mutex g_sinkMutex;
+static Sink g_sink = nullptr;
+static void *g_sinkContext = nullptr;
+
+void setSink(Sink sink, void *context) {
+	std::lock_guard<std::mutex> guard(g_sinkMutex);
+	g_sink = sink; g_sinkContext = context;
+}
+
+bool deliver(const Picture &picture, int kind, int shot, int shots) {
+	std::lock_guard<std::mutex> guard(g_sinkMutex);
+	if (!g_sink || picture.rgba.empty()) return false;
+	g_sink(picture, kind, shot, shots, g_sinkContext);
+	return true;
+}
+
+} // namespace Camera
+} // namespace Scummverse
