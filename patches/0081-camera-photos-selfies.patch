index bcdc4052..ab1350e4 100644
--- a/engines/scumm/actor.h
+++ b/engines/scumm/actor.h
@@ -306,6 +306,25 @@ public:
 		return _animProgress;
 	}
 
+	// Scummverse CAMERA: what posing for a selfie changes, to put it back.
+	struct PoseState {
+		uint16 facing = 0;
+		byte frame = 0, animProgress = 0;
+		bool needRedraw = false;
+		int top = 0, bottom = 0;
+		CostumeData cost;
+	};
+	PoseState getPoseState() const {
+		PoseState s;
+		s.facing = _facing; s.frame = _frame; s.animProgress = _animProgress;
+		s.needRedraw = _needRedraw; s.top = _top; s.bottom = _bottom; s.cost = _cost;
+		return s;
+	}
+	void setPoseState(const PoseState &s) {
+		_facing = s.facing; _frame = s.frame; _animProgress = s.animProgress;
+		_needRedraw = s.needRedraw; _top = s.top; _bottom = s.bottom; _cost = s.cost;
+	}
+
 	int getElevation() const {
 		return _elevation;
 	}
