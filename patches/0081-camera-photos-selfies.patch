@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Scummverse CAMERA: photos and selfies of the game. Portable: the requests
+// the interface makes and the game takes, the picture work (whole-pixel
+// enlarging, selfie framing), the poses a selfie asks of everyone, the
+// photos' names, and handing finished pictures to whoever saves them (the
+// iPhone backend, or a test). The game uses the plain-types part,
+// scummverse_camera_engine.h (its side is engines/scumm/scummverse_camera.inc).
+#ifndef COMMON_SCUMMVERSE_CAMERA_H
+#define COMMON_SCUMMVERSE_CAMERA_H
+
+#include "common/scummverse_camera_engine.h"
+
+#include <string>
+#include <vector>
+
+namespace Scummverse {
+namespace Camera {
+
+// ---- Requests, from the interface ----
+void requestPhoto(bool full);
+void requestSelfie(int shots); // 1, 3 or 5 (others are brought into range)
+void setHold(bool hold);
+bool takeNote(std::string &text);
+
+// ---- Pictures ----
+struct Picture {
+	int width = 0, height = 0;
+	std::vector<uint8_t> rgba; // top row first, opaque
+};
+// The crop of an 8-bit picture (palette: 256 RGB triplets), each pixel kx
+// by ky, no smoothing. False if the crop misses the picture.
+bool enlarge(const uint8_t *pixels, int pitch, int width, int height, const uint8_t *palette,
+             Rect crop, int kx, int ky, Picture &out);
+Rect frameSelfie(const Rect &player, const std::vector<Rect> &others, const Rect &view);
+int planShot(uint32_t seed, int shot, int player, const std::vector<int> &xs, std::vector<Choice> &out);
+
+// ---- Names: "SCUMMVERSE 2026-10-17 14.05.09 clean.png", a second photo
+// in the same second "SCUMMVERSE 2026-10-17 14.05.09-2 clean.png" ----
+class Namer {
+public:
+	std::string next(int year, int month, int day, int hour, int minute, int second, const char *kind);
+private:
+	std::string _last;
+	int _same = 0;
+};
+const char *kindName(int kind);
+
+// ---- Delivery ----
+// Called on the game's thread with each finished picture: shot (from 0)
+// of shots for a selfie, 0 of 1 otherwise. The picture is the sink's to
+// keep only for the call.
+typedef void (*Sink)(const Picture &picture, int kind, int shot, int shots, void *context);
+void setSink(Sink sink, void *context);
+bool deliver(const Picture &picture, int kind, int shot, int shots);
+
+} // namespace Camera
+} // namespace Scummverse
+
+#endif
diff --git a/common/scummverse_camera_engine.h b/common/scummverse_camera_engine.h
new file mode 100644
index 00000000..7e653d13
--- /dev/null
+++ b/common/scummverse_camera_engine.h
@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Scummverse CAMERA: engine-facing bridge (plain types only). The game takes
+// the interface's requests, plans a selfie's poses and frame, and hands its
+// 8-bit screen over to be enlarged and saved. See common/scummverse_camera.h.
+#ifndef COMMON_SCUMMVERSE_CAMERA_ENGINE_H
+#define COMMON_SCUMMVERSE_CAMERA_ENGINE_H
+
+#include <stdint.h>
+
+namespace Scummverse {
+namespace Camera {
+
+// What a photo shows: the room alone (CLEAN), the whole screen with the
+// verbs and inventory (FULL), or a selfie (framed on the player).
+enum Kind { kClean = 0, kFull = 1, kSelfie = 2 };
+enum { kMaxSelfies = 5 };
+
+// ---- Requests (made on the interface's thread, taken by the game's) ----
+struct Request {
+	int kind = kClean;
+	int shots = 1;
+};
+bool takeRequest(Request &request);
+// The game holds still (no scripts, no walking) while this is set: while
+// iOS asks for access to Photos.
+bool held();
+// A selfie is being taken (the game sets it; new requests wait).
+void setBusy(bool busy);
+bool busy();
+// A line for the player from the game ("No selfie here"), the latest one.
+void note(const char *text);
+// Nothing waiting, held or noted (a game starting or ending).
+void reset();
+
+// ---- Rectangles (pixels) ----
+struct Rect {
+	int x = 0, y = 0, w = 0, h = 0;
+	int right() const { return x + w; }
+	int bottom() const { return y + h; }
+	bool empty() const { return w <= 0 || h <= 0; }
+};
+Rect intersect(const Rect &a, const Rect &b);
+Rect unite(const Rect &a, const Rect &b);
+
+// Whole-pixel factors for a crop: columns kx, rows ky = kx * 6 / 5 (the
+// game's pixels are shown 1.2 times taller than wide), the smallest that
+// makes the longer side at least kTarget, at most kMaxSide on either side
+// (the whole screen: 5 by 6, 1600 by 1200).
+enum { kTarget = 1600, kMaxSide = 4096 };
+void factors(int width, int height, int &kx, int &ky);
+
+// A selfie's frame: the player and whoever stands near them (within three
+// quarters of the player's height, side to side), with head room, between
+// 4:5 and 4:3 as shown (rows 1.2 times taller), inside the view.
+Rect frameSelfie(const Rect &player, const Rect *others, int count, const Rect &view);
+
+// ---- Poses ----
+// How each one in the room poses for a shot: facing the viewer, or left or
+// right (toward the player), or as they were; standing, mid-step (advanced
+// `step` animation steps), talking, or as they were.
+enum Facing { kFaceViewer = 0, kFaceLeft, kFaceRight, kFaceAsIs };
+enum Pose { kStand = 0, kStep, kTalk, kAsIs };
+enum Surprise { kNoSurprise = 0, kNotNoticed, kStareAtPlayer };
+struct Choice {
+	int facing = kFaceViewer;
+	int pose = kStand;
+	int step = 0;
+};
+// The poses for shot `shot` of a selfie, one per x (`seed` picks them; the
+// same seed and shot give the same poses); player: the player's index. Now
+// and then a surprise: someone hasn't noticed the camera, or everyone else
+// stares at the player. Returns the surprise.
+int planShot(uint32_t seed, int shot, int player, const int *xs, int count, Choice *out);
+
+// The crop of an 8-bit picture (palette: 256 RGB triplets) enlarged by whole
+// pixels (factors) and handed to whoever saves photos (setSink). False if
+// the crop misses the picture or nobody takes it.
+bool shoot(const uint8_t *pixels, int pitch, int width, int height, const uint8_t *palette,
+           const Rect &crop, int kind, int shot, int shots);
+
+} // namespace Camera
+} // namespace Scummverse
+
+#endif
