diff --git a/backends/platform/ios7/scummverse_camera_ui.inc b/backends/platform/ios7/scummverse_camera_ui.inc
new file mode 100644
index 00000000..116fde05
--- /dev/null
+++ b/backends/platform/ios7/scummverse_camera_ui.inc
@@ -0,0 +1,472 @@
+// CAMERA: photos and selfies. The button beside AI and Talk (tap: a photo;
+// hold half a second while its ring fills: a selfie; slide it down: the
+// options, CLEAN or FULL and 1, 3 or 5 selfies, remembered), the white
+// flash, the shutter, the "1 photo saved" line, and the saving: to Photos
+// with add-only access (asked once, the game holding still meanwhile), or
+// to Files > SCUMMVERSE > Screenshots when that access is off. The game
+// takes the pictures (engines/scumm/scummverse_camera.inc) and hands them
+// here through Scummverse::Camera::setSink. The saving follows the Serious
+// Sam port's iOS photos code. Manual reference counting, like this file.
+#include "common/scummverse_camera.h"
+#import <Photos/Photos.h>
+#import <ImageIO/ImageIO.h>
+#import <AudioToolbox/AudioServices.h>
+
+static NSString *const kScummverseCameraFullKey = @"ScummverseCameraFull";
+static NSString *const kScummverseCameraSelfiesKey = @"ScummverseCameraSelfies";
+
+static BOOL scummverseCameraFull() {
+	return [[NSUserDefaults standardUserDefaults] boolForKey:kScummverseCameraFullKey];
+}
+static int scummverseCameraSelfies() {
+	const NSInteger n = [[NSUserDefaults standardUserDefaults] integerForKey:kScummverseCameraSelfiesKey];
+	return n == 1 || n == 5 ? (int)n : 3;
+}
+
+// ---- Messages: one short line over the game, fading ----
+static UILabel *scummverseCameraLabel;
+static void scummverseCameraMessage(NSString *text) {
+	UIView *view = [iOS7AppDelegate iPhoneView];
+	if (!view || !text.length) return;
+	if (!scummverseCameraLabel) {
+		scummverseCameraLabel = [[UILabel alloc] init];
+		scummverseCameraLabel.textColor = UIColor.whiteColor;
+		scummverseCameraLabel.backgroundColor = [UIColor colorWithWhite:0 alpha:0.75];
+		scummverseCameraLabel.font = [UIFont systemFontOfSize:15 weight:UIFontWeightSemibold];
+		scummverseCameraLabel.textAlignment = NSTextAlignmentCenter;
+		scummverseCameraLabel.numberOfLines = 2;
+		scummverseCameraLabel.layer.cornerRadius = 8;
+		scummverseCameraLabel.clipsToBounds = YES;
+		scummverseCameraLabel.userInteractionEnabled = NO;
+	}
+	[view addSubview:scummverseCameraLabel];
+	scummverseCameraLabel.text = text;
+	const CGSize fit = [scummverseCameraLabel sizeThatFits:CGSizeMake(view.bounds.size.width - 48, 60)];
+	scummverseCameraLabel.frame = CGRectMake((view.bounds.size.width - fit.width - 24) / 2, view.bounds.size.height * 0.42, fit.width + 24, fit.height + 14);
+	[scummverseCameraLabel.layer removeAllAnimations];
+	scummverseCameraLabel.alpha = 1;
+	[UIView animateWithDuration:0.4 delay:2.2 options:UIViewAnimationOptionBeginFromCurrentState animations:^{
+		scummverseCameraLabel.alpha = 0;
+	} completion:nil];
+}
+
+// The flash and the shutter, as each photo is taken (it is already taken:
+// neither is in it).
+static void scummverseCameraFlash() {
+	UIView *view = [iOS7AppDelegate iPhoneView];
+	if (!view) return;
+	UIView *flash = [[[UIView alloc] initWithFrame:view.bounds] autorelease];
+	flash.backgroundColor = UIColor.whiteColor;
+	flash.alpha = 0.85;
+	flash.userInteractionEnabled = NO;
+	[view addSubview:flash];
+	[UIView animateWithDuration:0.35 animations:^{ flash.alpha = 0; } completion:^(BOOL) { [flash removeFromSuperview]; }];
+	AudioServicesPlaySystemSound(1108); // the camera shutter
+}
+
+// ---- Saving, one photo after another, off the game's thread ----
+static dispatch_queue_t scummverseCameraQueue() {
+	static dispatch_queue_t queue;
+	static dispatch_once_t once;
+	dispatch_once(&once, ^{ queue = dispatch_queue_create("scummverse.camera", DISPATCH_QUEUE_SERIAL); });
+	return queue;
+}
+
+// What was saved since the last line, said once nothing more is on its way
+// (a selfie's photos once, after the last). Main thread only.
+static int scummverseCameraPending = 0, scummverseCameraToPhotos = 0, scummverseCameraToFiles = 0, scummverseCameraFailed = 0;
+static BOOL scummverseCameraBatch = NO, scummverseCameraPhotosOff = NO;
+
+static void scummverseCameraReport() {
+	if (scummverseCameraPending > 0 || scummverseCameraBatch) return;
+	NSMutableArray *parts = [NSMutableArray array];
+	if (scummverseCameraToPhotos)
+		[parts addObject:scummverseCameraToPhotos == 1 ? @"1 photo saved" : [NSString stringWithFormat:@"%d photos saved", scummverseCameraToPhotos]];
+	if (scummverseCameraToFiles)
+		[parts addObject:[NSString stringWithFormat:@"%d saved to Files › Screenshots (%@)", scummverseCameraToFiles,
+		                  scummverseCameraPhotosOff ? scummverseCameraNoPhotos() : @"Photos didn't take them"]];
+	if (scummverseCameraFailed)
+		[parts addObject:[NSString stringWithFormat:@"%d couldn't be saved", scummverseCameraFailed]];
+	scummverseCameraToPhotos = scummverseCameraToFiles = scummverseCameraFailed = 0;
+	scummverseCameraPhotosOff = NO;
+	if (parts.count) scummverseCameraMessage([parts componentsJoinedByString:@", "]);
+}
+
+static void scummverseCameraFinish(int toPhotos, int toFiles, int failed, BOOL photosOff) {
+	dispatch_async(dispatch_get_main_queue(), ^{
+		scummverseCameraToPhotos += toPhotos; scummverseCameraToFiles += toFiles; scummverseCameraFailed += failed;
+		if (photosOff) scummverseCameraPhotosOff = YES;
+		if (scummverseCameraPending > 0) --scummverseCameraPending;
+		scummverseCameraReport();
+	});
+}
+
+static void scummverseCameraFreeBytes(void *, const void *data, size_t) { free((void *)data); }
+
+static NSData *scummverseCameraPNG(unsigned char *rgba, int width, int height) {
+	CGDataProviderRef provider = CGDataProviderCreateWithData(NULL, rgba, (size_t)width * height * 4, scummverseCameraFreeBytes);
+	if (!provider) { free(rgba); return nil; }
+	CGColorSpaceRef color = CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
+	CGImageRef image = CGImageCreate(width, height, 8, 32, (size_t)width * 4, color, kCGBitmapByteOrderDefault | kCGImageAlphaNoneSkipLast,
+	                                 provider, NULL, false, kCGRenderingIntentDefault);
+	CGColorSpaceRelease(color);
+	CGDataProviderRelease(provider);
+	if (!image) return nil;
+	NSMutableData *data = [NSMutableData data];
+	CGImageDestinationRef out = CGImageDestinationCreateWithData((CFMutableDataRef)data, CFSTR("public.png"), 1, NULL);
+	BOOL ok = NO;
+	if (out) {
+		CGImageDestinationAddImage(out, image, NULL);
+		ok = CGImageDestinationFinalize(out);
+		CFRelease(out);
+	}
+	CGImageRelease(image);
+	return ok ? data : nil;
+}
+
+// Documents/Screenshots: Files › SCUMMVERSE › Screenshots.
+static int scummverseCameraSaveToFiles(NSData *png, NSString *name) {
+	NSString *documents = NSSearchPathForDirectoriesInDomains(NSDocumentDirectory, NSUserDomainMask, YES).firstObject;
+	if (!documents) return 0;
+	NSString *folder = [documents stringByAppendingPathComponent:@"Screenshots"];
+	[[NSFileManager defaultManager] createDirectoryAtPath:folder withIntermediateDirectories:YES attributes:nil error:nil];
+	return [png writeToFile:[folder stringByAppendingPathComponent:name] atomically:YES] ? 1 : 0;
+}
+
+// Add-only access to Photos (iOS 14 on). Before iOS 14 adding needs full
+// access to the library, which the app does not ask for: Files instead.
+static BOOL scummverseCameraPhotosAllowed() {
+	if (@available(iOS 14, *)) {
+		const PHAuthorizationStatus status = [PHPhotoLibrary authorizationStatusForAccessLevel:PHAccessLevelAddOnly];
+		return status == PHAuthorizationStatusAuthorized || status == PHAuthorizationStatusLimited;
+	}
+	return NO;
+}
+static NSString *scummverseCameraNoPhotos() {
+	if (@available(iOS 14, *)) return @"Photos access is off";
+	return @"Photos needs iOS 14";
+}
+
+static void scummverseCameraSave(NSData *png, NSString *name, NSDate *when) {
+	if (!png) { scummverseCameraFinish(0, 0, 1, NO); return; }
+	if (!scummverseCameraPhotosAllowed()) {
+		const int saved = scummverseCameraSaveToFiles(png, name);
+		scummverseCameraFinish(0, saved, 1 - saved, YES);
+		return;
+	}
+	[[PHPhotoLibrary sharedPhotoLibrary] performChanges:^{
+		PHAssetCreationRequest *request = [PHAssetCreationRequest creationRequestForAsset];
+		PHAssetResourceCreationOptions *options = [[[PHAssetResourceCreationOptions alloc] init] autorelease];
+		options.originalFilename = name;
+		[request addResourceWithType:PHAssetResourceTypePhoto data:png options:options];
+		request.creationDate = when;
+	} completionHandler:^(BOOL ok, NSError *) {
+		if (ok) { scummverseCameraFinish(1, 0, 0, NO); return; }
+		const int saved = scummverseCameraSaveToFiles(png, name);
+		scummverseCameraFinish(0, saved, 1 - saved, NO);
+	}];
+}
+
+// The game's thread: each finished picture, named for the moment it was
+// taken, flashed, then encoded and saved in order.
+static void scummverseCameraSink(const Scummverse::Camera::Picture &picture, int kind, int shot, int shots, void *) {
+	@autoreleasepool {
+		static Scummverse::Camera::Namer namer;
+		NSDate *when = [NSDate date];
+		NSDateComponents *c = [[NSCalendar currentCalendar] components:NSCalendarUnitYear | NSCalendarUnitMonth | NSCalendarUnitDay |
+		                       NSCalendarUnitHour | NSCalendarUnitMinute | NSCalendarUnitSecond fromDate:when];
+		const std::string name = namer.next((int)c.year, (int)c.month, (int)c.day, (int)c.hour, (int)c.minute, (int)c.second,
+		                                    Scummverse::Camera::kindName(kind));
+		NSString *file = [NSString stringWithUTF8String:name.c_str()];
+		unsigned char *rgba = (unsigned char *)malloc(picture.rgba.size());
+		if (rgba) memcpy(rgba, picture.rgba.data(), picture.rgba.size());
+		const int width = picture.width, height = picture.height;
+		const BOOL more = kind == Scummverse::Camera::kSelfie && shot + 1 < shots;
+		dispatch_async(dispatch_get_main_queue(), ^{
+			++scummverseCameraPending;
+			scummverseCameraBatch = more;
+			scummverseCameraFlash();
+		});
+		dispatch_async(scummverseCameraQueue(), ^{
+			@autoreleasepool {
+				scummverseCameraSave(rgba ? scummverseCameraPNG(rgba, width, height) : nil, file, when);
+			}
+		});
+	}
+}
+
+// Asks for add-only access the first time (the game holds still while iOS
+// asks), then goes on whatever the answer.
+// (taps while iOS is asking are ignored)
+static BOOL scummverseCameraAsking = NO;
+static void scummverseCameraWithAccess(void (^go)(void)) {
+	if (scummverseCameraAsking) return;
+	if (@available(iOS 14, *)) {
+		if ([PHPhotoLibrary authorizationStatusForAccessLevel:PHAccessLevelAddOnly] == PHAuthorizationStatusNotDetermined) {
+			scummverseCameraAsking = YES;
+			Scummverse::Camera::setHold(true);
+			[PHPhotoLibrary requestAuthorizationForAccessLevel:PHAccessLevelAddOnly handler:^(PHAuthorizationStatus) {
+				dispatch_async(dispatch_get_main_queue(), ^{
+					scummverseCameraAsking = NO;
+					Scummverse::Camera::setHold(false);
+					go();
+				});
+			}];
+			return;
+		}
+	}
+	go();
+}
+
+// ---- The button: tap, hold with a filling ring, or slide down ----
+@interface ScummverseCameraButton : UIControl {
+	UIImageView *_icon;
+	UILabel *_fallback;
+	CAShapeLayer *_ring;
+	CADisplayLink *_link;
+	CFTimeInterval _start;
+	CGPoint _down;
+	BOOL _fired, _slid;
+}
+@property(nonatomic, copy) void (^photo)(void);
+@property(nonatomic, copy) void (^selfie)(void);
+@property(nonatomic, copy) void (^options)(void);
+@end
+
+@implementation ScummverseCameraButton
+@synthesize photo = _photo, selfie = _selfie, options = _options;
+
+- (id)initWithFrame:(CGRect)frame {
+	if ((self = [super initWithFrame:frame])) {
+		self.backgroundColor = [UIColor colorWithWhite:0 alpha:0.65];
+		self.accessibilityLabel = @"Camera: tap for a photo, hold for a selfie, slide down for options";
+		self.isAccessibilityElement = YES;
+		self.accessibilityTraits = UIAccessibilityTraitButton;
+		self.accessibilityCustomActions = @[
+			[[[UIAccessibilityCustomAction alloc] initWithName:@"Selfie" target:self selector:@selector(accessibilitySelfie)] autorelease],
+			[[[UIAccessibilityCustomAction alloc] initWithName:@"Camera options" target:self selector:@selector(accessibilityOptions)] autorelease]];
+		UIImage *image = nil;
+		if (@available(iOS 13, *)) image = [UIImage systemImageNamed:@"camera.fill"];
+		if (image) {
+			_icon = [[UIImageView alloc] initWithImage:image];
+			_icon.tintColor = UIColor.whiteColor;
+			_icon.contentMode = UIViewContentModeScaleAspectFit;
+			_icon.userInteractionEnabled = NO;
+			[self addSubview:_icon];
+		} else {
+			_fallback = [[UILabel alloc] init];
+			_fallback.text = @"CAM";
+			_fallback.textColor = UIColor.whiteColor;
+			_fallback.textAlignment = NSTextAlignmentCenter;
+			_fallback.userInteractionEnabled = NO;
+			[self addSubview:_fallback];
+		}
+		_ring = [[CAShapeLayer alloc] init];
+		_ring.fillColor = UIColor.clearColor.CGColor;
+		_ring.strokeColor = UIColor.whiteColor.CGColor;
+		_ring.lineWidth = 3;
+		_ring.strokeEnd = 0;
+		_ring.hidden = YES;
+		[self.layer addSublayer:_ring];
+	}
+	return self;
+}
+
+- (void)dealloc {
+	[_link invalidate];
+	[_icon release]; [_fallback release]; [_ring release];
+	[_photo release]; [_selfie release]; [_options release];
+	[super dealloc];
+}
+
+- (void)layoutSubviews {
+	[super layoutSubviews];
+	const CGRect inner = CGRectInset(self.bounds, 9, 7);
+	_icon.frame = inner; _fallback.frame = self.bounds;
+	const CGFloat side = MIN(self.bounds.size.width, self.bounds.size.height) - 4;
+	const CGRect circle = CGRectMake((self.bounds.size.width - side) / 2, (self.bounds.size.height - side) / 2, side, side);
+	UIBezierPath *path = [UIBezierPath bezierPathWithArcCenter:CGPointMake(CGRectGetMidX(circle), CGRectGetMidY(circle))
+	                                                    radius:side / 2 startAngle:-M_PI_2 endAngle:3 * M_PI_2 clockwise:YES];
+	_ring.path = path.CGPath;
+}
+
+- (void)stopRing {
+	[_link invalidate]; _link = nil;
+	_ring.hidden = YES; _ring.strokeEnd = 0;
+}
+
+- (void)tick:(CADisplayLink *)link {
+	const double t = (CACurrentMediaTime() - _start) / 0.5;
+	[CATransaction begin]; [CATransaction setDisableActions:YES];
+	_ring.strokeEnd = MIN(1.0, t);
+	[CATransaction commit];
+	if (t >= 1 && !_fired) {
+		_fired = YES;
+		[self stopRing];
+		if (_selfie) _selfie();
+	}
+}
+
+- (BOOL)beginTrackingWithTouch:(UITouch *)touch withEvent:(UIEvent *)event {
+	_fired = _slid = NO;
+	if (Scummverse::Camera::busy()) return NO;
+	_down = [touch locationInView:self];
+	_start = CACurrentMediaTime();
+	_ring.hidden = NO; _ring.strokeEnd = 0;
+	_link = [CADisplayLink displayLinkWithTarget:self selector:@selector(tick:)];
+	[_link addToRunLoop:[NSRunLoop mainRunLoop] forMode:NSRunLoopCommonModes];
+	return YES;
+}
+
+- (BOOL)continueTrackingWithTouch:(UITouch *)touch withEvent:(UIEvent *)event {
+	if (_fired || _slid) return NO;
+	const CGPoint p = [touch locationInView:self];
+	if (p.y - _down.y > 24) {
+		_slid = YES;
+		[self stopRing];
+		if (_options) _options();
+		return NO;
+	}
+	// Off the button another way: nothing.
+	if (!CGRectContainsPoint(CGRectInset(self.bounds, -16, -16), p)) {
+		_slid = YES;
+		[self stopRing];
+		return NO;
+	}
+	return YES;
+}
+
+- (void)endTrackingWithTouch:(UITouch *)touch withEvent:(UIEvent *)event {
+	[self stopRing];
+	if (!_fired && !_slid && touch && CGRectContainsPoint(CGRectInset(self.bounds, -16, -16), [touch locationInView:self]) && _photo) _photo();
+}
+
+- (void)cancelTrackingWithEvent:(UIEvent *)event {
+	[self stopRing];
+}
+
+- (BOOL)accessibilityActivate {
+	if (_photo) _photo();
+	return YES;
+}
+- (BOOL)accessibilitySelfie {
+	if (_selfie) _selfie();
+	return YES;
+}
+- (BOOL)accessibilityOptions {
+	if (_options) _options();
+	return YES;
+}
+@end
+
+// ---- The options: CLEAN or FULL, and how many selfies ----
+@interface ScummverseCameraOptions : UIControl {
+	UIView *_panel;
+	CGSize _shownIn;
+}
+- (void)showBelow:(UIView *)button inView:(UIView *)view;
+@end
+
+@implementation ScummverseCameraOptions
+- (id)initWithFrame:(CGRect)frame {
+	if ((self = [super initWithFrame:frame])) {
+		// Tapping anywhere else closes it; so does turning the phone.
+		self.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
+		[self addTarget:self action:@selector(tapped:event:) forControlEvents:UIControlEventTouchUpInside];
+		_panel = [[UIView alloc] initWithFrame:CGRectMake(0, 0, 196, 104)];
+		_panel.backgroundColor = [UIColor colorWithWhite:0.05 alpha:0.9];
+		_panel.layer.cornerRadius = 10;
+		UISegmentedControl *kind = [[[UISegmentedControl alloc] initWithItems:@[@"CLEAN", @"FULL"]] autorelease];
+		kind.frame = CGRectMake(10, 10, 176, 32);
+		kind.selectedSegmentIndex = scummverseCameraFull() ? 1 : 0;
+		kind.accessibilityLabel = @"Photo: the room only, or the full screen";
+		[kind addTarget:self action:@selector(kindChanged:) forControlEvents:UIControlEventValueChanged];
+		[_panel addSubview:kind];
+		UILabel *label = [[[UILabel alloc] initWithFrame:CGRectMake(10, 56, 70, 32)] autorelease];
+		label.text = @"SELFIES";
+		label.textColor = UIColor.whiteColor;
+		label.font = [UIFont systemFontOfSize:13 weight:UIFontWeightSemibold];
+		[_panel addSubview:label];
+		UISegmentedControl *count = [[[UISegmentedControl alloc] initWithItems:@[@"1", @"3", @"5"]] autorelease];
+		count.frame = CGRectMake(80, 56, 106, 32);
+		const int selfies = scummverseCameraSelfies();
+		count.selectedSegmentIndex = selfies == 1 ? 0 : selfies == 5 ? 2 : 1;
+		count.accessibilityLabel = @"Photos per selfie";
+		[count addTarget:self action:@selector(countChanged:) forControlEvents:UIControlEventValueChanged];
+		[_panel addSubview:count];
+		if (@available(iOS 13, *)) {
+			for (UISegmentedControl *s in @[kind, count]) {
+				s.selectedSegmentTintColor = UIColor.whiteColor;
+				[s setTitleTextAttributes:@{NSForegroundColorAttributeName: UIColor.whiteColor} forState:UIControlStateNormal];
+				[s setTitleTextAttributes:@{NSForegroundColorAttributeName: UIColor.blackColor} forState:UIControlStateSelected];
+			}
+		}
+		[self addSubview:_panel];
+	}
+	return self;
+}
+- (void)dealloc { [_panel release]; [super dealloc]; }
+- (void)kindChanged:(UISegmentedControl *)control {
+	[[NSUserDefaults standardUserDefaults] setBool:control.selectedSegmentIndex == 1 forKey:kScummverseCameraFullKey];
+}
+- (void)countChanged:(UISegmentedControl *)control {
+	const int counts[] = {1, 3, 5};
+	[[NSUserDefaults standardUserDefaults] setInteger:counts[MAX(0, MIN(2, (int)control.selectedSegmentIndex))] forKey:kScummverseCameraSelfiesKey];
+}
+- (void)showBelow:(UIView *)button inView:(UIView *)view {
+	self.frame = view.bounds;
+	const CGSize size = _panel.bounds.size;
+	CGFloat x = CGRectGetMaxX(button.frame) - size.width, y = CGRectGetMaxY(button.frame) + 6;
+	if (y + size.height > view.bounds.size.height - 4) y = button.frame.origin.y - size.height - 6;
+	x = MAX(4, MIN(x, view.bounds.size.width - size.width - 4));
+	_panel.frame = CGRectMake(x, MAX(4, y), size.width, size.height);
+	_shownIn = view.bounds.size;
+	[view addSubview:self];
+}
+- (void)tapped:(id)sender event:(UIEvent *)event {
+	UITouch *touch = event.allTouches.anyObject;
+	if (touch && CGRectContainsPoint(_panel.frame, [touch locationInView:self])) return;
+	[self close];
+}
+// (turned or resized: closed rather than left in the wrong place)
+- (void)layoutSubviews {
+	[super layoutSubviews];
+	if (self.superview && !CGSizeEqualToSize(self.superview.bounds.size, _shownIn)) [self close];
+}
+- (void)close { [self removeFromSuperview]; }
+@end
+
+// Makes the button and starts taking the game's pictures.
+static ScummverseCameraButton *scummverseInstallCamera(UIView *view) {
+	Scummverse::Camera::setSink(scummverseCameraSink, nullptr);
+	ScummverseCameraButton *button = [[ScummverseCameraButton alloc] initWithFrame:CGRectMake(0, 0, 44, 36)];
+	button.photo = ^{
+		if (Scummverse::Camera::busy()) return;
+		const BOOL full = scummverseCameraFull();
+		scummverseCameraWithAccess(^{ Scummverse::Camera::requestPhoto(full); });
+	};
+	button.selfie = ^{
+		if (Scummverse::Camera::busy()) return;
+		const int shots = scummverseCameraSelfies();
+		scummverseCameraWithAccess(^{ Scummverse::Camera::requestSelfie(shots); });
+	};
+	// (__block: not retained by the block, which the button itself keeps)
+	__block ScummverseCameraButton *owner = button;
+	__block UIView *host = view;
+	button.options = ^{
+		ScummverseCameraOptions *options = [[[ScummverseCameraOptions alloc] initWithFrame:host.bounds] autorelease];
+		[options showBelow:owner inView:host];
+	};
+	[view addSubview:button];
+	// The game's own lines ("No selfie here"); and a selfie that ended
+	// before its last photo still says what was saved.
+	[NSTimer scheduledTimerWithTimeInterval:0.3 repeats:YES block:^(NSTimer *) {
+		std::string text;
+		if (Scummverse::Camera::takeNote(text)) scummverseCameraMessage([NSString stringWithUTF8String:text.c_str()]);
+		if (scummverseCameraBatch && !Scummverse::Camera::busy()) {
+			scummverseCameraBatch = NO;
+			scummverseCameraReport();
+		}
+	}];
+	return button;
+}
