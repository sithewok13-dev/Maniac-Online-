+// The stage's pixels in the screen's format as crossBlit converts them (each
+// 8-bit channel shortened to the format's bits, then put in its place), for
+// two and four bytes a pixel without a call a pixel.
+static void convertPart(byte *dst, int dstPitch, const uint32 *src, int srcPitch, int w, int h, const Graphics::PixelFormat &f) {
+	if (f.bytesPerPixel != 2 && f.bytesPerPixel != 4) {
+		Graphics::crossBlit(dst, (const byte *)src, dstPitch, srcPitch * 4, w, h, f, kStageFormat);
+		return;
+	}
+	const uint32 aLoss = f.aLoss, rLoss = f.rLoss, gLoss = f.gLoss, bLoss = f.bLoss, aShift = f.aShift, rShift = f.rShift, gShift = f.gShift, bShift = f.bShift;
+	// (The screens' own: OpenGL's red first in memory (the iPhone's), and
+	// red highest, alpha lowest; the same as below, in fewer steps.)
+	const bool eight = f.bytesPerPixel == 4 && !aLoss && !rLoss && !gLoss && !bLoss;
+	const bool redFirst = eight && rShift == 0 && gShift == 8 && bShift == 16 && aShift == 24;
+	const bool alphaLast = eight && rShift == 24 && gShift == 16 && bShift == 8 && aShift == 0;
+	for (int y = 0; y < h; ++y) {
+		const uint32 *in = src + (size_t)y * srcPitch;
+		if (redFirst) {
+			uint32 *out = (uint32 *)(dst + (size_t)y * dstPitch);
+			for (int x = 0; x < w; ++x) { const uint32 c = in[x]; out[x] = (c & 0xFF00FF00u) | (c >> 16 & 0xFFu) | (c & 0xFFu) << 16; }
+		} else if (alphaLast) {
+			uint32 *out = (uint32 *)(dst + (size_t)y * dstPitch);
+			for (int x = 0; x < w; ++x) { const uint32 c = in[x]; out[x] = c << 8 | c >> 24; }
+		} else if (f.bytesPerPixel == 4) {
+			uint32 *out = (uint32 *)(dst + (size_t)y * dstPitch);
+			for (int x = 0; x < w; ++x) {
+				const uint32 c = in[x];
+				out[x] = ((c >> 24) >> aLoss) << aShift | ((c >> 16 & 255) >> rLoss) << rShift | ((c >> 8 & 255) >> gLoss) << gShift | ((c & 255) >> bLoss) << bShift;
+			}
+		} else {
+			uint16 *out = (uint16 *)(dst + (size_t)y * dstPitch);
+			for (int x = 0; x < w; ++x) {
+				const uint32 c = in[x];
+				out[x] = (uint16)(((c >> 24) >> aLoss) << aShift | ((c >> 16 & 255) >> rLoss) << rShift | ((c >> 8 & 255) >> gLoss) << gShift | ((c & 255) >> bLoss) << bShift);
