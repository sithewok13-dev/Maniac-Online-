+void SandboxEngine::show(const int *rects, int count) {
+	const int bytes = _format.bytesPerPixel;
+	for (int i = 0; i < count; ++i) {
+		const int x0 = CLIP(rects[4 * i], 0, _width), y0 = CLIP(rects[4 * i + 1], 0, _height);
+		const int x1 = CLIP(rects[4 * i + 2], 0, _width), y1 = CLIP(rects[4 * i + 3], 0, _height);
+		if (x0 >= x1 || y0 >= y1) continue;
+		const uint32 *from = _frame.data() + y0 * _width + x0;
+		const byte *sent = (const byte *)from;
+		int pitch = _width * 4;
+		if (_format != kStageFormat) {
+			byte *to = _converted.data() + (y0 * _width + x0) * bytes;
+			convertPart(to, _width * bytes, from, _width, x1 - x0, y1 - y0, _format);
+			sent = to; pitch = _width * bytes;
+		}
+		g_system->copyRectToScreen(sent, pitch, x0, y0, x1 - x0, y1 - y0);
+		// (Checking: what the screen has now.)
+		for (int y = 0; y < y1 - y0 && _sent.size() == _frame.size() * bytes; ++y)
+			memcpy(&_sent[((y0 + y) * _width + x0) * bytes], sent + y * pitch, (x1 - x0) * bytes);
+	}
+}
