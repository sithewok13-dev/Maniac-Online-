+// (scummverse_check_frames.) The frame drawn whole, as it was before the
+// screen was drawn in parts (over the frame as it is: rows nothing draws on,
+// between the place and its panel, stay as they are), and converted whole
+// as crossBlit converts it: the frame drawn in parts and the screen as sent
+// must be the same.
+void SandboxEngine::checkFrame() {
+	_whole = _frame;
+	StageBridge::render(_whole.data(), _width);
+	Common::Array<Overlay> now;
+	overlays(now);
+	for (const Overlay &o : now) drawOverlay(o, _whole.data());
+	++_framesChecked;
+	int at = -1;
+	for (uint i = 0; i < _whole.size() && at < 0; ++i) if (_whole[i] != _frame[i]) at = i;
+	const int bytes = _format.bytesPerPixel;
+	Common::Array<byte> whole(_whole.size() * bytes);
+	// (Converted as crossBlit converts, every 32nd; else as show converts.)
+	if (_format == kStageFormat) memcpy(whole.data(), _whole.data(), whole.size());
+	else if (!(_framesChecked % 32)) Graphics::crossBlit(whole.data(), (const byte *)_whole.data(), _width * bytes, _width * 4, _width, _height, _format, kStageFormat);
+	else convertPart(whole.data(), _width * bytes, _whole.data(), _width, _width, _height, _format);
