+void SandboxEngine::present() {
+	aimFlashlight();
+	Common::Array<Overlay> now;
+	overlays(now);
+	// What to draw again (x0 y0 x1 y1 each): where the stage changed, ...
+	static const int kMostParts = 256;
+	int found[4 * kMostParts];
+	const int screenChange = g_system->getScreenChangeID();
+	bool all = !_frameShown || screenChange != _screenChange;
+	if (all) StageBridge::forget();
+	int count = StageBridge::changes(found, kMostParts);
+	all = all || count < 0;
+	Common::Array<int> parts;
+	Common::Array<bool> drawn(now.size(), false);
+	if (!all) {
+		for (int i = 0; i < 4 * count; ++i) parts.push_back(found[i]);
+		auto add = [&](const Overlay &o) {
+			if (o.x0 >= o.x1 || o.y0 >= o.y1) return;
+			parts.push_back(o.x0); parts.push_back(o.y0); parts.push_back(o.x1); parts.push_back(o.y1);
+		};
+		// ... each piece over it that changed where it was and is, one gone
+		// where it was, ...
+		for (uint k = 0; k < now.size(); ++k) {
+			const Overlay *was = nullptr;
+			for (const Overlay &p : _overlays) if (p.kind == now[k].kind) was = &p;
+			if (was && was->sameAs(now[k])) continue;
+			if (was) add(*was);
+			add(now[k]);
+			drawn[k] = true;
+		}
+		for (const Overlay &p : _overlays) {
+			bool still = false;
+			for (const Overlay &o : now) still = still || o.kind == p.kind;
+			if (!still) add(p);
+		}
+		// ... and all of each other piece where any of that is (until none is).
+		for (bool more = true; more && !all;) {
+			more = false;
+			count = StageBridge::join(parts.data(), parts.size() / 4, _width, _height);
+			parts.resize(4 * MAX(0, count));
+			all = count == 1 && parts[0] <= 0 && parts[1] <= 0 && parts[2] >= _width && parts[3] >= _height;
+			for (uint k = 0; k < now.size() && !all; ++k) {
+				const Overlay &o = now[k];
+				if (drawn[k] || o.x0 >= o.x1 || o.y0 >= o.y1) continue;
+				for (uint i = 0; i < parts.size() && !drawn[k]; i += 4)
+					if (o.x0 < parts[i + 2] && parts[i] < o.x1 && o.y0 < parts[i + 3] && parts[i + 1] < o.y1) { add(o); drawn[k] = more = true; }
+			}
+		}
+	}
+	if (all) {
+		StageBridge::render(_frame.data(), _width);
+		for (const Overlay &o : now) drawOverlay(o, _frame.data());
+		show();
+	} else if (!parts.empty()) {
+		StageBridge::render(_frame.data(), _width, parts.data(), parts.size() / 4);
+		for (uint k = 0; k < now.size(); ++k) if (drawn[k]) drawOverlay(now[k], _frame.data());
+		show(parts.data(), parts.size() / 4);
+	}
+	_overlays = now;
+	_frameShown = true; _screenChange = screenChange;
+	if (_checkFrames) checkFrame();
+}
