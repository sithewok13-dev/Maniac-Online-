+void join(std::vector<Rect> &rects, int screenWidth, int screenHeight) {
+	std::vector<Rect> kept;
+	for (Rect r : rects) {
+		r.x0 = std::max(0, r.x0); r.y0 = std::max(0, r.y0); r.x1 = std::min(screenWidth, r.x1); r.y1 = std::min(screenHeight, r.y1);
+		if (!r.empty()) kept.push_back(r);
+	}
+	const long long screen = (long long)std::max(0, screenWidth) * std::max(0, screenHeight);
+	// (Two joined where their joint rectangle is little more than both: a
+	// quarter more, or 64 by 64 pixels; again while any are.)
+	for (bool joined = true; joined && kept.size() <= 256;) {
+		joined = false;
+		for (size_t i = 0; i < kept.size(); ++i)
+			for (size_t j = i + 1; j < kept.size();) {
+				const Rect &a = kept[i], &b = kept[j];
+				const Rect u(std::min(a.x0, b.x0), std::min(a.y0, b.y0), std::max(a.x1, b.x1), std::max(a.y1, b.y1));
+				const long long both = a.area() + b.area();
+				if (u.area() > both + std::max(64LL * 64, both / 4)) { ++j; continue; }
+				kept[i] = u; kept.erase(kept.begin() + j); joined = true;
+				j = i + 1; // (it grew: the others looked at again)
+			}
+	}
+	long long total = 0;
+	for (const Rect &r : kept) total += r.area();
+	// (Most of the screen, or too many: all of it.)
+	if (kept.size() > 256 || total * 5 >= screen * 3) { kept.clear(); if (screen) kept.push_back(Rect(0, 0, screenWidth, screenHeight)); }
+	rects.swap(kept);
+}
