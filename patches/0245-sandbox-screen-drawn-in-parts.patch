+	const int x0 = (int)(std::lower_bound(_columns.begin(), _columns.end(), sx) - _columns.begin());
+	const int x1 = (int)(std::lower_bound(_columns.begin(), _columns.end(), sx + sw) - _columns.begin());
+	const int y0 = (int)(std::lower_bound(_rows.begin(), _rows.end(), sy) - _rows.begin());
