diff --git a/common/scummverse_net.cpp b/common/scummverse_net.cpp
new file mode 100644
index 00000000..f6402949
--- /dev/null
+++ b/common/scummverse_net.cpp
@@ -0,0 +1,573 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Scummverse local network play: codec and non-blocking POSIX TCP sessions.
+// See common/scummverse_net.h. Built for every backend; only used by the
+// SCUMM sandbox when the player hosts or joins.
+#define FORBIDDEN_SYMBOL_ALLOW_ALL
+
+#include "common/scummverse_net.h"
+#include "common/scummverse_net_engine.h"
+
+#include <algorithm>
+#include <arpa/inet.h>
+#include <cerrno>
+#include <chrono>
+#include <cstring>
+#include <fcntl.h>
+#include <ifaddrs.h>
+#include <mutex>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+namespace Scummverse {
+namespace Net {
+
+// ---- Codec ---------------------------------------------------------------
+
+static void put8(std::string &s, int v) { s.push_back((char)(uint8_t)v); }
+static void put16(std::string &s, int v) { put8(s, v & 0xFF); put8(s, (v >> 8) & 0xFF); }
+static int get8(const unsigned char *p) { return p[0]; }
+static int getU16(const unsigned char *p) { return p[0] | (p[1] << 8); }
+static int getS16(const unsigned char *p) { return (int16_t)(uint16_t)getU16(p); }
+
+bool validSay(const std::string &text) {
+	if (text.empty() || text.size() > kMaxSay) return false;
+	bool visible = false;
+	for (unsigned char c : text) {
+		if (c < 32 || c > 126) return false;
+		if (c != ' ') visible = true;
+	}
+	return visible;
+}
+
+static bool validActor(int actor) { return actor >= 1 && actor <= 24; }
+static bool validAvatar(const Avatar &a) {
+	return validActor(a.actor) && a.room >= 1 && a.room <= 255 && a.x >= -1024 && a.x <= 1024 && a.y >= -256 && a.y <= 256;
+}
+
+bool encode(const Frame &f, std::string &out) {
+	if (f.peer < 0 || f.peer > kMaxPeers) return false;
+	std::string body;
+	put8(body, (int)f.type); put8(body, f.peer);
+	switch (f.type) {
+	case FrameType::Hello:
+		if (f.protocol < 0 || f.protocol > 255 || f.content < 0 || f.content > 0xFFFF || !validActor(f.actor)) return false;
+		put8(body, f.protocol); put16(body, f.content); put8(body, f.actor); break;
+	case FrameType::Welcome:
+		if (!validActor(f.actor)) return false;
+		put8(body, f.actor); break;
+	case FrameType::Reject:
+		if (f.reason < 1 || f.reason > 3) return false;
+		put8(body, f.reason); break;
+	case FrameType::Avatar:
+		if (!validAvatar(f.avatar)) return false;
+		put8(body, f.avatar.actor); put16(body, f.avatar.room); put16(body, f.avatar.x); put16(body, f.avatar.y); break;
+	case FrameType::Say:
+		if (!validActor(f.actor) || !validSay(f.text)) return false;
+		put8(body, f.actor); body += f.text; break;
+	case FrameType::Bye:
+		break;
+	default:
+		return false;
+	}
+	if (body.size() > kMaxBody) return false;
+	put16(out, (int)body.size()); out += body;
+	return true;
+}
+
+int decode(const char *data, size_t size, Frame &f) {
+	if (size < 2) return 0;
+	const unsigned char *p = (const unsigned char *)data;
+	const size_t length = getU16(p);
+	if (length < 2 || length > kMaxBody) return -1;
+	if (size < 2 + length) return 0;
+	const unsigned char *b = p + 2;
+	f = Frame();
+	f.type = (FrameType)get8(b); f.peer = get8(b + 1);
+	if (f.peer > kMaxPeers) return -1;
+	const unsigned char *q = b + 2; const size_t n = length - 2;
+	switch (f.type) {
+	case FrameType::Hello:
+		if (n != 4) return -1;
+		f.protocol = get8(q); f.content = getU16(q + 1); f.actor = get8(q + 3);
+		if (!validActor(f.actor)) return -1;
+		break;
+	case FrameType::Welcome:
+		if (n != 1) return -1;
+		f.actor = get8(q); if (!validActor(f.actor)) return -1;
+		break;
+	case FrameType::Reject:
+		if (n != 1) return -1;
+		f.reason = get8(q); if (f.reason < 1 || f.reason > 3) return -1;
+		break;
+	case FrameType::Avatar:
+		if (n != 7) return -1;
+		f.avatar.actor = get8(q); f.avatar.room = getU16(q + 1); f.avatar.x = getS16(q + 3); f.avatar.y = getS16(q + 5);
+		if (!validAvatar(f.avatar)) return -1;
+		break;
+	case FrameType::Say:
+		if (n < 2) return -1;
+		f.actor = get8(q); f.text.assign((const char *)q + 1, n - 1);
+		if (!validActor(f.actor) || !validSay(f.text)) return -1;
+		break;
+	case FrameType::Bye:
+		if (n != 0) return -1;
+		break;
+	default:
+		return -1;
+	}
+	return (int)(2 + length);
+}
+
+// ---- Sessions ------------------------------------------------------------
+
+namespace {
+typedef std::chrono::steady_clock Clock;
+const auto kHandshakeTimeout = std::chrono::seconds(5);
+const size_t kMaxBuffered = 64 * 1024;
+
+struct Link {
+	int fd = -1, id = 0, actor = 0;
+	bool welcomed = false, closing = false, dead = false, hasAvatar = false;
+	std::string in, out;
+	Avatar last;
+	Clock::time_point opened = Clock::now();
+};
+
+void quietSocket(int fd) {
+	fcntl(fd, F_SETFL, fcntl(fd, F_GETFL, 0) | O_NONBLOCK);
+	int one = 1;
+	setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one));
+#ifdef SO_NOSIGPIPE
+	setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof(one));
+#endif
+}
+
+#ifdef MSG_NOSIGNAL
+const int kSendFlags = MSG_NOSIGNAL;
+#else
+const int kSendFlags = 0;
+#endif
+
+void flush(Link &l) {
+	while (!l.dead && !l.out.empty()) {
+		const ssize_t sent = ::send(l.fd, l.out.data(), l.out.size(), kSendFlags);
+		if (sent > 0) { l.out.erase(0, (size_t)sent); continue; }
+		if (sent < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)) break;
+		l.dead = true;
+	}
+	if (l.out.size() > kMaxBuffered) l.dead = true; // Peer stopped reading.
+	if (l.closing && l.out.empty()) l.dead = true;
+}
+
+void receive(Link &l) {
+	char buffer[2048];
+	while (!l.dead) {
+		const ssize_t got = ::recv(l.fd, buffer, sizeof(buffer), 0);
+		if (got > 0) { l.in.append(buffer, (size_t)got); if (l.in.size() > kMaxBuffered) l.dead = true; continue; }
+		if (got < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)) break;
+		l.dead = true; // Orderly close or error.
+	}
+}
+
+void send(Link &l, const Frame &f) {
+	if (l.dead || l.closing) return;
+	if (!encode(f, l.out)) return;
+}
+
+bool parseAddress(const std::string &text, sockaddr_in &address) {
+	std::string host = text; int port = kDefaultPort;
+	const size_t colon = text.find(':');
+	if (colon != std::string::npos) {
+		host = text.substr(0, colon);
+		const std::string digits = text.substr(colon + 1);
+		if (digits.empty() || digits.size() > 5) return false;
+		port = 0;
+		for (char c : digits) { if (c < '0' || c > '9') return false; port = port * 10 + (c - '0'); }
+		if (port < 1 || port > 65535) return false;
+	}
+	std::memset(&address, 0, sizeof(address));
+	address.sin_family = AF_INET; address.sin_port = htons((uint16_t)port);
+	return inet_pton(AF_INET, host.c_str(), &address.sin_addr) == 1;
+}
+} // End of anonymous namespace
+
+struct Session::Impl {
+	enum Mode { Off, Hosting, Connecting, Joined } mode = Off;
+	int listener = -1, content = 0, port = 0, localActor = 0;
+	std::vector<Link> links;        // Host: joined devices. Client: the host.
+	Avatar local; bool localSent = false;
+	int welcomedAs = 0;             // Client: peer id from Welcome.
+	std::vector<int> remoteActor = std::vector<int>(kMaxPeers + 1, 0); // Client: peer -> actor.
+	std::string target;
+	Clock::time_point started;
+
+	int welcomedCount() const { int n = 0; for (const auto &l : links) if (l.welcomed && !l.dead) ++n; return n; }
+	bool actorTaken(int actor, int except) const {
+		if (actor == localActor) return true;
+		for (const auto &l : links) if (l.welcomed && !l.dead && l.id != except && l.actor == actor) return true;
+		return false;
+	}
+	void broadcast(const Frame &f, int except) {
+		for (auto &l : links) if (l.welcomed && l.id != except) send(l, f);
+	}
+	void reset() {
+		for (auto &l : links) if (l.fd >= 0) ::close(l.fd);
+		links.clear();
+		if (listener >= 0) ::close(listener);
+		listener = -1; mode = Off; localSent = false; welcomedAs = 0;
+		std::fill(remoteActor.begin(), remoteActor.end(), 0);
+	}
+
+	void hostPoll(std::vector<Event> &events) {
+		for (;;) {
+			const int fd = ::accept(listener, nullptr, nullptr);
+			if (fd < 0) break;
+			quietSocket(fd);
+			Link l; l.fd = fd;
+			if (links.size() >= (size_t)kMaxPeers + 2) { // Bounded, even before handshakes.
+				Frame r; r.type = FrameType::Reject; r.reason = (int)RejectReason::Full;
+				encode(r, l.out); l.closing = true;
+			}
+			l.id = 0; links.push_back(l);
+		}
+		for (auto &l : links) {
+			flush(l); receive(l);
+			while (!l.closing) {
+				Frame f; const int used = decode(l.in.data(), l.in.size(), f);
+				if (used == 0) break;
+				if (used < 0) { l.dead = true; break; }
+				l.in.erase(0, (size_t)used);
+				hostFrame(l, f, events);
+				if (l.dead) break;
+			}
+			if (!l.welcomed && !l.closing && Clock::now() - l.opened > kHandshakeTimeout) l.dead = true;
+			flush(l);
+		}
+		for (size_t i = 0; i < links.size();) {
+			if (!links[i].dead) { ++i; continue; }
+			Link gone = links[i];
+			::close(gone.fd); links.erase(links.begin() + (long)i);
+			if (gone.welcomed) {
+				Event e; e.kind = Event::Left; e.peer = gone.id; e.avatar.actor = gone.actor; events.push_back(e);
+				Frame bye; bye.type = FrameType::Bye; bye.peer = gone.id; broadcast(bye, gone.id);
+			}
+		}
+	}
+
+	void hostFrame(Link &l, const Frame &f, std::vector<Event> &events) {
+		if (!l.welcomed) {
+			if (f.type != FrameType::Hello) { l.dead = true; return; }
+			Frame r; r.type = FrameType::Reject;
+			if (f.protocol != kProtocol || f.content != content) r.reason = (int)RejectReason::Version;
+			else if (welcomedCount() >= kMaxPeers) r.reason = (int)RejectReason::Full;
+			else if (actorTaken(f.actor, -1)) r.reason = (int)RejectReason::ActorTaken;
+			if (r.reason) { send(l, r); l.closing = true; return; }
+			int id = 1;
+			while (id <= kMaxPeers) { bool used = false; for (const auto &o : links) if (o.welcomed && o.id == id) used = true; if (!used) break; ++id; }
+			l.id = id; l.actor = f.actor; l.welcomed = true;
+			Frame w; w.type = FrameType::Welcome; w.peer = id; w.actor = f.actor; send(l, w);
+			// Bring the newcomer up to date with everyone already here.
+			if (localSent) { Frame a; a.type = FrameType::Avatar; a.peer = 0; a.avatar = local; send(l, a); }
+			for (const auto &o : links) if (o.welcomed && o.id != id && o.hasAvatar) {
+				Frame a; a.type = FrameType::Avatar; a.peer = o.id; a.avatar = o.last; send(l, a);
+			}
+			return;
+		}
+		switch (f.type) {
+		case FrameType::Avatar: {
+			// Each device controls one character no one else controls.
+			if (actorTaken(f.avatar.actor, l.id)) return;
+			l.actor = f.avatar.actor; l.last = f.avatar; l.hasAvatar = true;
+			Event e; e.kind = Event::Moved; e.peer = l.id; e.avatar = f.avatar; events.push_back(e);
+			Frame a = f; a.peer = l.id; broadcast(a, l.id);
+			break;
+		}
+		case FrameType::Say: {
+			Event e; e.kind = Event::Said; e.peer = l.id; e.avatar.actor = l.actor; e.text = f.text; events.push_back(e);
+			Frame s = f; s.peer = l.id; s.actor = l.actor; broadcast(s, l.id);
+			break;
+		}
+		case FrameType::Bye:
+			l.dead = true; break;
+		default:
+			l.dead = true; break; // Hello twice, or host-only frames from a client.
+		}
+	}
+
+	void clientPoll(std::vector<Event> &events) {
+		Link &l = links[0];
+		if (mode == Connecting) {
+			pollfd p; p.fd = l.fd; p.events = POLLOUT; p.revents = 0;
+			if (::poll(&p, 1, 0) > 0) {
+				int error = 0; socklen_t size = sizeof(error);
+				getsockopt(l.fd, SOL_SOCKET, SO_ERROR, &error, &size);
+				if (error) { fail(events, std::string("Could not reach ") + target + ": " + std::strerror(error)); return; }
+				mode = Joined;
+			} else if (Clock::now() - started > kHandshakeTimeout) {
+				fail(events, "No game found at " + target + ". Check the address and that both devices share a WiFi network."); return;
+			} else return;
+		}
+		flush(l); receive(l);
+		// Frames that arrived before a close (a Reject, a final Bye) still count.
+		for (;;) {
+			Frame f; const int used = decode(l.in.data(), l.in.size(), f);
+			if (used == 0) break;
+			if (used < 0) { fail(events, "The host sent invalid data."); return; }
+			l.in.erase(0, (size_t)used);
+			switch (f.type) {
+			case FrameType::Welcome:
+				welcomedAs = f.peer; l.welcomed = true;
+				if (local.actor) { Frame a; a.type = FrameType::Avatar; a.avatar = local; send(l, a); localSent = true; }
+				break;
+			case FrameType::Reject:
+				fail(events, f.reason == (int)RejectReason::Version ? "The host runs a different game version." :
+					f.reason == (int)RejectReason::Full ? "That game is full." :
+					"Someone there already plays this character. Switch character and join again.");
+				return;
+			case FrameType::Avatar:
+				if (f.peer == welcomedAs || !l.welcomed) break;
+				remoteActor[f.peer] = f.avatar.actor;
+				{ Event e; e.kind = Event::Moved; e.peer = f.peer; e.avatar = f.avatar; events.push_back(e); }
+				break;
+			case FrameType::Say:
+				if (f.peer == welcomedAs || !l.welcomed) break;
+				{ Event e; e.kind = Event::Said; e.peer = f.peer; e.avatar.actor = f.actor; e.text = f.text; events.push_back(e); }
+				break;
+			case FrameType::Bye:
+				if (f.peer == 0 || f.peer == welcomedAs) { fail(events, "The host closed the game."); return; }
+				{ Event e; e.kind = Event::Left; e.peer = f.peer; e.avatar.actor = remoteActor[f.peer]; events.push_back(e); remoteActor[f.peer] = 0; }
+				break;
+			default:
+				fail(events, "The host sent invalid data."); return;
+			}
+		}
+		if (!l.welcomed && Clock::now() - started > kHandshakeTimeout * 2) { fail(events, "The host did not answer."); return; }
+		flush(l);
+		if (l.dead) fail(events, "Connection to the host was lost.");
+	}
+
+	void fail(std::vector<Event> &events, const std::string &why) {
+		// Remote characters return to the local world before the failure.
+		for (int peer = 0; peer <= kMaxPeers; ++peer) if (remoteActor[peer]) {
+			Event e; e.kind = Event::Left; e.peer = peer; e.avatar.actor = remoteActor[peer]; events.push_back(e);
+		}
+		Event e; e.kind = Event::Failed; e.text = why; events.push_back(e);
+		reset();
+	}
+};
+
+Session::Session() : _impl(new Impl) {}
+Session::~Session() { close(); }
+
+bool Session::host(uint16_t port, int content, int actor, std::string &error) {
+	close();
+	Impl &s = *_impl;
+	const int fd = ::socket(AF_INET, SOCK_STREAM, 0);
+	if (fd < 0) { error = "Networking is unavailable."; return false; }
+	int one = 1; setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+	sockaddr_in address; std::memset(&address, 0, sizeof(address));
+	address.sin_family = AF_INET; address.sin_port = htons(port); address.sin_addr.s_addr = htonl(INADDR_ANY);
+	if (::bind(fd, (sockaddr *)&address, sizeof(address)) < 0 || ::listen(fd, kMaxPeers) < 0) {
+		error = std::string("Cannot host: ") + std::strerror(errno); ::close(fd); return false;
+	}
+	fcntl(fd, F_SETFL, fcntl(fd, F_GETFL, 0) | O_NONBLOCK);
+	s.listener = fd; s.mode = Impl::Hosting; s.content = content; s.localActor = actor; s.port = port;
+	return true;
+}
+
+bool Session::join(const std::string &text, int content, int actor, std::string &error) {
+	close();
+	Impl &s = *_impl;
+	sockaddr_in address;
+	if (!parseAddress(text, address)) { error = "Enter the host's address, like 192.168.1.20"; return false; }
+	if (!validActor(actor)) { error = "Choose a character first."; return false; }
+	const int fd = ::socket(AF_INET, SOCK_STREAM, 0);
+	if (fd < 0) { error = "Networking is unavailable."; return false; }
+	quietSocket(fd);
+	if (::connect(fd, (sockaddr *)&address, sizeof(address)) < 0 && errno != EINPROGRESS) {
+		error = std::string("Could not reach ") + text + ": " + std::strerror(errno); ::close(fd); return false;
+	}
+	Link l; l.fd = fd;
+	Frame hello; hello.type = FrameType::Hello; hello.protocol = kProtocol; hello.content = content; hello.actor = actor;
+	encode(hello, l.out);
+	s.links.push_back(l); s.mode = Impl::Connecting; s.content = content; s.localActor = actor;
+	s.local = Avatar(); s.local.actor = actor; s.target = text; s.started = Clock::now();
+	return true;
+}
+
+void Session::close() {
+	Impl &s = *_impl;
+	if (s.mode == Impl::Off) return;
+	Frame bye; bye.type = FrameType::Bye; bye.peer = s.mode == Impl::Hosting ? 0 : s.welcomedAs;
+	for (auto &l : s.links) if (l.welcomed) { send(l, bye); flush(l); }
+	s.reset();
+}
+
+bool Session::active() const { return _impl->mode != Impl::Off; }
+bool Session::hosting() const { return _impl->mode == Impl::Hosting; }
+bool Session::connected() const {
+	return _impl->mode == Impl::Hosting || (_impl->mode == Impl::Joined && !_impl->links.empty() && _impl->links[0].welcomed);
+}
+int Session::remoteCount() const {
+	const Impl &s = *_impl;
+	if (s.mode == Impl::Hosting) return s.welcomedCount();
+	int n = 0; for (int actor : s.remoteActor) if (actor) ++n;
+	return n;
+}
+
+void Session::setLocal(const Avatar &avatar) {
+	Impl &s = *_impl;
+	if (!validAvatar(avatar) || (s.localSent && avatar == s.local)) return;
+	s.local = avatar; s.localActor = avatar.actor;
+	Frame f; f.type = FrameType::Avatar; f.avatar = avatar;
+	if (s.mode == Impl::Hosting) { s.broadcast(f, -1); s.localSent = true; }
+	else if (connected()) { f.peer = s.welcomedAs; send(s.links[0], f); s.localSent = true; }
+}
+
+bool Session::say(const std::string &text) {
+	Impl &s = *_impl;
+	if (!validSay(text) || !validActor(s.localActor) || !connected()) return false;
+	Frame f; f.type = FrameType::Say; f.actor = s.localActor; f.text = text;
+	if (s.mode == Impl::Hosting) s.broadcast(f, -1);
+	else { f.peer = s.welcomedAs; send(s.links[0], f); }
+	return true;
+}
+
+void Session::poll(std::vector<Event> &events) {
+	Impl &s = *_impl;
+	if (s.mode == Impl::Hosting) s.hostPoll(events);
+	else if (s.mode != Impl::Off && !s.links.empty()) s.clientPoll(events);
+}
+
+std::string Session::describe() const {
+	const Impl &s = *_impl;
+	const int others = remoteCount();
+	const std::string count = others == 1 ? "1 other player" : std::to_string(others) + " other players";
+	switch (s.mode) {
+	case Impl::Hosting: return "Hosting on " + localAddresses() + " port " + std::to_string(s.port) + " - " + count;
+	case Impl::Connecting: return "Connecting to " + s.target + "...";
+	case Impl::Joined: return connected() ? "Playing with " + s.target + " - " + count : "Joining " + s.target + "...";
+	default: return "Local WiFi play is off";
+	}
+}
+
+std::string localAddresses() {
+	std::string out;
+	ifaddrs *list = nullptr;
+	if (getifaddrs(&list) != 0) return "this device";
+	for (ifaddrs *i = list; i; i = i->ifa_next) {
+		if (!i->ifa_addr || i->ifa_addr->sa_family != AF_INET) continue;
+		const sockaddr_in *a = (const sockaddr_in *)i->ifa_addr;
+		if ((ntohl(a->sin_addr.s_addr) >> 24) == 127) continue;
+		char text[INET_ADDRSTRLEN];
+		if (!inet_ntop(AF_INET, &a->sin_addr, text, sizeof(text))) continue;
+		if (out.find(text) != std::string::npos) continue;
+		if (!out.empty()) out += ", ";
+		out += text;
+	}
+	freeifaddrs(list);
+	return out.empty() ? "this device" : out;
+}
+
+// ---- Cross-thread control -------------------------------------------------
+
+namespace {
+struct Control {
+	std::mutex mutex;
+	std::vector<Request> requests;
+	std::string status = "Local WiFi play is off";
+	bool online = false;
+	int players = 0;
+};
+Control &control() { static Control c; return c; }
+}
+
+void postRequest(const Request &request) {
+	Control &c = control(); std::lock_guard<std::mutex> guard(c.mutex);
+	if (c.requests.size() < 8) c.requests.push_back(request);
+}
+bool takeRequest(Request &request) {
+	Control &c = control(); std::lock_guard<std::mutex> guard(c.mutex);
+	if (c.requests.empty()) return false;
+	request = c.requests.front(); c.requests.erase(c.requests.begin());
+	return true;
+}
+void publishStatus(const std::string &status, bool online, int players) {
+	Control &c = control(); std::lock_guard<std::mutex> guard(c.mutex);
+	c.status = status; c.online = online; c.players = players;
+}
+std::string status() { Control &c = control(); std::lock_guard<std::mutex> guard(c.mutex); return c.status; }
+bool online() { Control &c = control(); std::lock_guard<std::mutex> guard(c.mutex); return c.online; }
+int players() { Control &c = control(); std::lock_guard<std::mutex> guard(c.mutex); return c.players; }
+
+} // End of namespace Net
+} // End of namespace Scummverse
+
+// ---- Engine bridge ---------------------------------------------------------
+
+namespace Scummverse {
+namespace NetBridge {
+
+static_assert(kMaxPeers == Net::kMaxPeers && kMaxSay == (int)Net::kMaxSay && kDefaultPort == Net::kDefaultPort, "bridge constants");
+static Net::Session &session() { static Net::Session s; return s; }
+static void copy(const std::string &from, char *out, int capacity) {
+	if (!out || capacity < 1) return;
+	const size_t n = std::min(from.size(), (size_t)capacity - 1);
+	std::memcpy(out, from.data(), n); out[n] = 0;
+}
+
+bool host(int content, int actor, char *message, int capacity) {
+	std::string error;
+	const bool ok = session().host(kDefaultPort, content, actor, error);
+	copy(ok ? session().describe() : error, message, capacity);
+	return ok;
+}
+bool join(const char *address, int content, int actor, char *message, int capacity) {
+	std::string error;
+	const bool ok = session().join(address ? address : "", content, actor, error);
+	copy(ok ? session().describe() : error, message, capacity);
+	return ok;
+}
+void close() { session().close(); }
+bool active() { return session().active(); }
+bool connected() { return session().connected(); }
+int remoteCount() { return session().remoteCount(); }
+void describe(char *out, int capacity) { copy(session().describe(), out, capacity); }
+void setLocal(int actor, int room, int x, int y) {
+	Net::Avatar a; a.actor = actor; a.room = room; a.x = x; a.y = y; session().setLocal(a);
+}
+bool say(const char *text) {
+	std::string line(text ? text : "");
+	if (line.size() > Net::kMaxSay) line.resize(Net::kMaxSay);
+	return session().say(line);
+}
+int poll(Event *events, int capacity) {
+	static std::vector<Net::Event> pending;
+	if (pending.empty()) session().poll(pending);
+	int n = 0;
+	while (n < capacity && !pending.empty()) {
+		const Net::Event &e = pending.front();
+		Event &out = events[n++];
+		out.kind = e.kind == Net::Event::Moved ? EventMoved : e.kind == Net::Event::Said ? EventSaid :
+			e.kind == Net::Event::Left ? EventLeft : EventFailed;
+		out.peer = e.peer; out.actor = e.avatar.actor; out.room = e.avatar.room; out.x = e.avatar.x; out.y = e.avatar.y;
+		copy(e.text, out.text, sizeof(out.text));
+		pending.erase(pending.begin());
+	}
+	return n;
+}
+int takeRequest(char *text, int capacity) {
+	Net::Request request;
+	if (!Net::takeRequest(request)) return RequestNone;
+	copy(request.text, text, capacity);
+	return request.kind == Net::Request::Host ? RequestHost : request.kind == Net::Request::Join ? RequestJoin :
+		request.kind == Net::Request::Leave ? RequestLeave : request.kind == Net::Request::Say ? RequestSay : RequestNone;
+}
+void publish(const char *status, bool online, int players) { Net::publishStatus(status ? status : "", online, players); }
+
+} // End of namespace NetBridge
+} // End of namespace Scummverse
diff --git a/common/scummverse_net.h b/common/scummverse_net.h
new file mode 100644
index 00000000..e9750d6d
--- /dev/null
+++ b/common/scummverse_net.h
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Scummverse local network play (same WiFi / LAN). One device hosts, others
+// join by IP address. Every device runs the same build and the same cast, so
+// each player controls one character; the host validates and relays avatar
+// positions and speech. No internet service, accounts or persistence.
+//
+// Frames: [u16 body length][u8 type][u8 peer][payload], little endian.
+// Peer 0 is the host; joined devices are 1..kMaxPeers.
+#ifndef COMMON_SCUMMVERSE_NET_H
+#define COMMON_SCUMMVERSE_NET_H
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace Scummverse {
+namespace Net {
+
+const uint16_t kDefaultPort = 47913;
+const int kProtocol = 1;
+const int kMaxPeers = 4;          // Remote players one host accepts.
+const size_t kMaxBody = 200;      // Largest valid frame body.
+const size_t kMaxSay = 160;       // Printable ASCII characters per line.
+
+enum class FrameType : uint8_t { Hello = 1, Welcome = 2, Reject = 3, Avatar = 4, Say = 5, Bye = 6 };
+enum class RejectReason : uint8_t { Version = 1, Full = 2, ActorTaken = 3 };
+
+struct Avatar {
+	int actor = 0, room = 0, x = 0, y = 0;
+	bool operator==(const Avatar &o) const { return actor == o.actor && room == o.room && x == o.x && y == o.y; }
+	bool operator!=(const Avatar &o) const { return !(*this == o); }
+};
+
+struct Frame {
+	FrameType type = FrameType::Bye;
+	int peer = 0;
+	int protocol = 0, content = 0, actor = 0, reason = 0; // Hello / Welcome / Reject
+	Avatar avatar;                                        // Avatar
+	std::string text;                                     // Say
+};
+
+// Pure codec. encode() appends one frame; false for out-of-range fields.
+bool encode(const Frame &frame, std::string &out);
+// Parses the first frame: bytes consumed, 0 when incomplete, -1 when malformed.
+int decode(const char *data, size_t size, Frame &frame);
+// Speech is printable ASCII (the V1 font); anything else is rejected.
+bool validSay(const std::string &text);
+
+struct Event {
+	enum Kind { Moved, Said, Left, Failed } kind = Moved;
+	int peer = 0;
+	Avatar avatar;      // Moved (actor/room/x/y), Said and Left (actor)
+	std::string text;   // Said text, or the Failed reason
+};
+
+class Session {
+public:
+	Session();
+	~Session();
+	// Listen on all IPv4 interfaces. content identifies the game build.
+	bool host(uint16_t port, int content, int actor, std::string &error);
+	// address is "a.b.c.d" or "a.b.c.d:port".
+	bool join(const std::string &address, int content, int actor, std::string &error);
+	void close();
+	bool active() const;
+	bool hosting() const;
+	bool connected() const;   // Host listening, or client welcomed.
+	int remoteCount() const;
+	// The local player's avatar; sent when it changes.
+	void setLocal(const Avatar &avatar);
+	bool say(const std::string &text);
+	// Non-blocking: accepts, reads, validates, relays and reports.
+	void poll(std::vector<Event> &events);
+	std::string describe() const;
+private:
+	struct Impl;
+	std::unique_ptr<Impl> _impl;
+	Session(const Session &) = delete;
+	Session &operator=(const Session &) = delete;
+};
+
+// IPv4 addresses of this device's network interfaces, for the host to share.
+std::string localAddresses();
+
+// Cross-thread control: the UI posts requests; the engine applies them and
+// publishes status. Safe from any thread.
+struct Request {
+	enum Kind { None, Host, Join, Leave, Say } kind = None;
+	std::string text;   // Join address or Say text
+};
+void postRequest(const Request &request);
+bool takeRequest(Request &request);
+void publishStatus(const std::string &status, bool online, int players);
+std::string status();
+bool online();
+int players();
+
+} // End of namespace Net
+} // End of namespace Scummverse
+
+#endif
