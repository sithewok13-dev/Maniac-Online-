@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Scummverse local WiFi play: the engine-facing bridge. Plain types only, so
+// engine code can include it after ScummVM's forbidden-symbol macros. One
+// session per process, owned by common/scummverse_net.cpp.
+#ifndef COMMON_SCUMMVERSE_NET_ENGINE_H
+#define COMMON_SCUMMVERSE_NET_ENGINE_H
+
+namespace Scummverse {
+namespace NetBridge {
+
+enum { kMaxPeers = 4, kMaxSay = 160, kDefaultPort = 47913 };
+enum RequestKind { RequestNone = 0, RequestHost, RequestJoin, RequestLeave, RequestSay };
+enum EventKind { EventMoved = 0, EventSaid, EventLeft, EventFailed };
+
+struct Event {
+	int kind, peer, actor, room, x, y;
+	char text[200];
+};
+
+// Session control (engine thread). Messages are NUL-terminated and bounded.
+bool host(int content, int actor, char *message, int capacity);
+bool join(const char *address, int content, int actor, char *message, int capacity);
+void close();
+bool active();
+bool connected();
+int remoteCount();
+void describe(char *out, int capacity);
+void setLocal(int actor, int room, int x, int y);
+bool say(const char *text);
+// Fills up to capacity events; returns how many.
+int poll(Event *events, int capacity);
+
+// Requests posted by the UI thread; returns the kind (RequestNone when empty).
+int takeRequest(char *text, int capacity);
+void publish(const char *status, bool online, int players);
+
+} // End of namespace NetBridge
+} // End of namespace Scummverse
+
+#endif
