diff --git a/engines/scumm/scummverse_net.inc b/engines/scumm/scummverse_net.inc
new file mode 100644
index 00000000..fbc94227
--- /dev/null
+++ b/engines/scumm/scummverse_net.inc
@@ -0,0 +1,130 @@
+// SCUMMVERSE local WiFi play: engine adapter. GPL-3.0-or-later.
+// The session (common/scummverse_net.*) moves bytes and validates frames;
+// this adapter maps each remote player to the cast member they control,
+// validates rooms and positions against this build, and keeps local systems
+// (NPC roaming, chat, vehicles) away from characters that people control.
+// Nothing here is saved: remote characters are ordinary actors in a save.
+
+namespace NetBridge = ::Scummverse::NetBridge;
+
+// Build identity sent in the handshake: devices must share room content and
+// patch level. Bump the low byte with patches that change shared state.
+static const int kScummverseNetContent = ((ScummverseContent::kRoomCount & 0xFF) << 8) | 53;
+
+int ScummEngine::scummverseNetContent() const { return kScummverseNetContent; }
+
+bool ScummEngine::scummverseRemoteActor(int id) const {
+	return id > 0 && id < 25 && (_scummverseRemoteMask & (1u << id)) != 0;
+}
+
+static bool scummverseNetRoom(int room) {
+	return (room >= 1 && room <= 55) || zakSceneSlotRoom(room) != 0;
+}
+
+void ScummEngine::scummverseReleaseRemote(int peer) {
+	if (peer < 0 || peer > NetBridge::kMaxPeers) return;
+	const int id = _scummversePeerActor[peer];
+	_scummversePeerActor[peer] = 0;
+	if (!scummverseRemoteActor(id)) return;
+	_scummverseRemoteMask &= ~(1u << id);
+	// The character stays where its player left it and resumes local life.
+	Actor *a = derefActor(id, "released remote");
+	a->stopActorMoving(); _scummverseRoamers[id] = Roamer(); _scummverseRoamers[id].wait = 600;
+}
+
+void ScummEngine::scummverseNetSay(const char *line) {
+	if (_scummverseNetOn && line && NetBridge::connected()) NetBridge::say(line);
+}
+
+void ScummEngine::scummverseUpdateNet(int delta) {
+	if (!_scummverseRoaming || !_scummverseRoamingReady) return;
+	char text[256], message[256];
+	const int ego = VAR(VAR_EGO);
+	for (int kind; (kind = NetBridge::takeRequest(text, sizeof(text))) != NetBridge::RequestNone;) {
+		if (kind == NetBridge::RequestLeave) {
+			NetBridge::close(); _scummverseNetOn = false;
+			for (int peer = 0; peer <= NetBridge::kMaxPeers; ++peer) scummverseReleaseRemote(peer);
+			NetBridge::publish("Local WiFi play is off", false, 0);
+			scummverseWorldReport("Left the local WiFi game.");
+		} else if (kind == NetBridge::RequestSay) {
+			if (ego > 0 && ego < 25 && derefActor(ego, "network speaker")->_room == _currentRoom && !VAR(VAR_HAVE_MSG)) {
+				scummverseSay(ego, text); scummverseNetSay(text);
+			}
+		} else {
+			for (int peer = 0; peer <= NetBridge::kMaxPeers; ++peer) scummverseReleaseRemote(peer);
+			_scummverseNetOn = kind == NetBridge::RequestHost ?
+				NetBridge::host(kScummverseNetContent, ego, message, sizeof(message)) :
+				NetBridge::join(text, kScummverseNetContent, ego, message, sizeof(message));
+			NetBridge::publish(message, false, 0);
+			scummverseWorldReport(message);
+			_scummverseNetClock = 0;
+		}
+	}
+	if (!_scummverseNetOn) return;
+
+	// The local player's character, at most ten times a second.
+	_scummverseNetClock -= delta;
+	if (_scummverseNetClock <= 0 && ego > 0 && ego < 25 && !scummverseRemoteActor(ego)) {
+		_scummverseNetClock = 6;
+		Actor *me = derefActor(ego, "network avatar");
+		if (scummverseNetRoom(me->_room)) NetBridge::setLocal(ego, me->_room, me->getRealPos().x, me->getRealPos().y);
+	}
+
+	NetBridge::Event events[16];
+	const int count = NetBridge::poll(events, ARRAYSIZE(events));
+	for (int i = 0; i < count; ++i) {
+		const NetBridge::Event &event = events[i];
+		if (event.peer < 0 || event.peer > NetBridge::kMaxPeers) continue;
+		switch (event.kind) {
+		case NetBridge::EventMoved: {
+			bool cast = false; for (int id : mansionCast) if (id == event.actor) cast = true;
+			// Deterministic validation: a cast member this build has, not the
+			// local player's, in a room this build can show.
+			if (!cast || event.actor == ego || !scummverseNetRoom(event.room)) break;
+			if ((event.actor == 24 && !_scummVars[760]) || (scummverseZakGuest(event.actor) && !_scummVars[763])) break;
+			if (event.room >= 56 && !scummverseMountExtra(event.room)) break;
+			if (_scummversePeerActor[event.peer] != event.actor) {
+				scummverseReleaseRemote(event.peer);
+				for (int peer = 0; peer <= NetBridge::kMaxPeers; ++peer) if (_scummversePeerActor[peer] == event.actor) scummverseReleaseRemote(peer);
+				_scummversePeerActor[event.peer] = event.actor;
+				_scummverseRemoteMask |= 1u << event.actor;
+				// People are never NPC companions, passengers or chat partners.
+				_scummVars[770 + event.actor] = 0; _scummVars[766] &= ~(1u << event.actor);
+				_scummverseNpcDestination[event.actor] = 0; _scummverseNpcBoarding[event.actor] = 0;
+			}
+			Actor *a = derefActor(event.actor, "remote player");
+			a->setElevation(0);
+			if (a->_room != event.room || event.room != _currentRoom) {
+				const bool arriving = a->_room != event.room;
+				a->stopActorMoving(); a->putActor(event.x, event.y, event.room);
+				if (arriving && event.room == _currentRoom) a->startAnimActor(a->_standFrame);
+			} else {
+				const Common::Point now = a->getRealPos();
+				if (ABS(now.x - event.x) > 1 || ABS(now.y - event.y) > 1) {
+					AdjustBoxResult target = a->adjustXYToBeInBox(event.x, event.y);
+					a->startWalkActor(target.x, target.y, -1);
+				}
+			}
+			break;
+		}
+		case NetBridge::EventSaid:
+			if (_scummversePeerActor[event.peer] == event.actor && scummverseRemoteActor(event.actor) &&
+				derefActor(event.actor, "remote speaker")->_room == _currentRoom)
+				scummverseSay(event.actor, event.text);
+			break;
+		case NetBridge::EventLeft:
+			scummverseReleaseRemote(event.peer);
+			break;
+		case NetBridge::EventFailed:
+			for (int peer = 0; peer <= NetBridge::kMaxPeers; ++peer) scummverseReleaseRemote(peer);
+			_scummverseNetOn = false;
+			NetBridge::publish(event.text, false, 0);
+			scummverseWorldReport(event.text);
+			break;
+		}
+	}
+	if (_scummverseNetOn && NetBridge::active()) {
+		NetBridge::describe(message, sizeof(message));
+		NetBridge::publish(message, NetBridge::connected(), NetBridge::remoteCount());
+	}
+}
