+static bool scummverseWriteUi(const ScummverseUi &ui, const Common::Path &file, Common::String &problem) {
+	Common::DumpFile *dump = new Common::DumpFile();
+	if (!dump->open(file, true)) { delete dump; problem = "cannot write cache"; return false; }
+	Common::ScopedPtr<Common::WriteStream> compressed(Common::wrapCompressedWriteStream(dump));
+	Common::WriteStream &out = *compressed;
+	out.write("SVI1", 4);
+	for (int f : {ui.width, ui.screenHeight, ui.top, ui.rows}) scummverseWrite16(out, f);
+	out.write(ui.palette, 768);
+	out.write(ui.image.data(), ui.image.size());
+	out.writeByte(MIN<uint>(ui.verbs.size(), 255));
+	for (uint i = 0; i < ui.verbs.size() && i < 255; ++i) {
+		const ScummverseUiVerb &v = ui.verbs[i];
+		out.writeByte(v.kind); scummverseWrite16(out, v.id);
+		for (int f : {v.x, v.y, v.width, v.height}) scummverseWrite16(out, f);
+		out.writeByte(v.name.size()); out.write(v.name.c_str(), v.name.size());
+		out.write(v.lit.data(), v.lit.size());
+	}
+	for (int f : {ui.sentenceX, ui.sentenceY}) scummverseWrite16(out, f);
+	out.writeByte(ui.sentenceCentred ? 1 : 0); out.writeByte(ui.sentenceColor);
+	out.writeByte(ui.slotKind); out.writeByte(ui.slotColor); out.writeByte(ui.slotLit);
+	out.writeByte(MIN<uint>(ui.slots.size(), 255));
+	for (uint i = 0; i < ui.slots.size() && i < 255; ++i) for (int f : {ui.slots[i].x, ui.slots[i].y, ui.slots[i].width, ui.slots[i].height}) scummverseWrite16(out, f);
+	for (const ScummverseUiRect &r : ui.arrows) for (int f : {r.x, r.y, r.width, r.height}) scummverseWrite16(out, f);
+	out.writeByte(ui.talk);
+	for (const ScummverseUiFont &f : ui.fonts) {
+		out.writeByte(f.height); out.writeByte(f.ink); out.writeByte(f.none); out.writeByte(MIN<uint>(f.glyphs.size(), 255));
+		for (uint i = 0; i < f.glyphs.size() && i < 255; ++i) {
+			const ScummverseUiGlyph &g = f.glyphs[i];
+			out.writeByte(g.code); out.writeByte(g.advance); out.writeByte((byte)(int8)g.x); out.writeByte((byte)(int8)g.y);
+			out.writeByte(g.width); out.writeByte(g.height); out.write(g.pixels.data(), g.pixels.size());
+		}
+	}
+	out.finalize();
+	if (out.err()) { problem = "cannot write cache"; return false; }
+	return true;
