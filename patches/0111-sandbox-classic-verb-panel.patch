+// The next of the game's people (its cast's order), played where the one
+// played stands. (The one before is not left standing there: who wanders is
+// chosen when the engine starts, without the one played then.)
+void SandboxEngine::newKid() {
+	Common::Array<int> keys;
+	for (const WorldCastGuest &c : kWorldCast)
+		if (c.game == _game && hasCharacter(worldAppearanceKey(c.game, c.guest.costume))) keys.push_back(worldAppearanceKey(c.game, c.guest.costume));
+	if (keys.size() < 2) { say("There's no one else here to play."); return; }
+	uint at = keys.size() - 1;
+	for (uint i = 0; i < keys.size(); ++i) if (keys[i] == _playerKey) at = i;
+	double x, y;
+	StageBridge::position(_player, x, y);
+	const int before = _playerKey;
+	Common::String problem;
+	// (One who cannot be shown is passed over for the next.)
+	for (uint step = 1; step <= keys.size(); ++step) {
+		_playerKey = keys[(at + step) % keys.size()];
+		if (_playerKey == before || !enter(_game, _room, 0, problem)) continue;
+		StageBridge::place(_player, x, y);
+		if (!_testing) saveState();
+		return;
+	}
+	_playerKey = before;
+	enter(_game, _room, 0, problem);
+	StageBridge::place(_player, x, y);
+	say("There's no one else here to play.");
+}
