+Common::String iOS7_getZakDirectory() {
+	@autoreleasepool {
+		NSString *relative = [[NSUserDefaults standardUserDefaults] stringForKey:@"SCUMMVERSEZakImport"];
+		if ([relative hasPrefix:@"ConnectedWorlds/zak-"] && ![relative containsString:@".."] && [[relative pathComponents] count] == 2) {
+			NSURL *base = [[[NSFileManager defaultManager] URLsForDirectory:NSApplicationSupportDirectory inDomains:NSUserDomainMask] firstObject];
+			return Common::String([[base URLByAppendingPathComponent:relative isDirectory:YES] fileSystemRepresentation]);
+		}
+		NSString *documents = [NSString stringWithUTF8String:iOS7_getDocumentsDir().c_str()];
+		NSString *candidate = [documents stringByAppendingPathComponent:@"zak"];
+		BOOL directory = NO;
+		NSFileManager *fm = [NSFileManager defaultManager];
+		if (![fm fileExistsAtPath:candidate isDirectory:&directory] || !directory) {
+			for (NSString *name in [fm contentsOfDirectoryAtPath:documents error:nil]) {
+				NSString *path = [documents stringByAppendingPathComponent:name];
+				if ([name caseInsensitiveCompare:@"zak"] == NSOrderedSame && [fm fileExistsAtPath:path isDirectory:&directory] && directory) { candidate = path; break; }
+			}
+		}
+		return Common::String([candidate fileSystemRepresentation]);
+	}
+}
