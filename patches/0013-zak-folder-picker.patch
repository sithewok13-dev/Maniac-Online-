index 00000000..b68245e7
--- /dev/null
+++ b/backends/platform/ios7/scummverse_worlds_ui.inc
@@ -0,0 +1,113 @@
+// User-selected Zak resource import. GPL-3.0-or-later. No game data bundled.
+// Import into a new private directory before publishing its relative name.
+@interface ScummverseZakImporter : NSObject <UIDocumentPickerDelegate> {
+	BOOL _busy;
+	UIViewController *_presenter;
+}
++ (ScummverseZakImporter *)shared;
+- (void)chooseFrom:(UIViewController *)controller;
+- (void)finish:(NSString *)message;
+@end
+
+@implementation ScummverseZakImporter
++ (ScummverseZakImporter *)shared {
+	static ScummverseZakImporter *instance;
+	static dispatch_once_t once;
+	dispatch_once(&once, ^{ instance = [[ScummverseZakImporter alloc] init]; });
+	return instance;
+}
+- (void)chooseFrom:(UIViewController *)controller {
+	if (_busy) return;
+	_busy = YES;
+	_presenter = [controller retain];
+	UIDocumentPickerViewController *picker = [[UIDocumentPickerViewController alloc]
+		initWithDocumentTypes:@[@"public.folder"] inMode:UIDocumentPickerModeOpen];
+	picker.delegate = self;
+	picker.allowsMultipleSelection = NO;
+	picker.directoryURL = [[[NSFileManager defaultManager] URLsForDirectory:NSDocumentDirectory inDomains:NSUserDomainMask] firstObject];
+	[_presenter presentViewController:picker animated:YES completion:nil];
+	[picker release];
+}
+- (void)finish:(NSString *)message {
+	_busy = NO;
+	scummverseWorldReport([message UTF8String]);
+	UIAlertController *alert = [UIAlertController alertControllerWithTitle:@"Zak game files" message:message preferredStyle:UIAlertControllerStyleAlert];
+	[alert addAction:[UIAlertAction actionWithTitle:@"OK" style:UIAlertActionStyleDefault handler:nil]];
+	UIViewController *presenter = [_presenter autorelease]; _presenter = nil;
+	void (^show)(void) = ^{ [presenter presentViewController:alert animated:YES completion:nil]; };
+	if (presenter.presentedViewController) [presenter dismissViewControllerAnimated:YES completion:show];
+	else show();
+}
+- (void)documentPickerWasCancelled:(UIDocumentPickerViewController *)controller {
+	_busy = NO; [_presenter release]; _presenter = nil;
+}
+- (void)documentPicker:(UIDocumentPickerViewController *)controller didPickDocumentsAtURLs:(NSArray<NSURL *> *)urls {
+	if (urls.count != 1) { [self finish:@"Choose the folder containing 00.LFL and the other Zak files."]; return; }
+	NSURL *selected = urls.firstObject;
+	// File-provider reads and verification stay off the game and UI threads.
+	dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+		@autoreleasepool {
+			BOOL scoped = [selected startAccessingSecurityScopedResource];
+			NSFileManager *fm = [NSFileManager defaultManager];
+			NSURL *support = [[fm URLsForDirectory:NSApplicationSupportDirectory inDomains:NSUserDomainMask] firstObject];
+			NSString *relative = [@"ConnectedWorlds/zak-" stringByAppendingString:[[NSUUID UUID] UUIDString]];
+			NSURL *stage = [support URLByAppendingPathComponent:relative isDirectory:YES];
+			__block NSString *failure = nil;
+			void (^fail)(NSString *) = ^(NSString *message) { [failure release]; failure = [message copy]; };
+			__block NSUInteger copied = 0;
+			NSError *coordinationError = nil;
+			NSFileCoordinator *coordinator = [[NSFileCoordinator alloc] initWithFilePresenter:nil];
+			[coordinator coordinateReadingItemAtURL:selected options:0 error:&coordinationError byAccessor:^(NSURL *folder) {
+				NSError *error = nil;
+				NSArray<NSURL *> *children = [fm contentsOfDirectoryAtURL:folder includingPropertiesForKeys:nil options:NSDirectoryEnumerationSkipsHiddenFiles error:&error];
+				if (!children || ![fm createDirectoryAtURL:stage withIntermediateDirectories:YES attributes:nil error:&error]) {
+					fail([NSString stringWithFormat:@"Cannot read or copy that folder: %@", error.localizedDescription]); return;
+				}
+				NSMutableDictionary<NSString *, NSURL *> *files = [NSMutableDictionary dictionary];
+				for (NSURL *child in children) files[[child.lastPathComponent uppercaseString]] = child;
+				NSDictionary<NSString *, NSString *> *required = @{
+					@"00.LFL": @"7020931d5a2be0a49d68e7a1882363e4", @"01.LFL": @"2e30571757edc1cd0f2a450ba5c89153",
+					@"03.LFL": @"25a9e059a9df572554ee8ceffc08cb9f", @"08.LFL": @"5337090e7a6ebdbfb698ebda3750d926"};
+				for (int number = 0; number < 59; ++number) {
+					NSString *name = [NSString stringWithFormat:@"%02d.LFL", number];
+					NSURL *file = files[name];
+					if (!file) {
+						if (required[name]) { fail([NSString stringWithFormat:@"%@ is missing. Open the extracted Zak folder and choose the folder containing the LFL files.", name]); return; }
+						continue;
+					}
+					NSNumber *size = nil;
+					if (![file getResourceValue:&size forKey:NSURLFileSizeKey error:&error] || size.unsignedLongLongValue < 2 || size.unsignedLongLongValue > 65535) {
+						fail([NSString stringWithFormat:@"Cannot read a valid %@ in that folder.", name]); return;
+					}
+					NSData *data = [NSData dataWithContentsOfURL:file options:0 error:&error];
+					if (!data || data.length < 2 || data.length > 65535) { fail([NSString stringWithFormat:@"Cannot read %@: %@", name, error.localizedDescription]); return; }
+					if (required[name]) {
+						unsigned char digest[CC_MD5_DIGEST_LENGTH]; CC_MD5(data.bytes, (CC_LONG)data.length, digest);
+						NSMutableString *hash = [NSMutableString string];
+						for (int i=0;i<CC_MD5_DIGEST_LENGTH;++i) [hash appendFormat:@"%02x", digest[i]];
+						if (![hash isEqualToString:required[name]]) { fail([NSString stringWithFormat:@"%@ does not match the supported original English DOS V1 Zak edition.", name]); return; }
+					}
+					if (![data writeToURL:[stage URLByAppendingPathComponent:name] options:NSDataWritingAtomic error:&error]) {
+						fail([NSString stringWithFormat:@"Cannot store %@: %@", name, error.localizedDescription]); return;
+					}
+					++copied;
+				}
+			}];
+			[coordinator release];
+			if (scoped) [selected stopAccessingSecurityScopedResource];
+			if (!failure && coordinationError) fail(coordinationError.localizedDescription);
+			if (!failure && copied < 4) fail(@"No usable Zak files were copied. Choose the folder containing 00.LFL.");
+			if (failure) {
+				[fm removeItemAtURL:stage error:nil];
+			} else {
+				// Relative storage survives iOS changing the application's container UUID.
+				// Existing imports and the selected source folder are never overwritten.
+				[[NSUserDefaults standardUserDefaults] setObject:relative forKey:@"SCUMMVERSEZakImport"];
+			}
+			NSString *message = failure ?: [NSString stringWithFormat:@"Imported %lu Zak files. Open Worlds and choose Go to airport. Your original folder was left untouched.", (unsigned long)copied];
+			dispatch_async(dispatch_get_main_queue(), ^{ [self finish:message]; });
+			[failure release];
+		}
+	});
+}
+@end
