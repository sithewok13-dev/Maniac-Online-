diff --git a/common/scummverse_restore.cpp b/common/scummverse_restore.cpp
new file mode 100644
index 00000000..438ec6bc
--- /dev/null
+++ b/common/scummverse_restore.cpp
@@ -0,0 +1,83 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Scummverse: the phone's restore point, read. See scummverse_restore.h.
+#define FORBIDDEN_SYMBOL_ALLOW_ALL
+
+#include "common/scummverse_restore.h"
+
+#include <cstring>
+
+namespace Scummverse {
+namespace Restore {
+
+static bool space(char c) { return c == ' ' || c == '\t' || c == '\r' || c == '\n' || c == '\v' || c == '\f'; }
+static bool alnum(char c) { return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'); }
+// (A section's or a key's name: the letters ScummVM's INI reader takes.)
+static bool nameChar(char c) { return alnum(c) || c == '-' || c == '_' || c == '.' || c == ' ' || c == ':'; }
+static char lower(char c) { return c >= 'A' && c <= 'Z' ? (char)(c - 'A' + 'a') : c; }
+static bool named(const char *text, size_t size, const char *name) {
+	if (std::strlen(name) != size) return false;
+	for (size_t i = 0; i < size; ++i)
+		if (lower(text[i]) != name[i]) return false;
+	return true;
+}
+
+bool parse(const char *text, size_t size, char *target, int capacity, int &slot) {
+	slot = -1;
+	if (target && capacity > 0) target[0] = 0;
+	if (!text || !target || capacity <= 0 || size > kMostBytes || std::memchr(text, 0, size)) return false;
+	size_t at = size >= 3 && !std::memcmp(text, "\xEF\xBB\xBF", 3) ? 3 : 0;
+	// (0: before any section; 1: the first state section; 2: any other.)
+	int section = 0;
+	bool stateSeen = false;
+	const char *targetText = nullptr, *slotText = nullptr;
+	size_t targetSize = 0, slotSize = 0;
+	while (at < size) {
+		const char *line = text + at;
+		const char *end = static_cast<const char *>(std::memchr(line, '\n', size - at));
+		size_t n = end ? (size_t)(end - line) : size - at;
+		at += n + (end ? 1 : 0);
+		while (n && space(line[0])) { ++line; --n; }
+		while (n && space(line[n - 1])) --n;
+		if (!n) continue;
+		if (!end) return false; // (cut short: its value may be too)
+		if (line[0] == '#' || line[0] == ';' || line[0] == '(' || (n >= 2 && line[0] == '/' && line[1] == '/')) continue;
+		if (line[0] == '[') {
+			size_t i = 1;
+			while (i < n && nameChar(line[i])) ++i;
+			if (i == 1 || i >= n || line[i] != ']') return false;
+			const bool state = named(line + 1, i - 1, "state");
+			section = state && !stateSeen ? 1 : 2;
+			stateSeen = stateSeen || state;
+			continue;
+		}
+		const char *equals = static_cast<const char *>(std::memchr(line, '=', n));
+		if (!section || !equals) return false;
+		size_t keySize = equals - line;
+		while (keySize && space(line[keySize - 1])) --keySize;
+		if (!keySize) return false;
+		for (size_t i = 0; i < keySize; ++i)
+			if (!nameChar(line[i])) return false;
+		const char *value = equals + 1;
+		size_t valueSize = n - (size_t)(value - line);
+		while (valueSize && space(value[0])) { ++value; --valueSize; }
+		if (section != 1) continue;
+		if (!targetText && named(line, keySize, "restore_target")) { targetText = value; targetSize = valueSize; }
+		else if (!slotText && named(line, keySize, "restore_slot")) { slotText = value; slotSize = valueSize; }
+	}
+	if (!targetText || !slotText || !targetSize || targetSize >= (size_t)capacity || !slotSize) return false;
+	for (size_t i = 0; i < targetSize; ++i)
+		if (!alnum(targetText[i]) && targetText[i] != '-' && targetText[i] != '_') return false;
+	int number = 0;
+	for (size_t i = 0; i < slotSize; ++i) {
+		if (slotText[i] < '0' || slotText[i] > '9') return false;
+		number = number * 10 + (slotText[i] - '0');
+		if (number > kMostSlot) return false;
+	}
+	std::memcpy(target, targetText, targetSize);
+	target[targetSize] = 0;
+	slot = number;
+	return true;
+}
+
+} // End of namespace Restore
+} // End of namespace Scummverse
diff --git a/common/scummverse_restore.h b/common/scummverse_restore.h
new file mode 100644
index 00000000..8db5b7c1
--- /dev/null
+++ b/common/scummverse_restore.h
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Scummverse: the phone's restore point. As the app is put away, the
+// iPhone's backend autosaves the game playing and writes a small file naming
+// it (backends/platform/ios7/ios7_osys_main.cpp, saveState: an INI file,
+// "[state]", "restore_target=<target>", "restore_slot=<slot>", each line
+// ended). ScummVM's launcher would take it at the next start, from an event
+// the backend queues; Explore mode starts the mansion with no launcher, and
+// an engine playing only lets that event drop the file, so base/main.cpp
+// reads the file itself with this, as the app starts. Plain types only.
+#ifndef COMMON_SCUMMVERSE_RESTORE_H
+#define COMMON_SCUMMVERSE_RESTORE_H
+
+#include <cstddef>
+
+namespace Scummverse {
+namespace Restore {
+
+// The most a restore point is read to (a whole one is a few dozen bytes).
+static const size_t kMostBytes = 4096;
+// The highest slot taken (a save slot ScummVM names: the autosave's is 0).
+static const int kMostSlot = 999;
+
+// What a restore point names (text: the file's bytes, size of them): its
+// target (copied into target, capacity bytes with its end) and its slot;
+// false, target "" and slot -1, when it is not a whole restore point:
+// - more than kMostBytes, or a NUL byte in it;
+// - a line that is not blank, a comment (#, ;, // or ( first, as ScummVM's
+//   INI reader skips them), a section ([name]: letters, digits, '-', '_',
+//   '.', ' ' or ':') or a key=value pair in a section (the key of those
+//   letters too): what ScummVM's reader refuses or stops the app at, and a
+//   line with no '=' (which it takes as a key); a last line cut short (no
+//   line end; the backend ends each one), whose value may be cut too;
+// - no restore_target or restore_slot in the state section (the first of
+//   each in the first such section counts; section and keys in any case;
+//   spaces round names and values, a byte-order mark and \r\n line ends are
+//   let be, as ScummVM's reader lets them);
+// - a target that is not a whole target name (1 to capacity - 1 letters,
+//   digits, '-' or '_', as ScummVM names its targets), or a slot that is not
+//   0 to kMostSlot in decimal digits only.
+bool parse(const char *text, size_t size, char *target, int capacity, int &slot);
+
+} // End of namespace Restore
+} // End of namespace Scummverse
+
+#endif
