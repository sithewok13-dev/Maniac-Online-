+// The phone's restore point (common/scummverse_restore.h): the target and
+// autosave slot the iPhone's backend named as the app was put away, the
+// game playing then autosaved. ScummVM's launcher would take it from an
+// event the backend queues as the app starts again; here nothing takes
+// events before a game plays, and a game playing lets that event drop the
+// file. So it is taken as the app starts (scummverseTakeRestorePoint), and
+// the mansion goes on from it at its first start (scummvm_main). Its file:
+// the backend's; elsewhere none, unless a test names its own.
+static const char *const kScummverseRestorePointKey = "scummverse_restore_point";
+static char scummverseRestoreTarget[64]; // (empty: none)
+static int scummverseRestoreSlot = -1;
+static Common::Path scummverseRestorePointFile() {
+#ifdef IPHONE
+	return Common::Path(iOS7_getRestorePointFile());
+#else
+	return ConfMan.hasKey(kScummverseRestorePointKey, Common::ConfigManager::kApplicationDomain) ?
+		ConfMan.getPath(kScummverseRestorePointKey, Common::ConfigManager::kApplicationDomain) : Common::Path();
+#endif
+}
+static void scummverseTakeRestorePoint() {
+	scummverseRestoreTarget[0] = 0;
+	scummverseRestoreSlot = -1;
+	const Common::Path path = scummverseRestorePointFile();
+	if (path.empty()) return;
+	const Common::FSNode file(path);
+	if (!file.exists() || file.isDirectory()) return;
+	Common::Array<char> text;
+	{
+		Common::ScopedPtr<Common::SeekableReadStream> in(file.createReadStream());
+		if (!in || in->size() == 0) return; // (none, or let go already)
+		if (in->size() > 0 && in->size() <= (int64)Scummverse::Restore::kMostBytes) {
+			text.resize((uint)in->size());
+			if (in->read(text.data(), text.size()) != text.size()) text.clear();
+		}
+	}
+	// (Let go at once, whatever it holds: never taken twice, nor again at
+	// the next start if this one stops; the backend's event finds nothing.)
+	Common::ScopedPtr<Common::SeekableWriteStream> out(file.createWriteStream());
+	if (!out) warning("SCUMMVERSE: the phone's restore point could not be let go");
+	out.reset();
+	if (text.empty() || !Scummverse::Restore::parse(text.data(), text.size(), scummverseRestoreTarget, sizeof(scummverseRestoreTarget), scummverseRestoreSlot)) {
+		warning("SCUMMVERSE: the phone's restore point is damaged; not used");
+		return;
+	}
+	debug(1, "SCUMMVERSE: the phone's restore point: %s, slot %d", scummverseRestoreTarget, scummverseRestoreSlot);
+}
