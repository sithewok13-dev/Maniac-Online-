+// The picture a thing of the mansion's is in, as its game counts: what the
+// stage shows, else (one with no second picture) what was kept for it, else
+// where its game puts it.
+int SandboxEngine::thingBit(int object, int id) const {
+	if (StageBridge::objectPictures(object) > 1) return StageBridge::objectShown(object) ? 1 : 0;
+	const Common::HashMap<int, int>::const_iterator kept = _pictures.find(thingKey(_game, _room, id));
+	if (kept != _pictures.end()) return kept->_value & 1;
+	int picture, answers;
+	return PanelBridge::gameThing(_game, _room, id, picture, answers) ? picture & 1 : 0;
