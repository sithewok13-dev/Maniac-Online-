+// Scummverse: the man-eating plant's pot on wheels, newly drawn (the
+// original paints its pot into the room), in its costume's colors: 1 the
+// flower's, 2 the stem's, 3 black; a and b the wheels' spokes, which swap
+// at every step it rolls. Two-pixel cells, laid out facing left like the
+// costume's own (the stem of its everyday stage stands over cells 3 and 4)
+// and mirrored with it; the last row is its feet.
+static const char *const kScummverseRollingPot[] = {
+	"33333333",
+	"31111113",
+	"33333333",
+	".311113.",
+	".312213.",
+	".311113.",
+	".311113.",
+	".311113.",
+	".311113.",
+	".311113.",
+	"..3113..",
+	"..3333..",
+	".333333.",
+	".33..33.",
+	".ab..ab.",
+	".ba..ba.",
+	".33..33.",
+};
+
+void ClassicCostumeRenderer::drawExtra(const Actor *a) {
+	if (_vm->_game.id != GID_MANIAC || _loaded._format != 0x57 || !_vm->scummverseRollingPot(a)) return;
+	int numerator = 1, denominator = 1;
+	_vm->scummverseDistantScene(&numerator, &denominator);
+	auto scale = [numerator, denominator](int n) {
+		return n >= 0 ? n*numerator/denominator : -((-n*numerator+denominator-1)/denominator);
+	};
+	byte palette[4] = {0, 0, 0, 0};
+	const int colors = _vm->scummverseColorActor(_actorID);
+	if (_vm->getCurrentLights() & LIGHTMODE_actor_use_colors) {
+		palette[1] = _vm->_gdi->remapColorToRenderMode(colors < ARRAYSIZE(v1MMActorPalatte1) ? v1MMActorPalatte1[colors] : 8);
+		palette[2] = _vm->_gdi->remapColorToRenderMode(colors < ARRAYSIZE(v1MMActorPalatte2) ? v1MMActorPalatte2[colors] : 8);
+	} else palette[2] = palette[3] = _vm->_gdi->remapColorToRenderMode(11);
+	const int phase = (a->getRealPos().x + a->getRealPos().y) & 1;
+	const int rows = ARRAYSIZE(kScummverseRollingPot);
+	int left = _out.w, right = 0, top = _out.h, bottom = 0;
+	for (int row = 0; row < rows; ++row) for (int cell = 0; cell < 8; ++cell) {
+		const char c = kScummverseRollingPot[row][cell];
+		const int value = c == 'a' ? (phase ? 3 : 2) : c == 'b' ? (phase ? 2 : 3) : c >= '1' && c <= '3' ? c - '0' : 0;
+		if (!value) continue;
+		const int u = -14 + cell * 2, x = _mirror ? 6 - u : u, v = row - rows;
+		const int x0 = MAX(0, _actorX + scale(x)), x1 = MIN<int>(_out.w, _actorX + scale(x + 2));
+		const int y0 = MAX(0, _actorY + scale(v)), y1 = MIN<int>(_out.h, _actorY + scale(v + 1));
+		if (x0 >= x1 || y0 >= y1) continue;
+		left = MIN(left, x0); right = MAX(right, x1); top = MIN(top, y0); bottom = MAX(bottom, y1);
+		for (int y = y0; y < y1; ++y) {
+			const byte *mask = _vm->scummverseRenderingPortrait() ? nullptr : _vm->getMaskBuffer(0, y, _zbuf);
+			for (int px = x0; px < x1; ++px)
+				if (!mask || !(mask[px / 8] & revBitMask(px & 7))) *(byte *)_out.getBasePtr(px, y) = palette[value];
+		}
+	}
+	if (left < right && top < bottom) {
+		_vm->markRectAsDirty(kMainVirtScreen, left, right, top, bottom, _actorID);
+		_drawTop = MIN(_drawTop, top); _drawBottom = MAX(_drawBottom, bottom);
+	}
+}
+
