+// Pinned model downloads, generated from local-ai.json. No weights bundled.
+struct SVModel { const char *file; const char *url; const char *sha256; uint64_t bytes; };
+static const SVModel svModels[] = {
+	{"qwen2.5-0.5b-instruct-q4_k_m.gguf", "https://huggingface.co/Qwen/Qwen2.5-0.5B-Instruct-GGUF/resolve/9217f5db79a29953eb74d5343926648285ec7e67/qwen2.5-0.5b-instruct-q4_k_m.gguf", "74a4da8c9fdbcd15bd1f6d01d621410d31c6fc00986f5eb687824e7b93d7a9db", 491400032ULL},
+	{"qwen2.5-1.5b-instruct-q4_k_m.gguf", "https://huggingface.co/Qwen/Qwen2.5-1.5B-Instruct-GGUF/resolve/91cad51170dc346986eccefdc2dd33a9da36ead9/qwen2.5-1.5b-instruct-q4_k_m.gguf", "6a1a2eb6d15622bf3c96857206351ba97e1af16c30d7a74ee38970e434e9407e", 1117320736ULL},
+};
diff --git a/backends/platform/ios7/scummverse_ai_runtime.inc b/backends/platform/ios7/scummverse_ai_runtime.inc
new file mode 100644
index 00000000..b45e15e8
--- /dev/null
+++ b/backends/platform/ios7/scummverse_ai_runtime.inc
@@ -0,0 +1,228 @@
+// SCUMMVERSE optional local dialogue runtime. GPL-3.0-or-later.
+// Platform-independent implementation, also exercised by the Linux inference test.
+#include "llama.h"
+#include "ggml-backend.h"
+#include "common/scummverse_ai.h"
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace ScummverseLocalAI {
+static const char *actorName(int id) {
+	static const char *names[] = {"", "Syd", "Razor", "Dave", "Michael", "Bernard", "Wendy", "Jeff", "", "Dr Fred", "Nurse Edna", "Weird Ed", "", "Purple Tentacle", "Green Tentacle"};
+	return id == 23 ? "Sandy" : (id > 0 && id < 15 ? names[id] : "visitor");
+}
+static const char *personality(int id) {
+	switch (id) {
+	case 1: return "a relaxed keyboard player who notices sounds";
+	case 2: return "a bold punk singer with dry humor";
+	case 3: return "a determined teenager looking out for friends";
+	case 4: return "a photographer who notices lighting and strange details";
+	case 5: return "a nervous but clever electronics enthusiast";
+	case 6: return "an aspiring writer collecting odd observations";
+	case 7: return "a laid-back surfer, surprised to be indoors";
+	case 9: return "an eccentric scientist distracted by experiments";
+	case 10: return "a sharp-tongued nurse annoyed by messy houseguests";
+	case 11: return "a suspicious military enthusiast devoted to his hamster";
+	case 13: return "a pompous purple tentacle taking a break from guard duty";
+	case 14: return "a friendly green tentacle who loves music and snacks";
+	case 23: return "a resourceful young woman relieved to explore freely";
+	default: return "an eccentric mansion resident";
+	}
+}
+static const char *roomName(int room) {
+	switch (room) {
+	case 1: return "front yard"; case 2: return "drained swimming pool";
+	case 3: return "living room"; case 4: return "dungeon";
+	case 5: return "library"; case 6: return "poolside";
+	case 7: return "kitchen"; case 8: return "basement";
+	case 9: return "bathroom"; case 10: return "entrance hall";
+	case 11: case 12: case 13: case 38: return "upstairs hallway";
+	case 14: case 17: case 18: case 22: case 23: return "one of the mansion's rooms";
+	case 15: return "attic room"; case 16: case 52: return "garage exterior";
+	case 19: return "Edna's bedroom"; case 20: return "Green Tentacle's room";
+	case 21: return "music room"; case 24: return "Ted's room";
+	case 25: return "bedroom"; case 26: return "Weird Ed's bedroom";
+	case 27: return "plant room"; case 28: return "observatory";
+	case 29: return "crawlspace"; case 30: case 31: case 51: return "laboratory";
+	case 36: return "garage"; case 37: return "pantry"; case 44: return "driveway";
+	default: return "mansion";
+	}
+}
+// ASCII only: the V1 text renderer treats some control bytes as instructions.
+// Reject tags, multiline roleplay, non-English output, and truncated sentences.
+static std::string cleanLine(const std::string &raw) {
+	std::string out;
+	for (unsigned char c : raw) {
+		if (c == '\r' || c == '\n') { if (!out.empty()) break; else continue; }
+		if (c < 32 || c > 126 || c == '<' || c == '>' || c == '{' || c == '}' || c == '@' || c == '^') return "";
+		if (c == '"' || c == '*') continue;
+		if (c == ' ' && (out.empty() || out.back() == ' ')) continue;
+		out += c;
+		if (out.size() > 150) return "";
+		if ((c == '.' || c == '!' || c == '?') && out.size() >= 8) break;
+	}
+	if (out.size() < 8 || out.find(':') != std::string::npos) return "";
+	if (out.back() != '.' && out.back() != '!' && out.back() != '?') return "";
+	return out;
+}
+
+class Runtime {
+public:
+	Runtime() : worker(&Runtime::work, this) {}
+	~Runtime() {
+		{ std::lock_guard<std::mutex> guard(mutex); quitting = true; ++epoch; }
+		wake.notify_one(); worker.join();
+	}
+	void configure(const std::string &file, bool useGPU) {
+		std::lock_guard<std::mutex> guard(mutex);
+		++epoch; desired = file; gpu = useGPU; dirty = true;
+		pending = false; result.clear(); ready = false;
+		status = file.empty() ? "Off - using classic dialogue" : "Loading model - classic dialogue remains available";
+		wake.notify_one();
+	}
+	bool request(int actor, int room, int visitor) {
+		std::lock_guard<std::mutex> guard(mutex);
+		if (!ready || busy || pending || !result.empty() || desired.empty()) return false;
+		jobActor = actor; jobRoom = room; jobVisitor = visitor;
+		pending = true; wake.notify_one(); return true;
+	}
+	bool poll(int &actor, int &room, char *text, int capacity) {
+		std::lock_guard<std::mutex> guard(mutex);
+		if (result.empty() || capacity < 2) return false;
+		actor = resultActor; room = resultRoom;
+		std::strncpy(text, result.c_str(), capacity - 1); text[capacity - 1] = 0;
+		result.clear(); return true;
+	}
+	void cancel() {
+		std::lock_guard<std::mutex> guard(mutex);
+		if (ready) { ++epoch; status = "Ready - using classic dialogue until next encounter"; }
+		pending = false; result.clear();
+	}
+	std::string getStatus() { std::lock_guard<std::mutex> guard(mutex); return status; }
+private:
+	std::mutex mutex;
+	std::condition_variable wake;
+	std::atomic<unsigned> epoch{0};
+	unsigned activeEpoch = 0;
+	std::chrono::steady_clock::time_point deadline;
+	bool quitting = false, dirty = false, pending = false, busy = false, ready = false, gpu = false;
+	std::string desired, result, status = "Off - using classic dialogue";
+	std::string memories[25];
+	int jobActor = 0, jobRoom = 0, jobVisitor = 0, resultActor = 0, resultRoom = 0;
+	llama_model *model = nullptr;
+	llama_context *context = nullptr;
+	// Keep worker last: all state must be initialized before its thread starts.
+	std::thread worker;
+	bool aborted() { return epoch.load() != activeEpoch || std::chrono::steady_clock::now() > deadline; }
+	static bool abortCallback(void *p) { return static_cast<Runtime *>(p)->aborted(); }
+	static bool progressCallback(float, void *p) { return !static_cast<Runtime *>(p)->aborted(); }
+	void unload() {
+		if (context) llama_free(context);
+		if (model) llama_model_free(model);
+		context = nullptr; model = nullptr;
+	}
+	bool load(const std::string &path, bool useGPU) {
+		llama_model_params mp = llama_model_default_params();
+		mp.n_gpu_layers = useGPU ? 99 : 0;
+		mp.progress_callback = progressCallback; mp.progress_callback_user_data = this;
+		model = llama_model_load_from_file(path.c_str(), mp);
+		if (!model || aborted()) { unload(); return false; }
+		llama_context_params cp = llama_context_default_params();
+		cp.n_ctx = 512; cp.n_batch = 64; cp.n_ubatch = 64;
+		cp.n_threads = 2; cp.n_threads_batch = 2;
+		cp.abort_callback = abortCallback; cp.abort_callback_data = this;
+		cp.offload_kqv = useGPU; cp.op_offload = useGPU;
+		context = llama_init_from_model(model, cp);
+		if (!context) { unload(); return false; }
+		return true;
+	}
+	std::string generate(int actor, int room, int visitor) {
+		if (actor <= 0 || actor >= 25) return "";
+		std::string system = "You write dialogue for a spooky comic adventure game. You are ";
+		system += actorName(actor); system += ", "; system += personality(actor);
+		system += ". Reply with ONE short spoken English sentence, at most 18 words. No name prefix, quotes, narration or stage directions. Be playful, not explicit. Do not claim to move, give items or change the game.";
+		std::string user = "You meet "; user += actorName(visitor); user += " in the "; user += roomName(room);
+		user += ". Make a fresh in-character observation or greeting.";
+		if (!memories[actor].empty()) { user += " Avoid repeating your previous line: "; user += memories[actor]; }
+		llama_chat_message messages[] = {{"system", system.c_str()}, {"user", user.c_str()}};
+		char prompt[4096];
+		int length = llama_chat_apply_template(llama_model_chat_template(model, nullptr), messages, 2, true, prompt, sizeof(prompt));
+		if (length <= 0 || length >= (int)sizeof(prompt)) return "";
+		const llama_vocab *vocab = llama_model_get_vocab(model);
+		llama_token tokens[448];
+		int count = llama_tokenize(vocab, prompt, length, tokens, 448, true, true);
+		if (count <= 0 || count > 448) return "";
+		llama_memory_clear(llama_get_memory(context), true);
+		for (int offset = 0; offset < count; offset += 64) {
+			if (aborted() || llama_decode(context, llama_batch_get_one(tokens + offset, std::min(64, count - offset))) != 0) return "";
+		}
+		llama_sampler *sampler = llama_sampler_chain_init(llama_sampler_chain_default_params());
+		llama_sampler_chain_add(sampler, llama_sampler_init_top_k(32));
+		llama_sampler_chain_add(sampler, llama_sampler_init_top_p(0.9f, 1));
+		llama_sampler_chain_add(sampler, llama_sampler_init_temp(0.85f));
+		llama_sampler_chain_add(sampler, llama_sampler_init_dist(LLAMA_DEFAULT_SEED));
+		std::string output;
+		for (int n = 0; n < 48 && !aborted(); ++n) {
+			llama_token token = llama_sampler_sample(sampler, context, -1);
+			if (llama_vocab_is_eog(vocab, token)) break;
+			char piece[256];
+			int bytes = llama_token_to_piece(vocab, token, piece, sizeof(piece), 0, false);
+			if (bytes <= 0 || bytes > (int)sizeof(piece)) break;
+			output.append(piece, bytes);
+			if (output.size() > 180 || !cleanLine(output).empty()) break;
+			if (llama_decode(context, llama_batch_get_one(&token, 1)) != 0) { output.clear(); break; }
+		}
+		llama_sampler_free(sampler);
+		std::string clean = aborted() ? "" : cleanLine(output);
+		if (!clean.empty()) memories[actor] = clean;
+		return clean;
+	}
+	void work() {
+		// No game state, UIKit, network, or renderer calls on this thread.
+		bool initialized = false;
+		for (;;) {
+			std::unique_lock<std::mutex> lock(mutex);
+			wake.wait(lock, [&] { return quitting || dirty || pending; });
+			if (quitting) break;
+			activeEpoch = epoch.load();
+			if (dirty) {
+				std::string path = desired; bool useGPU = gpu; dirty = false; busy = true;
+				deadline = std::chrono::steady_clock::now() + std::chrono::seconds(90);
+				lock.unlock(); unload();
+				if (!path.empty() && !initialized) {
+					ggml_backend_load_all(); llama_backend_init(); initialized = true;
+				}
+				bool ok = !path.empty() && load(path, useGPU);
+				lock.lock(); busy = false;
+				if (activeEpoch == epoch.load()) {
+					ready = ok;
+					status = path.empty() ? "Off - using classic dialogue" : ok ? "Ready - dialogue stays on this device" : "Model unavailable - using classic dialogue";
+				}
+				continue;
+			}
+			int actor = jobActor, room = jobRoom, visitor = jobVisitor;
+			pending = false; busy = true;
+			deadline = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+			status = "Writing a line on this device";
+			lock.unlock(); std::string line = context ? generate(actor, room, visitor) : ""; lock.lock();
+			busy = false;
+			if (activeEpoch == epoch.load()) {
+				result = line; resultActor = actor; resultRoom = room;
+				status = line.empty() ? "Ready - last response used classic fallback" : "Ready - dialogue stays on this device";
+			}
+		}
+		unload();
+	}
+};
+static Runtime &runtime() { static Runtime instance; return instance; }
+}
+bool scummverseAIRequest(int actor, int room, int visitor) { return ScummverseLocalAI::runtime().request(actor, room, visitor); }
+bool scummverseAIPoll(int &actor, int &room, char *text, int capacity) { return ScummverseLocalAI::runtime().poll(actor, room, text, capacity); }
+void scummverseAICancel() { ScummverseLocalAI::runtime().cancel(); }
diff --git a/backends/platform/ios7/scummverse_ai_ui.inc b/backends/platform/ios7/scummverse_ai_ui.inc
new file mode 100644
index 00000000..16709ca3
--- /dev/null
+++ b/backends/platform/ios7/scummverse_ai_ui.inc
@@ -0,0 +1,201 @@
+// Optional model settings/download UI. GPL-3.0-or-later.
+#include <CommonCrypto/CommonDigest.h>
+#include <os/proc.h>
+#include "backends/platform/ios7/scummverse_ai_models.inc"
+#include "backends/platform/ios7/scummverse_ai_runtime.inc"
+
+@interface ScummverseAISettings : NSObject {
+	NSURLSession *_session;
+	NSURLSessionDownloadTask *_task;
+	std::atomic<unsigned> _generation;
+	NSString *_notice;
+	NSInteger _downloadTier;
+}
++ (ScummverseAISettings *)shared;
+- (void)showFrom:(UIView *)view;
+- (void)activate:(NSInteger)tier;
+- (BOOL)verify:(NSURL *)file tier:(NSInteger)tier;
+- (NSURL *)directory;
+- (NSURL *)fileFor:(NSInteger)tier;
+- (BOOL)hasCapacity:(NSInteger)tier;
+- (void)setNotice:(NSString *)notice;
+- (void)disable;
+- (void)download:(NSInteger)tier;
+- (void)stopForPressure:(NSNotification *)notification;
+- (void)background:(NSNotification *)notification;
+- (void)foreground:(NSNotification *)notification;
+@end
+
+@implementation ScummverseAISettings
++ (ScummverseAISettings *)shared {
+	static ScummverseAISettings *instance = nil;
+	static dispatch_once_t once;
+	dispatch_once(&once, ^{ instance = [[ScummverseAISettings alloc] init]; });
+	return instance;
+}
+- (id)init {
+	if ((self = [super init])) {
+		_generation = 0;
+		NSURLSessionConfiguration *configuration = [NSURLSessionConfiguration defaultSessionConfiguration];
+		configuration.allowsCellularAccess = NO;
+		configuration.timeoutIntervalForRequest = 60;
+		configuration.timeoutIntervalForResource = 3600;
+		_session = [[NSURLSession sessionWithConfiguration:configuration] retain];
+		NSNotificationCenter *center = [NSNotificationCenter defaultCenter];
+		[center addObserver:self selector:@selector(stopForPressure:) name:UIApplicationDidReceiveMemoryWarningNotification object:nil];
+		[center addObserver:self selector:@selector(stopForPressure:) name:NSProcessInfoThermalStateDidChangeNotification object:nil];
+		[center addObserver:self selector:@selector(background:) name:UIApplicationDidEnterBackgroundNotification object:nil];
+		[center addObserver:self selector:@selector(foreground:) name:UIApplicationDidBecomeActiveNotification object:nil];
+	}
+	return self;
+}
+- (NSURL *)directory {
+	NSURL *root = [[[NSFileManager defaultManager] URLsForDirectory:NSApplicationSupportDirectory inDomains:NSUserDomainMask] firstObject];
+	NSURL *directory = [root URLByAppendingPathComponent:@"LocalDialogue" isDirectory:YES];
+	[[NSFileManager defaultManager] createDirectoryAtURL:directory withIntermediateDirectories:YES attributes:nil error:nil];
+	[directory setResourceValue:@YES forKey:NSURLIsExcludedFromBackupKey error:nil];
+	return directory;
+}
+- (NSURL *)fileFor:(NSInteger)tier {
+	return [[self directory] URLByAppendingPathComponent:[NSString stringWithUTF8String:svModels[tier - 1].file]];
+}
+- (void)setNotice:(NSString *)notice {
+	[_notice release]; _notice = [notice copy];
+}
+- (BOOL)hasCapacity:(NSInteger)tier {
+	if (tier < 1 || tier > 2) return NO;
+	// Conservative starting limits, not claims of per-device benchmarks.
+	uint64_t physical = [NSProcessInfo processInfo].physicalMemory;
+	uint64_t needed = tier == 1 ? 800ULL * 1024 * 1024 : 1600ULL * 1024 * 1024;
+	return physical >= (tier == 1 ? 3ULL : 6ULL) * 1024 * 1024 * 1024 &&
+		os_proc_available_memory() >= needed &&
+		[NSProcessInfo processInfo].thermalState < NSProcessInfoThermalStateSerious;
+}
+- (void)activate:(NSInteger)tier {
+	if (tier < 1 || tier > 2) return;
+	if (![self hasCapacity:tier]) {
+		[self setNotice:@"Not enough free memory, or the phone is too warm. Classic dialogue is active. Try Small later."];
+		ScummverseLocalAI::runtime().configure("", false);
+		return;
+	}
+	NSURL *file = [self fileFor:tier];
+	if (![[NSFileManager defaultManager] fileExistsAtPath:file.path]) {
+		[self setNotice:@"Model is not downloaded. Choose a model below to download over Wi-Fi."];
+		return;
+	}
+	const unsigned token = ++_generation;
+	[self setNotice:@"Checking downloaded model..."];
+	// Hash and file I/O never run on the game or UIKit threads.
+	dispatch_async(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+		BOOL valid = [self verify:file tier:tier];
+		dispatch_async(dispatch_get_main_queue(), ^{
+			if (token != _generation.load()) return;
+			if (!valid || ![self hasCapacity:tier]) {
+				[self setNotice:valid ? @"Model paused: memory or temperature limit." : @"Model check failed. Delete downloads and download again."];
+				ScummverseLocalAI::runtime().configure("", false); return;
+			}
+			[self setNotice:nil];
+			[[NSUserDefaults standardUserDefaults] setInteger:tier forKey:@"SCUMMVERSELocalDialogue"];
+			// CPU mode limits memory on older devices; newer devices use Metal.
+			BOOL gpu = [NSProcessInfo processInfo].physicalMemory >= 6ULL * 1024 * 1024 * 1024;
+			ScummverseLocalAI::runtime().configure(file.path.UTF8String, gpu);
+		});
+	});
+}
+- (BOOL)verify:(NSURL *)file tier:(NSInteger)tier {
+	const SVModel &model = svModels[tier - 1];
+	NSDictionary *attributes = [[NSFileManager defaultManager] attributesOfItemAtPath:file.path error:nil];
+	if ([attributes fileSize] != model.bytes) return NO;
+	NSInputStream *stream = [NSInputStream inputStreamWithURL:file]; [stream open];
+	CC_SHA256_CTX hash; CC_SHA256_Init(&hash);
+	uint8_t buffer[65536]; NSInteger read;
+	while ((read = [stream read:buffer maxLength:sizeof(buffer)]) > 0) CC_SHA256_Update(&hash, buffer, (CC_LONG)read);
+	[stream close]; if (read < 0) return NO;
+	unsigned char digest[CC_SHA256_DIGEST_LENGTH]; CC_SHA256_Final(digest, &hash);
+	char hex[65]; for (int n = 0; n < 32; ++n) snprintf(hex + n * 2, 3, "%02x", digest[n]);
+	return strcmp(hex, model.sha256) == 0;
+}
+- (void)disable {
+	++_generation;
+	[_task cancel]; [_task release]; _task = nil;
+	[[NSUserDefaults standardUserDefaults] setInteger:0 forKey:@"SCUMMVERSELocalDialogue"];
+	[self setNotice:nil];
+	ScummverseLocalAI::runtime().configure("", false);
+}
+- (void)download:(NSInteger)tier {
+	if (![self hasCapacity:tier]) { [self setNotice:@"Use Classic for now: memory or temperature limit reached."]; return; }
+	if ([[NSFileManager defaultManager] fileExistsAtPath:[self fileFor:tier].path]) { [self activate:tier]; return; }
+	[self disable];
+	const unsigned token = ++_generation;
+	const SVModel &model = svModels[tier - 1];
+	NSDictionary *space = [[NSFileManager defaultManager] attributesOfFileSystemForPath:[self directory].path error:nil];
+	if ([space[NSFileSystemFreeSize] unsignedLongLongValue] < model.bytes + 300ULL * 1024 * 1024) {
+		[self setNotice:@"Not enough storage for this model."]; return;
+	}
+	_downloadTier = tier;
+	[self setNotice:@"Downloading over Wi-Fi. Tap AI again to check progress or cancel."];
+	NSURL *url = [NSURL URLWithString:[NSString stringWithUTF8String:model.url]];
+	_task = [[_session downloadTaskWithURL:url completionHandler:^(NSURL *location, NSURLResponse *response, NSError *error) {
+		if (token != _generation.load()) return;
+		NSURL *staged = [[self directory] URLByAppendingPathComponent:[NSString stringWithFormat:@"model-%u.partial", token]];
+		BOOL ok = !error && [(NSHTTPURLResponse *)response statusCode] == 200 && location &&
+			[[NSFileManager defaultManager] moveItemAtURL:location toURL:staged error:nil];
+		if (ok) ok = [self verify:staged tier:tier];
+		dispatch_async(dispatch_get_main_queue(), ^{
+			if (token != _generation.load()) { [[NSFileManager defaultManager] removeItemAtURL:staged error:nil]; return; }
+			[_task release]; _task = nil;
+			BOOL installed = ok && [[NSFileManager defaultManager] moveItemAtURL:staged toURL:[self fileFor:tier] error:nil];
+			if (!installed) {
+				[[NSFileManager defaultManager] removeItemAtURL:staged error:nil];
+				[self setNotice:@"Download failed or did not pass verification. Classic dialogue is active; reconnect to Wi-Fi and retry."];
+				return;
+			}
+			[self activate:tier];
+		});
+	}] retain];
+	[_task resume];
+}
+- (void)stopForPressure:(NSNotification *)notification {
+	if (![NSThread isMainThread]) {
+		dispatch_async(dispatch_get_main_queue(), ^{ [self stopForPressure:notification]; }); return;
+	}
+	if ([notification.name isEqualToString:NSProcessInfoThermalStateDidChangeNotification] &&
+		[NSProcessInfo processInfo].thermalState < NSProcessInfoThermalStateSerious) return;
+	++_generation;
+	[_task cancel]; [_task release]; _task = nil;
+	ScummverseLocalAI::runtime().configure("", false);
+	[self setNotice:@"Local dialogue paused to free memory or let the phone cool. Classic lines remain available. Select a model to retry."];
+}
+- (void)background:(NSNotification *)notification {
+	++_generation;
+	[_task cancel]; [_task release]; _task = nil;
+	ScummverseLocalAI::runtime().configure("", false);
+}
+- (void)foreground:(NSNotification *)notification {
+	NSInteger tier = [[NSUserDefaults standardUserDefaults] integerForKey:@"SCUMMVERSELocalDialogue"];
+	if (tier > 0) [self activate:tier];
+}
+- (void)showFrom:(UIView *)view {
+	UIResponder *responder = view;
+	while (responder && ![responder isKindOfClass:[UIViewController class]]) responder = responder.nextResponder;
+	UIViewController *controller = (UIViewController *)responder;
+	if (!controller || controller.presentedViewController) return;
+	NSString *status = _notice ?: [NSString stringWithUTF8String:ScummverseLocalAI::runtime().getStatus().c_str()];
+	if (_task) status = [NSString stringWithFormat:@"Downloading %@: %.0f%%. Wi-Fi only. Cancels if the app goes into the background.", _downloadTier == 1 ? @"Small" : @"Larger", _task.progress.fractionCompleted * 100];
+	NSString *message = [status stringByAppendingString:@"\n\nOptional on-device dialogue. No chat leaves your phone. Slow responses use classic lines. Movement stays unchanged.\n\nSmall: 491 MB, lower memory use.\nLarger: 1.12 GB, needs more memory.\nFirst download needs Wi-Fi; then works offline. Unavailable choices need more free memory or a cooler phone.\nQwen2.5 Instruct models (Apache 2.0)."];
+	UIAlertController *alert = [UIAlertController alertControllerWithTitle:@"Local dialogue" message:message preferredStyle:UIAlertControllerStyleAlert];
+	[alert addAction:[UIAlertAction actionWithTitle:@"Classic / cancel download" style:UIAlertActionStyleDefault handler:^(UIAlertAction *) { [self disable]; }]];
+	UIAlertAction *small = [UIAlertAction actionWithTitle:@"Use or download Small" style:UIAlertActionStyleDefault handler:^(UIAlertAction *) { [self download:1]; }];
+	UIAlertAction *large = [UIAlertAction actionWithTitle:@"Use or download Larger" style:UIAlertActionStyleDefault handler:^(UIAlertAction *) { [self download:2]; }];
+	small.enabled = [self hasCapacity:1] && !_task; large.enabled = [self hasCapacity:2] && !_task;
+	[alert addAction:small]; [alert addAction:large];
+	[alert addAction:[UIAlertAction actionWithTitle:@"Delete downloaded models" style:UIAlertActionStyleDestructive handler:^(UIAlertAction *) {
+		[self disable];
+		// POSIX unlink is safe while the worker finishes cancelling mmap use.
+		[[NSFileManager defaultManager] removeItemAtURL:[self directory] error:nil];
+		[self setNotice:@"Downloaded models deleted. Classic dialogue is active."];
+	}]];
+	[alert addAction:[UIAlertAction actionWithTitle:@"Done" style:UIAlertActionStyleCancel handler:nil]];
+	[controller presentViewController:alert animated:YES completion:nil];
+}
+@end
