+// SPDX-License-Identifier: GPL-3.0-or-later
+#ifndef SCUMMVERSE_PORTRAIT_H
+#define SCUMMVERSE_PORTRAIT_H
+
+// Portable presentation contract v1. No engine, platform or game dependencies.
+namespace ScummversePresentation {
+struct PortraitFit {
+ int x, y, width, height;
+ bool valid() const { return width > 0 && height > 0; }
+};
+// Contain the entire nontransparent sprite, centered with transparent padding.
+// Integer nearest-neighbor sampling preserves the source pixel-art proportions.
+inline PortraitFit fitPortrait(int width, int height, int target, int padding) {
+ PortraitFit empty = {0, 0, 0, 0};
+ if (width <= 0 || height <= 0 || target <= 0 || padding < 0 || padding >= target / 2)
+  return empty;
+ const int available = target - 2 * padding;
+ const int longest = width > height ? width : height;
+ PortraitFit fit;
+ fit.width = int((static_cast<long long>(width) * available) / longest);
+ fit.height = int((static_cast<long long>(height) * available) / longest);
+ if (!fit.width) fit.width = 1;
+ if (!fit.height) fit.height = 1;
+ fit.x = (target - fit.width) / 2;
+ fit.y = (target - fit.height) / 2;
+ return fit;
+}
+}
+#endif
