+// A coin game's controls ("<game>-ui.svi" as "SVI3", the new engine's step
+// 2f; see kWorldCoins): from its own start, run on at once until the player
+// has the pointer (that pointer, and the palette then); the coin and the box
+// of things drawn alone from their costumes by an actor of the engine's
+// own, in the game's exact colours as it sets them each time it shows them
+// (each remapped to the palette, a free entry taken where none matches);
+// each verb's part lit where its animation differs from the coin's; the
+// box's arrows in theirs; its cells; the name's lettering and the talk's.
+bool ScummEngine::scummverseExportCoin(int gameIndex, const Common::Path &file, Common::String &problem) {
+	const WorldCoin *coin = worldCoin(gameIndex);
+	if (!coin) { problem = "no controls"; return false; }
+	if (_game.version != 7 || _game.heversion) { problem = "its controls are drawn its own way"; return false; }
+	for (int c : {(int)coin->coin, (int)coin->box})
+		if (c <= 0 || c >= _numCostumes || !_res->_types[rtCostume][c]._roomno) { problem = "costume missing"; return false; }
+	for (uint i = 0; i < NUM_SCRIPT_SLOT; ++i) { vm.slot[i].status = ssDead; vm.slot[i].cutsceneOverride = 0; vm.slot[i].freezeCount = 0; }
+	_currentScript = 0xFF; vm.cutSceneStackPointer = 0; vm.cutSceneScriptIndex = 0xFF;
+	memset(vm.cutScenePtr, 0, sizeof(vm.cutScenePtr)); memset(vm.cutSceneScript, 0, sizeof(vm.cutSceneScript)); memset(vm.cutSceneData, 0, sizeof(vm.cutSceneData));
+	_EXCD_offs = 0;
+	int args[NUM_SCRIPT_LOCAL];
+	memset(args, 0, sizeof(args));
+	args[0] = _bootParam;
+	_rnd.setSeed(0x5C0BE); // (The same start each time.)
+	runScript(1, 0, 0, args);
+	int frame = 0;
+	auto frames = [&](int count) {
+		for (int n = 0; n < count && !shouldQuit(); ++n, ++frame) {
+			for (uint i = 0; i < NUM_SCRIPT_SLOT; ++i)
+				if (vm.slot[i].status == ssPaused) { vm.slot[i].delay = 0; vm.slot[i].status = ssRunning; }
+			scummverseSkipCutscene();
+			if (VAR_HAVE_MSG != 0xFF) VAR(VAR_HAVE_MSG) = 0;
+			_talkDelay = 0;
+			_scummverseMusicTimer = frame * 4;
+			scummLoop(4);
+			_sound->stopAllSounds();
+		}
+	};
+	auto ready = [&]() { return _userPut > 0 && _cursor.state > 0 && _cursor.width > 0 && _cursor.height > 0; };
+	int steady = 0;
+	while (frame < 3000 && !shouldQuit() && steady < 30) { frames(1); steady = ready() ? steady + 1 : 0; }
