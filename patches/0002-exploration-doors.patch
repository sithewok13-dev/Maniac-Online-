@@ -126,6 +126,29 @@ void ScummEngine::runObjectScript(int object, int entry, bool freezeResistant, b
 
 	obcd = getOBCDOffs(object);
 
+	// SCUMMVERSE exploration preview: remove only audited passage locks just
+	// before their original OPEN handlers run. Those handlers still update
+	// both sides, play sounds and use the original room-transition scripts.
+	// State 04 is not universally a lock: never clear it on arbitrary objects.
+	if (_scummverseExplorationDoors && where == WIO_ROOM &&
+		(entry == 1 || (entry == 10 && (object == 143 || object == 108)))) {
+		static const struct { int room; int object; } doors[] = {
+			{1, 61},   // Front door.
+			{1, 53},   // Rusted grate.
+			{6, 137},  // Pool / garage passage, both sides.
+			{36, 125},
+			{16, 143}, // Pool gate.
+			{30, 255}, // Outer laboratory door.
+			{52, 108}  // Alternate pool gate room.
+		};
+		for (uint i = 0; i < ARRAYSIZE(doors); ++i) {
+			if (_roomResource == doors[i].room && object == doors[i].object) {
+				putState(object, getState(object) & ~kObjectStateLocked);
+				break;
+			}
+		}
+	}
+
 	// Find a free object slot, unless one was specified
 	if (slot == -1)
 		slot = getScriptSlot();
