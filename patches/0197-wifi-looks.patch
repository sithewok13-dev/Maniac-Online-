+// Saves keep the characters' own looks, never those their remote players
+// play (the players are not in the save).
+void ScummEngine::scummverseRemoteLooksSaved(bool saving) {
+	for (int id = 1; id < 25; ++id) {
+		if (!scummverseRemoteActor(id) || !_scummverseRemoteLookBefore[id]) continue;
+		const int before = _scummverseRemoteLookBefore[id] - 1;
+		Actor *a = derefActor(id, "remote look saved");
+		if (!saving) {
+			scummverseApplyRemoteLook(id);
+			// (A costume changed stops a walk: it goes on to where its player
+			// was last sent, since no frame comes until they move again.)
+			if (a->isInCurrentRoom() && a->getRealPos() != _scummverseRemoteGoal[id]) {
+				AdjustBoxResult target = a->adjustXYToBeInBox(_scummverseRemoteGoal[id].x, _scummverseRemoteGoal[id].y);
+				a->startWalkActor(target.x, target.y, -1);
+			}
+		} else if (scummverseAppearance(id) != before && !scummverseQuietAppearance(id, before)) scummverseQuietAppearance(id, 0);
+	}
+}
+
+// A save loaded during a WiFi game: the characters' looks are the save's
+// own now (kept for their release); their players' looks go back on.
+void ScummEngine::scummverseRemoteLooksLoaded() {
+	for (int id = 1; id < 25; ++id) {
+		if (!scummverseRemoteActor(id)) continue;
+		_scummverseRemoteLookBefore[id] = scummverseAppearance(id) + 1;
+		// (Loaded as the local player's own: theirs now, their friend's
+		// frames ignored as before; the save's look kept.)
+		if (id == VAR(VAR_EGO)) {
+			for (int peer = 0; peer <= NetBridge::kMaxPeers; ++peer) if (_scummversePeerActor[peer] == id) scummverseReleaseRemote(peer);
+			continue;
+		}
+		scummverseApplyRemoteLook(id);
+	}
+}
