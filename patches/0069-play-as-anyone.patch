+// Places guest slot k of the viewed place near the arrival point.
+void ScummEngine::scummversePlaceGuest(int k, int place) {
+	const WorldGuest *guest = worldGuestAt(place, k);
+	if (!guest || _scummverseGuestSprite[k] < 0) return;
+	Actor *a = derefActor(kScummverseGuestActor + k, "world guest");
+	// Any V1 costume keeps the actor in the draw list; the frames replace it.
+	if (!a->_costume) a->setActorCostume(derefActor(VAR(VAR_EGO), "guest stand-in")->_costume);
+	a->_talkColor = guest->talkColor;
+	const size_t length = strlen(guest->name) + 1;
+	memcpy(_res->createResource(rtActorName, a->_number, length), guest->name, length);
+	// Spread out on both sides of the arrival point.
+	const int offset = (k / 2 + 1) * 5 * (k % 2 ? -1 : 1);
+	a->putActor(WorldBridge::spawnX(), WorldBridge::spawnY(), _currentRoom);
+	AdjustBoxResult point = a->adjustXYToBeInBox(CLIP<int>(WorldBridge::spawnX() + offset, 1, WorldBridge::width() / 8 - 2), WorldBridge::spawnY() + k % 3);
+	a->putActor(point.x, point.y, _currentRoom);
+	a->setDirection(180); a->startAnimActor(a->_standFrame); a->showActor();
+	_scummverseGuestTick[k] = 0; _scummverseGuestShown[k] = -1; _scummverseGuestGreeted[k] = false;
+	_scummverseGuestIdle[k] = 120 + 90 * k;
+}
