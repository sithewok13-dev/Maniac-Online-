+// ---- Playing someone from another game ------------------------------------
+
+int ScummEngine::scummverseAppearance(int id) const {
+	if (!_scummverseRoaming || !_scummVars || id <= 0 || id >= kScummverseManiacActors) return 0;
+	const int key = _scummVars[kScummverseAppearanceVar + id];
+	return worldAppearance(key) ? key : 0;
+}
+
+const byte *ScummEngine::scummverseAppearanceName(int id) const {
+	const WorldGuest *who = worldAppearance(scummverseAppearance(id));
+	return who ? (const byte *)who->name : nullptr;
+}
+
+// Key 0 makes them themselves again. Refused (with a notice) when that
+// game's characters are not exported here.
+bool ScummEngine::scummverseSetAppearance(int id, int key) {
+	if (!_scummverseRoaming || id <= 0 || id >= kScummverseManiacActors) return false;
+	Actor *a = derefActor(id, "appearance");
+	const WorldGuest *who = worldAppearance(key);
+	if (key && !who) { _scummverseWorldNotice = "That character is not in the catalog."; return false; }
+	if (who && scummverseCharacterFrames(worldAppearanceGame(key), who->costume).empty()) {
+		_scummverseWorldNotice = Common::String::format("%s's game is not set up here. Add it to Documents/%s and restart.", who->name, kWorldGames[worldAppearanceGame(key)].folder);
+		return false;
+	}
+	_scummVars[kScummverseAppearanceVar + id] = who ? key : 0;
+	::scummverseTalkAppearance(id, who ? key : 0);
+	_scummverseCharactersKey.clear();
+	a->_needRedraw = true; _fullRedraw = true;
+	_scummverseWorldNotice = who ? Common::String::format("You are playing %s.", who->name)
+		: Common::String::format("%s again.", (const char *)a->getActorName());
+	return true;
+}
+
+bool ScummEngine::scummverseAppearancePortrait(int id, byte *rgba) {
+	const int key = scummverseAppearance(id);
+	if (!key) return false;
+	const Common::Array<byte> data = scummverseCharacterFrames(worldAppearanceGame(key), worldAppearanceCostume(key));
+	return !data.empty() && WorldBridge::spritePortrait(data.data(), data.size(), 64, rgba);
+}
+
+void ScummEngine::scummverseMountCharacters() {
+	int source;
+	const int gameIndex = scummverseWorldGameOf(_currentRoom, source);
+	const bool inWorld = _scummverseRoaming && _scummverseWorldRoom == _currentRoom && gameIndex >= 0 && WorldBridge::mounted();
+	Common::String key = Common::String::format("%d:%d", _currentRoom, inWorld ? 1 : 0);
+	for (int id = 1; id < kScummverseManiacActors; ++id) {
+		const int look = scummverseAppearance(id);
+		if (look && _actors[id]->_room == _currentRoom) key += Common::String::format(" %d=%d", id, look);
+	}
+	if (key == _scummverseCharactersKey) return;
+	_scummverseCharactersKey = key;
+	for (int id = 1; id < kScummverseManiacActors; ++id) ::scummverseTalkAppearance(id, scummverseAppearance(id));
+	const int most = kScummverseGuestSlots + kScummverseManiacActors;
+	const byte *data[most]; size_t sizes[most]; double scales[most]; int count = 0;
+	Common::Array<byte> looks[kScummverseManiacActors];
+	for (int k = 0; k < kScummverseGuestSlots; ++k) {
+		_scummverseGuestSprite[k] = -1;
+		if (!inWorld || _scummverseGuestData[k].empty()) continue;
+		// Someone here already plays this character: it steps aside.
+		const WorldGuest *guest = worldGuestAt(worldPlaceKey(gameIndex, source), k);
+		if (guest && key.contains(Common::String::format("=%d", worldAppearanceKey(gameIndex, guest->costume)))) continue;
+		_scummverseGuestSprite[k] = count;
+		data[count] = _scummverseGuestData[k].data(); sizes[count] = _scummverseGuestData[k].size(); scales[count] = WorldBridge::sceneScale(); ++count;
+	}
+	// As tall as a person standing here: this scene game's lead (fitted like
+	// the scene), or a Maniac teenager in the mansion and Zak's places.
+	const double person = inWorld ? kWorldGames[gameIndex].heroHeight * WorldBridge::sceneScale() : kWorldManiacHeight;
+	for (int id = 1; id < kScummverseManiacActors; ++id) {
+		_scummverseAvatarSprite[id] = 0;
+		const int look = scummverseAppearance(id);
+		if (!look || _actors[id]->_room != _currentRoom) continue;
+		looks[id] = scummverseCharacterFrames(worldAppearanceGame(look), worldAppearanceCostume(look));
+		if (looks[id].empty()) continue;
+		_scummverseAvatarSprite[id] = count + 1;
+		data[count] = looks[id].data(); sizes[count] = looks[id].size();
+		scales[count] = CLIP(person / kWorldGames[worldAppearanceGame(look)].heroHeight, 0.06, 4.0); ++count;
+		_actors[id]->_needRedraw = true;
+	}
+	char problem[128];
+	if (!count) { WorldBridge::unmountGuests(); return; }
+	if (!WorldBridge::mountCharacters(data, sizes, scales, count, kWorldGuestColor, kWorldGuestColors, problem, sizeof(problem))) {
+		warning("SCUMMVERSE world: characters not shown (%s)", problem);
+		for (int &k : _scummverseGuestSprite) k = -1;
+		for (int &k : _scummverseAvatarSprite) k = 0;
+		WorldBridge::unmountGuests();
+		return;
+	}
+	const byte *rgb = WorldBridge::guestPalette();
+	for (int i = 0; i < WorldBridge::guestSlotCount(); ++i)
+		setPalColor(kWorldGuestColor + i, rgb[i * 3], rgb[i * 3 + 1], rgb[i * 3 + 2]);
+}
