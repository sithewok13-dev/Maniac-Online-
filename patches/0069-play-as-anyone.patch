+// Playing someone from another game: the character you control takes on a
+// cast member's look, name and voice in chat (engine scummverseSetAppearance).
+- (void)showScummversePlayAsFrom:(UIViewController *)controller {
+	UIAlertController *menu = [UIAlertController alertControllerWithTitle:@"Play as someone else" message:@"The character you control becomes someone from your other games: their look, name and conversation. Switch characters to play several of them at once." preferredStyle:UIAlertControllerStyleAlert];
+	[menu addAction:[UIAlertAction actionWithTitle:@"Be yourself again" style:UIAlertActionStyleDefault handler:^(UIAlertAction *) {
+		scummverseWorldRequest(Scummverse::WorldCatalog::worldAppearanceRequest(0));
+	}]];
+	for (const auto &game : Scummverse::WorldCatalog::kWorldGames) {
+		const BOOL installed = scummverseWorldInstalled(game);
+		NSString *title = installed ? [NSString stringWithUTF8String:game.title] : [NSString stringWithFormat:@"%s (add Documents/%s)", game.title, game.folder];
+		const Scummverse::WorldCatalog::WorldGame *chosen = &game;
+		UIAlertAction *action = [UIAlertAction actionWithTitle:title style:UIAlertActionStyleDefault handler:^(UIAlertAction *) {
+			[controller dismissViewControllerAnimated:YES completion:^{ [self showScummversePlayAs:chosen from:controller]; }];
+		}];
+		action.enabled = installed;
+		[menu addAction:action];
+	}
+	[menu addAction:[UIAlertAction actionWithTitle:@"Close" style:UIAlertActionStyleCancel handler:nil]];
+	[controller presentViewController:menu animated:YES completion:nil];
+}
+- (void)showScummversePlayAs:(const Scummverse::WorldCatalog::WorldGame *)game from:(UIViewController *)controller {
+	const int gameIndex = (int)(game - Scummverse::WorldCatalog::kWorldGames);
+	UIAlertController *menu = [UIAlertController alertControllerWithTitle:[NSString stringWithUTF8String:game->title] message:@"Choose who to play." preferredStyle:UIAlertControllerStyleAlert];
+	NSString *documents = NSSearchPathForDirectoriesInDomains(NSDocumentDirectory, NSUserDomainMask, YES).firstObject;
+	NSFileManager *fm = [NSFileManager defaultManager];
+	// Everyone exported from this game, once each (some stand in several rooms), by name.
+	NSMutableDictionary<NSString *, NSNumber *> *people = [NSMutableDictionary dictionary];
+	for (const auto &cast : Scummverse::WorldCatalog::kWorldCast) {
+		if (cast.game != gameIndex) continue;
+		NSString *frames = [NSString stringWithFormat:@"%@/worlds/%s-c%d.svc", documents, game->gameid, cast.guest.costume];
+		NSString *name = [NSString stringWithUTF8String:cast.guest.name];
+		if (people[name] || ![fm fileExistsAtPath:frames]) continue;
+		people[name] = @(Scummverse::WorldCatalog::worldAppearanceKey(gameIndex, cast.guest.costume));
+	}
+	for (NSString *name in [people.allKeys sortedArrayUsingSelector:@selector(localizedCaseInsensitiveCompare:)]) {
+		const int key = people[name].intValue;
+		[menu addAction:[UIAlertAction actionWithTitle:name style:UIAlertActionStyleDefault handler:^(UIAlertAction *) {
+			scummverseWorldRequest(Scummverse::WorldCatalog::worldAppearanceRequest(key));
+		}]];
+	}
+	if (!people.count) menu.message = @"No characters are set up for this game yet. Restart the app to set it up.";
+	[menu addAction:[UIAlertAction actionWithTitle:@"Close" style:UIAlertActionStyleCancel handler:nil]];
+	[controller presentViewController:menu animated:YES completion:nil];
+}
