+bool Scene::mountPicture(const uint8_t *data, size_t size, std::string &error) {
+	World::SourceScene other;
+	if (_source.pixels.empty()) { error = "no scene"; return false; }
+	if (!World::parseScene(data, size, other, error)) return false;
+	if (other.width != _source.width || other.height != _source.height) { error = "not the same place's size"; return false; }
+	// Its colours as the scene's: the same entry where it is the same colour,
+	// else the nearest.
+	uint8_t remap[256];
+	for (int c = 0; c < 256; ++c) {
+		const int r = other.palette[c * 3], g = other.palette[c * 3 + 1], b = other.palette[c * 3 + 2];
+		int best = c;
+		long bestAway = -1;
+		for (int k = 0; k < 256; ++k) {
+			const int dr = r - _source.palette[k * 3], dg = g - _source.palette[k * 3 + 1], db = b - _source.palette[k * 3 + 2];
+			const long away = (long)dr * dr + (long)dg * dg + (long)db * db;
+			if (bestAway < 0 || away < bestAway || (away == bestAway && k == c)) { best = k; bestAway = away; }
+		}
+		remap[c] = (uint8_t)best;
+	}
+	int x0 = other.width, y0 = other.height, x1 = -1, y1 = -1;
+	for (int y = 0; y < other.height; ++y)
+		for (int x = 0; x < other.width; ++x)
+			if (remap[other.pixels[(size_t)y * other.width + x]] != _source.pixels[(size_t)y * _source.width + x]) {
+				x0 = std::min(x0, x); y0 = std::min(y0, y); x1 = std::max(x1, x); y1 = std::max(y1, y);
+			}
+	if (x1 < 0) { error = "no different picture"; return false; }
+	Picture p;
+	p.on = true; p.x = x0; p.y = y0; p.w = x1 - x0 + 1; p.h = y1 - y0 + 1;
+	p.pixels.resize((size_t)p.w * p.h); p.mask.resize(p.pixels.size()); p.clean.resize(p.pixels.size());
+	for (int y = 0; y < p.h; ++y)
+		for (int x = 0; x < p.w; ++x) {
+			const size_t at = (size_t)y * p.w + x, src = (size_t)(p.y + y) * _source.width + p.x + x;
+			p.pixels[at] = remap[other.pixels[src]];
+			p.clean[at] = _source.pixels[src];
+			p.mask[at] = p.pixels[at] != p.clean[at];
+		}
+	_picture = std::move(p);
