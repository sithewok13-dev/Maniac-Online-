+			if (!StageBridge::pictureMounted()) { fail("no car"); continue; }
+			int car = -1, id, ox, oy, w, h, wx, wy, state, sx, sy;
+			for (int o = 0; o < StageBridge::objectCount() && car < 0; ++o)
+				if (StageBridge::object(o, id, ox, oy, w, h, wx, wy, state) && id == here.car && isDoor(o)) car = o;
+			if (car < 0) { fail("no car door"); continue; }
+			StageBridge::object(car, id, ox, oy, w, h, wx, wy, state);
+			StageBridge::lookAt(ox + w / 2.0);
+			present();
+			const Common::Array<uint32> before = _frame;
+			// A tap on its door: walked to the ledge, where it is called.
+			StageBridge::toScreen(ox + w / 2.0, oy + h / 2.0, sx, sy);
+			tap(sx, sy);
+			if (_door >= 0) fail("the car's door to be gone through");
+			const bool parkedHere = ((_tram.parked >> (l * 2)) & 3) == (unsigned)(1 + e);
+			for (int t = 0; t < 6000 && !_tram.phase; ++t) step(1);
+			if (_game != tl.game || _room != here.room) { fail("gone through the car's door"); continue; }
+			if (!_tram.phase) { fail("not called from the ledge"); continue; }
+			if (parkedHere != (_tram.phase >= kTramOpen)) fail(parkedHere ? "parked here, not waiting open" : "open before it came");
+			for (int t = 0; t < 600 && _tram.phase && _tram.phase < kTramOpen; ++t) step(1);
+			present();
+			int differ = 0;
+			for (uint i = 0; i < _frame.size(); ++i) differ += _frame[i] != before[i];
+			if (differ < 100) fail("the car not drawn");
+			if (!pictured && ConfMan.hasKey("scummverse_shots")) pictured = shot("tram.png");
+			if (!e) {
+				// On the ledge as the doors close: away, unseen, and off at the other end.
+				bool seen = false;
+				for (int t = 0; t < 3000 && _tram.phase; ++t) {
