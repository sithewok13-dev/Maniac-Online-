+// ---- The Dig's tram ----
+
+// Ticks from the call: arriving until kTramOpen, boarding until kTramClose,
+// leaving until kTramGone, riding, at the other end from kTramThere, its
+// doors open there until kTramDone (as Maniac's).
+static const int kTramOpen = 90, kTramClose = kTramOpen + 300, kTramGone = kTramClose + 90,
+	kTramThere = kTramGone + 120, kTramDone = kTramThere + 90;
+
+void SandboxEngine::announce(const char *text) {
+	_notice = text;
+	_noticeClock = MIN<int>(90 + 4 * _notice.size(), 480);
+	_dirty = true;
+}
+
+bool SandboxEngine::tramStop(int &line, int &end) const { return _game >= 0 && worldTramStop(_game, _room, line, end); }
+
+// The station's car ("<game>-<room>-car.svw"), hidden till shown; a new
+// station: its ledge calls again.
+void SandboxEngine::tramMount(int game, int room) {
+	_tram.armed = true; _tram.busySaid = false;
+	_tram.shownDx = 1 << 20; _tram.shownAmount = 256;
+	int line, end;
+	if (!worldTramStop(game, room, line, end)) return;
+	Common::Array<byte> data;
+	char error[128];
+	if (!read(Common::String::format("%s-%d-car.svw", kWorldGames[game].gameid, room), data)) return; // (an older export: the car unseen)
+	if (!StageBridge::mountPicture(data.data(), data.size(), error, sizeof(error)))
+		warning("SCUMMVERSE sandbox: %s-%d tram car not shown (%s)", kWorldGames[game].gameid, room, error);
+}
+
+void SandboxEngine::tramCall(int line, int end) {
+	const int trip = line * 2 + end + 1;
+	if (_tram.phase) {
+		if (_tram.trip == trip) { _tram.armed = false; return; }
+		if (!_tram.busySaid) announce("The tram is on another run. Wait here.");
+		_tram.busySaid = true;
+		return;
+	}
+	_tram.armed = false; _tram.busySaid = false;
+	_tram.trip = trip;
+	const unsigned parked = (_tram.parked >> (line * 2)) & 3;
+	if (parked == (unsigned)(1 + end)) { _tram.phase = kTramOpen; announce("The tram is here. All aboard!"); return; }
+	_tram.parked &= ~(3u << (line * 2));
+	_tram.phase = 1;
+	announce("Here comes the tram.");
+}
+
+void SandboxEngine::tramStep(int ticks) {
+	if (_player < 0) return;
+	const double unit = _game >= 0 ? screenWidthOf(_game) / 320.0 : 1;
+	int line, end;
+	// Each walk onto the ledge calls the car once (not stepping off it; not
+	// the tour's guide).
+	if (!_tram.riding && !_touring.on && tramStop(line, end)) {
+		const WorldTramStop &stop = kWorldTramLines[line].ends[end];
+		double lx = stop.ledgeX, ly = stop.ledgeY, px, py;
+		StageBridge::walkable(lx, ly);
+		StageBridge::position(_player, px, py);
+		const double dx = fabs(px - lx), dy = fabs(py - ly);
+		if (dx > 6 * unit || dy > 6 * unit) _tram.armed = true;
+		else if (dx <= 3 * unit && dy <= 3 * unit && _tram.armed && !StageBridge::moving(_player)) tramCall(line, end);
+	}
+	if (_tram.phase) {
+		const int previous = _tram.phase;
+		const int phase = _tram.phase += MIN(ticks, 60);
+		const int trip = _tram.trip - 1, tripLine = trip / 2, from = trip % 2;
+		const WorldTramLine &tl = kWorldTramLines[tripLine];
+		const WorldTramStop &here = tl.ends[from], &there = tl.ends[1 - from];
+		const bool atOrigin = _game == tl.game && _room == here.room;
+		auto onLedge = [&]() {
+			if (!atOrigin) return false;
+			double lx = here.ledgeX, ly = here.ledgeY, px, py;
+			StageBridge::walkable(lx, ly);
+			StageBridge::position(_player, px, py);
+			return fabs(px - lx) <= 3 * unit && fabs(py - ly) <= 3 * unit;
+		};
+		if (previous < kTramOpen && phase >= kTramOpen && atOrigin) announce("The doors open. All aboard!");
+		if (previous < kTramClose - 90 && phase >= kTramClose - 90 && phase <= kTramClose && atOrigin) announce("Doors closing!");
+		if (previous <= kTramClose && phase > kTramClose) {
+			if (!onLedge()) {
+				// Not without the one played: it waits here, open.
+				_tram.parked = (_tram.parked & ~(3u << (tripLine * 2))) | ((unsigned)(1 + from) << (tripLine * 2));
+				_tram.phase = _tram.trip = 0;
+				tramShow();
+				return;
+			}
+			_tram.riding = true;
+			StageBridge::stop(_player);
+			StageBridge::hide(_player, true);
+			_dirty = true;
+		}
+		if (previous < kTramThere && phase >= kTramThere && _tram.riding) {
+			// At the other end: there, unseen till its doors open.
+			Common::String problem;
+			if (enter(tl.game, there.room, 0, problem)) {
+				double lx = there.ledgeX, ly = there.ledgeY;
+				StageBridge::walkable(lx, ly);
+				StageBridge::place(_player, lx, ly);
+				StageBridge::follow(_player);
+				StageBridge::hide(_player, true);
+			} else {
+				warning("SCUMMVERSE sandbox: tram to %s-%d not shown (%s)", kWorldGames[tl.game].gameid, there.room, problem.c_str());
+				_tram.riding = false;
+				StageBridge::hide(_player, false);
+			}
+		}
+		if (phase >= kTramDone) {
+			if (_tram.riding && _game == tl.game && _room == there.room) {
+				StageBridge::hide(_player, false);
+				double ex = there.exitX, ey = there.exitY;
+				StageBridge::walkable(ex, ey);
+				StageBridge::walkTo(_player, ex, ey);
+				_tram.armed = false; // (stepping off is not a call)
+			}
+			_tram.parked = (_tram.parked & ~(3u << (tripLine * 2))) | ((unsigned)(2 - from) << (tripLine * 2));
+			_tram.phase = _tram.trip = 0;
+			_tram.riding = false;
+			_dirty = true;
+		}
+	}
+	tramShow();
+}
+
+// The car in view: parked, or sliding in or out of its tunnel (a dissolve
+// where it comes toward the viewer).
+void SandboxEngine::tramShow() {
+	int line, end;
+	if (!tramStop(line, end) || !StageBridge::pictureMounted()) return;
+	const WorldTramStop &stop = kWorldTramLines[line].ends[end];
+	double shown = ((_tram.parked >> (line * 2)) & 3) == (unsigned)(1 + end) ? 1 : 0;
+	const int phase = _tram.phase, trip = _tram.trip - 1;
+	if (phase && trip / 2 == line) {
+		if (trip % 2 == end) {
+			shown = phase < kTramOpen ? (double)phase / kTramOpen : phase <= kTramClose ? 1 :
+				phase < kTramGone ? 1 - (double)(phase - kTramClose) / (kTramGone - kTramClose) : 0;
+		} else shown = phase < kTramThere ? 0 : MIN(1.0, (double)(phase - kTramThere) / (kTramDone - kTramThere));
+	}
+	const int width = StageBridge::pictureWidth();
+	int dx = 0, amount = 256;
+	if (shown <= 0) dx = 1 << 20;
+	else if (stop.tunnel) dx = (int)(stop.tunnel * width * (1 - shown));
+	else amount = (int)(256 * shown);
+	if (dx == _tram.shownDx && amount == _tram.shownAmount) return;
+	_tram.shownDx = dx; _tram.shownAmount = amount;
+	StageBridge::showPicture(dx, amount);
+	_dirty = true;
+}
