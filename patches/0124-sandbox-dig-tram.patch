+					seen = seen || (_tram.riding && !StageBridge::hidden(_player));
+				}
+				if (seen) fail("seen riding");
+				if (_tram.phase || _game != tl.game || _room != there.room || StageBridge::hidden(_player)) fail("not off at the other end");
+				else if (((_tram.parked >> (l * 2)) & 3) != (unsigned)(2 - e)) fail("not staying at the other end");
+				else ++rides;
+			} else {
+				// Walked off the ledge: it stays, open, without the one played.
+				double xs[12], ys[12], lx = here.ledgeX, ly = here.ledgeY, far = -1;
+				int to = -1;
+				const int spots = StageBridge::spots(12, xs, ys);
+				for (int i = 0; i < spots; ++i) if ((xs[i] - lx) * (xs[i] - lx) + (ys[i] - ly) * (ys[i] - ly) > far) { far = (xs[i] - lx) * (xs[i] - lx) + (ys[i] - ly) * (ys[i] - ly); to = i; }
+				if (to >= 0) StageBridge::walkTo(_player, xs[to], ys[to]);
+				for (int t = 0; t < 3000 && _tram.phase; ++t) step(1);
+				if (_game != tl.game || _room != here.room || ((_tram.parked >> (l * 2)) & 3) != (unsigned)(1 + e)) fail("gone without the one played");
+				else ++waits;
+			}
+		}
+	}
+	g_system->updateScreen();
+	warning("SCUMMVERSE sandbox selftest rides: %d tram stations, %d rides, %d waited, %d failed", stations, rides, waits, failed);
+	if (failed || !rides) return Common::Error(Common::kUnknownError, "sandbox selftest failed");
+	warning("SCUMMVERSE sandbox selftest PASS");
+	return Common::kNoError;
+}
