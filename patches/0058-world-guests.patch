+// ---- Guests --------------------------------------------------------------
+// A scene's guest borrows the resident actor (kZakResidentActor): it walks
+// the scene's boxes, talks and chats like any sandbox character, but is
+// drawn from frames its own game's engine exported.
+
+bool ScummEngine::scummverseWorldGuestRoom(int room) const { return worldGuestInRoom(room) != nullptr; }
+
+static bool worldGuestActive(int room, int heldRoom, int mountedRoom) {
+	return worldGuestInRoom(room) && heldRoom == room && mountedRoom == room && WorldBridge::guestMounted();
+}
+
+void ScummEngine::scummverseBorrowGuest(Actor *a) {
+	const WorldGuest *guest = worldGuestInRoom(_currentRoom);
+	if (!guest || _scummverseWorldRoom != _currentRoom || !WorldBridge::guestMounted()) return;
+	_scummVars[769] = a->_costume;
+	a->stopActorMoving();
+	// Any costume keeps the actor in the draw list; the frames replace it.
+	if (!a->_costume) a->setActorCostume(derefActor(VAR(VAR_EGO), "guest stand-in")->_costume);
+	a->_talkColor = guest->talkColor;
+	const size_t length = strlen(guest->name) + 1;
+	memcpy(_res->createResource(rtActorName, kZakResidentActor, length), guest->name, length);
+	a->putActor(WorldBridge::spawnX(), WorldBridge::spawnY(), _currentRoom);
+	AdjustBoxResult point = a->adjustXYToBeInBox(WorldBridge::spawnX() + 5, WorldBridge::spawnY());
+	a->putActor(point.x, point.y, _currentRoom);
+	a->setDirection(180); a->startAnimActor(a->_standFrame);
+	_scummVars[768] = _currentRoom;
+	_scummverseGuestTick = 0; _scummverseGuestIdle = 120; _scummverseGuestGreeted = false;
+}
+
+static int worldGuestDirection(int facing) {
+	facing = (facing % 360 + 360) % 360;
+	return facing > 45 && facing < 135 ? 1 : facing >= 135 && facing <= 225 ? 2 : facing > 225 && facing < 315 ? 0 : 3;
+}
+
+bool ScummEngine::scummverseDrawGuest(Actor *a) {
+	if (a->_number != kZakResidentActor || !worldGuestActive(_currentRoom, _scummVars[768], _scummverseWorldRoom)) return false;
+	if (!a->_needRedraw) return true;
+	a->_needRedraw = false;
+	const int kind = a->_moving ? 1 : getTalkingActor() == a->_number ? 2 : 0;
+	const int index = kind == 1 ? _scummverseGuestTick / 6 : kind == 2 ? _scummverseGuestTick / 9 : 0;
+	const int dir = worldGuestDirection(a->getFacing());
+	_scummverseGuestShown = (dir * 3 + kind) * 64 + index % 64;
+	int dx, dy, width, height;
+	const byte *frame = WorldBridge::guestFrame(dir, kind, index, dx, dy, width, height);
+	a->_top = 0x7fffffff; a->_bottom = 0;
+	if (!frame) return true;
+	VirtScreen &vs = _virtscr[kMainVirtScreen];
+	const int x0 = a->getPos().x - vs.xstart + dx, y0 = a->getPos().y - a->getElevation() + dy;
+	const int left = MAX(0, x0), right = MIN<int>(_screenWidth, x0 + width);
+	const int top = MAX(0, y0), bottom = MIN<int>(vs.h, y0 + height);
+	if (left >= right || top >= bottom) return true;
+	for (int y = top; y < bottom; ++y) {
+		const byte *src = frame + (y - y0) * width + (left - x0);
+		byte *dst = (byte *)vs.getPixels(left, y);
+		for (int x = left; x < right; ++x, ++src, ++dst) if (*src) *dst = *src;
+	}
+	a->_top = top; a->_bottom = bottom;
+	markRectAsDirty(kMainVirtScreen, left, right, top, bottom, a->_number);
+	return true;
+}
