+// ---- Characters -------------------------------------------------------------
+
+bool parseSprite(const uint8_t *data, size_t size, SourceSprite &sprite, std::string &error) {
+	sprite = SourceSprite();
+	if (!data || size < 8 + 768 || std::memcmp(data, "SVC1", 4)) { error = "not a character file"; return false; }
+	sprite.costume = read16(data + 4);
+	const int count = read16(data + 6);
+	std::memcpy(sprite.palette, data + 8, 768);
+	size_t at = 8 + 768;
+	for (int i = 0; i < count; ++i) {
+		if (size - at < 12) { error = "truncated character"; return false; }
+		const uint8_t *p = data + at;
+		SourceFrame f;
+		f.dir = p[0]; f.kind = p[1]; f.index = p[2];
+		f.dx = readS16(p + 4); f.dy = readS16(p + 6); f.width = read16(p + 8); f.height = read16(p + 10);
+		if (f.dir >= kGuestDirections || f.kind >= kGuestKinds || f.width < 1 || f.height < 1 || f.width > 640 || f.height > 480) {
+			error = "bad frame"; return false;
+		}
+		const size_t area = (size_t)f.width * f.height;
+		at += 12;
+		if (size - at < area * 2) { error = "truncated character"; return false; }
+		f.pixels.assign(data + at, data + at + area);
+		f.mask.assign(data + at + area, data + at + 2 * area);
+		at += area * 2;
+		sprite.frames.push_back(f);
+	}
+	if (at != size) { error = "trailing bytes"; return false; }
+	if (sprite.frames.empty()) { error = "no frames"; return false; }
+	return true;
+}
+
+bool fitSprite(const SourceSprite &src, double scale, int firstSlot, int slotCount, SandboxSprite &out, std::string &error) {
+	out = SandboxSprite();
+	if (scale <= 0.05 || scale > 4 || firstSlot < 1 || slotCount < 1 || firstSlot + slotCount > 256) { error = "bad target"; return false; }
+	std::vector<long> frequency(256, 0);
+	for (const SourceFrame &f : src.frames)
+		for (size_t i = 0; i < f.pixels.size(); ++i) if (f.mask[i]) ++frequency[f.pixels[i]];
+	std::vector<int> used;
+	for (int c = 0; c < 256; ++c) if (frequency[c]) used.push_back(c);
+	std::stable_sort(used.begin(), used.end(), [&](int a, int b) { return frequency[a] > frequency[b]; });
+	if ((int)used.size() > slotCount) used.resize(slotCount);
+	std::vector<int> slotOf(256, -1);
+	for (int i = 0; i < (int)used.size(); ++i) slotOf[used[i]] = i;
+	auto rgb = [&](int c, int k) { return (int)src.palette[c * 3 + k]; };
+	for (int c = 0; c < 256; ++c) {
+		if (slotOf[c] >= 0 || !frequency[c]) continue;
+		long best = -1;
+		for (int i = 0; i < (int)used.size(); ++i) {
+			const long dr = rgb(c, 0) - rgb(used[i], 0), dg = rgb(c, 1) - rgb(used[i], 1), db = rgb(c, 2) - rgb(used[i], 2);
+			const long d = 2 * dr * dr + 4 * dg * dg + 3 * db * db;
+			if (best < 0 || d < best) { best = d; slotOf[c] = i; }
+		}
+	}
+	out.firstSlot = firstSlot; out.slotCount = (int)used.size();
+	out.palette.resize(used.size() * 3);
+	for (int i = 0; i < (int)used.size(); ++i) for (int k = 0; k < 3; ++k) out.palette[i * 3 + k] = src.palette[used[i] * 3 + k];
+	for (const SourceFrame &f : src.frames) {
+		SpriteFrame o;
+		o.dir = f.dir; o.kind = f.kind; o.index = f.index;
+		// Edges stay anchored to the feet: scale the frame's corners.
+		const int x0 = (int)std::floor(f.dx * scale), y0 = (int)std::floor(f.dy * scale);
+		const int x1 = (int)std::ceil((f.dx + f.width) * scale), y1 = (int)std::ceil((f.dy + f.height) * scale);
+		o.dx = x0; o.dy = y0; o.width = std::max(1, x1 - x0); o.height = std::max(1, y1 - y0);
+		o.pixels.assign((size_t)o.width * o.height, 0);
+		for (int y = 0; y < o.height; ++y) {
+			const int sy = (int)std::floor((y0 + y + 0.5) / scale) - f.dy;
+			if (sy < 0 || sy >= f.height) continue;
+			for (int x = 0; x < o.width; ++x) {
+				const int sx = (int)std::floor((x0 + x + 0.5) / scale) - f.dx;
+				if (sx < 0 || sx >= f.width) continue;
+				const size_t i = (size_t)sy * f.width + sx;
+				if (f.mask[i]) o.pixels[(size_t)y * o.width + x] = (uint8_t)(firstSlot + slotOf[f.pixels[i]]);
+			}
+		}
+		out.frames.push_back(o);
+	}
+	if (out.frames.empty()) { error = "no frames"; return false; }
+	return true;
+}
+
+int SandboxSprite::frameCount(int dir, int kind) const {
+	int count = 0;
+	for (const SpriteFrame &f : frames) if (f.dir == dir && f.kind == kind) ++count;
+	return count;
+}
+
+const SpriteFrame *SandboxSprite::frame(int dir, int kind, int index) const {
+	// A missing pose falls back to standing; a missing facing to the nearest one.
+	static const int facings[kGuestDirections][4] = {
+		{kGuestLeft, kGuestFront, kGuestRight, kGuestBack}, {kGuestRight, kGuestFront, kGuestLeft, kGuestBack},
+		{kGuestFront, kGuestLeft, kGuestRight, kGuestBack}, {kGuestBack, kGuestFront, kGuestLeft, kGuestRight}};
+	static const int kinds[kGuestKinds][2] = {{kGuestStand, kGuestStand}, {kGuestWalk, kGuestStand}, {kGuestTalk, kGuestStand}};
+	if (dir < 0 || dir >= kGuestDirections || kind < 0 || kind >= kGuestKinds) return nullptr;
+	for (int k : kinds[kind]) for (int d : facings[dir]) {
+		const int count = frameCount(d, k);
+		if (!count) continue;
+		const int want = ((index % count) + count) % count;
+		for (const SpriteFrame &f : frames) if (f.dir == d && f.kind == k && f.index == want) return &f;
+	}
+	return nullptr;
+}
