+// Animation, a greeting when the player comes near, and short strolls.
+void ScummEngine::scummverseUpdateGuest(int delta, unsigned chatting) {
+	if (!worldGuestActive(_currentRoom, _scummVars[768], _scummverseWorldRoom)) return;
+	const WorldGuest *guest = worldGuestInRoom(_currentRoom);
+	Actor *a = derefActor(kZakResidentActor, "world guest");
+	if (a->_room != _currentRoom) return;
+	_scummverseGuestTick += delta;
+	const int kind = a->_moving ? 1 : getTalkingActor() == a->_number ? 2 : 0;
+	const int index = kind == 1 ? _scummverseGuestTick / 6 : kind == 2 ? _scummverseGuestTick / 9 : 0;
+	if ((worldGuestDirection(a->getFacing()) * 3 + kind) * 64 + index % 64 != _scummverseGuestShown) a->_needRedraw = true;
+	if (chatting & (1u << kZakResidentActor)) {
+		if (a->_moving) { a->stopActorMoving(); a->startAnimActor(a->_standFrame); }
+		return;
+	}
+	Actor *player = derefActor(VAR(VAR_EGO), "guest visitor");
+	const bool near = player->_room == _currentRoom && ABS(a->getPos().x - player->getPos().x) < 72 && ABS(a->getPos().y - player->getPos().y) < 32;
+	if (near && !_scummverseGuestGreeted && !VAR(VAR_HAVE_MSG) && !_scummverseAIActor) {
+		_scummverseGuestGreeted = true;
+		a->stopActorMoving();
+		a->setDirection(player->getPos().x < a->getPos().x ? 270 : 90);
+		scummverseSay(kZakResidentActor, guest->lines[_rnd.getRandomNumber(2)]);
+		_scummverseGuestIdle = 240;
+		return;
+	}
+	if (getTalkingActor() == kZakResidentActor && VAR(VAR_HAVE_MSG)) return;
+	if (a->_moving || (_scummverseGuestIdle -= delta) > 0) return;
+	// A short stroll inside the scene's walk boxes.
+	_scummverseGuestIdle = 300 + _rnd.getRandomNumber(600);
+	const int x = CLIP<int>(a->getRealPos().x + (int)_rnd.getRandomNumber(16) - 8, 1, WorldBridge::width() / 8 - 2);
+	const int y = CLIP<int>(a->getRealPos().y + (int)_rnd.getRandomNumber(8) - 4, 1, WorldBridge::height() / 2 - 1);
+	AdjustBoxResult target = a->adjustXYToBeInBox(x, y);
