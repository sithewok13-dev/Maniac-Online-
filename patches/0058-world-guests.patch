+// Renders one of the running game's costumes, with its own costume
+// renderer, in the room exported last. Each pose is drawn twice over
+// different fills: a pixel is opaque when both passes agree.
+bool ScummEngine::scummverseExportGuest(int costume, const Common::Path &file, Common::String &problem) {
+	if (costume <= 0 || costume >= _numCostumes) { problem = "costume out of range"; return false; }
+	if (_game.version >= 4 && !_res->_types[rtCostume][costume]._roomno) { problem = "costume missing"; return false; }
+	if (_game.version <= 3 && _res->_types[rtCostume][costume]._roomoffs == RES_INVALID_OFFSET) { problem = "costume missing"; return false; }
+	VirtScreen &vs = _virtscr[kMainVirtScreen];
+	const int W = _screenWidth, H = vs.h;
+	Actor *a = _actors[1];
+	a->initActor(0);
+	a->putActor(camera._cur.x, H - 4, _currentRoom);
+	a->setActorCostume(costume);
+	// Full size, unmasked, one animation step per call.
+	a->_ignoreBoxes = true; a->setScale(255, 255); a->_forceClip = 0; a->setAnimSpeed(0);
+	putClass(a->_number, kObjectClassNeverClip, true);
+	a->_visible = true;
+	const int ax = a->getPos().x - vs.xstart, ay = a->getPos().y - a->getElevation();
+	Common::Array<byte> pass[2];
+	auto capture = [&](ScummverseGuestFrame &f) {
+		for (int p = 0; p < 2; ++p) {
+			for (int y = 0; y < H; ++y) memset(vs.getPixels(0, y), p ? 255 : 254, W);
+			a->_needRedraw = true; a->drawActorCostume();
+			pass[p].resize(W * H);
+			for (int y = 0; y < H; ++y) memcpy(&pass[p][y * W], vs.getPixels(0, y), W);
+		}
+		int left = W, right = -1, top = H, bottom = -1;
+		for (int y = 0; y < H; ++y) for (int x = 0; x < W; ++x)
+			if (pass[0][y * W + x] == pass[1][y * W + x]) { left = MIN(left, x); right = MAX(right, x); top = MIN(top, y); bottom = MAX(bottom, y); }
+		if (right < 0) return false;
+		f.dx = left - ax; f.dy = top - ay; f.width = right - left + 1; f.height = bottom - top + 1;
+		f.pixels.resize(f.width * f.height); f.mask.resize(f.width * f.height);
+		for (int y = 0; y < f.height; ++y) for (int x = 0; x < f.width; ++x) {
+			const int i = (top + y) * W + left + x;
+			f.mask[y * f.width + x] = pass[0][i] == pass[1][i];
+			f.pixels[y * f.width + x] = f.mask[y * f.width + x] ? pass[0][i] : 0;
+		}
+		return true;
+	};
+	static const int facings[4] = {270, 90, 180, 0};
+	static const int kMaxFrames[3] = {1, 12, 6};
+	Common::Array<ScummverseGuestFrame> frames;
+	for (int dir = 0; dir < 4; ++dir) for (int kind = 0; kind < 3; ++kind) {
+		a->setDirection(facings[dir]);
+		a->startAnimActor(a->_standFrame); a->animateCostume();
+		if (kind) a->startAnimActor(kind == 1 ? a->_walkFrame : a->_talkStartFrame);
+		const uint first = frames.size();
+		for (int i = 0; i < kMaxFrames[kind]; ++i) {
+			ScummverseGuestFrame f;
+			if (!capture(f)) break;
+			if (i && f.sameImage(frames[first])) break; // The cycle repeats.
+			f.dir = dir; f.kind = kind; f.index = i;
+			frames.push_back(f);
+			a->animateCostume();
+		}
+	}
+	a->hideActor(); putClass(a->_number, kObjectClassNeverClip, false);
+	a->_ignoreBoxes = false;
+	if (frames.empty()) { problem = "costume draws nothing"; return false; }
+	Common::DumpFile out;
+	if (!out.open(file, true)) { problem = "cannot write cache"; return false; }
+	out.write("SVC1", 4); scummverseWrite16(out, costume); scummverseWrite16(out, frames.size());
+	out.write(_currentPalette, 768);
+	for (const auto &f : frames) {
+		out.writeByte(f.dir); out.writeByte(f.kind); out.writeByte(f.index); out.writeByte(0);
+		scummverseWrite16(out, f.dx); scummverseWrite16(out, f.dy); scummverseWrite16(out, f.width); scummverseWrite16(out, f.height);
+		out.write(f.pixels.data(), f.pixels.size()); out.write(f.mask.data(), f.mask.size());
+	}
+	out.finalize();
+	return !out.err();
+}
