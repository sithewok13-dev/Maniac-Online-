+// A character from another game: frames rendered by its own engine ("SVC1"),
+// facing left, right, the viewer or away, standing, walking or talking.
+enum GuestDirection { kGuestLeft, kGuestRight, kGuestFront, kGuestBack, kGuestDirections };
+enum GuestKind { kGuestStand, kGuestWalk, kGuestTalk, kGuestKinds };
+
+struct SourceFrame {
+	int dir = 0, kind = 0, index = 0;
+	int dx = 0, dy = 0, width = 0, height = 0;   // top left relative to the feet
+	std::vector<uint8_t> pixels, mask;           // mask 1 = opaque
+};
+
+struct SourceSprite {
+	int costume = 0;
+	uint8_t palette[768] = {};
+	std::vector<SourceFrame> frames;
+};
+
+struct SpriteFrame {
+	int dir = 0, kind = 0, index = 0;
+	int dx = 0, dy = 0, width = 0, height = 0;
+	std::vector<uint8_t> pixels;                 // 0 = transparent, else a slot
+};
+
+struct SandboxSprite {
+	int firstSlot = 0, slotCount = 0;
+	std::vector<uint8_t> palette;                // slotCount*3 RGB
+	std::vector<SpriteFrame> frames;
+	// The frame to show (exact match, else the nearest pose and facing), or null.
+	const SpriteFrame *frame(int dir, int kind, int index) const;
+	int frameCount(int dir, int kind) const;
+};
+
+// Parses an "SVC1" character file. False (with a reason) for anything malformed.
+bool parseSprite(const uint8_t *data, size_t size, SourceSprite &sprite, std::string &error);
+
+// Scales every frame (nearest pixel, so outlines stay crisp) and packs the
+// colors into slotCount slots from firstSlot (most common colors kept).
+bool fitSprite(const SourceSprite &source, double scale, int firstSlot, int slotCount,
+	SandboxSprite &out, std::string &error);
+
