+// ---- The Dig's tram -------------------------------------------------------
+// Walking to a station's ledge calls the car: it comes from the other end or
+// the tunnel and opens; it leaves once its wait is over with the player
+// aboard, together with everyone else on the ledge and the player's
+// companions, and arrives at the other end of the line. Nobody aboard: it
+// stays parked, open. One trip runs at a time (newly written lines).
+
+// Room pixels of a game's room to V1 units, as the scene is fitted (the
+// scene file's size gives its scale and centering; fitScene).
+bool ScummEngine::scummverseWorldUnits(int game, int source, int x, int y, int &ux, int &uy) const {
+	if (game < 0 || game >= worldGameCount()) return false;
+	const Common::FSNode node(scummverseWorldCache().appendComponent(Common::String::format("%s-%d.svw", kWorldGames[game].gameid, source)));
+	Common::ScopedPtr<Common::SeekableReadStream> in(node.exists() ? Common::wrapCompressedReadStream(node.createReadStream()) : nullptr);
+	byte header[10];
+	if (!in || in->read(header, sizeof(header)) != sizeof(header)) return false;
+	const int width = READ_LE_UINT16(header + 6), height = READ_LE_UINT16(header + 8);
+	if (width <= 0 || height <= 0) return false;
+	const double scale = 128.0 / height;
+	const int scaled = MAX(8, (int)floor(width * scale + 0.5)), fitted = (scaled + 7) & ~7;
+	const int pad = ((MAX(fitted, 320) - fitted) / 2) & ~7;
+	ux = (int)floor((x * scale + pad) / 8 + 0.5); uy = (int)floor(y * scale / 2 + 0.5);
+	return true;
+}
+
+bool ScummEngine::scummverseDigTramStop(int &line, int &end) const {
+	int source;
+	const int game = scummverseWorldGameOf(_currentRoom, source);
+	return game >= 0 && worldTramStop(game, source, line, end);
+}
+
+// A station's car picture ("<game>-<room>-car.svw"), mounted hidden with the scene.
+void ScummEngine::scummverseMountDigTram(int game, int source) {
+	_scummverseDigTramPicture = false;
+	_scummverseDigTramArmed = true; _scummverseDigTramBusySaid = false; // A new station: the ledge calls.
+	int line, end;
+	if (!worldTramStop(game, source, line, end)) return;
+	const Common::FSNode node(scummverseWorldCache().appendComponent(Common::String::format("%s-%d-car.svw", kWorldGames[game].gameid, source)));
+	Common::ScopedPtr<Common::SeekableReadStream> in(node.exists() ? Common::wrapCompressedReadStream(node.createReadStream()) : nullptr);
+	if (!in) return; // An older export: the car stays unseen.
+	Common::Array<byte> data; data.resize(in->size());
+	char problem[128];
+	if (in->read(data.data(), data.size()) != data.size() || !WorldBridge::mountPicture(data.data(), data.size(), problem, sizeof(problem)))
+		warning("SCUMMVERSE world: tram car not shown");
+	else { _scummverseDigTramPicture = true; _scummverseDigTramShown = 1 << 20; _scummverseDigTramAmount = 256; }
+}
+
+void ScummEngine::scummverseCallDigTram(int line, int end) {
+	const int trip = line * 2 + end + 1;
+	if (_scummVars[609]) {
+		if (_scummVars[611] == trip) { _scummverseDigTramArmed = false; return; }
+		if (!_scummverseDigTramBusySaid) scummverseAnnounce("The tram is on another run. Wait here.");
+		_scummverseDigTramBusySaid = true;
+		return;
+	}
+	_scummverseDigTramArmed = false; _scummverseDigTramBusySaid = false;
+	_scummVars[611] = trip; _scummVars[610] = 0;
+	const int parked = (_scummVars[612] >> (line * 2)) & 3;
+	if (parked == 1 + end) { _scummVars[609] = kDigTramOpen; scummverseAnnounce("The tram is here. All aboard!"); return; }
+	_scummVars[612] &= ~(3 << (line * 2));
+	_scummVars[609] = 1;
+	scummverseAnnounce("Here comes the tram.");
+}
+
+void ScummEngine::scummverseServiceDigTram(int delta) {
+	if (!_scummverseRoamingReady || !_scummVars || VAR(VAR_EGO) < 1 || VAR(VAR_EGO) >= kScummverseManiacActors) return;
+	Actor *player = derefActor(VAR(VAR_EGO), "tram passenger");
+	int line, end, source;
+	const int game = scummverseWorldGameOf(_currentRoom, source);
+	// Each approach to the ledge calls the car once (not by a rider arriving).
+	if (scummverseDigTramStop(line, end) && player->_room == _currentRoom && !(_scummVars[610] & (1u << VAR(VAR_EGO)))) {
+		const WorldTramStop &stop = kWorldTramLines[line].ends[end];
+		int lx, ly;
+		if (scummverseWorldUnits(game, source, stop.ledgeX, stop.ledgeY, lx, ly)) {
+			const AdjustBoxResult ledge = player->adjustXYToBeInBox(lx, ly);
+			const int dx = ABS(player->getRealPos().x - ledge.x), dy = ABS(player->getRealPos().y - ledge.y);
+			if (dx > 4 || dy > 6) _scummverseDigTramArmed = true;
+			else if (dx <= 2 && dy <= 3 && _scummverseDigTramArmed && !player->_moving) scummverseCallDigTram(line, end);
+		}
+	}
+	const int previous = _scummVars[609];
+	if (previous) {
+		const int phase = _scummVars[609] += MIN(delta, 60);
+		const int trip = _scummVars[611] - 1, tripLine = trip / 2, from = trip % 2;
+		const WorldTramLine &tl = kWorldTramLines[tripLine];
+		const WorldTramStop &here = tl.ends[from], &there = tl.ends[1 - from];
+		// The stations' rooms (no slot is taken for one if none holds it).
+		int origin = 0, arrival = 0;
+		for (int i = 0; i < kWorldRoomSlots; ++i) {
+			if (_scummVars[kWorldSlotVar + i] == tl.game * 1024 + here.room + 1) origin = kWorldSlotRoom + i;
+			if (_scummVars[kWorldSlotVar + i] == tl.game * 1024 + there.room + 1) arrival = kWorldSlotRoom + i;
+		}
+		int lx = 0, ly = 0;
+		const bool ledge = scummverseWorldUnits(tl.game, here.room, here.ledgeX, here.ledgeY, lx, ly);
+		auto onLedge = [&](Actor *a) {
+			const AdjustBoxResult at = a->adjustXYToBeInBox(lx, ly);
+			return ledge && a->_room == origin && ABS(a->getRealPos().x - at.x) <= 3 && ABS(a->getRealPos().y - at.y) <= 4;
+		};
+		if (previous < kDigTramOpen && phase >= kDigTramOpen && _currentRoom == origin) scummverseAnnounce("The doors open. All aboard!");
+		if (phase >= kDigTramOpen && phase <= kDigTramClose) {
+			// The player's companions come along to the ledge.
+			for (int id : mansionCast) {
+				if (scummverseRemoteActor(id) || _scummVars[770 + id] != VAR(VAR_EGO) || !onLedge(player)) continue;
+				Actor *a = derefActor(id, "tram companion");
+				if (a->_room == origin && !onLedge(a) && !a->_moving && ledge) {
+					const AdjustBoxResult to = a->adjustXYToBeInBox(lx + (id % 3) - 1, ly); a->startWalkActor(to.x, to.y, -1);
+				}
+			}
+			if (previous < kDigTramClose - 90 && phase >= kDigTramClose - 90 && _currentRoom == origin) scummverseAnnounce("Doors closing!");
+		}
+		if (previous <= kDigTramClose && phase > kDigTramClose) {
+			unsigned riders = 0;
+			for (int id : mansionCast) if (!scummverseRemoteActor(id) && onLedge(derefActor(id, "tram rider"))) riders |= 1u << id;
+			if (!(riders & (1u << VAR(VAR_EGO)))) {
+				// Not without the player: it waits here, open.
+				_scummVars[612] = (_scummVars[612] & ~(3 << (tripLine * 2))) | ((1 + from) << (tripLine * 2));
+				_scummVars[609] = _scummVars[610] = _scummVars[611] = 0;
+				scummverseShowDigTram();
+				return;
+			}
+			_scummVars[610] = riders;
+			for (int id : mansionCast) if (riders & (1u << id)) { Actor *a = derefActor(id, "tram aboard"); a->stopActorMoving(); a->hideActor(); }
+		}
+		scummverseHideDigTramRiders();
+		if (previous < kDigTramThere && phase >= kDigTramThere) {
+			// At the other end: whoever plays travels there unseen; the rest too.
+			const unsigned riders = _scummVars[610];
+			const int destination = scummverseWorldRoomFor(tl.game, there.room);
+			int tx = 0, ty = 0;
+			if (destination && scummverseWorldUnits(tl.game, there.room, there.ledgeX, there.ledgeY, tx, ty)) {
+				if (riders & (1u << VAR(VAR_EGO))) {
+					_scummverseLanding = true; scummverseTravelWorld(destination, tx, ty); _scummverseLanding = false;
+				}
+				for (int id : mansionCast) if (riders & (1u << id)) {
+					Actor *a = derefActor(id, "tram arrival"); a->stopActorMoving(); a->putActor(tx, ty, destination); a->hideActor();
+				}
+			}
+		}
+		if (phase >= kDigTramDone) {
+			const unsigned riders = _scummVars[610];
+			int ex = 0, ey = 0;
+			const bool exit = scummverseWorldUnits(tl.game, there.room, there.exitX, there.exitY, ex, ey);
+			for (int id : mansionCast) if (riders & (1u << id)) {
+				Actor *a = derefActor(id, "tram leaving");
+				if (!a->_visible && a->_room != arrival) a->showActor(); // Moved on meanwhile.
+				if (a->_room == arrival && a->_room == _currentRoom) {
+					a->showActor(); a->startAnimActor(a->_standFrame);
+					if (exit) { const AdjustBoxResult to = a->adjustXYToBeInBox(ex + (id % 5) - 2, ey); a->startWalkActor(to.x, to.y, -1); }
+				}
+				_scummverseRoamers[id] = Roamer(); _scummverseRoamers[id].wait = 600;
+			}
+			_scummVars[612] = (_scummVars[612] & ~(3 << (tripLine * 2))) | ((2 - from) << (tripLine * 2));
+			_scummVars[609] = _scummVars[610] = _scummVars[611] = 0;
+			// Getting off is not a new call (unless the player went elsewhere).
+			if ((riders & (1u << VAR(VAR_EGO))) && player->_room == arrival && arrival == _currentRoom) _scummverseDigTramArmed = false;
+		}
+	}
+	scummverseShowDigTram();
+}
+
+// Aboard is unseen, also after a load or a scene entry showed them: in the
+// station left while it leaves and rides, then in the one reached until it
+// stops. Nobody who has moved on elsewhere.
+void ScummEngine::scummverseHideDigTramRiders() {
+	const int phase = _scummVars[609], trip = _scummVars[611] - 1;
+	if (!_scummverseRoaming || phase <= kDigTramClose || phase >= kDigTramDone || trip < 0 || trip >= 2 * kWorldTramLineCount) return;
+	const WorldTramLine &tl = kWorldTramLines[trip / 2];
+	const int station = tl.ends[phase < kDigTramThere ? trip % 2 : 1 - trip % 2].room;
+	int source;
+	if (scummverseWorldGameOf(_currentRoom, source) != tl.game || source != station) return;
+	for (int id : mansionCast) if (_scummVars[610] & (1u << id)) {
+		Actor *a = derefActor(id, "tram unseen");
+		if (a->_room == _currentRoom && a->_visible) { a->stopActorMoving(); a->hideActor(); }
+	}
+}
+
+// The car in view: parked, or sliding in or out of its tunnel (a dissolve
+// where it comes toward the viewer), from the saved state.
+void ScummEngine::scummverseShowDigTram() {
+	int line, end;
+	if (!scummverseDigTramStop(line, end) || !_scummverseDigTramPicture || !WorldBridge::pictureMounted()) return;
+	const WorldTramStop &stop = kWorldTramLines[line].ends[end];
+	double shown = ((_scummVars[612] >> (line * 2)) & 3) == 1 + end ? 1 : 0;
+	const int phase = _scummVars[609], trip = _scummVars[611] - 1;
+	if (phase && trip / 2 == line) {
+		if (trip % 2 == end) {
+			shown = phase < kDigTramOpen ? (double)phase / kDigTramOpen : phase <= kDigTramClose ? 1 :
+				phase < kDigTramGone ? 1 - (double)(phase - kDigTramClose) / (kDigTramGone - kDigTramClose) : 0;
+		} else shown = phase < kDigTramThere ? 0 : MIN(1.0, (double)(phase - kDigTramThere) / (kDigTramDone - kDigTramThere));
+	}
+	const int width = WorldBridge::pictureWidth();
+	int dx = 0, amount = 256;
+	if (shown <= 0) dx = 1 << 20;
+	else if (stop.tunnel) dx = (int)(stop.tunnel * width * (1 - shown));
+	else amount = (int)(256 * shown);
+	if (dx == _scummverseDigTramShown && amount == _scummverseDigTramAmount) return;
+	_scummverseDigTramShown = dx; _scummverseDigTramAmount = amount;
+	WorldBridge::showPicture(dx, amount);
+	_fullRedraw = true;
+}
