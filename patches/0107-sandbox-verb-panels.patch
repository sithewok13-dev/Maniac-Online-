+			int x0 = boxW, y0 = boxH, x1 = 0, y1 = 0;
+			for (int y = 0; y < boxH; ++y)
+				for (int x = 0; x < boxW; ++x)
+					if (at(x, y) != none) { x0 = MIN(x0, x); y0 = MIN(y0, y); x1 = MAX(x1, x + 1); y1 = MAX(y1, y + 1); }
