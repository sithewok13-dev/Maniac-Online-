+		const int penX = 8, penY = top + 4, boxW = 64, boxH = MIN(rows, 32);
+		auto draw = [&](const byte *text) {
+			loadPtrToResource(rtVerb, sentence, text);
+			line = kept;
+			line.charset_nr = charset; line.center = false; line.curmode = 1; line.hicolor = 0; line.color = ink;
+			line.curRect.left = penX; line.curRect.top = penY; line.oldRect.left = -1;
+			drawVerb(sentence, 0);
+			_charset->setCurID(charset);
+		};
+		// (A first one loads the charset's own colours: "nothing" is none of them.)
+		const byte warm[2] = {'A', 0};
+		draw(warm);
+		int none = 255;
+		auto used = [&](int c) {
+			if (c == ink) return true;
+			for (int k = 0; k < 16; ++k) if (_charsetColorMap[k] == c) return true;
+			return false;
+		};
