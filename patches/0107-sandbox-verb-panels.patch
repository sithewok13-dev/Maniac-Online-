+namespace {
+
+struct Reader {
+	const uint8_t *p, *end;
+	bool ok = true;
+	Reader(const uint8_t *from, const uint8_t *to) : p(from), end(to) {}
+	bool need(size_t n) { if ((size_t)(end - p) < n) ok = false; return ok; }
+	int u8() { if (!need(1)) return 0; return *p++; }
+	int s8() { if (!need(1)) return 0; return (int8_t)*p++; }
+	int u16() { if (!need(2)) return 0; const int v = p[0] | p[1] << 8; p += 2; return v; }
+	int s16() { return (int16_t)(uint16_t)u16(); }
+	bool bytes(size_t n, std::vector<uint8_t> &out) { if (!need(n)) return false; out.assign(p, p + n); p += n; return true; }
+	Rect rect() { const int x = s16(), y = s16(), w = u16(), h = u16(); return Rect(x, y, w, h); }
+};
+
+bool within(const Rect &r, int width, int height) {
+	if (r.width == 0 && r.height == 0) return true;
+	return r.width > 0 && r.height > 0 && r.x >= 0 && r.y >= 0 && r.x + r.width <= width && r.y + r.height <= height;
+}
+
+} // End of anonymous namespace
+
+bool parse(const uint8_t *data, size_t size, Source &out, std::string &error) {
+	out = Source();
+	if (!data || size < 12 || std::memcmp(data, "SVI1", 4)) { error = "not a verb panel"; return false; }
+	Reader r(data + 4, data + size);
+	out.screenWidth = r.u16(); out.screenHeight = r.u16(); out.top = r.u16(); out.rows = r.u16();
+	if (out.screenWidth < 8 || out.screenWidth > 1024 || out.rows < 1 || out.rows > 480 || out.top + out.rows > out.screenHeight) { error = "bad panel size"; return false; }
+	std::vector<uint8_t> palette;
+	if (!r.bytes(768, palette) || !r.bytes((size_t)out.screenWidth * out.rows, out.pixels)) { error = "truncated panel"; return false; }
+	std::memcpy(out.palette, palette.data(), 768);
+	const int verbs = r.u8();
+	for (int i = 0; i < verbs && r.ok; ++i) {
+		Verb v;
+		v.kind = r.u8(); v.id = r.u16(); v.rect = r.rect();
+		const int length = r.u8();
+		std::vector<uint8_t> name;
+		r.bytes(length, name);
+		v.name.assign(name.begin(), name.end());
+		r.bytes((size_t)v.rect.width * v.rect.height, v.lit);
+		if (!r.ok) break;
+		if (v.kind < kWalk || v.kind > kWhatIs || !within(v.rect, out.screenWidth, out.rows)) { error = "bad verb"; return false; }
+		out.verbs.push_back(v);
+	}
+	out.sentenceX = r.s16(); out.sentenceY = r.s16();
+	out.sentenceCentred = r.u8() != 0; out.sentenceColor = r.u8();
+	out.slotKind = r.u8(); out.slotColor = r.u8(); out.slotLit = r.u8();
+	const int slots = r.u8();
+	for (int i = 0; i < slots && r.ok; ++i) {
+		const Rect s = r.rect();
+		if (!within(s, out.screenWidth, out.rows)) { error = "bad slot"; return false; }
+		out.slots.push_back(s);
+	}
+	out.up = r.rect(); out.down = r.rect();
+	out.talkColor = r.u8();
+	if (r.ok && (out.slotKind < 1 || out.slotKind > 2 || !within(out.up, out.screenWidth, out.rows) || !within(out.down, out.screenWidth, out.rows))) {
+		error = "bad inventory"; return false;
+	}
+	for (Font &f : out.fonts) {
+		f.height = r.u8(); f.ink = r.u8(); f.none = r.u8();
+		const int glyphs = r.u8();
+		for (int i = 0; i < glyphs && r.ok; ++i) {
+			const int code = r.u8();
+			Glyph g;
+			g.advance = r.u8(); g.x = r.s8(); g.y = r.s8(); g.width = r.u8(); g.height = r.u8();
+			if (!r.bytes((size_t)g.width * g.height, g.pixels)) break;
+			if (f.has[code] || g.width > 64 || g.height > 64) { error = "bad lettering"; return false; }
+			f.has[code] = true;
+			f.glyphs[code] = g;
+		}
+	}
+	if (!r.ok) { error = "truncated panel"; return false; }
+	if (r.p != r.end) { error = "truncated panel"; return false; }
+	return true;
+}
+
+Outcome decide(int kind, const Thing &thing, const std::string &name) {
+	Outcome o;
+	auto say = [&](const char *line) { o.result = kSay; o.say = line; return o; };
+	auto show = [&](int picture) { o.result = kShow; o.picture = picture; return o; };
+	const bool states = thing.pictures >= 2;
+	switch (kind) {
+	case kLook:
+	case kWhatIs:
+		o.result = kSay; o.say = name.empty() ? "Nothing special." : name;
+		if (!name.empty()) o.say[0] = (char)std::toupper((unsigned char)o.say[0]);
+		if (!name.empty() && o.say.back() != '.' && o.say.back() != '!' && o.say.back() != '?') o.say += ".";
+		return o;
+	case kPickUp:
+		if (!thing.door && states && thing.shown != 0 && thing.differs && thing.width * thing.height <= kSmallest) {
+			o.result = kTake; o.picture = 0; return o;
+		}
+		return say("I can't pick that up.");
+	case kOpen:
+	case kTurnOn:
+		if (!states) return say(kind == kOpen ? "It doesn't open." : "It doesn't turn on.");
+		if (thing.shown != 0) return say(kind == kOpen ? "It's already open." : "It's already on.");
+		return show(1);
+	case kClose:
+	case kTurnOff:
+		if (!states) return say(kind == kClose ? "It doesn't close." : "It doesn't turn off.");
+		if (thing.shown == 0) return say(kind == kClose ? "It's already closed." : "It's already off.");
+		return show(0);
+	case kPush:
+	case kPull:
+		// (Two pictures: there and not; more: through the ones showing it.)
+		if (!states) return say("It won't budge.");
+		if (thing.pictures == 2 || thing.shown == 0) return show(thing.shown ? 0 : 1);
+		return show(thing.shown % (thing.pictures - 1) + 1);
+	case kUse:
+	case kGive:
+		return say("That doesn't seem to work.");
+	case kTalk:
+		return say("It doesn't answer.");
+	default:
+		return o;
+	}
+}
+
+void Panel::clear() { *this = Panel(); }
+
+bool Panel::load(const uint8_t *data, size_t size, std::string &error) {
+	Source source;
+	if (!parse(data, size, source, error)) return false;
+	// (The things carried go with the one played, panel to panel.)
+	std::vector<Item> items = std::move(_items);
+	clear();
+	_source = std::move(source);
+	_loaded = true;
+	setItems(items);
+	return true;
+}
+
+uint32_t Panel::color(int index) const {
+	const uint8_t *c = _source.palette + 3 * (index & 255);
+	return 0xFF000000u | (uint32_t)c[0] << 16 | (uint32_t)c[1] << 8 | c[2];
+}
+
+int Panel::rowsAt(double rowScale) const { return _loaded ? (int)std::lround(_source.rows * rowScale) : 0; }
+
+void Panel::layout(int screenWidth, int screenHeight, int top, double rowScale, double colScale) {
+	_screenWidth = screenWidth; _top = top; _rowScale = rowScale; _colScale = colScale;
+	_screenRows = std::max(0, std::min(rowsAt(rowScale), screenHeight - top));
+	_columns = _loaded ? std::min(screenWidth, (int)std::lround(_source.screenWidth * colScale)) : 0;
+	_left = std::max(0, (screenWidth - _columns) / 2);
+}
+
+// The first screen pixel from `origin` that maps (as hit does) to `edge` or
+// past it.
+static int firstAt(int edge, int origin, double scale) {
+	int s = origin + (int)std::ceil(edge * scale);
+	while (s > origin && (int)((s - 1 - origin) / scale) >= edge) --s;
+	while ((int)((s - origin) / scale) < edge) ++s;
+	return s;
+}
+
+Rect Panel::onScreen(const Rect &r) const {
+	if (!_loaded || _rowScale <= 0 || _colScale <= 0 || r.width <= 0 || r.height <= 0) return Rect();
+	const int x0 = firstAt(r.x, _left, _colScale), x1 = std::min(_left + _columns, firstAt(r.x + r.width, _left, _colScale));
+	const int y0 = firstAt(r.y, _top, _rowScale), y1 = std::min(_top + _screenRows, firstAt(r.y + r.height, _top, _rowScale));
+	return Rect(x0, y0, std::max(0, x1 - x0), std::max(0, y1 - y0));
+}
+
+Panel::Hit Panel::hit(int screenX, int screenY) const {
+	Hit h;
+	if (!_loaded || screenY < _top || screenY >= _top + _screenRows) return h;
+	h.panel = true;
+	if (screenX < _left || screenX >= _left + _columns || _rowScale <= 0 || _colScale <= 0) return h;
+	const int x = std::min(_source.screenWidth - 1, (int)((screenX - _left) / _colScale));
+	const int y = std::min(_source.rows - 1, (int)((screenY - _top) / _rowScale));
+	for (size_t i = 0; i < _source.verbs.size(); ++i) if (_source.verbs[i].rect.contains(x, y)) { h.verb = (int)i; return h; }
+	if (_source.up.contains(x, y)) { h.arrow = -1; return h; }
+	if (_source.down.contains(x, y)) { h.arrow = 1; return h; }
+	for (size_t s = 0; s < _source.slots.size(); ++s)
+		if (_source.slots[s].contains(x, y) && _first + (int)s < (int)_items.size()) { h.item = _first + (int)s; return h; }
+	// (A finger is wider than the games' letters: the nearest verb a few
+	// pixels off counts, outside the slots and arrows.)
+	for (const Rect &s : _source.slots) if (s.contains(x, y)) return h;
+	int best = -1, bestAway = kVerbReach * kVerbReach + 1;
+	for (size_t i = 0; i < _source.verbs.size(); ++i) {
+		const Rect &r = _source.verbs[i].rect;
+		if (!r.width || !r.height) continue;
+		const int dx = x < r.x ? r.x - x : x >= r.x + r.width ? x - (r.x + r.width - 1) : 0;
+		const int dy = y < r.y ? r.y - y : y >= r.y + r.height ? y - (r.y + r.height - 1) : 0;
+		if (dx * dx + dy * dy < bestAway) { bestAway = dx * dx + dy * dy; best = (int)i; }
+	}
+	h.verb = best;
+	return h;
+}
+
+int Panel::kindOf(int verb) const { return verb >= 0 && verb < (int)_source.verbs.size() ? _source.verbs[verb].kind : kWalk; }
+
+int Panel::walkVerb() const {
+	for (size_t i = 0; i < _source.verbs.size(); ++i) if (_source.verbs[i].kind == kWalk) return (int)i;
+	return -1;
+}
+
+std::string Panel::verbName(int verb) const {
+	if (verb < 0 || verb >= (int)_source.verbs.size()) verb = walkVerb();
+	return verb >= 0 ? _source.verbs[verb].name : std::string("Walk to");
+}
+
+void Panel::setItems(const std::vector<Item> &items) {
+	_items = items;
+	scroll(0);
+}
+
+void Panel::scroll(int by) {
+	const int slots = (int)_source.slots.size();
+	if (!slots) { _first = 0; return; }
+	int perRow = 0;
+	for (const Rect &s : _source.slots) perRow += s.y == _source.slots[0].y;
+	perRow = std::max(1, perRow);
+	const int rows = ((int)_items.size() + perRow - 1) / perRow, shown = std::max(1, slots / perRow);
+	const int most = std::max(0, rows - shown) * perRow;
+	_first = std::max(0, std::min(most, _first + by * perRow));
+	_first -= _first % perRow;
+}
+
+int Panel::textWidth(int font, const std::string &text) const {
+	const Font &f = _source.fonts[font & 1];
+	int width = 0;
+	for (unsigned char c : text) if (f.has[c]) width += f.glyphs[c].advance;
+	return width;
+}
+
+std::vector<std::string> Panel::wrap(int font, const std::string &text, int width) const {
+	std::vector<std::string> lines;
+	std::string line, word;
+	auto flush = [&]() {
+		if (word.empty()) return;
+		const std::string joined = line.empty() ? word : line + " " + word;
+		if (!line.empty() && textWidth(font, joined) > width) { lines.push_back(line); line = word; }
+		else line = joined;
+		word.clear();
+	};
+	for (char c : text) { if (c == ' ') flush(); else word += c; }
+	flush();
+	if (!line.empty()) lines.push_back(line);
+	return lines;
+}
+
+void Panel::text(std::vector<uint32_t> &canvas, int font, const std::string &s, int x, int y, uint32_t ink, int clipRight) const {
+	const Font &f = _source.fonts[font & 1];
+	const int W = _source.screenWidth, H = _source.rows;
+	for (unsigned char c : s) {
+		if (!f.has[c]) continue;
+		const Glyph &g = f.glyphs[c];
+		for (int gy = 0; gy < g.height; ++gy)
+			for (int gx = 0; gx < g.width; ++gx) {
+				const int v = g.pixels[(size_t)gy * g.width + gx];
+				const int px = x + g.x + gx, py = y + g.y + gy;
+				if (v == f.none || px < 0 || py < 0 || px >= std::min(W, clipRight) || py >= H) continue;
+				canvas[(size_t)py * W + px] = v == f.ink ? ink : color(v);
+			}
+		x += g.advance;
+	}
+}
+
+void Panel::compose(std::vector<uint32_t> &canvas) const {
+	const int W = _source.screenWidth, H = _source.rows;
+	canvas.resize((size_t)W * H);
+	for (size_t i = 0; i < canvas.size(); ++i) canvas[i] = color(_source.pixels[i]);
+	if (_selected >= 0 && _selected < (int)_source.verbs.size()) {
+		const Verb &v = _source.verbs[_selected];
+		for (int y = 0; y < v.rect.height; ++y)
+			for (int x = 0; x < v.rect.width; ++x) canvas[(size_t)(v.rect.y + y) * W + v.rect.x + x] = color(v.lit[(size_t)y * v.rect.width + x]);
+	}
+	if (!_sentence.empty()) {
+		const int width = textWidth(0, _sentence);
+		const int x = _source.sentenceCentred ? _source.sentenceX - width / 2 : _source.sentenceX;
+		text(canvas, 0, _sentence, std::max(0, x), _source.sentenceY, color(_source.sentenceColor), W);
+	}
+	for (size_t s = 0; s < _source.slots.size(); ++s) {
+		const int i = _first + (int)s;
+		if (i >= (int)_items.size()) break;
+		const Rect &r = _source.slots[s];
+		const Item &item = _items[i];
+		if (r.width <= 0 || r.height <= 0) continue;
+		if (_source.slotKind == 1) { text(canvas, 0, item.name, r.x, r.y, color(_source.slotColor), r.x + r.width); continue; }
+		if (item.width <= 0 || item.height <= 0 || item.picture.size() != (size_t)item.width * item.height) continue;
+		// A picture fitted to its slot (smaller only), centred.
+		const double fit = std::min(1.0, std::min((double)r.width / item.width, (double)r.height / item.height));
+		const int w = std::max(1, (int)(item.width * fit)), h = std::max(1, (int)(item.height * fit));
+		const int x0 = r.x + (r.width - w) / 2, y0 = r.y + (r.height - h) / 2;
+		for (int y = 0; y < h; ++y)
+			for (int x = 0; x < w; ++x) {
+				const uint32_t c = item.picture[(size_t)std::min(item.height - 1, (int)(y / fit)) * item.width + std::min(item.width - 1, (int)(x / fit))];
+				if ((c >> 24) && x0 + x < W && y0 + y < H) canvas[(size_t)(y0 + y) * W + x0 + x] = c;
+			}
+	}
+	// Names lists show their arrows only when there is more (as the games do).
+	if (_source.slotKind == 1) {
+		const int slots = (int)_source.slots.size();
+		for (int k = 0; k < 2; ++k) {
+			const Rect &a = k ? _source.down : _source.up;
+			const bool more = k ? _first + slots < (int)_items.size() : _first > 0;
+			if (!more || !a.width) continue;
+			const uint32_t ink = color(_source.slotColor);
+			for (int y = 0; y < a.height; ++y) {
+				const int half = (k ? a.height - 1 - y : y) * a.width / (2 * std::max(1, a.height));
+				for (int x = a.width / 2 - half; x <= a.width / 2 + half; ++x)
+					if (x >= 0 && x < a.width) canvas[(size_t)(a.y + y) * W + a.x + x] = ink;
+			}
+		}
+	}
+}
+
+void Panel::render(uint32_t *screen, int pitch, int screenHeight) const {
+	if (!_loaded || !screen) return;
+	std::vector<uint32_t> canvas;
+	compose(canvas);
+	const int W = _source.screenWidth;
+	for (int row = _top; row < std::min(screenHeight, _top + _screenRows); ++row) {
+		uint32_t *out = screen + (size_t)row * pitch;
+		const int y = std::min(_source.rows - 1, (int)((row - _top) / _rowScale));
+		for (int x = 0; x < _screenWidth; ++x) {
+			if (x < _left || x >= _left + _columns) { out[x] = 0xFF000000u; continue; }
+			out[x] = canvas[(size_t)y * W + std::min(W - 1, (int)((x - _left) / _colScale))];
+		}
+	}
+}
+
+void Panel::say(uint32_t *screen, int pitch, int screenWidth, int limit, const std::string &text, int centreX, int bottomY,
+	double rowScale, double colScale, uint32_t ink) const {
+	if (!_loaded || !screen || rowScale <= 0 || colScale <= 0) return;
+	const Font &f = _source.fonts[1];
+	const std::vector<std::string> lines = wrap(1, text, _source.screenWidth * 3 / 4);
+	const int lineHeight = std::max(1, f.height);
+	int y = bottomY - (int)std::lround(lines.size() * lineHeight * rowScale);
+	y = std::max(0, y);
+	for (const std::string &line : lines) {
+		const int width = (int)std::lround(textWidth(1, line) * colScale);
+		double pen = std::max(0, std::min(screenWidth - width, centreX - width / 2));
+		for (unsigned char c : line) {
+			if (!f.has[c]) continue;
+			const Glyph &g = f.glyphs[c];
+			for (int gy = 0; gy < g.height; ++gy)
+				for (int gx = 0; gx < g.width; ++gx) {
+					const int v = g.pixels[(size_t)gy * g.width + gx];
+					if (v == f.none) continue;
+					const uint32_t c2 = v == f.ink ? ink : color(v);
+					const int x0 = (int)std::lround(pen + (g.x + gx) * colScale), x1 = (int)std::lround(pen + (g.x + gx + 1) * colScale);
+					const int y0 = (int)std::lround(y + (g.y + gy) * rowScale), y1 = (int)std::lround(y + (g.y + gy + 1) * rowScale);
+					for (int py = std::max(0, y0); py < std::min(limit, y1); ++py)
+						for (int px = std::max(0, x0); px < std::min(screenWidth, x1); ++px) screen[(size_t)py * pitch + px] = c2;
+				}
+			pen += g.advance * colScale;
+		}
+		y += (int)std::lround(lineHeight * rowScale);
+	}
+}
+
+} // End of namespace Panel
+
+namespace PanelBridge {
+
+namespace {
+Panel::Panel &panel() { static Panel::Panel p; return p; }
+int copy(const std::string &text, char *out, int capacity) {
+	if (out && capacity > 0) { std::strncpy(out, text.c_str(), capacity - 1); out[capacity - 1] = 0; }
+	return (int)text.size();
+}
+} // End of anonymous namespace
+
+bool load(const unsigned char *data, size_t size, char *error, int capacity) {
+	std::string problem;
+	if (panel().load(data, size, problem)) return true;
+	unload();
+	copy(problem, error, capacity);
+	return false;
+}
+void unload() {
+	std::vector<Panel::Item> items = panel().items();
+	panel().clear();
+	panel().setItems(items);
+}
+void clear() { panel().clear(); }
+bool loaded() { return panel().loaded(); }
+int rows() { return panel().loaded() ? panel().source().rows : 0; }
+int columns() { return panel().loaded() ? panel().source().screenWidth : 0; }
+int rowsAt(double rowScale) { return panel().rowsAt(rowScale); }
+void layout(int screenWidth, int screenHeight, int top, double rowScale, double colScale) { panel().layout(screenWidth, screenHeight, top, rowScale, colScale); }
+int top() { return panel().top(); }
+int screenRows() { return panel().screenRows(); }
+int hit(int screenX, int screenY, int &index) {
+	const Panel::Panel::Hit h = panel().hit(screenX, screenY);
+	index = -1;
+	if (!h.panel) return 0;
+	if (h.verb >= 0) { index = h.verb; return 2; }
+	if (h.item >= 0) { index = h.item; return 3; }
+	if (h.arrow) { index = h.arrow; return 4; }
+	return 1;
+}
+void select(int verb) { panel().select(verb); }
+int selected() { return panel().selected(); }
+int verbCount() { return (int)panel().source().verbs.size(); }
+int verbKind(int verb) { return panel().kindOf(verb); }
+int walkVerb() { return panel().walkVerb(); }
+int verbName(int verb, char *name, int capacity) { return copy(panel().verbName(verb), name, capacity); }
+bool verbShown(int verb) { return verb >= 0 && verb < verbCount() && panel().source().verbs[verb].rect.width > 0; }
+static bool screenRect(const Panel::Rect &source, int &x, int &y, int &width, int &height) {
+	const Panel::Rect r = panel().onScreen(source);
+	x = r.x; y = r.y; width = r.width; height = r.height;
+	return width > 0 && height > 0;
+}
+bool verbRect(int verb, int &x, int &y, int &width, int &height) {
+	return verbShown(verb) && screenRect(panel().source().verbs[verb].rect, x, y, width, height);
+}
+int slotCount() { return (int)panel().source().slots.size(); }
+bool slotRect(int slot, int &x, int &y, int &width, int &height) {
+	return slot >= 0 && slot < slotCount() && screenRect(panel().source().slots[slot], x, y, width, height);
+}
+void sentence(const char *text) { panel().setSentence(text ? text : ""); }
+int sentenceText(char *text, int capacity) { return copy(panel().sentence(), text, capacity); }
+int itemCount() { return (int)panel().items().size(); }
+int itemName(int item, char *name, int capacity) {
+	return copy(item >= 0 && item < itemCount() ? panel().items()[item].name : std::string(), name, capacity);
+}
+bool addItem(const unsigned char *scene, size_t size, int id, const char *name, int picture) {
+	World::SourceScene source;
+	std::string problem;
+	if (!World::parseScene(scene, size, source, problem)) return false;
+	for (const World::SourceObject &o : source.objects) {
+		if (o.id != id || o.pictures.empty()) continue;
+		// Its picture as the place showed it (the one asked, else the one
+		// shown, else its last).
+		const int k = picture > 0 && picture < (int)o.pictures.size() ? picture : o.shown > 0 ? o.shown : (int)o.pictures.size() - 1;
+		Panel::Item item;
+		item.name = name ? name : o.name;
+		item.width = o.pictureWidth; item.height = o.pictureHeight;
+		const std::vector<uint8_t> &without = o.pictures[0], &with = o.pictures[k];
+		for (size_t i = 0; i < with.size(); ++i) {
+			const uint8_t *c = source.palette + 3 * with[i];
+			// (Only what differs from the place without it: the thing itself.)
+			item.picture.push_back(with[i] == without[i] && k != 0 ? 0u : 0xFF000000u | (uint32_t)c[0] << 16 | (uint32_t)c[1] << 8 | c[2]);
+		}
+		std::vector<Panel::Item> items = panel().items();
+		items.push_back(item);
+		panel().setItems(items);
+		return true;
+	}
+	return false;
+}
+void removeItem(int item) {
+	std::vector<Panel::Item> items = panel().items();
+	if (item < 0 || item >= (int)items.size()) return;
+	items.erase(items.begin() + item);
+	panel().setItems(items);
+}
+void clearItems() { panel().setItems(std::vector<Panel::Item>()); }
+void scroll(int by) { panel().scroll(by); }
+int firstItem() { return panel().firstItem(); }
+void render(unsigned int *screen, int pitch, int screenHeight) { panel().render(screen, pitch, screenHeight); }
+void say(unsigned int *screen, int pitch, int screenWidth, int limit, const char *text, int centreX, int bottomY, double rowScale, double colScale) {
+	if (!panel().loaded() || !text) return;
+	panel().say(screen, pitch, screenWidth, limit, text, centreX, bottomY, rowScale, colScale, panel().color(panel().source().talkColor));
+}
+int decide(int kind, bool door, int pictures, int shown, bool differs, int width, int height, const char *name, int &picture, char *say, int capacity) {
+	Panel::Thing t;
+	t.door = door; t.pictures = pictures; t.shown = shown; t.differs = differs; t.width = width; t.height = height;
+	const Panel::Outcome o = Panel::decide(kind, t, name ? name : "");
+	picture = o.picture;
+	copy(o.say, say, capacity);
+	return o.result;
+}
+
+} // End of namespace PanelBridge
+} // End of namespace Scummverse
diff --git a/common/scummverse_panel.h b/common/scummverse_panel.h
new file mode 100644
index 00000000..043e6d4b
--- /dev/null
+++ b/common/scummverse_panel.h
@@ -0,0 +1,144 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Scummverse sandbox: a game's verb panel (step 2c), portable C++11. A panel
+// file ("<game>-ui.svi", written by the SCUMM engine from the game's own
+// start, see engines/scumm/scummverse_world_export.inc) holds the panel as
+// the game draws it, its verbs (each also highlighted), its sentence line,
+// its inventory's slots and arrows and its lettering. The panel is shown
+// under the scene at the scene's scale; a tap on it picks a verb or a thing
+// carried. `decide` says what a verb does to a thing in the scene: the
+// games' own scripts do not run here, so the same plain rules hold for all.
+#ifndef COMMON_SCUMMVERSE_PANEL_H
+#define COMMON_SCUMMVERSE_PANEL_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string>
+#include <vector>
+
+namespace Scummverse {
+namespace Panel {
+
+// What a verb does (the catalog's WorldVerbKind).
+enum VerbKind {
+	kWalk = 1, kLook, kPickUp, kOpen, kClose, kPush, kPull, kUse, kGive, kTalk, kTurnOn, kTurnOff, kWhatIs
+};
+
+struct Rect {
+	int x = 0, y = 0, width = 0, height = 0;
+	Rect() {}
+	Rect(int x_, int y_, int w, int h) : x(x_), y(y_), width(w), height(h) {}
+	bool contains(int px, int py) const { return width > 0 && height > 0 && px >= x && py >= y && px < x + width && py < y + height; }
+};
+// A character as the game draws it from the pen (x, y the top left of its
+// pixels; `none` where nothing is drawn, `ink` the text's own colour).
+struct Glyph { int advance = 0, x = 0, y = 0, width = 0, height = 0; std::vector<uint8_t> pixels; };
+struct Font {
+	int height = 0, ink = 0, none = 0;
+	bool has[256] = {};
+	Glyph glyphs[256];
+};
+// A verb on the panel (no rectangle: one only named, as walking is in the
+// later games); `lit` is its rectangle drawn highlighted.
+struct Verb { int kind = 0, id = 0; Rect rect; std::string name; std::vector<uint8_t> lit; };
+struct Source {
+	int screenWidth = 0, screenHeight = 0, top = 0, rows = 0;
+	uint8_t palette[768] = {};
+	std::vector<uint8_t> pixels; // screenWidth * rows palette indices
+	std::vector<Verb> verbs;
+	int sentenceX = 0, sentenceY = 0, sentenceColor = 0;
+	bool sentenceCentred = false;
+	int slotKind = 0; // 1: names, 2: pictures
+	int slotColor = 0, slotLit = 0;
+	std::vector<Rect> slots;
+	Rect up, down; // the inventory's arrows (from the panel's own when its slots hold names)
+	int talkColor = 0;
+	Font fonts[2]; // the sentence line's, the talk's
+};
+// Bytes of an "SVI1" file (uncompressed); false (with `error`) when malformed.
+bool parse(const uint8_t *data, size_t size, Source &out, std::string &error);
+
+// A thing carried: its name and picture (0xAARRGGBB, width * height).
+struct Item { std::string name; int width = 0, height = 0; std::vector<uint32_t> picture; };
+
+// A thing in the scene a verb is used on: a door of the game's map; how many
+// pictures it has (0, or 1 + its states: 0 is the place without it) and the
+// one shown; whether picture 0 looks different from the one shown; its size.
+struct Thing { bool door = false; int pictures = 0, shown = 0; bool differs = false; int width = 0, height = 0; };
+enum Result { kNothing = 0, kSay, kShow, kTake };
+// kSay: `say`; kShow: picture `picture`; kTake: into the inventory, the
+// place then shows picture 0.
+struct Outcome { int result = kNothing; int picture = -1; std::string say; };
+// The plain rules: look (and "what is") names it; open and turn on show
+// picture 1 when it shows none, close and turn off picture 0; push and pull
+// switch one with two pictures, else step through those showing it; pick
+// up takes what is small, shown and not a door; the rest is said not to work.
+Outcome decide(int kind, const Thing &thing, const std::string &name);
+// Things up to this size can be picked up (source pixels, the games' own
+// small things: about a fifth of the screen each way).
+static const int kSmallest = 64 * 64;
+// A tap this near a verb (panel pixels) is for it.
+static const int kVerbReach = 6;
+
+class Panel {
+public:
+	bool load(const uint8_t *data, size_t size, std::string &error); // (keeps the things carried)
+	void clear();
+	bool loaded() const { return _loaded; }
+	const Source &source() const { return _source; }
+	// Under the scene from screen row `top`: `rowScale` screen rows a panel
+	// row, `colScale` screen columns a column, its columns centred on a
+	// screen `screenWidth` wide (its rows kept on a screen `screenHeight` tall).
+	void layout(int screenWidth, int screenHeight, int top, double rowScale, double colScale);
+	int top() const { return _top; }
+	int screenRows() const { return _screenRows; }
+	// The rows on screen it takes at a scale.
+	int rowsAt(double rowScale) const;
+	// A rectangle of the panel on screen.
+	Rect onScreen(const Rect &source) const;
+	// What a tap is on: a verb, a slot (its item's number) or an arrow
+	// (-1 up, 1 down); nothing: all -1 / 0.
+	struct Hit { int verb = -1, item = -1, arrow = 0; bool panel = false; };
+	Hit hit(int screenX, int screenY) const;
+	// The verb chosen (an index into source().verbs; -1: walking).
+	void select(int verb) { _selected = verb; }
+	int selected() const { return _selected; }
+	int kindOf(int verb) const;
+	// The verb walking is (its name for the sentence line), -1 if none.
+	int walkVerb() const;
+	std::string verbName(int verb) const;
+	void setSentence(const std::string &text) { _sentence = text; }
+	const std::string &sentence() const { return _sentence; }
+	void setItems(const std::vector<Item> &items);
+	const std::vector<Item> &items() const { return _items; }
+	int firstItem() const { return _first; }
+	void scroll(int by); // by a row of slots
+	// The panel's rows of a screen of 0xAARRGGBB (`pitch` pixels a row).
+	void render(uint32_t *screen, int pitch, int screenHeight) const;
+	// The panel at its own size (screenWidth * rows), as render scales it.
+	void compose(std::vector<uint32_t> &canvas) const;
+	// Text in the game's lettering: its width (source pixels), and lines of
+	// at most `width` source pixels.
+	int textWidth(int font, const std::string &text) const;
+	std::vector<std::string> wrap(int font, const std::string &text, int width) const;
+	// Speech: lines in the talk lettering, centred on `centreX`, the last
+	// ending at `bottomY` (screen pixels), at the scene's scale, kept on a
+	// screen screenWidth by screenHeight (rows below `limit` untouched).
+	void say(uint32_t *screen, int pitch, int screenWidth, int limit, const std::string &text, int centreX, int bottomY,
+		double rowScale, double colScale, uint32_t ink) const;
+	uint32_t color(int index) const;
+
+private:
+	void text(std::vector<uint32_t> &canvas, int font, const std::string &s, int x, int y, uint32_t ink, int clipRight) const;
+	Source _source;
+	bool _loaded = false;
+	int _screenWidth = 0, _top = 0, _screenRows = 0, _left = 0, _columns = 0;
+	double _rowScale = 1, _colScale = 1;
+	int _selected = -1, _first = 0;
+	std::string _sentence;
+	std::vector<Item> _items;
+};
+
+} // End of namespace Panel
+} // End of namespace Scummverse
+
+#endif
