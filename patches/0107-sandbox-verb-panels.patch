+	}
+	// Nothing carried: the inventory as it is when empty (the game's own
+	// inventory script draws it).
+	const int ego = VAR_EGO != 0xFF ? VAR(VAR_EGO) : 0;
+	for (int n = 0; n < 64 && ego; ++n) {
+		const int obj = findInventory(ego, 1);
+		if (obj <= 0) break;
+		setOwnerOf(obj, 0);
+	}
+	frames(30, frame);
+	_scummverseMusicTimer = -1;
+	if (most < 4 || verbsUp() < 4 || shouldQuit()) { problem = "its verbs never showed"; return false; }
+	const int W = _screenWidth, top = vs.topline, rows = MIN<int>(vs.h, _screenHeight - top);
+	if (rows <= 0 || vs.w < W) { problem = "no verb screen"; return false; }
+	auto at = [&](int x, int y) -> byte & { return *((byte *)vs.getPixels(x, y)); };
