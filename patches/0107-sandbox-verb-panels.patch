+// SPDX-License-Identifier: GPL-3.0-or-later
+// Scummverse sandbox verb panel: engine-facing bridge (plain types only) for
+// the sandbox engine (engines/scummverse). Holds the panel of the game on
+// stage and the things carried. See common/scummverse_panel.h.
+#ifndef COMMON_SCUMMVERSE_PANEL_ENGINE_H
+#define COMMON_SCUMMVERSE_PANEL_ENGINE_H
+
+#include <stddef.h>
+
+namespace Scummverse {
+namespace PanelBridge {
+
+// A panel (bytes of one .svi file, uncompressed); false (with `error`), and
+// no panel, when malformed. The things carried stay (also through unload,
+// no panel); clear drops them too.
+bool load(const unsigned char *data, size_t size, char *error, int capacity);
+void unload();
+void clear();
+bool loaded();
+int rows();    // its own rows (0: none)
+int columns(); // its own columns (the game's screen width)
+int rowsAt(double rowScale);
+// Under the scene from screen row `top`, at the scene's scale, kept on screen.
+void layout(int screenWidth, int screenHeight, int top, double rowScale, double colScale);
+int top();
+int screenRows();
+// A tap: 0 not on the panel, 1 on it (nothing there), 2 a verb, 3 a thing
+// carried, 4 an arrow (`index` -1 up, 1 down).
+int hit(int screenX, int screenY, int &index);
+// The verb chosen (-1: walking) and the verbs (their kinds as the catalog's
+// WorldVerbKind; shown: on the panel).
+void select(int verb);
+int selected();
+int verbCount();
+int verbKind(int verb);
+bool verbShown(int verb);
+// Where a verb and an inventory slot are on screen (false: not shown).
+bool verbRect(int verb, int &x, int &y, int &width, int &height);
+int slotCount();
+bool slotRect(int slot, int &x, int &y, int &width, int &height);
+int walkVerb();
+int verbName(int verb, char *name, int capacity);
+void sentence(const char *text);
+int sentenceText(char *text, int capacity);
+// Things carried: one more from a scene (bytes of its .svw, uncompressed),
+// the object `id` in its picture `picture` (else as that place shows it);
+// false when it has no picture.
+bool addItem(const unsigned char *scene, size_t size, int id, const char *name, int picture = -1);
+int itemCount();
+int itemName(int item, char *name, int capacity);
+void removeItem(int item);
+void clearItems();
+void scroll(int by);
+int firstItem();
+// The panel's rows of a screen of 0xAARRGGBB, `pitch` pixels a row.
+void render(unsigned int *screen, int pitch, int screenHeight);
+// Speech in the game's talk lettering and the player's talk colour,
+// centred on `centreX`, ending at `bottomY`, rows from `limit` on untouched.
+void say(unsigned int *screen, int pitch, int screenWidth, int limit, const char *text, int centreX, int bottomY, double rowScale, double colScale);
+// What verb `kind` does to a thing in the scene (Panel::decide): 0 nothing,
+// 1 say `say`, 2 show `picture`, 3 take it (the place then shows picture 0).
+int decide(int kind, bool door, int pictures, int shown, bool differs, int width, int height, const char *name, int &picture, char *say, int capacity);
+
+} // End of namespace PanelBridge
+} // End of namespace Scummverse
+
+#endif
