+	image.resize(W * rows);
+	for (int y = 0; y < rows; ++y) for (int x = 0; x < W; ++x) image[y * W + x] = at(x, y);
+	// The verbs, each also drawn highlighted; walking is named even where it
+	// is not on the panel (a tap).
+	struct Verb { int kind, id, x, y, width, height; Common::String name; Common::Array<byte> lit; };
+	Common::Array<Verb> verbs;
+	for (int i = 1; i < _numVerbs; ++i) {
+		VerbSlot &v = _verbs[i];
+		const int kind = worldVerbKind(gameIndex, v.verbid);
