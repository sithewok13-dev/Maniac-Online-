+	// emptied as the game empties them.
+	int sentence = -1;
+	for (int i = 1; i < _numVerbs; ++i) if (_verbs[i].verbid == panel->sentence && onPanel(_verbs[i])) sentence = i;
+	if (sentence < 0) { problem = "no sentence line"; return false; }
