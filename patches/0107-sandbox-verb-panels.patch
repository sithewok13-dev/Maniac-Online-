+		verb.x = verb.y = verb.width = verb.height = 0;
+		// (Its own letters: the later games' lettering joins some, "oo".)
+		const byte *name = getResourceAddress(rtVerb, i);
+		for (const byte *c = name; c && *c && verb.name.size() < 32; ++c) {
+			if (*c == 0xFF || *c == 0xFE) { // (an escape, its code and any two bytes it carries)
