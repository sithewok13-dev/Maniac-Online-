+// advance, int8 x, y (from the pen), u8 width, height and its pixels.
+bool ScummEngine::scummverseExportPanel(int gameIndex, const Common::Path &file, Common::String &problem) {
+	const WorldPanel *panel = worldPanel(gameIndex);
+	if (!panel) { problem = "no verb panel"; return false; }
+	// (Mac Indiana Jones draws its verbs in a window of its own, FM Towns on
+	// a layer of its own: not here.)
+	if ((_macGui && _game.id == GID_INDY3) || _game.platform == Common::kPlatformFMTowns) { problem = "its verbs are drawn elsewhere"; return false; }
+	// The game's own start, run on at once: no waits, speech or cutscenes,
+	// the music's clock moving with the frames (an opening waits on it), a
+	// typed answer where it asks for one (any passes, as the engine has
+	// it), until its verbs are up and stay so. As a start: no scripts,
+	// cutscenes or overrides left from the places' export, no room to leave.
+	for (uint i = 0; i < NUM_SCRIPT_SLOT; ++i) { vm.slot[i].status = ssDead; vm.slot[i].cutsceneOverride = 0; vm.slot[i].freezeCount = 0; }
+	_currentScript = 0xFF; vm.cutSceneStackPointer = 0; vm.cutSceneScriptIndex = 0xFF;
+	memset(vm.cutScenePtr, 0, sizeof(vm.cutScenePtr)); memset(vm.cutSceneScript, 0, sizeof(vm.cutSceneScript)); memset(vm.cutSceneData, 0, sizeof(vm.cutSceneData));
+	_EXCD_offs = 0;
+	if (_game.id == GID_MONKEY2 && _game.platform == Common::kPlatformMacintosh && _bootParam == -7873 && !verifyMI2MacBootScript()) _bootParam = 0;
+	int args[NUM_SCRIPT_LOCAL];
+	memset(args, 0, sizeof(args));
+	args[0] = _bootParam;
+	runScript(1, 0, 0, args);
+	VirtScreen &vs = _virtscr[kVerbVirtScreen];
+	auto onPanel = [&](const VerbSlot &v) { return v.curRect.top >= vs.topline && v.curRect.top < _screenHeight; };
+	auto verbsUp = [&]() {
+		int up = 0;
+		for (int i = 1; i < _numVerbs; ++i)
+			up += _verbs[i].verbid && _verbs[i].curmode && worldVerbKind(gameIndex, _verbs[i].verbid) && onPanel(_verbs[i]);
