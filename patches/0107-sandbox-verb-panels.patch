+	VerbSlot &line = _verbs[sentence];
+	const VerbSlot kept = line;
+	Common::Array<byte> keptName;
+	for (const byte *c = getResourceAddress(rtVerb, sentence); c && *c; ++c) keptName.push_back(*c);
+	keptName.push_back(0);
+	const int ink = line.color;
+	auto letters = [&](int charset, Font &font) {
+		const byte *resource = charset >= 0 && charset < _numCharsets ? getResourceAddress(rtCharset, charset) : nullptr;
