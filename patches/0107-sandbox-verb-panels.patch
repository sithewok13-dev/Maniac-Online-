+// Every game's verb panel: under its first place at the scene's scale, each
+// verb chosen by a tap (the sentence line naming it) and let go by another;
+// then, on the things there, by a tap on the verb and one on the thing
+// (walked to first): looking names it (the line said, then gone), open then
+// close, push, pick up (into the inventory, gone from the place, not to be
+// used again; the thing carried looked at by a tap on its slot), picking up
+// a door is refused, and out of reach nothing is done; all kept through the
+// state file. A picture of each panel in use.
+Common::Error SandboxEngine::verbsTest() {
+	int panels = 0, verbs = 0, chosen = 0, failed = 0;
+	int looked = 0, opened = 0, closed = 0, pushed = 0, taken = 0, refused = 0, unreached = 0, items = 0, gone = 0;
+	auto fail = [&](const char *what, int g) { ++failed; warning("SCUMMVERSE sandbox verbs: %s: %s", kWorldGames[g].gameid, what); };
+	auto tapRect = [&](int x, int y, int w, int h) { tap(x + w / 2, y + h / 2); };
+	auto settle = [&]() { for (int t = 0; t < 40000 && (StageBridge::moving(_player) || _action); ++t) step(1); };
+	auto verbOf = [&](int kind) {
+		for (int v = 0; v < PanelBridge::verbCount(); ++v) if (PanelBridge::verbKind(v) == kind && PanelBridge::verbShown(v)) return v;
+		return -1;
+	};
+	// A verb used on an object: false when the panel has no such verb or a
+	// tap on the object's middle is for another one.
+	auto use = [&](int kind, int object) {
+		const int v = verbOf(kind);
+		int x, y, w, h, id, ox, oy, ow, oh, wx, wy, state, sx, sy;
+		if (v < 0 || !PanelBridge::verbRect(v, x, y, w, h) || !StageBridge::object(object, id, ox, oy, ow, oh, wx, wy, state)) return false;
+		tapRect(x, y, w, h);
+		StageBridge::lookAt(ox + ow / 2.0);
+		StageBridge::toScreen(ox + ow / 2.0, oy + oh / 2.0, sx, sy);
+		if (sx < 0 || sx >= _width || sy < 0 || sy >= PanelBridge::top()) { PanelBridge::select(-1); return false; }
+		tap(sx, sy);
+		if (_target != object) { _action = 0; _target = -1; return false; }
+		settle();
+		return true;
+	};
+	for (int g = 0; g < worldGameCount(); ++g) {
+		int room;
+		Common::Array<byte> ui;
+		if (!firstPlace(g, room) || !read(Common::String::format("%s-ui.svi", kWorldGames[g].gameid), ui)) continue;
+		for (const WorldLead &l : kWorldLeads) if (l.game == g && hasCharacter(worldAppearanceKey(g, l.costume))) _playerKey = worldAppearanceKey(g, l.costume);
+		Common::String problem;
+		if (!enter(g, room, 0, problem) || !PanelBridge::loaded()) { fail("no panel", g); continue; }
+		++panels;
+		int left, top, width, height;
+		double rowScale, colScale;
+		StageBridge::view(left, top, width, height, rowScale, colScale);
+		if (PanelBridge::top() != top + height || PanelBridge::top() + PanelBridge::screenRows() > _height) fail("not under the scene", g);
+		// Each verb chosen, then let go.
+		int shownVerbs = 0;
+		for (int v = 0; v < PanelBridge::verbCount(); ++v) {
+			int x, y, w, h;
+			if (!PanelBridge::verbRect(v, x, y, w, h)) continue;
+			++shownVerbs; ++verbs;
+			tapRect(x, y, w, h);
+			char name[40], said[160];
+			PanelBridge::verbName(v, name, sizeof(name));
+			PanelBridge::sentenceText(said, sizeof(said));
+			const bool walk = PanelBridge::verbKind(v) == kWorldVerbWalk;
+			if ((walk ? PanelBridge::selected() != -1 : PanelBridge::selected() != v) || strcmp(said, name)) fail("a verb not chosen", g);
+			else ++chosen;
+			if (!walk) tapRect(x, y, w, h);
+			if (PanelBridge::selected() != -1) fail("a verb not let go", g);
+		}
+		if (shownVerbs < 9) fail("fewer than nine verbs", g);
+		Common::Array<int> things;
+		for (int o = 0; o < StageBridge::objectCount(); ++o) if (isThing(o)) things.push_back(o);
+		auto facts = [&](int o, int &id, int &pictures, int &shown, bool &door, bool &small) {
+			int ox, oy, w, h, wx, wy, state;
+			StageBridge::object(o, id, ox, oy, w, h, wx, wy, state);
+			pictures = StageBridge::objectPictures(o); shown = StageBridge::objectShown(o);
+			door = worldLinkFrom(g, room, id) != nullptr;
+			small = w * h <= 64 * 64;
+		};
+		// Looking (the first thing a tap finds): it is named; the line goes,
+		// and the screen is drawn again then.
+		for (int o : things) {
+			if (!use(kWorldVerbLook, o) && !use(kWorldVerbWhatIs, o)) continue;
+			if (_speech.empty()) { fail("looking said nothing", g); break; }
+			++looked;
+			_dirty = false;
+			for (int t = 0; t < 600 && !_speech.empty(); ++t) step(1);
+			if (_speech.empty() && _dirty) ++gone; else fail("a line not gone", g);
+			break;
+		}
+		// Open then close (one that shows none of its pictures), push.
+		for (int o : things) {
+			int id, pictures, shown; bool door, small;
+			facts(o, id, pictures, shown, door, small);
+			if (pictures < 2 || shown != 0 || !StageBridge::picturesDiffer(o, 0, 1) || !use(kWorldVerbOpen, o)) continue;
+			if (StageBridge::objectShown(o) != 1) { fail("not opened", g); break; }
+			++opened;
+			if (!use(kWorldVerbClose, o)) { fail("not closed", g); break; }
+			if (StageBridge::objectShown(o) != 0) fail("not closed", g); else ++closed;
+			break;
+		}
+		for (int o : things) {
+			int id, pictures, shown; bool door, small;
+			facts(o, id, pictures, shown, door, small);
+			if (pictures < 2 || !use(kWorldVerbPush, o)) continue;
+			if (StageBridge::objectShown(o) != (shown + 1) % pictures) fail("not pushed", g); else ++pushed;
+			break;
+		}
+		// Picking up: something small (into the inventory, gone from here); a
+		// door is refused.
+		for (int o : things) {
+			int id, pictures, shown; bool door, small;
