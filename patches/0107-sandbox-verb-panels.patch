+			const Common::Rect drawn = v.oldRect.left != -1 ? v.oldRect : v.curRect;
+			const int x0 = CLIP<int>(drawn.left, 0, W), x1 = CLIP<int>(drawn.right, x0, W);
+			const int y0 = CLIP<int>(drawn.top - top, 0, rows), y1 = CLIP<int>(drawn.bottom - top, y0, rows);
+			verb.x = x0; verb.y = y0; verb.width = x1 - x0; verb.height = y1 - y0;
+			for (int y = y0; y < y1; ++y) for (int x = x0; x < x1; ++x) verb.lit.push_back(at(x, y));
+			drawVerb(i, 0);
+		}
+		// (One shown wins over one only named.)
+		bool replaced = false;
+		for (Verb &k : verbs) if (k.kind == verb.kind && !k.width && verb.width) { k = verb; replaced = true; }
+		if (!replaced) for (const Verb &k : verbs) replaced = replaced || k.kind == verb.kind;
+		if (!replaced) verbs.push_back(verb);
+	}
+	_charset->setCurID(_verbs[sentence].charset_nr);
+	const int lineHeight = _charset->getFontHeight();
+	// Rectangles on the panel (else none).
+	struct SlotRect { int x, y, width, height; };
+	auto within = [&](SlotRect r) { return r.width > 0 && r.height > 0 && r.x >= 0 && r.y >= 0 && r.x + r.width <= W && r.y + r.height <= rows ? r : SlotRect{0, 0, 0, 0}; };
+	auto rectOf = [&](int slot, int &x, int &y, int &w, int &h) {
+		const VerbSlot &v = _verbs[slot];
+		x = v.curRect.left; y = v.curRect.top - top;
+		w = v.curRect.right - v.curRect.left; h = v.curRect.bottom - v.curRect.top;
+		return v.curmode && w > 0 && h > 0 && onPanel(v);
+	};
+	// The inventory's arrows: as shown; a names list shows its own only
+	// when there is more: where they go.
+	SlotRect arrows[2] = {{0, 0, 0, 0}, {0, 0, 0, 0}};
+	for (int k = 0; k < 2; ++k) {
+		const int id = k ? panel->down : panel->up;
+		for (int i = 1; i < _numVerbs; ++i)
+			if (_verbs[i].verbid == id) {
+				int x, y, w, h;
+				if (rectOf(i, x, y, w, h)) arrows[k] = within(SlotRect{x, y, w, h});
+				else if (!panel->pictures) arrows[k] = within(SlotRect{x, y, 8, lineHeight});
+				break;
+			}
+	}
+	// The slots: where each is (a hidden one takes the first shown one's
+	// size, or a line of the sentence's lettering to the edge).
+	int slotW = 0, slotH = 0;
+	for (int slot : slots) { int x, y, w, h; if (slot > 0 && !slotW && rectOf(slot, x, y, w, h)) { slotW = w; slotH = h; } }
+	Common::Array<SlotRect> slotRects;
+	for (int slot : slots) {
+		SlotRect r = {0, 0, 0, 0};
+		int w, h;
+		if (slot > 0) {
+			const bool shown = rectOf(slot, r.x, r.y, w, h);
+			r.width = panel->pictures ? (shown ? w : slotW) : W - r.x;
