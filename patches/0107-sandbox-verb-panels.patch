+	for (int i = 1; i < _numVerbs; ++i) if (action(_verbs[i])) ++counts[_verbs[i].color];
+	int usual = 0;
+	for (int c = 1; c < 256; ++c) if (counts[c] > counts[usual]) usual = c;
