+			if (door || !small || pictures < 2 || shown == 0 || !StageBridge::picturesDiffer(o, 0, shown)) continue;
+			const int before = PanelBridge::itemCount();
+			if (!use(kWorldVerbPickUp, o)) continue;
+			if (PanelBridge::itemCount() != before + 1 || StageBridge::objectShown(o) != 0) { fail("not taken", g); break; }
+			++taken;
+			// Not there to be used again.
+			if (use(kWorldVerbPickUp, o) || use(kWorldVerbOpen, o)) fail("used again once taken", g);
+			// Looked at in its slot.
+			const int look = verbOf(kWorldVerbLook) >= 0 ? verbOf(kWorldVerbLook) : verbOf(kWorldVerbWhatIs);
+			int x, y, w, h;
+			const int slot = PanelBridge::itemCount() - 1 - PanelBridge::firstItem();
+			if (look >= 0 && PanelBridge::verbRect(look, x, y, w, h)) {
+				tapRect(x, y, w, h);
+				char name[80];
+				PanelBridge::itemName(PanelBridge::itemCount() - 1, name, sizeof(name));
+				if (PanelBridge::slotRect(slot, x, y, w, h)) {
