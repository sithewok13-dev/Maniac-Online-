+		// Out of reach (from the farthest spot): nothing done.
+		double xs[12], ys[12];
+		const int spots = StageBridge::spots(12, xs, ys);
+		for (int o : things) {
+			int id, pictures, shown; bool door, small;
+			facts(o, id, pictures, shown, door, small);
+			if (pictures < 2 || door || !spots) continue;
+			int ox, oy, w, h, wx, wy, state;
+			StageBridge::object(o, id, ox, oy, w, h, wx, wy, state);
+			int far = 0;
+			double farthest = -1;
+			for (int k = 0; k < spots; ++k) {
+				const double d = (xs[k] - (ox + w / 2.0)) * (xs[k] - (ox + w / 2.0)) + (ys[k] - (oy + h / 2.0)) * (ys[k] - (oy + h / 2.0));
+				if (d > farthest) { farthest = d; far = k; }
+			}
+			const double reach = 2 * kDoorReach * screenWidthOf(g) / 320.0 + MAX(w, h);
+			if (farthest <= reach * reach) continue;
+			StageBridge::place(_player, xs[far], ys[far]);
+			_action = kWorldVerbOpen; _target = o;
+			act();
+			if (_speech != "I can't reach that." || StageBridge::objectShown(o) != shown) fail("done out of reach", g); else ++unreached;
+			break;
+		}
+		for (int o : things) {
+			int id, pictures, shown; bool door, small;
+			facts(o, id, pictures, shown, door, small);
+			if (!door || !use(kWorldVerbPickUp, o)) continue;
+			if (_speech != "I can't pick that up." || PanelBridge::itemCount() != (int)_carried.size()) fail("a door taken", g); else ++refused;
+			break;
+		}
+		// The panel in use: a verb chosen, the sentence, what is carried.
+		const int look = verbOf(kWorldVerbLook);
+		if (look >= 0) { PanelBridge::select(look); char name[40]; PanelBridge::verbName(look, name, sizeof(name)); sentence(name); }
+		present();
+		if (ConfMan.hasKey("scummverse_shots")) shot(Common::String::format("verbs-%s.png", kWorldGames[g].gameid));
+		PanelBridge::select(-1);
+	}
+	// Kept: the state saved and loaded back.
+	if (_game >= 0) {
+		const uint carried = _carried.size(), pictures = _pictures.size();
+		saveState();
+		_carried.clear(); _pictures.clear(); PanelBridge::clearItems();
+		int game, room;
+		double x, y;
+		if (!loadState(game, room, x, y) || _carried.size() != carried || _pictures.size() != pictures || PanelBridge::itemCount() != (int)carried) fail("not kept", _game);
+		// The place again: what was taken stays gone.
+		Common::String problem;
+		for (const Carried &c : _carried) {
+			if (!enter(c.game, c.room, 0, problem)) { fail("not shown again", c.game); continue; }
+			for (int o = 0; o < StageBridge::objectCount(); ++o) {
+				int id, ox, oy, w, h, wx, wy, state;
+				if (StageBridge::object(o, id, ox, oy, w, h, wx, wy, state) && id == c.id && StageBridge::objectShown(o) != 0) fail("back again", c.game);
+			}
+		}
+	}
+	g_system->updateScreen();
+	warning("SCUMMVERSE sandbox selftest verbs: %d panels, %d verbs (%d chosen), %d looked at (%d lines gone), %d opened, %d closed, %d pushed, %d taken (%d looked at carried), %d refused, %d out of reach, %d carried, %d failed",
+		panels, verbs, chosen, looked, gone, opened, closed, pushed, taken, items, refused, unreached, (int)_carried.size(), failed);
+	// (Each panel looked through; each kind of use seen at least once.)
+	if (!panels || failed || looked != panels || chosen != verbs || !opened || closed != opened || !pushed || !taken || items != taken || !refused || !unreached)
+		return Common::Error(Common::kUnknownError, "sandbox selftest failed");
+	warning("SCUMMVERSE sandbox selftest PASS");
+	return Common::kNoError;
+}
