+// From 0306 the "verbs" check's (see verbsTest): Sam & Max's Max as a
+// player plays him, as its things file has him. Max (35), whom its start
+// gives Sam in room 1, which no place exports (kWorldStartThings): a damaged
+// state's given-so value (kWorldStartGiven) at 2 let go first; nothing
+// carried, a place of it shown while self-testing (as the other checks run:
+// none given), then as a player has it: Max carried by his name, once, his
+// picture in the box its things file's icon (drawn as the pointer when held);
+// through a save and a load; another place shown, not given again, nor once
+// he is gone. Max held from the box as the pointer through its own controls
+// (its use pointer chosen in the box, the box opened from its button, a tap
+// on his cell) and used on the dead guy of the street (room 9, actor 4, his
+// cast's costume 51: its local script 205, read with descumm, nothing
+// copied): its lines said in turn, the carnival tickets (95) carried by
+// their own picture, Max kept; through a save and a load; used on him again,
+// the tickets not carried twice. Before, Max was never carried, and none of
+// his uses could be played.
+SandboxEngine::SamnmaxThings SandboxEngine::samnmaxThingsPlayed() {
+	SamnmaxThings c;
+	const Common::HashMap<int, int> picturesKept = _pictures, touchedKept = _touched, keptKept = _kept;
+	const Common::Array<Carried> carriedKept = _carried;
+	const int wasGame = _game, wasRoom = _room;
+	Common::String problem;
+	int g = -1;
+	for (int k = 0; k < worldGameCount(); ++k) if (sameId(kWorldGames[k].gameid, "samnmax")) g = k;
+	if (g >= 0) loadThings(g);
+	auto fresh = [&]() {
+		_carried.clear(); PanelBridge::clearItems(); forgetThings(); _going = Going(); _holding = Pair(); _pairing = Pair();
+		_saying.clear(); _speech.clear(); _notice.clear(); _speechClock = _noticeClock = 0; _kept.clear();
+		PanelBridge::open(false); PanelBridge::select(-1);
+	};
+	auto settle = [&]() { for (int t = 0; t < 40000 && (StageBridge::moving(_player) || _action || !_saying.empty() || _going.room); ++t) step(1); };
+	const char *what = "";
+	auto check = [&](bool ok, const char *how) {
+		if (!ok) { ++c.failed; warning("SCUMMVERSE sandbox Sam & Max's things: %s: %s", what, how); }
+		return ok;
+	};
+	auto carriedAt = [&](int room, int id) {
+		for (uint n = 0; n < _carried.size(); ++n) if (_carried[n].game == g && _carried[n].room == room && _carried[n].id == id) return (int)n;
+		return -1;
+	};
+	auto carriedCount = [&](int room, int id) {
+		int n = 0;
+		for (const Carried &k : _carried) n += k.game == g && k.room == room && k.id == id;
+		return n;
+	};
+	auto saved = [&]() {
+		saveState();
+		fresh();
+		int sg, sr;
+		double sx, sy;
+		return loadState(sg, sr, sx, sy);
+	};
+	// (As a player has it: its start's things given on showing one of its
+	// places.)
+	auto shownAsPlayed = [&](int room) {
+		_startGiving = true;
+		const bool ok = enter(g, room, 0, problem);
+		_startGiving = false;
+		return ok;
+	};
+	const WorldStartThing *maxRow = g >= 0 ? worldStartThing(g, 35) : nullptr;
+	auto maxOnce = [&]() { const int k = maxRow ? carriedAt(maxRow->room, 35) : -1; return k >= 0 && carriedCount(maxRow->room, 35) == 1 && !_carried[k].name.empty(); };
+	// (Held as a player holds it: its use pointer chosen in the box, then the
+	// box opened from its button and a tap on his cell.)
+	auto holdIt = [&](int item) {
+		int x, y, w, h, bx, by, bw, bh;
+		_holding = Pair(); _pairing = Pair(); PanelBridge::open(false); PanelBridge::select(-1);
+		int use = -1;
+		for (int v = 0; v < PanelBridge::verbCount(); ++v) if (PanelBridge::verbKind(v) == kWorldVerbUse) use = v;
+		if (use < 0 || !PanelBridge::buttonRect(bx, by, bw, bh)) return false;
+		tap(bx + bw / 2, by + bh / 2);
+		if (!PanelBridge::isOpen() || !PanelBridge::verbRect(use, x, y, w, h)) return false;
+		tap(x + w / 2, y + h / 2);
+		if (PanelBridge::pointerVerb() != use) return false;
+		tap(bx + bw / 2, by + bh / 2);
+		if (!PanelBridge::isOpen()) return false;
+		for (int turn = 0; turn < 64 && item - PanelBridge::firstItem() >= PanelBridge::slotCount(); ++turn) PanelBridge::scroll(1);
+		if (!PanelBridge::slotRect(item - PanelBridge::firstItem(), x, y, w, h)) return false;
+		tap(x + w / 2, y + h / 2);
+		return _holding.kind == kWorldVerbUse && _holding.item == item && PanelBridge::heldItem() == item && !PanelBridge::isOpen();
+	};
+	// (Drawn as the pointer: his picture where the pointer is, not the
+	// pointer's own.)
+	auto pictureDrawn = [&](int item) {
+		int x, y, w, h;
+		if (_pointerX < 0 || PanelBridge::heldItem() != item || !PanelBridge::controlsBounds(_width, _height, _pointerX, _pointerY, true, x, y, w, h) || w <= 0 || h <= 0) return false;
+		Common::Array<uint32> withIt(_width * _height, 0), without(_width * _height, 0);
+		PanelBridge::renderControls(withIt.data(), _width, _width, _height, _pointerX, _pointerY, true);
+		PanelBridge::holdItem(-1);
+		PanelBridge::renderControls(without.data(), _width, _width, _height, _pointerX, _pointerY, true);
+		PanelBridge::holdItem(item);
+		bool differs = false;
+		for (int r = y; r < y + h && !differs; ++r) differs = memcmp(&withIt[r * _width + x], &without[r * _width + x], w * sizeof(uint32)) != 0;
+		return differs;
+	};
