 // One list for drawing and VoiceOver labels, in airport/pad command order.
 static const char *const scummverseFlightNames[]={"MANIAC MANSION","SAN FRANCISCO","SEATTLE","MIAMI","ZAIRE","KATHMANDU NEPAL","CAIRO","LONDON","MEXICO CITY","LIMA PERU"};
 // Original crystal-map sites, in engine pad order (commands 50+).
 static const char *const scummversePadNames[]={"SEATTLE","MEXICO","PERU","EGYPT","MARS"};
 static const int scummversePadCount=sizeof(scummversePadNames)/sizeof(scummversePadNames[0]);
+// The pads also reach otherworldly places of the installed other worlds:
+// each named place and story area of these games whose scene is exported.
+static const struct { const char *gameid, *label; } scummversePadWorlds[]={{"dig","DIG"},{"loom","LOOM"},{"atlantis","ATLANTIS"}};
+struct ScummversePad { std::string label; int command, request; }; // Zak site: token-bound command; other world: place request.
+static std::vector<ScummversePad> scummversePads() {
+	std::vector<ScummversePad> pads;
+	for (int i=0;i<scummversePadCount;++i) pads.push_back({scummversePadNames[i],50+i,0});
+	NSString *documents=NSSearchPathForDirectoriesInDomains(NSDocumentDirectory, NSUserDomainMask, YES).firstObject;
+	NSFileManager *fm=[NSFileManager defaultManager];
+	for (const auto &world : scummversePadWorlds) {
+		const Scummverse::WorldCatalog::WorldGame *game=Scummverse::WorldCatalog::worldGame(world.gameid);
+		if(!game) continue;
+		const int index=(int)(game-Scummverse::WorldCatalog::kWorldGames);
+		auto add=[&](int room,const char *name) {
+			if(![fm fileExistsAtPath:[NSString stringWithFormat:@"%@/worlds/%s-%d.svw",documents,game->gameid,room]]) return;
+			std::string label=std::string(world.label)+" "+name;
+			for(char &c : label) c=(char)toupper((unsigned char)c);
+			pads.push_back({label.substr(0,34),0,Scummverse::WorldCatalog::worldPlaceRequest(index,room)});
+		};
+		for(int i=0;i<game->sceneCount;++i) add(game->scenes[i].room,game->scenes[i].name);
+		if(const auto *map=Scummverse::WorldCatalog::worldMap(index)) for(int i=0;i<map->areaCount;++i) add(map->areas[i].room,map->areas[i].name);
+	}
+	return pads;
+}
