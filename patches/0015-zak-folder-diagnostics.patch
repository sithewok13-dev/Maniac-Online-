 // User-selected Zak resource import. GPL-3.0-or-later. No game data bundled.
 // Import into a new private directory before publishing its relative name.
+static NSString *scummverseZakFolderReport(NSURL *selected, NSString *result) {
+	NSFileManager *fm = [NSFileManager defaultManager];
+	NSURL *documents = [[fm URLsForDirectory:NSDocumentDirectory inDomains:NSUserDomainMask] firstObject];
+	NSMutableString *report = [NSMutableString stringWithFormat:@"SCUMMVERSE folder diagnostic v1\nResult: %@\nBundle: %@\nHome: %@\nDocuments: %@\nEngine Documents: %s\nWorking directory: %@\nSelected: %@\n", result, [NSBundle mainBundle].bundleIdentifier, NSHomeDirectory(), documents.path, iOS7_getDocumentsDir().c_str(), fm.currentDirectoryPath, selected.path];
+	for (NSURL *directory in @[documents, selected]) {
+		NSError *error = nil;
+		NSArray<NSURL *> *children = [fm contentsOfDirectoryAtURL:directory includingPropertiesForKeys:nil options:0 error:&error];
+		[report appendFormat:@"\nListing %@ (%lu entries):\n", directory.path, (unsigned long)children.count];
+		if (!children) [report appendFormat:@"%@\n", error];
+		NSUInteger count = 0;
+		for (NSURL *child in children) {
+			if (++count > 150) { [report appendString:@"Listing truncated at 150 entries.\n"]; break; }
+			NSError *attributeError = nil;
+			NSDictionary *attributes = [fm attributesOfItemAtPath:child.path error:&attributeError];
+			[report appendFormat:@"name=%@ UTF8=%@ type=%@ bytes=%@ error=%@\n", child.lastPathComponent, [child.lastPathComponent dataUsingEncoding:NSUTF8StringEncoding], attributes[NSFileType], attributes[NSFileSize], attributeError];
+		}
+	}
+	NSError *writeError = nil;
+	[report writeToURL:[documents URLByAppendingPathComponent:@"SCUMMVERSE-folder-report.txt"] atomically:YES encoding:NSUTF8StringEncoding error:&writeError];
+	if (writeError) [report appendFormat:@"\nCould not save report: %@\n", writeError];
+	return report;
+}
