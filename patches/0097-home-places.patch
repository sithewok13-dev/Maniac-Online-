+// The Other worlds menu's Maniac Mansion and Zak McKracken: their places as
+// the tour visits them (a run of numbered places, such as a maze's cells, by
+// its first), to go to directly.
+void ScummEngine::scummverseHomePlacesOffer(bool zak) {
+	const int kind = zak ? kTourZak : kTourManiac;
+	if (_scummverseTouring) { scummverseSay(VAR(VAR_EGO), "Let's stop the tour first."); return; }
+	if (zak && !scummverseMountZak()) {
+		if (_scummverseWorldNotice.empty()) _scummverseWorldNotice = "Zak's files are not set up. Put them in Documents/zak and restart the app.";
+		scummverseWorldReport(_scummverseWorldNotice.c_str()); scummverseSay(VAR(VAR_EGO), _scummverseWorldNotice.c_str());
+		return;
+	}
+	scummverseTourBuild();
+	::scummversePlacesBegin(zak ? "Zak McKracken" : "Maniac Mansion");
+	Common::Array<Common::String> named;
+	for (const auto &stop : _scummverseTourStops) {
+		// (Not the plane or the van in flight: they are rides, not places.)
+		if (stop.kind != kind || (zak && (stop.room == 56 || stop.room == 221))) continue;
+		Common::String name;
+		if (kind == kTourManiac) {
+			for (const auto &r : kTourManiacRooms) if (r.room == stop.room) name = r.name;
+			if (!name.empty()) name.setChar(toupper(name[0]), 0);
+		} else {
+			const char *place = stop.room == 53 ? "San Francisco airport" : stop.room == 54 ? "Zak's apartment" : stop.room == 55 ? "13th Avenue (Zak's street)" : zakSceneName(stop.room);
+			if (place) name = place;
+		}
+		while (!name.empty() && (Common::isDigit(name.lastChar()) || name.lastChar() == ' ')) name.deleteLastChar();
+		if (name.empty() || name.contains("(retired)")) continue;
+		bool seen = false;
+		for (const auto &n : named) if (n == name) seen = true;
+		if (seen) continue;
+		named.push_back(name);
+		::scummversePlacesItem(name.c_str(), worldPlaceRequest(zak ? kWorldZakPlaces : kWorldManiacPlaces, stop.room));
+	}
+	::scummversePlacesShow();
+}
+bool ScummEngine::scummverseTravelHome(bool zak, int room) {
+	if (_scummverseTouring) { scummverseSay(VAR(VAR_EGO), "Let's stop the tour first."); return false; }
+	if (zak) return scummverseTourZakRoom(room);
+	for (const auto &r : kTourManiacRooms) if (r.room == room) {
+		_scummverseWorldNotice.clear();
+		if (scummverseTourPlace(r.room, r.x, r.y)) {
+			Common::String name(r.name); name.setChar(toupper(name[0]), 0);
+			_scummverseWorldNotice = "Maniac Mansion: " + name + ".";
+			return true;
+		}
+		if (_scummverseWorldNotice.empty()) scummverseSay(VAR(VAR_EGO), "I can't get there from here.");
+		return false;
+	}
+	return false;
+}
