+
+// A list of places (scummversePlacesBegin/Item/Show), filled in order on the
+// main queue and shown over the game.
+static NSString *scummversePlacesTitle;
+static NSMutableArray *scummversePlaces;
+void scummversePlacesBegin(const char *title) {
+	NSString *name = [[NSString alloc] initWithUTF8String:title ? title : ""];
+	dispatch_async(dispatch_get_main_queue(), ^{
+		[scummversePlacesTitle release]; scummversePlacesTitle = name;
+		if (!scummversePlaces) scummversePlaces = [[NSMutableArray alloc] init];
+		[scummversePlaces removeAllObjects];
+	});
+}
+void scummversePlacesItem(const char *name, int request) {
+	if (!name || !*name) return;
+	NSString *place = [[NSString alloc] initWithUTF8String:name];
+	dispatch_async(dispatch_get_main_queue(), ^{
+		if (place) [scummversePlaces addObject:@[place, @(request)]];
+		[place release];
+	});
+}
+static void scummversePlacesPresent(int tries) {
+	UIResponder *responder = [iOS7AppDelegate iPhoneView];
+	while (responder && ![responder isKindOfClass:UIViewController.class]) responder = responder.nextResponder;
+	UIViewController *controller = (UIViewController *)responder;
+	if (!controller || !scummversePlaces.count) return;
+	if (controller.presentedViewController) {
+		if (tries > 0) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.6 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ scummversePlacesPresent(tries - 1); });
+		return;
+	}
+	ScummverseCastPeopleController *list = [[[ScummverseCastPeopleController alloc] initWithPeople:scummversePlaces title:scummversePlacesTitle screen:nil] autorelease];
+	UINavigationController *navigation = [[[UINavigationController alloc] initWithRootViewController:list] autorelease];
+	navigation.modalPresentationStyle = UIModalPresentationFormSheet;
+	[controller presentViewController:navigation animated:YES completion:nil];
+}
+void scummversePlacesShow() {
+	dispatch_async(dispatch_get_main_queue(), ^{ scummversePlacesPresent(5); });
+}
