+// A game's story, the original game in its own engine (the Worlds menu's
+// Play the original games, as Maniac's): this place kept, then that game,
+// from its newest save; leaving it brings the mansion back where it was
+// when this engine was opened (base/main.cpp's home rule). Its way back here
+// is dropped: a story goes on only with nothing queued after it.
+void SandboxEngine::openStory(int game) {
+	if (game < 0 || game >= worldGameCount()) return;
+	const WorldGame &story = kWorldGames[game];
+	const Common::String target = Common::String(kWorldStoryPrefix) + story.gameid;
+	// (A folder added since the app started gets its target now; the
+	// mansion's own story was set up as the app started.)
+	if (!ConfMan.hasGameDomain(target) && !::Scummverse::addStoryTarget(story)) {
+		say(Common::String::format("I need its files in Documents/%s first.", story.folder));
+		return;
+	}
+	Common::String missing = ::Scummverse::storyMissing(story.gameid, ConfMan.getPath("path", target));
+	if (!missing.empty()) {
+		missing.toUppercase();
+		say(Common::String::format("It needs all of its files in Documents/%s: %s is missing.", story.folder, missing.c_str()));
+		return;
+	}
+	if (!_testing) saveState();
+	Common::String next;
+	int slot;
+	while (ChainedGamesMan.pop(next, slot)) {}
+	ChainedGamesMan.push(target);
+	warning("SCUMMVERSE sandbox: opening %s", target.c_str());
+	Common::Event event;
+	event.type = Common::EVENT_RETURN_TO_LAUNCHER;
+	g_system->getEventManager()->pushEvent(event);
+}
