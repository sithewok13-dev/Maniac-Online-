+// SPDX-License-Identifier: GPL-3.0-or-later
+// Scummverse other worlds: portable scene loader. See scummverse_world.h.
+#define FORBIDDEN_SYMBOL_ALLOW_ALL
+
+#include "common/scummverse_world.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <deque>
+#include <unordered_map>
+
+namespace Scummverse {
+namespace World {
+
+static int read16(const uint8_t *p) { return p[0] | (p[1] << 8); }
+static int readS16(const uint8_t *p) { return (int16_t)(uint16_t)read16(p); }
+
+bool parseScene(const uint8_t *data, size_t size, SourceScene &scene, std::string &error) {
+	scene = SourceScene();
+	if (!data || size < 12 + 768 || std::memcmp(data, "SVW1", 4)) { error = "not a scene file"; return false; }
+	scene.room = read16(data + 4); scene.width = read16(data + 6); scene.height = read16(data + 8);
+	const int boxes = data[10];
+	if (scene.width < 8 || scene.width > 4096 || scene.height < 8 || scene.height > 480) { error = "bad scene size"; return false; }
+	const size_t pixels = (size_t)scene.width * scene.height;
+	if (size != 12 + 768 + pixels + (size_t)boxes * 18) { error = "truncated scene"; return false; }
+	std::memcpy(scene.palette, data + 12, 768);
+	scene.pixels.assign(data + 12 + 768, data + 12 + 768 + pixels);
+	const uint8_t *p = data + 12 + 768 + pixels;
+	for (int i = 0; i < boxes; ++i, p += 18) {
+		SourceBox box;
+		for (int c = 0; c < 4; ++c) { box.x[c] = readS16(p + c * 4); box.y[c] = readS16(p + c * 4 + 2); }
+		box.flags = p[16]; box.mask = p[17];
+		scene.boxes.push_back(box);
+	}
+	return true;
+}
+
+// ---- Box geometry (V2 units) ---------------------------------------------
+
+struct Pt { double x, y; };
+static void polygon(const V2Box &b, Pt out[4]) {
+	out[0] = {(double)b.ulx, (double)b.uy}; out[1] = {(double)b.urx, (double)b.uy};
+	out[2] = {(double)b.lrx, (double)b.ly}; out[3] = {(double)b.llx, (double)b.ly};
+}
+static double segmentDistance(Pt p, Pt a, Pt b) {
+	const double dx = b.x - a.x, dy = b.y - a.y, len = dx * dx + dy * dy;
+	double t = len > 0 ? ((p.x - a.x) * dx + (p.y - a.y) * dy) / len : 0;
+	t = std::max(0.0, std::min(1.0, t));
+	const double ex = a.x + t * dx - p.x, ey = a.y + t * dy - p.y;
+	return std::sqrt(ex * ex + ey * ey);
+}
+static bool inside(Pt p, const V2Box &b) {
+	if (p.y < b.uy || p.y > b.ly) return false;
+	const double t = b.ly == b.uy ? 0 : (p.y - b.uy) / (double)(b.ly - b.uy);
+	const double left = b.ulx + (b.llx - b.ulx) * t, right = b.urx + (b.lrx - b.urx) * t;
+	return p.x >= left - 1e-9 && p.x <= right + 1e-9;
+}
+static bool touching(const V2Box &a, const V2Box &b) {
+	Pt pa[4], pb[4]; polygon(a, pa); polygon(b, pb);
+	for (int i = 0; i < 4; ++i) if (inside(pa[i], b) || inside(pb[i], a)) return true;
+	double best = 1e9;
+	for (int i = 0; i < 4; ++i) for (int j = 0; j < 4; ++j) {
+		best = std::min(best, segmentDistance(pa[i], pb[j], pb[(j + 1) % 4]));
+		best = std::min(best, segmentDistance(pb[i], pa[j], pa[(j + 1) % 4]));
+	}
+	return best <= 1.0;
+}
+
+std::vector<int8_t> routeBoxes(const std::vector<V2Box> &boxes) {
+	const int n = (int)boxes.size();
+	std::vector<int8_t> next((size_t)n * n, -1);
+	std::vector<std::vector<int>> links(n);
+	for (int i = 0; i < n; ++i) for (int j = i + 1; j < n; ++j)
+		if (touching(boxes[i], boxes[j])) { links[i].push_back(j); links[j].push_back(i); }
+	for (int from = 0; from < n; ++from) {
+		std::vector<int> first(n, -1); first[from] = from;
+		std::deque<int> queue; queue.push_back(from);
+		while (!queue.empty()) {
+			const int at = queue.front(); queue.pop_front();
+			for (int to : links[at]) if (first[to] < 0) { first[to] = at == from ? to : first[at]; queue.push_back(to); }
+		}
+		for (int to = 0; to < n; ++to) next[(size_t)from * n + to] = (int8_t)(to == from ? from : first[to]);
+	}
+	return next;
+}
+
+// ---- Fitting ------------------------------------------------------------
+
+bool fitScene(const SourceScene &src, int targetHeight, int firstSlot, int slotCount, SandboxScene &out, std::string &error, int minWidth) {
+	out = SandboxScene();
+	if (src.width <= 0 || src.height <= 0 || (int)src.pixels.size() != src.width * src.height) { error = "empty scene"; return false; }
+	if (targetHeight < 8 || targetHeight % 8 || firstSlot < 0 || slotCount < 1 || firstSlot + slotCount > 256) { error = "bad target"; return false; }
+	const double scale = (double)targetHeight / src.height;
+	const int scaledWidth = std::max(8, (int)std::lround(src.width * scale));
+	const int fitted = (scaledWidth + 7) & ~7;
+	const int width = std::max(fitted, (minWidth + 7) & ~7);
+	// Narrow scenes are centered on whole 8-pixel columns.
+	const int pad = ((width - fitted) / 2) & ~7;
+	if (width / 8 > 255) { error = "scene too wide"; return false; }
+
+	// Colors in use, most common first; they keep their exact RGB values.
+	std::vector<long> frequency(256, 0);
+	for (uint8_t c : src.pixels) ++frequency[c];
+	std::vector<int> used;
+	for (int c = 0; c < 256; ++c) if (frequency[c]) used.push_back(c);
+	std::stable_sort(used.begin(), used.end(), [&](int a, int b) { return frequency[a] > frequency[b]; });
+	if ((int)used.size() > slotCount) used.resize(slotCount);
+	auto rgb = [&](int c, int k) { return (int)src.palette[c * 3 + k]; };
+	std::unordered_map<int, int> nearestCache;
+	auto nearest = [&](int r, int g, int b) {
+		const int key = (r << 16) | (g << 8) | b;
+		auto hit = nearestCache.find(key);
+		if (hit != nearestCache.end()) return hit->second;
+		int best = 0; long bestDistance = -1;
+		for (int i = 0; i < (int)used.size(); ++i) {
+			const long dr = r - rgb(used[i], 0), dg = g - rgb(used[i], 1), db = b - rgb(used[i], 2);
+			const long d = 2 * dr * dr + 4 * dg * dg + 3 * db * db;
+			if (bestDistance < 0 || d < bestDistance) { best = i; bestDistance = d; }
+		}
+		nearestCache[key] = best;
+		return best;
+	};
+	std::vector<int> slotOf(256, -1);
+	for (int i = 0; i < (int)used.size(); ++i) slotOf[used[i]] = i;
+
+	out.width = width; out.height = targetHeight; out.firstSlot = firstSlot; out.slotCount = (int)used.size();
+	out.pixels.assign((size_t)width * targetHeight, 0);
+	out.palette.resize(used.size() * 3);
+	for (int i = 0; i < (int)used.size(); ++i) for (int k = 0; k < 3; ++k) out.palette[i * 3 + k] = src.palette[used[i] * 3 + k];
+	// 16-color art (dithered EGA) keeps its pattern with point sampling;
+	// richer art is area-averaged and snapped back to its own colors.
+	const bool pointSample = frequency.size() && std::count_if(frequency.begin(), frequency.end(), [](long f) { return f > 0; }) <= 16;
+	out.padLeft = pad;
+	int darkest = 0;
+	for (int i = 1; i < (int)used.size(); ++i)
+		if (rgb(used[i], 0) + rgb(used[i], 1) + rgb(used[i], 2) < rgb(used[darkest], 0) + rgb(used[darkest], 1) + rgb(used[darkest], 2)) darkest = i;
+	std::fill(out.pixels.begin(), out.pixels.end(), (uint8_t)(firstSlot + darkest));
+	for (int oy = 0; oy < targetHeight; ++oy) {
+		const double y0 = oy / scale, y1 = (oy + 1) / scale;
+		for (int ox = 0; ox < fitted; ++ox) {
+			const int sx = std::min(ox, scaledWidth - 1);
+			const double x0 = sx / scale, x1 = (sx + 1) / scale;
+			int slot;
+			if (pointSample) {
+				const int px = std::min(src.width - 1, (int)((x0 + x1) / 2)), py = std::min(src.height - 1, (int)((y0 + y1) / 2));
+				const int c = src.pixels[(size_t)py * src.width + px];
+				slot = slotOf[c] >= 0 ? slotOf[c] : nearest(rgb(c, 0), rgb(c, 1), rgb(c, 2));
+			} else {
+				double r = 0, g = 0, b = 0, area = 0;
+				for (int y = (int)y0; y < (int)std::ceil(y1) && y < src.height; ++y) {
+					const double wy = std::min(y1, y + 1.0) - std::max(y0, (double)y);
+					if (wy <= 0) continue;
+					for (int x = (int)x0; x < (int)std::ceil(x1) && x < src.width; ++x) {
+						const double wx = std::min(x1, x + 1.0) - std::max(x0, (double)x);
+						if (wx <= 0) continue;
+						const int c = src.pixels[(size_t)y * src.width + x];
+						r += rgb(c, 0) * wx * wy; g += rgb(c, 1) * wx * wy; b += rgb(c, 2) * wx * wy; area += wx * wy;
+					}
+				}
+				if (area <= 0) area = 1;
+				slot = nearest((int)std::lround(r / area), (int)std::lround(g / area), (int)std::lround(b / area));
+			}
+			out.pixels[(size_t)oy * width + pad + ox] = (uint8_t)(firstSlot + slot);
+		}
+	}
+
+	// Boxes: scale, then V1 units (x/8, y/2). Disabled boxes are dropped.
+	auto ux = [&](int x) { return std::max(0, std::min(255, (int)std::lround((x * scale + pad) / 8))); };
+	auto uy = [&](int y) { return std::max(0, std::min(targetHeight / 2, (int)std::lround(y * scale / 2))); };
+	for (const SourceBox &b : src.boxes) {
+		if (b.flags & 0x80) continue;
+		V2Box v;
+		v.uy = uy(std::min(b.y[0], b.y[1])); v.ly = uy(std::max(b.y[2], b.y[3]));
+		v.ulx = ux(b.x[0]); v.urx = ux(b.x[1]); v.lrx = ux(b.x[2]); v.llx = ux(b.x[3]);
+		if (v.ulx > v.urx) std::swap(v.ulx, v.urx);
+		if (v.llx > v.lrx) std::swap(v.llx, v.lrx);
+		if (v.uy > v.ly) { std::swap(v.uy, v.ly); std::swap(v.ulx, v.llx); std::swap(v.urx, v.lrx); }
+		v.mask = 0; v.flags = 0;
+		out.boxes.push_back(v);
+		if ((int)out.boxes.size() == 120) break; // Fits the one-byte box offset layout.
+	}
+	out.next = routeBoxes(out.boxes);
+	// Spawn in the biggest box; edges where walking reaches the room sides.
+	double bestArea = -1;
+	for (const V2Box &v : out.boxes) {
+		const double area = ((v.urx - v.ulx) + (v.lrx - v.llx) + 2) * (v.ly - v.uy + 1) / 2.0;
+		if (area > bestArea) { bestArea = area; out.spawnX = (v.ulx + v.urx + v.llx + v.lrx) / 4; out.spawnY = (v.uy + v.ly) / 2; }
+		const int left = std::min(v.ulx, v.llx), right = std::max(v.urx, v.lrx);
+		if (left <= pad / 8 + 1 && (out.leftX < 0 || left < out.leftX)) { out.leftX = left; out.leftY = left == v.ulx ? v.uy : v.ly; }
+		if (right >= (pad + fitted) / 8 - 2 && right > out.rightX) { out.rightX = right; out.rightY = right == v.urx ? v.uy : v.ly; }
+	}
+	if (out.boxes.empty()) { out.spawnX = width / 16; out.spawnY = targetHeight / 2 - 4; }
+	return true;
+}
+
+// ---- V1 room resource ------------------------------------------------------
+
+static void put16(std::vector<uint8_t> &v, size_t at, int value) { v[at] = (uint8_t)(value & 0xFF); v[at + 1] = (uint8_t)((value >> 8) & 0xFF); }
+// V1 tile stream of `count` zero bytes (four common colors, runs of 32).
+static void zeroStream(std::vector<uint8_t> &v, int count) {
+	for (int i = 0; i < 4; ++i) v.push_back(0);
+	while (count > 0) { const int run = std::min(32, count); v.push_back((uint8_t)(0x80 | (run - 1))); count -= run; }
+}
+
+std::vector<uint8_t> buildV1Room(const SandboxScene &scene) {
+	const int cols = scene.width / 8, rows = scene.height / 8, n = (int)scene.boxes.size();
+	std::vector<uint8_t> room(28, 0);
+	room[4] = (uint8_t)cols; room[5] = (uint8_t)rows;
+	room[20] = 0;      // objects
+	room[21] = 28;     // boxes follow the header (one-byte offset)
+	room.push_back((uint8_t)n);
+	for (const V2Box &b : scene.boxes) {
+		const int fields[8] = {b.uy, b.ly, b.ulx, b.urx, b.llx, b.lrx, b.mask, b.flags};
+		for (int f : fields) room.push_back((uint8_t)f);
+	}
+	for (int i = 0; i < n; ++i) room.push_back((uint8_t)(i * n));
+	for (int8_t hop : scene.next) room.push_back((uint8_t)hop);
+	const int offsets[5] = {10, 12, 14, 16, 18};
+	const int sizes[4] = {2048, cols * rows, cols * rows, cols * rows};
+	for (int s = 0; s < 4; ++s) { put16(room, offsets[s], (int)room.size()); zeroStream(room, sizes[s]); }
+	put16(room, offsets[4], (int)room.size());
+	room.push_back(8); room.push_back(0); zeroStream(room, 0); // Empty mask characters.
+	put16(room, 0, (int)room.size());
+	return room;
+}
+
+} // End of namespace World
+} // End of namespace Scummverse
+
+// ---- Engine bridge ---------------------------------------------------------
+
+#include "common/scummverse_world_engine.h"
+
+namespace Scummverse {
+namespace WorldBridge {
+
+struct Mounted { bool ok = false; World::SandboxScene scene; std::vector<uint8_t> room; };
+static Mounted &current() { static Mounted m; return m; }
+
+bool mount(const unsigned char *data, size_t size, int targetHeight, int firstSlot, int slotCount, char *error, int capacity) {
+	World::SourceScene source; World::SandboxScene scene; std::string problem;
+	const bool ok = World::parseScene(data, size, source, problem) &&
+		World::fitScene(source, targetHeight, firstSlot, slotCount, scene, problem, 320);
+	if (!ok) {
+		if (error && capacity > 0) { std::strncpy(error, problem.c_str(), capacity - 1); error[capacity - 1] = 0; }
+		return false;
+	}
+	Mounted &m = current();
+	m.scene = scene; m.room = World::buildV1Room(m.scene); m.ok = true;
+	return true;
+}
+bool mounted() { return current().ok; }
+int width() { return current().scene.width; }
+int height() { return current().scene.height; }
+const unsigned char *pixels() { return current().scene.pixels.data(); }
+int firstSlot() { return current().scene.firstSlot; }
+int slotCount() { return current().scene.slotCount; }
+const unsigned char *palette() { return current().scene.palette.data(); }
+const unsigned char *room() { return current().room.data(); }
+int roomSize() { return (int)current().room.size(); }
+int spawnX() { return current().scene.spawnX; }
+int spawnY() { return current().scene.spawnY; }
+int leftX() { return current().scene.leftX; }
+int leftY() { return current().scene.leftY; }
+int rightX() { return current().scene.rightX; }
+int rightY() { return current().scene.rightY; }
+const unsigned char *blankRoom(int &size) {
+	static std::vector<uint8_t> room;
+	if (room.empty()) { World::SandboxScene empty; empty.width = 320; empty.height = 128; room = World::buildV1Room(empty); }
+	size = (int)room.size();
+	return room.data();
+}
+
+} // End of namespace WorldBridge
+} // End of namespace Scummverse
