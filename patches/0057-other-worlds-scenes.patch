+// Other worlds: scenes from the player's own copies of other SCUMM games.
+// A game folder in Documents (e.g. Documents/monkey2) is exported to the
+// private worlds/ cache on the next launch; installed scenes can be visited.
+static BOOL scummverseWorldInstalled(const Scummverse::WorldCatalog::WorldGame &game) {
+	NSString *documents = NSSearchPathForDirectoriesInDomains(NSDocumentDirectory, NSUserDomainMask, YES).firstObject;
+	NSString *file = [NSString stringWithFormat:@"%@/worlds/%s-%d.svw", documents, game.gameid, game.scenes[0].room];
+	return [[NSFileManager defaultManager] fileExistsAtPath:file];
+}
+- (void)showScummverseOtherWorldsFrom:(UIViewController *)controller {
+	UIAlertController *menu = [UIAlertController alertControllerWithTitle:@"Other worlds" message:@"Scenes from your own copies of other SCUMM games. To add one, copy its files into a folder in Documents named as shown, then restart the app." preferredStyle:UIAlertControllerStyleAlert];
+	int first = 0;
+	for (const auto &game : Scummverse::WorldCatalog::kWorldGames) {
+		const BOOL installed = scummverseWorldInstalled(game);
+		NSString *title = installed ? [NSString stringWithUTF8String:game.title] : [NSString stringWithFormat:@"%s (add Documents/%s)", game.title, game.folder];
+		const Scummverse::WorldCatalog::WorldGame *chosen = &game; const int base = first;
+		UIAlertAction *action = [UIAlertAction actionWithTitle:title style:UIAlertActionStyleDefault handler:^(UIAlertAction *) {
+			[controller dismissViewControllerAnimated:YES completion:^{ [self showScummverseScenes:chosen base:base from:controller]; }];
+		}];
+		action.enabled = installed;
+		[menu addAction:action];
+		first += game.sceneCount;
+	}
+	[menu addAction:[UIAlertAction actionWithTitle:@"Close" style:UIAlertActionStyleCancel handler:nil]];
+	[controller presentViewController:menu animated:YES completion:nil];
+}
+- (void)showScummverseScenes:(const Scummverse::WorldCatalog::WorldGame *)game base:(int)base from:(UIViewController *)controller {
+	UIAlertController *menu = [UIAlertController alertControllerWithTitle:[NSString stringWithUTF8String:game->title] message:@"Choose a place. Walk off the sides to reach neighboring places." preferredStyle:UIAlertControllerStyleAlert];
+	for (int i = 0; i < game->sceneCount; ++i) {
+		const int command = 160 + base + i;
+		[menu addAction:[UIAlertAction actionWithTitle:[NSString stringWithUTF8String:game->scenes[i].name] style:UIAlertActionStyleDefault handler:^(UIAlertAction *) {
+			scummverseWorldRequest(ScummverseLocalAI::sceneToken() | command);
+		}]];
+	}
+	[menu addAction:[UIAlertAction actionWithTitle:@"Back" style:UIAlertActionStyleCancel handler:nil]];
+	[controller presentViewController:menu animated:YES completion:nil];
+}
