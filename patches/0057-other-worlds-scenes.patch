--- /dev/null
+++ b/common/scummverse_world.h
@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Scummverse other worlds: portable scene loader. Reads a scene exported from
+// the player's own copy of another SCUMM game (see the engine exporter) and
+// fits it to the V1 sandbox: height scaled to the sandbox view, colors moved
+// into palette slots the 16-color V1 art never uses, and walk boxes turned
+// into V1/V2 trapezoids with a next-box routing table. No game data inside.
+#ifndef COMMON_SCUMMVERSE_WORLD_H
+#define COMMON_SCUMMVERSE_WORLD_H
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace Scummverse {
+namespace World {
+
+struct SourceBox {
+	int x[4], y[4];   // ul, ur, lr, ll (pixels)
+	int flags = 0, mask = 0;
+};
+
+struct SourceScene {
+	int room = 0, width = 0, height = 0;
+	uint8_t palette[768] = {};
+	std::vector<uint8_t> pixels;     // width*height palette indices
+	std::vector<SourceBox> boxes;
+};
+
+// V1/V2 box: rows in 2-pixel units, columns in 8-pixel units.
+struct V2Box { int uy, ly, ulx, urx, llx, lrx, mask, flags; };
+
+struct SandboxScene {
+	int width = 0, height = 0;       // pixels; width is a multiple of 8
+	int firstSlot = 0, slotCount = 0;
+	std::vector<uint8_t> pixels;     // width*height palette slot indices
+	std::vector<uint8_t> palette;    // slotCount*3 RGB for slots firstSlot..
+	std::vector<V2Box> boxes;
+	std::vector<int8_t> next;        // boxes*boxes next-box table (-1 none)
+	int padLeft = 0;                 // pixels added on the left (centering)
+	int spawnX = 0, spawnY = 0;      // V1 units, inside a walkable box
+	int leftX = -1, rightX = -1;     // V1 units of walkable edge points (-1 none)
+	int leftY = 0, rightY = 0;
+};
+
+// Parses an "SVW1" scene. False (with a reason) for anything malformed.
+bool parseScene(const uint8_t *data, size_t size, SourceScene &scene, std::string &error);
+
+// Scales to targetHeight (area average, then nearest of the scene's own
+// colors), packs the colors used into slotCount slots from firstSlot, and
+// converts boxes. Disabled boxes (flag 0x80) are dropped.
+// minWidth pads narrow scenes (centered, in the scene's darkest color).
+bool fitScene(const SourceScene &source, int targetHeight, int firstSlot, int slotCount,
+	SandboxScene &out, std::string &error, int minWidth = 0);
+
+// Next-box routing for V2 boxes that touch (shared edge or overlap).
+std::vector<int8_t> routeBoxes(const std::vector<V2Box> &boxes);
+
+// A V1 room resource for the sandbox: header, boxes, routing and empty tile
+// streams (the picture is drawn from SandboxScene::pixels). No objects or
+// scripts.
+std::vector<uint8_t> buildV1Room(const SandboxScene &scene);
+
+} // End of namespace World
+} // End of namespace Scummverse
+
+#endif
