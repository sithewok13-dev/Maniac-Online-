diff --git a/engines/scumm/scummverse_world_export.inc b/engines/scumm/scummverse_world_export.inc
new file mode 100644
index 00000000..91cdbf4d
--- /dev/null
+++ b/engines/scumm/scummverse_world_export.inc
@@ -0,0 +1,83 @@
+// SCUMMVERSE other worlds: exporter. GPL-3.0-or-later.
+// Runs inside the original game's own engine (any SCUMM v3-v6 edition the
+// catalog lists) and writes each catalog scene, rendered by ScummVM's own
+// decoders, to a private cache next to the player's saves. The sandbox only
+// ever reads that cache. Room scripts are not run: the scene is the room's
+// background with its initially drawn objects.
+//
+// Cache file (little endian): "SVW1", u16 room, u16 width, u16 height,
+// u8 boxCount, u8 reserved, palette[768], pixels[width*height], then per box
+// int16 ulx,uly,urx,ury,lrx,lry,llx,lly, u8 flags, u8 mask.
+
+static void scummverseWrite16(Common::WriteStream &out, int value) { out.writeUint16LE((uint16)value); }
+
+bool ScummEngine::scummverseExportScene(int room, const Common::Path &file, Common::String &problem) {
+	if (room <= 0 || room >= _numRooms) { problem = "room out of range"; return false; }
+	if (_game.version >= 4 && !_res->_types[rtRoom][room]._roomno) { problem = "room missing"; return false; }
+	for (uint i = 0; i < NUM_SCRIPT_SLOT; ++i) vm.slot[i].status = ssDead;
+	_currentScript = 0xFF; vm.cutSceneStackPointer = 0;
+	// startScene's room setup, without exit or entry scripts.
+	killScriptsAndResources(); clearDrawQueues();
+	for (int id = 1; id < _numActors; ++id) _actors[id]->hideActor();
+	for (int i = 0; i < 256; ++i) { _roomPalette[i] = i; if (_shadowPalette) _shadowPalette[i] = i; }
+	if (_game.features & GF_SMALL_HEADER) setDirtyColors(0, 255);
+	_fullRedraw = true; _currentRoom = room; VAR(VAR_ROOM) = room; _roomResource = room;
+	if (VAR_ROOM_RESOURCE != 0xFF) VAR(VAR_ROOM_RESOURCE) = room;
+	ensureResourceLoaded(rtRoom, room); clearRoomObjects(); setupRoomSubBlocks(); resetRoomSubBlocks();
+	if (_roomHeight <= 0 || _roomHeight > _screenHeight || _roomWidth < _screenWidth) { problem = "unsupported room size"; return false; }
+	if (_virtscr[kMainVirtScreen].h != _roomHeight) {
+		const int top = _roomHeight + 16 <= _screenHeight ? 16 : 0;
+		initScreens(top, top + _roomHeight);
+	}
+	initBGBuffers(_roomHeight); resetRoomObjects();
+	if (VAR_ROOM_WIDTH != 0xFF && VAR_ROOM_HEIGHT != 0xFF) { VAR(VAR_ROOM_WIDTH) = _roomWidth; VAR(VAR_ROOM_HEIGHT) = _roomHeight; }
+	if (VAR_CAMERA_MIN_X != 0xFF) VAR(VAR_CAMERA_MIN_X) = _screenWidth / 2;
+	if (VAR_CAMERA_MAX_X != 0xFF) VAR(VAR_CAMERA_MAX_X) = _roomWidth - _screenWidth / 2;
+	camera._mode = kNormalCameraMode;
+	const int W = _roomWidth, H = _roomHeight;
+	Common::Array<byte> pixels; pixels.resize(W * H);
+	// Render one screen at a time across the room (camera centers).
+	for (int center = _screenWidth / 2;; center += _screenWidth) {
+		const int c = MIN(center, W - _screenWidth / 2);
+		setCameraAt(c, 0); camera._cur.x = camera._dest.x = c; cameraMoved();
+		_fullRedraw = true; scummLoop_handleDrawing();
+		const int left = c - _screenWidth / 2, xs = _virtscr[kMainVirtScreen].xstart;
+		for (int y = 0; y < H; ++y)
+			for (int x = 0; x < _screenWidth; ++x)
+				pixels[y * W + left + x] = *((const byte *)_virtscr[kMainVirtScreen].getBasePtr(xs + x, y));
+		if (c >= W - _screenWidth / 2) break;
+	}
+	Common::DumpFile out;
+	if (!out.open(file, true)) { problem = "cannot write cache"; return false; }
+	const int boxes = MIN<int>(getNumBoxes(), 255);
+	out.write("SVW1", 4); scummverseWrite16(out, room); scummverseWrite16(out, W); scummverseWrite16(out, H);
+	out.writeByte(boxes); out.writeByte(0);
+	out.write(_currentPalette, 768);
+	out.write(pixels.data(), pixels.size());
+	for (int b = 0; b < boxes; ++b) {
+		const BoxCoords box = getBoxCoordinates(b);
+		const Common::Point corners[4] = {box.ul, box.ur, box.lr, box.ll};
+		for (const auto &p : corners) { scummverseWrite16(out, p.x); scummverseWrite16(out, p.y); }
+		out.writeByte(getBoxFlags(b)); out.writeByte(getMaskFromBox(b));
+	}
+	out.finalize();
+	return !out.err();
+}
+
+// Exports every catalog scene of the running game into dir/<gameid>/.
+// Returns the number of scenes written; problems are logged per scene.
+int ScummEngine::scummverseExportWorld(const Common::Path &dir) {
+	const WorldGame *game = worldGame(_game.gameid);
+	if (!game || game->version != _game.version) {
+		warning("SCUMMVERSE world export: %s (version %d) is not a supported edition", _game.gameid, _game.version);
+		return 0;
+	}
+	int written = 0;
+	for (int i = 0; i < game->sceneCount; ++i) {
+		Common::String problem;
+		const Common::Path file = dir.appendComponent(Common::String::format("%s-%d.svw", game->gameid, game->scenes[i].room));
+		if (scummverseExportScene(game->scenes[i].room, file, problem)) ++written;
+		else warning("SCUMMVERSE world export: %s room %d skipped (%s)", game->gameid, game->scenes[i].room, problem.c_str());
+	}
+	return written;
+}
diff --git a/engines/scumm/scummverse_world_play.inc b/engines/scumm/scummverse_world_play.inc
new file mode 100644
index 00000000..a8fd2432
--- /dev/null
+++ b/engines/scumm/scummverse_world_play.inc
@@ -0,0 +1,149 @@
+// SCUMMVERSE other worlds: visiting exported scenes. GPL-3.0-or-later.
+// Every catalog scene has a logical room (kWorldFirstRoom + catalog index)
+// backed by the one physical kForeignRoom, mounted on entry from the
+// player's private export cache. Walking off a scene's side reaches the
+// neighboring scene of the same game when the original walk boxes allow it.
+
+namespace WorldBridge = ::Scummverse::WorldBridge;
+
+static const int kWorldFirstRoom = 200, kWorldFirstSlot = 16, kWorldSlots = 240; // kScummverseWorldFirstRoom
+
+static int worldSceneTotal() {
+	int total = 0;
+	for (const auto &game : kWorldGames) total += game.sceneCount;
+	return total;
+}
+static bool worldSceneAt(int index, const WorldGame *&game, int &scene) {
+	for (const auto &g : kWorldGames) {
+		if (index < g.sceneCount) { game = &g; scene = index; return true; }
+		index -= g.sceneCount;
+	}
+	return false;
+}
+static int worldIndexOfRoom(int room) {
+	const int index = room - kWorldFirstRoom;
+	return room >= kWorldFirstRoom && index < worldSceneTotal() ? index : -1;
+}
+static const char *worldSceneName(int room) {
+	const WorldGame *game; int scene;
+	return worldSceneAt(worldIndexOfRoom(room), game, scene) ? game->scenes[scene].name : nullptr;
+}
+
+int ScummEngine::scummverseWorldSceneCount() const { return worldSceneTotal(); }
+bool ScummEngine::scummverseWorldPlace(int index, int &scene, int &count) const {
+	const WorldGame *game;
+	if (!worldSceneAt(index, game, scene)) return false;
+	count = game->sceneCount; return true;
+}
+
+Common::Path ScummEngine::scummverseWorldCache() const {
+	if (ConfMan.hasKey("scummverse_worlds_path")) return ConfMan.getPath("scummverse_worlds_path");
+	return Common::Path("worlds");
+}
+
+bool ScummEngine::scummverseMountWorld(int room) {
+	const WorldGame *game; int scene;
+	if (!worldSceneAt(worldIndexOfRoom(room), game, scene)) return false;
+	if (_scummverseWorldRoom == room && WorldBridge::mounted()) return true;
+	const Common::Path file = scummverseWorldCache().appendComponent(Common::String::format("%s-%d.svw", game->gameid, game->scenes[scene].room));
+	// The cache lives outside the game's search paths: open it directly.
+	const Common::FSNode node(file);
+	Common::ScopedPtr<Common::SeekableReadStream> in(node.exists() ? node.createReadStream() : nullptr);
+	if (!in) {
+		_scummverseWorldNotice = Common::String::format("%s isn't installed. Add your copy of %s to Documents/%s.", game->scenes[scene].name, game->title, game->folder);
+		return false;
+	}
+	Common::Array<byte> data; data.resize(in->size());
+	if (in->read(data.data(), data.size()) != data.size()) { _scummverseWorldNotice = "The scene file could not be read."; return false; }
+	char problem[128];
+	if (!WorldBridge::mount(data.data(), data.size(), 128, kWorldFirstSlot, kWorldSlots, problem, sizeof(problem))) {
+		_scummverseWorldNotice = Common::String::format("%s could not be shown (%s). Export it again.", game->scenes[scene].name, problem);
+		return false;
+	}
+	_scummverseWorldRoom = room;
+	_resourceMapper[room & 0x7F] = ScummverseContent::kForeignRoom;
+	_res->nukeResource(rtRoom, ScummverseContent::kForeignRoom);
+	_gdi->setForeignBackground(WorldBridge::pixels(), WorldBridge::width(), WorldBridge::height());
+	return true;
+}
+
+// The scene's own colors live in palette slots the V1 art never uses.
+void ScummEngine::scummverseApplyWorldPalette() {
+	if (!WorldBridge::mounted() || worldIndexOfRoom(_currentRoom) < 0) return;
+	const byte *rgb = WorldBridge::palette();
+	for (int i = 0; i < WorldBridge::slotCount(); ++i)
+		setPalColor(WorldBridge::firstSlot() + i, rgb[i * 3], rgb[i * 3 + 1], rgb[i * 3 + 2]);
+}
+
+bool ScummEngine::scummverseTravelWorld(int room, int x, int y) {
+	if (!_scummverseRoamingReady || !_userPut || VAR(VAR_EGO) < 1 || VAR(VAR_EGO) > 24) return false;
+	if (_currentRoom == 56 && _scummVars[724]) { scummverseSay(VAR(VAR_EGO), "Choose Arrive to finish this flight first."); return false; }
+	if (scummverseOnBus() || scummverseOnTram()) { scummverseSay(VAR(VAR_EGO), "Let's finish this ride first."); return false; }
+	if (!scummverseMountWorld(room)) { scummverseWorldReport(_scummverseWorldNotice.c_str()); scummverseSay(VAR(VAR_EGO), _scummverseWorldNotice.c_str()); return false; }
+	Actor *player = derefActor(VAR(VAR_EGO), "world visitor");
+	// Remember where the visit started so the menu can bring the player back.
+	const int key = travellerReturnKey(VAR(VAR_EGO));
+	if (_currentRoom < 53 && player->_room == _currentRoom) {
+		_scummVars[key] = _currentRoom; _scummVars[key + 1] = player->getRealPos().x; _scummVars[key + 2] = player->getRealPos().y;
+	}
+	scummverseUpdateCompanions();
+	scummverseAICancel(); _scummverseAIActor = 0; stopTalk();
+	if (x < 0) { x = WorldBridge::spawnX(); y = WorldBridge::spawnY(); }
+	player->stopActorMoving(); player->setElevation(0); player->putActor(x, y, room);
+	startScene(room, player, 0);
+	scummverseApplyWorldPalette();
+	VAR(VAR_CURRENT_LIGHTS) = LIGHTMODE_room_lights_on | LIGHTMODE_actor_use_colors;
+	AdjustBoxResult point = player->adjustXYToBeInBox(x, y);
+	player->putActor(point.x, point.y, room); player->startAnimActor(player->_standFrame);
+	setCameraAt(player->getPos().x, player->getPos().y); setCameraFollows(player);
+	scummverseUpdateCompanions();
+	scummverseUpdateResident();
+	resetSentence(); _fullRedraw = true; _scummverseTransitArmed = false;
+	const WorldGame *game; int scene; worldSceneAt(worldIndexOfRoom(room), game, scene);
+	_scummverseWorldNotice = Common::String::format("%s (%s). Walk off the sides to explore; Worlds brings you home.", game->scenes[scene].name, game->title);
+	scummverseWorldReport(_scummverseWorldNotice.c_str());
+	return true;
+}
+
+// Walking to a side that the walk boxes reach continues to the neighboring
+// scene of the same game.
+void ScummEngine::scummverseWorldEdges() {
+	const int index = worldIndexOfRoom(_currentRoom);
+	if (index < 0 || !WorldBridge::mounted()) return;
+	Actor *player = derefActor(VAR(VAR_EGO), "world walker");
+	if (player->_moving) return;
+	const int x = player->getRealPos().x;
+	// One unit of slack: walking ends where the box edge snaps the actor.
+	const bool left = WorldBridge::leftX() >= 0 && x <= WorldBridge::leftX() + 1;
+	const bool right = WorldBridge::rightX() >= 0 && x >= WorldBridge::rightX() - 1;
+	if (!left && !right) { _scummverseTransitArmed = true; return; }
+	if (!_scummverseTransitArmed) return;
+	_scummverseTransitArmed = false;
+	const WorldGame *game; int scene; worldSceneAt(index, game, scene);
+	const int target = scene + (right ? 1 : -1);
+	if (target < 0 || target >= game->sceneCount) return;
+	const int targetRoom = _currentRoom + (right ? 1 : -1);
+	if (!scummverseMountWorld(targetRoom)) return;
+	// Arrive at the matching side of the next scene when it has one.
+	const int ax = right ? WorldBridge::leftX() : WorldBridge::rightX();
+	const int ay = right ? WorldBridge::leftY() : WorldBridge::rightY();
+	scummverseTravelWorld(targetRoom, ax >= 0 ? ax + (right ? 3 : -3) : -1, ax >= 0 ? ay : -1);
+}
+
+// After a load inside a scene: mount it again, or bring the player to the
+// airport when the scene is no longer installed.
+void ScummEngine::scummverseRestoreWorld() {
+	if (!_scummverseRoaming || worldIndexOfRoom(_currentRoom) < 0) return;
+	_scummverseWorldRoom = 0;
+	if (scummverseMountWorld(_currentRoom)) {
+		_res->nukeResource(rtRoom, ScummverseContent::kForeignRoom);
+		Actor *player = derefActor(VAR(VAR_EGO), "restored visitor");
+		startScene(_currentRoom, player, 0);
+		scummverseApplyWorldPalette();
+		setCameraFollows(player); _fullRedraw = true;
+		return;
+	}
+	Actor *player = derefActor(VAR(VAR_EGO), "stranded visitor");
+	player->putActor(30, 60, 53);
+	scummverseTravel(3);
+}
