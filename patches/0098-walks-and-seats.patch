+// A guest the game only drew sitting (kWorldCostumeGrafts): the relative's
+// stance and walk, its clothes repainted, its head cut off at the neck and
+// the guest's own head (standing, or talking) set on the neck instead. All
+// of it faces left as drawn, mirrored to face right.
+bool ScummEngine::scummverseGraftGuest(int costume, Common::Array<ScummverseGuestFrame> &frames, Common::String &problem) {
+	const WorldGame *game = worldGame(_game.gameid);
+	const int gameIndex = game ? (int)(game - kWorldGames) : -1;
+	const WorldCostumeGraft *graft = worldCostumeGraft(gameIndex, costume);
+	if (!graft) { problem = "no graft"; return false; }
+	for (int c : {(int)graft->costume, (int)graft->body})
+		if (c <= 0 || c >= _numCostumes || (_game.version >= 4 && !_res->_types[rtCostume][c]._roomno)) { problem = "costume missing"; return false; }
+	const WorldSideWalk *side = worldSideWalk(gameIndex, graft->body);
+	auto pose = [&](int id, int facing, int kind, int most, uint32 limbs, Common::Array<ScummverseGuestFrame> &out) {
+		scummverseCapturePose(id, facing, kind, most, limbs, out);
+	};
+	Common::Array<ScummverseGuestFrame> heads, talks, stands, walks;
+	const uint32 head = (1u << graft->head) | (1u << graft->mouth);
+	pose(graft->costume, 180, 0, 1, head, heads);
+	pose(graft->costume, 180, 2, 6, head, talks);
+	pose(graft->body, 180, 0, 1, 0xFFFF, stands);
+	pose(graft->body, side ? side->facing : 270, 1, 12, 0xFFFF, walks);
+	if (heads.empty() || stands.empty()) { problem = "graft draws nothing"; return false; }
+	// Turned to face as the body does (mirrored around its own middle).
+	if (graft->flip)
+		for (auto *set : {&heads, &talks})
+			for (ScummverseGuestFrame &h : *set) { const int middle = 2 * h.dx + h.width - 1; h.mirror(); h.dx += middle; }
+	if (talks.empty()) talks.push_back(heads[0]);
+	if (walks.empty()) walks.push_back(stands[0]);
+	auto cloth = [&](byte c) {
+		for (const auto &r : graft->recolor) if ((r[0] || r[1]) && r[0] == c) return true;
+		return false;
+	};
+	const ScummverseGuestFrame &still = heads[0];
+	auto join = [&](const ScummverseGuestFrame &body, const ScummverseGuestFrame &face, ScummverseGuestFrame &f) {
+		// Where the clothes start: the first row with a few of their pixels.
+		int top = -1, left = body.width, right = -1;
+		for (int y = 0; y < body.height && top < 0; ++y) {
+			int n = 0;
+			for (int x = 0; x < body.width; ++x) n += body.mask[y * body.width + x] && cloth(body.pixels[y * body.width + x]);
+			if (n >= 3) top = y;
+		}
+		if (top < 0) return false;
+		for (int y = top; y < MIN(top + 3, body.height); ++y) for (int x = 0; x < body.width; ++x)
+			if (body.mask[y * body.width + x] && cloth(body.pixels[y * body.width + x])) { left = MIN(left, x); right = MAX(right, x); }
+		// The head on the neck, a talking one where it moves from the still one.
+		const int hx = body.dx + (left + right) / 2 - still.width / 2 - 1 + face.dx - still.dx;
+		const int hy = body.dy + top + graft->neck + 2 - still.height + face.dy - still.dy;
+		f.dx = MIN(body.dx, hx); f.dy = MIN(body.dy, hy);
+		f.width = MAX(body.dx + body.width, hx + face.width) - f.dx; f.height = MAX(body.dy + body.height, hy + face.height) - f.dy;
+		f.pixels.clear(); f.mask.clear(); f.pixels.resize(f.width * f.height, 0); f.mask.resize(f.width * f.height, 0);
+		for (int y = 0; y < body.height; ++y) for (int x = 0; x < body.width; ++x) {
+			const int i = y * body.width + x;
+			if (!body.mask[i] || (y < top + graft->neck && !cloth(body.pixels[i]))) continue;
+			byte c = body.pixels[i];
+			for (const auto &r : graft->recolor) if ((r[0] || r[1]) && r[0] == c) { c = r[1]; break; }
+			const int o = (body.dy - f.dy + y) * f.width + body.dx - f.dx + x;
+			f.pixels[o] = c; f.mask[o] = 1;
+		}
+		for (int y = 0; y < face.height; ++y) for (int x = 0; x < face.width; ++x) {
+			const int i = y * face.width + x;
+			if (!face.mask[i]) continue;
+			const int o = (hy - f.dy + y) * f.width + hx - f.dx + x;
+			f.pixels[o] = face.pixels[i]; f.mask[o] = 1;
+		}
+		return true;
+	};
+	for (int dir = 0; dir < 4; ++dir) for (int kind = 0; kind < 3; ++kind) {
+		const Common::Array<ScummverseGuestFrame> &bodies = kind == 1 ? walks : stands;
+		const int count = kind == 1 ? bodies.size() : kind == 2 ? talks.size() : 1;
+		for (int i = 0; i < count; ++i) {
+			ScummverseGuestFrame f;
+			if (!join(kind == 1 ? bodies[i] : stands[0], kind == 2 ? talks[i] : still, f)) { problem = "graft has no clothes"; return false; }
+			f.dir = dir; f.kind = kind; f.index = i;
+			if (dir == 1) f.mirror();
+			frames.push_back(f);
+		}
+	}
+	return true;
+}
