+// Draws the actor twice, over different fills: a pixel is the actor's where
+// both passes agree. Cropped, relative to (ax, ay); false if nothing shows.
+static bool scummverseCaptureActor(VirtScreen &vs, int W, int H, Actor *a, int ax, int ay, ScummverseGuestFrame &f) {
+	Common::Array<byte> pass[2];
+	for (int p = 0; p < 2; ++p) {
+		for (int y = 0; y < H; ++y) memset(vs.getPixels(0, y), p ? 255 : 254, W);
+		a->_needRedraw = true; a->drawActorCostume();
+		pass[p].resize(W * H);
+		for (int y = 0; y < H; ++y) memcpy(&pass[p][y * W], vs.getPixels(0, y), W);
+	}
+	int left = W, right = -1, top = H, bottom = -1;
+	for (int y = 0; y < H; ++y) for (int x = 0; x < W; ++x)
+		if (pass[0][y * W + x] == pass[1][y * W + x]) { left = MIN(left, x); right = MAX(right, x); top = MIN(top, y); bottom = MAX(bottom, y); }
+	if (right < 0) return false;
+	f.dx = left - ax; f.dy = top - ay; f.width = right - left + 1; f.height = bottom - top + 1;
+	f.pixels.resize(f.width * f.height); f.mask.resize(f.width * f.height);
+	for (int y = 0; y < f.height; ++y) for (int x = 0; x < f.width; ++x) {
+		const int i = (top + y) * W + left + x;
+		f.mask[y * f.width + x] = pass[0][i] == pass[1][i];
+		f.pixels[y * f.width + x] = f.mask[y * f.width + x] ? pass[0][i] : 0;
+	}
+	return true;
+}
