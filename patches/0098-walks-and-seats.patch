+// A guest drawn only from the front (kWorldSideViews) seen from the side:
+// a relative's stance and walk facing left and right, the relative's colours
+// repainted in the guest's, its head replaced by the guest's own, drawn
+// anew facing right, and (the three-headed monkey) more of them behind it,
+// each a step back and up. Their own front and back stay; from the side they
+// talk standing.
+void ScummEngine::scummverseSideViews(int costume, Common::Array<ScummverseGuestFrame> &frames) {
+	const WorldGame *game = worldGame(_game.gameid);
+	const WorldSideView *view = game ? worldSideView((int)(game - kWorldGames), costume) : nullptr;
+	if (!view || !view->head || view->headRows <= 0 || view->body <= 0 || view->body >= _numCostumes ||
+		(_game.version >= 4 && !_res->_types[rtCostume][view->body]._roomno)) return;
+	auto paint = [&](byte c) {
+		for (const auto &r : view->recolor) if ((r[0] || r[1]) && r[0] == c) return r[1];
+		return c;
+	};
+	const int artWidth = (int)strlen(view->head[0]), artHeight = view->headRows, extra = MAX(0, view->heads - 1);
+	Common::Array<ScummverseGuestFrame> made;
+	for (int dir = 0; dir < 2; ++dir) for (int kind = 0; kind < 2; ++kind) {
+		Common::Array<ScummverseGuestFrame> poses;
+		scummverseCapturePose(view->body, dir ? 90 : 270, kind, kind ? 12 : 1, 0xFFFF, poses);
+		for (uint i = 0; i < poses.size(); ++i) {
+			// Made facing right, turned back to face left.
+			ScummverseGuestFrame body = poses[i];
+			if (!dir) body.mirror();
+			// The face: the first rows down with its colour (lower down, the
+			// same colour is a chest or a hand). The head is around it.
+			int faceLeft = body.width, faceRight = -1, faceTop = -1, faceBottom = -1;
+			for (int y = 0; y < body.height; ++y) {
+				bool row = false;
+				for (int x = 0; x < body.width; ++x)
+					if (body.mask[y * body.width + x] && body.pixels[y * body.width + x] == view->face) {
+						faceLeft = MIN(faceLeft, x); faceRight = MAX(faceRight, x); row = true;
+					}
+				if (row) { if (faceTop < 0) faceTop = y; faceBottom = y; } else if (faceTop >= 0) break;
+			}
+			if (faceTop < 0) continue;
+			const int headLeft = faceLeft - 3, headRight = faceRight + 4, headTop = faceTop - 3, headBottom = faceBottom + 1;
+			// The new head reaches a pixel past the old one's front, a row below its top.
+			const int artX = headRight + 2 - artWidth, artY = headTop + 1;
+			int left = MIN(0, artX - view->stepX * extra), top = MIN(0, artY - view->stepY * extra);
+			int right = MAX(body.width, artX + artWidth), bottom = MAX(body.height, artY + artHeight);
+			ScummverseGuestFrame f;
+			f.dir = 1; f.kind = kind; f.index = i;
+			f.dx = body.dx + left; f.dy = body.dy + top; f.width = right - left; f.height = bottom - top;
+			f.pixels.resize(f.width * f.height, 0); f.mask.resize(f.width * f.height, 0);
+			auto head = [&](int ox, int oy) {
+				for (int y = 0; y < artHeight; ++y) for (int x = 0; x < artWidth; ++x) {
+					const char *ink = view->head[y][x] == '.' ? nullptr : strchr(view->legend, view->head[y][x]);
+					if (!ink) continue;
+					const int o = (oy + y - top) * f.width + ox + x - left;
+					f.pixels[o] = view->inks[ink - view->legend]; f.mask[o] = 1;
+				}
+			};
+			// The heads behind first, each on a neck down to where the head
+			// in front sits (as wide as a head's chin, so nothing shows
+			// through between them), then the body without its own head, then
+			// the head in front.
+			int chinRow = artHeight - 1, chinLeft = artWidth, chinRight = -1;
+			for (int y = MAX(0, artHeight - 3); y < artHeight; ++y) {
+				int l = 0, r = artWidth - 1;
+				while (l < artWidth && view->head[y][l] == '.') ++l;
+				while (r >= 0 && view->head[y][r] == '.') --r;
+				if (r - l > chinRight - chinLeft) { chinRow = y; chinLeft = l; chinRight = r; }
+			}
+			for (int k = extra; k > 0 && chinRight >= chinLeft; --k) {
+				const int rise = view->stepY * k, back = view->stepX * k;
+				for (int y = 0; y <= rise; ++y) {
+					const int shift = rise ? back * y / rise : 0;
+					for (int x = chinLeft; x <= chinRight; ++x) {
+						const int o = (artY - rise + chinRow + y - top) * f.width + artX - back + shift + x - left;
+						f.pixels[o] = view->neck; f.mask[o] = 1;
+					}
+				}
+			}
+			for (int k = extra; k > 0; --k) head(artX - view->stepX * k, artY - view->stepY * k);
+			for (int y = 0; y < body.height; ++y) for (int x = 0; x < body.width; ++x) {
+				const int s = y * body.width + x;
+				if (!body.mask[s] || (x >= headLeft && x <= headRight && y >= headTop && y <= headBottom)) continue;
+				const int o = (y - top) * f.width + x - left;
+				f.pixels[o] = paint(body.pixels[s]); f.mask[o] = 1;
+			}
+			head(artX, artY);
+			// As big as asked, scaled around the feet (nearest pixel).
+			if (view->size > 0 && view->size != 100) {
+				ScummverseGuestFrame g = f;
+				g.width = MAX(1, f.width * view->size / 100); g.height = MAX(1, f.height * view->size / 100);
+				g.dx = f.dx * view->size / 100; g.dy = (f.dy + f.height) * view->size / 100 - g.height;
+				g.pixels.clear(); g.mask.clear(); g.pixels.resize(g.width * g.height, 0); g.mask.resize(g.width * g.height, 0);
+				for (int y = 0; y < g.height; ++y) for (int x = 0; x < g.width; ++x) {
+					const int s = MIN(f.height - 1, y * 100 / view->size) * f.width + MIN(f.width - 1, x * 100 / view->size);
+					g.pixels[y * g.width + x] = f.pixels[s]; g.mask[y * g.width + x] = f.mask[s];
+				}
+				f = g;
+			}
+			if (!dir) { f.mirror(); f.dir = 0; }
+			made.push_back(f);
+		}
+	}
+	if (made.empty()) return;
+	Common::Array<ScummverseGuestFrame> kept;
+	for (const ScummverseGuestFrame &f : frames) if (f.dir >= 2) kept.push_back(f);
+	for (const ScummverseGuestFrame &f : made) kept.push_back(f);
+	frames = kept;
+}
