+// Walking frames for a guest drawn standing only (kWorldLegSwings): each
+// leg is followed up from its foot, row by row, and swings from the hip,
+// the lighter near legs against the darker far ones.
+static void scummverseSwingLegs(const WorldLegSwing &swing, const byte *palette, Common::Array<ScummverseGuestFrame> &frames) {
+	static const int kMaxLegs = 32;
+	Common::Array<ScummverseGuestFrame> walks;
+	for (const ScummverseGuestFrame &stand : frames) {
+		if (stand.kind != 0 || stand.index != 0) continue;
+		const int w = stand.width, h = stand.height, hip = h * swing.hip / 100;
+		if (h - hip < 4) continue;
+		Common::Array<int> leg(w * h, -1);
+		int legs = 0;
+		for (int y = h - 1; y >= hip; --y)
+			for (int x = 0; x < w;) {
+				if (!stand.mask[y * w + x]) { ++x; continue; }
+				int end = x;
+				while (end < w && stand.mask[y * w + end]) ++end;
+				// The leg below that this run touches most; a new one at a foot.
+				int count[kMaxLegs] = {0}, best = -1;
+				for (int k = MAX(0, x - 1); y + 1 < h && k < MIN(w, end + 1); ++k)
+					if (leg[(y + 1) * w + k] >= 0) ++count[leg[(y + 1) * w + k]];
+				for (int l = 0; l < legs; ++l) if (count[l] && (best < 0 || count[l] > count[best])) best = l;
+				if (best < 0 && legs < kMaxLegs) best = legs++;
+				for (int k = x; k < end; ++k) leg[y * w + k] = best;
+				x = end;
+			}
+		// Near or far: brighter or darker than the middle leg.
+		double shade[kMaxLegs] = {0};
+		int size[kMaxLegs] = {0};
+		for (int i = 0; i < w * h; ++i)
+			if (leg[i] >= 0) {
+				const byte *c = palette + 3 * stand.pixels[i];
+				shade[leg[i]] += 3 * c[0] + 6 * c[1] + c[2]; ++size[leg[i]];
+			}
+		Common::Array<double> shades;
+		for (int l = 0; l < legs; ++l) if (size[l]) { shade[l] /= size[l]; if (size[l] >= 12) shades.push_back(shade[l]); }
+		Common::sort(shades.begin(), shades.end());
+		const double middle = shades.empty() ? 0 : shades[shades.size() / 2];
+		const int reach = swing.reach;
+		for (int n = 0; n < kWorldLegSwingFrames; ++n) {
+			ScummverseGuestFrame f;
+			f.dir = stand.dir; f.kind = 1; f.index = n;
+			f.dx = stand.dx - reach; f.dy = stand.dy; f.width = w + 2 * reach; f.height = h;
+			f.pixels.resize(f.width * h, 0); f.mask.resize(f.width * h, 0);
+			// Far legs first, then the body, then the near legs over it.
+			for (int layer = 0; layer < 3; ++layer)
+				for (int y = 0; y < h; ++y) for (int x = 0; x < w; ++x) {
+					const int i = y * w + x, l = leg[i];
+					if (!stand.mask[i]) continue;
+					const bool far = l >= 0 && shade[l] < middle;
+					if (layer != (l < 0 ? 1 : far ? 0 : 2)) continue;
+					int to = x + reach;
+					if (l >= 0) to += (int)lround(reach * (double)(y - hip) / (h - 1 - hip) * sin(2 * M_PI * n / kWorldLegSwingFrames + (far ? M_PI : 0)));
+					if (to < 0 || to >= f.width) continue;
+					f.pixels[y * f.width + to] = stand.pixels[i]; f.mask[y * f.width + to] = 1;
+				}
+			walks.push_back(f);
+		}
+	}
+	if (walks.empty()) return;
+	Common::Array<ScummverseGuestFrame> kept;
+	for (const ScummverseGuestFrame &f : frames) if (f.kind != 1) kept.push_back(f);
+	for (const ScummverseGuestFrame &f : walks) kept.push_back(f);
+	frames = kept;
+}
