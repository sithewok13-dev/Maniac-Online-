+	const int W = _screenWidth, H = vs.h;
+	Actor *a = _actors[1];
+	a->initActor(0); a->setActorCostume(costume);
+	a->_ignoreBoxes = true; a->setScale(255, 255); a->_forceClip = 0; a->setAnimSpeed(0);
+	putClass(a->_number, kObjectClassNeverClip, true); a->_visible = true;
+	a->putActor(camera._cur.x, H - 4, _currentRoom);
+	const int ax = a->getPos().x - vs.xstart, ay = a->getPos().y - a->getElevation();
+	a->_cost.reset(); a->setDirection(facing); a->startAnimActor(a->_initFrame);
+	a->startAnimActor(kind == 1 ? a->_walkFrame : kind == 2 ? a->_talkStartFrame : a->_standFrame);
