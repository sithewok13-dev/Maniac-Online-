+// A seated pose (kWorldSeatPoses), made from the stance facing right: its
+// parts cut out, turned and set as the catalog says (or all of it), as the
+// picture behind the seat's front and (parts marked front) the one over it,
+// the same size, standing on the stance's feet, gaps filled if asked.
+// Returns the pictures made: none if a part reaches outside the stance or
+// is set on a part that never gets set.
+static int scummverseSeatPose(const WorldSeatPose &pose, const ScummverseGuestFrame &stand, ScummverseGuestFrame out[2]) {
+	// Down each column, then across each row, from its first pixel to its last.
+	auto fill = [&](ScummverseGuestFrame &f) {
+		if (pose.fill < 0) return;
+		for (int across = 0; across < 2; ++across) {
+			const int lines = across ? f.height : f.width, along = across ? f.width : f.height;
+			for (int i = 0; i < lines; ++i) {
+				auto at = [&](int j) { return across ? i * f.width + j : j * f.width + i; };
+				int first = -1, last = -1;
+				for (int j = 0; j < along; ++j) if (f.mask[at(j)]) { if (first < 0) first = j; last = j; }
+				for (int j = MAX(0, first); first >= 0 && j <= last; ++j)
+					if (!f.mask[at(j)]) { f.pixels[at(j)] = (byte)pose.fill; f.mask[at(j)] = 1; }
+			}
+		}
+	};
+	const int most = ARRAYSIZE(pose.parts);
+	struct Placed { double c, s, scale; int x, y, left, top, right, bottom; bool set; } placed[ARRAYSIZE(pose.parts)];
+	int count = 0;
+	while (count < most && pose.parts[count].x1 > pose.parts[count].x0) {
+		const WorldSeatPart &p = pose.parts[count++];
+		if (p.x0 < 0 || p.y0 < 0 || p.x1 > stand.width || p.y1 > stand.height || p.y1 <= p.y0 || p.scale <= 0 || p.on >= most) return 0;
+	}
+	if (!count) {
+		out[0] = stand;
+		out[0].dir = 1; out[0].kind = kWorldSeatedKind; out[0].index = 0;
+		fill(out[0]);
+		return 1;
+	}
+	// Where each pivot lands: the parts set from the origin first, then
+	// those set on parts already set (a shin on a thigh on a body).
+	for (int i = 0; i < count; ++i) placed[i].set = false;
+	for (int pass = 0, unset = count; pass < count && unset > 0; ++pass)
+		for (int i = 0; i < count; ++i) {
+			const WorldSeatPart &p = pose.parts[i];
+			if (placed[i].set || (p.on >= 0 && (p.on >= count || !placed[p.on].set))) continue;
+			Placed &q = placed[i];
+			const double t = p.angle * M_PI / 180;
+			q.c = cos(t); q.s = sin(t); q.scale = p.scale / 100.0;
+			double x = p.atX, y = p.atY;
+			if (p.on >= 0) {
+				const WorldSeatPart &b = pose.parts[p.on];
+				const Placed &o = placed[p.on];
+				const double px = (p.atX - b.pivotX) * o.scale, py = (p.atY - b.pivotY) * o.scale;
+				x = o.x + px * o.c + py * o.s; y = o.y - px * o.s + py * o.c;
+			}
+			q.x = (int)floor(x); q.y = (int)floor(y);
+			// The part's reach around its pivot, a pixel to spare.
+			double minX = 1e9, maxX = -1e9, minY = 1e9, maxY = -1e9;
+			for (int cx : {p.x0, p.x1}) for (int cy : {p.y0, p.y1}) {
+				const double px = (cx - p.pivotX) * q.scale, py = (cy - p.pivotY) * q.scale;
+				const double rx = px * q.c + py * q.s, ry = -px * q.s + py * q.c;
+				minX = MIN(minX, rx); maxX = MAX(maxX, rx); minY = MIN(minY, ry); maxY = MAX(maxY, ry);
+			}
+			q.left = q.x + (int)minX - 1; q.right = q.x + (int)maxX + 1; q.top = q.y + (int)minY - 1; q.bottom = q.y + (int)maxY + 1;
+			q.set = true; --unset;
+		}
+	int left = INT_MAX, top = INT_MAX, right = INT_MIN, bottom = INT_MIN;
+	for (int i = 0; i < count; ++i) {
+		if (!placed[i].set) return 0;
+		left = MIN(left, placed[i].left); right = MAX(right, placed[i].right);
+		top = MIN(top, placed[i].top); bottom = MAX(bottom, placed[i].bottom);
+	}
+	const int w = right - left + 1, h = bottom - top + 1;
+	Common::Array<byte> pixels[2], mask[2];
+	for (int k = 0; k < 2; ++k) { pixels[k].resize(w * h, 0); mask[k].resize(w * h, 0); }
+	for (int i = 0; i < count; ++i) {
+		const WorldSeatPart &p = pose.parts[i];
+		const Placed &q = placed[i];
+		const int k = p.front ? 1 : 0;
+		for (int y = q.top; y <= q.bottom; ++y) for (int x = q.left; x <= q.right; ++x) {
+			const double X = x - q.x, Y = y - q.y;
+			const int u = (int)floor((X * q.c - Y * q.s) / q.scale + p.pivotX), v = (int)floor((X * q.s + Y * q.c) / q.scale + p.pivotY);
+			if (u < p.x0 || u >= p.x1 || v < p.y0 || v >= p.y1 || !stand.mask[v * stand.width + u]) continue;
+			pixels[k][(y - top) * w + x - left] = stand.pixels[v * stand.width + u]; mask[k][(y - top) * w + x - left] = 1;
+		}
+	}
+	// Both cropped to what either shows.
+	int l = w, r = -1, t = h, b = -1;
+	bool over = false;
+	for (int y = 0; y < h; ++y) for (int x = 0; x < w; ++x)
+		if (mask[0][y * w + x] || mask[1][y * w + x]) {
+			l = MIN(l, x); r = MAX(r, x); t = MIN(t, y); b = MAX(b, y); over = over || mask[1][y * w + x];
+		}
+	if (r < 0) return 0;
+	const int made = over ? 2 : 1;
+	for (int k = 0; k < made; ++k) {
+		ScummverseGuestFrame &f = out[k];
+		f.dir = 1; f.kind = kWorldSeatedKind; f.index = k;
+		f.width = r - l + 1; f.height = b - t + 1;
+		f.dx = stand.dx + (stand.width - f.width) / 2; f.dy = stand.dy + stand.height - f.height;
+		f.pixels.resize(f.width * f.height); f.mask.resize(f.width * f.height);
+		for (int y = 0; y < f.height; ++y) for (int x = 0; x < f.width; ++x) {
+			f.pixels[y * f.width + x] = pixels[k][(t + y) * w + l + x]; f.mask[y * f.width + x] = mask[k][(t + y) * w + l + x];
+		}
+	}
+	fill(out[0]);
+	return made;
+}
