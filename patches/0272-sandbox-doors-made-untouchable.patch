+// From 0272 (the "doors" and "verbs" checks): each door an answer of its
+// game's things file makes untouchable or touchable, in its place, the
+// touches as that answer leaves them (touchesAfter; the answers themselves
+// are the verbs check's). Before it, a door (as its game starts it; a
+// switched one shut aside), a walking tap where a tap takes it on its way
+// through it. After it, made untouchable: no door, a tap there not on its
+// way through it, nor (`verbs`) with a verb chosen used on it, no way
+// through it (travel refuses), on the tour's way still, kept so through a
+// save and a load, and a door again, a tap taking it, once another answer
+// makes it touchable (where one does); made touchable, a door, a tap
+// taking it. One kDoorTouchApart lists: a door all the same, a tap taking
+// it (with a verb chosen, used on it or on its way through it), a thing or
+// not as before. Each as it was again after.
+SandboxEngine::TouchedDoors SandboxEngine::touchedDoors(bool verbs) {
+	TouchedDoors c;
+	// (Those whose games make them so only in a state this engine does not
+	// play, as read with their games' scripts: kDoorTouchApart's, said here
+	// again so that the table is checked against them.)
+	struct Apart { const char *gameid; short room, object; };
+	static const Apart kApart[] = {{"ft", 54, 284}, {"monkey", 48, 597}, {"samnmax", 27, 281}};
+	Common::String problem;
+	const Common::HashMap<int, int> keptPictures = _pictures, keptTouched = _touched;
+	Common::HashMap<int, bool> doors, saved;
+	auto fail = [&](int g, int room, int id, const char *what) {
+		++c.failed;
+		warning("SCUMMVERSE sandbox door %s-%d object %d: %s", kWorldGames[g].gameid, room, id, what);
+	};
+	// (Where a walking tap takes it, as tap finds doors (a pointer over the
+	// scene taking things first: not under one): of the part the scene
+	// shows, the spot nearest its middle; false: none.)
+	auto spotOf = [&](int object, double &x, double &y) {
+		int id, ox, oy, w, h, wx, wy, state;
+		if (!StageBridge::object(object, id, ox, oy, w, h, wx, wy, state)) return false;
+		Common::Array<int> candidates, over;
+		for (int i = 0; i < StageBridge::objectCount(); ++i) {
+			int oid, x_, y_, w_, h_, wx_, wy_, state_;
+			const bool ride = StageBridge::object(i, oid, x_, y_, w_, h_, wx_, wy_, state_) && worldRideAt(_game, _room, oid);
+			if ((isDoor(i) && !insideShut(i)) || ride) candidates.push_back(i);
+			if (i != object && PanelBridge::over() && isThing(i) && !isDoor(i)) over.push_back(i);
+		}
+		const int x0 = MAX(0, ox), y0 = MAX(0, oy), x1 = MIN(StageBridge::sceneWidth(), ox + w), y1 = MIN(StageBridge::sceneHeight(), oy + h);
+		const double cx = (x0 + x1) / 2.0, cy = (y0 + y1) / 2.0;
+		const int bottom = PanelBridge::loaded() && !PanelBridge::over() ? PanelBridge::top() : _height;
+		double best = -1;
+		for (int a = 0; a <= 8 && x0 < x1 && y0 < y1; ++a)
+			for (int b = 0; b <= 8; ++b) {
+				const double px = x0 + (x1 - x0 - 1) * a / 8.0, py = y0 + (y1 - y0 - 1) * b / 8.0, d = (px - cx) * (px - cx) + (py - cy) * (py - cy);
+				int sx, sy;
+				double tx, ty;
+				StageBridge::lookAt(px);
+				StageBridge::toScreen(px, py, sx, sy);
+				if (sx < 0 || sx >= _width || sy < 0 || sy >= bottom || (best >= 0 && d >= best)) continue;
+				StageBridge::toScene(sx, sy, tx, ty);
+				if (StageBridge::objectAt(tx, ty, candidates.data(), candidates.size(), 4) == object && StageBridge::objectAt(tx, ty, over.data(), over.size(), 2) < 0) { best = d; x = px; y = py; }
+			}
+		return best >= 0;
+	};
+	auto tapAt = [&](double x, double y) {
+		int sx, sy;
+		StageBridge::lookAt(x);
+		StageBridge::toScreen(x, y, sx, sy);
+		tap(CLIP(sx, 0, _width - 1), CLIP(sy, 0, _height - 1));
+	};
+	// (After a tap: nothing under way, nothing chosen, in its place again.)
+	auto settleBack = [&](int g, int room) {
+		if (_holding.kind) letGo();
+		_door = -1; _doorGoalLink = -1; _opening = 0; _action = 0; _target = -1; _pairing = Pair();
+		PanelBridge::select(-1);
+		sentence("");
+		if (_player >= 0) StageBridge::stop(_player);
+		_wayBack = WayBack(); _noWayOn = false;
+		if (_game != g || _room != room) enter(g, room, 0, problem);
+	};
+	// (A verb chosen as a player chooses it, Open or else Look, else another
+	// that is no walk, nor named where it is, nor of two things; none in a
+	// coin game or Loom's. Its kind; 0: none.)
+	auto pickVerb = [&]() {
+		if (!PanelBridge::loaded() || PanelBridge::coin() || PanelBridge::distaff()) return 0;
+		for (int pass = 0; pass < 2; ++pass)
+			for (int v = 0; v < PanelBridge::verbCount(); ++v) {
+				const int kind = PanelBridge::verbKind(v);
+				if (pass ? kind == kWorldVerbWalk || kind == kWorldVerbWhatIs || twoThings(kind, false) : kind != kWorldVerbOpen && kind != kWorldVerbLook) continue;
+				if (!PanelBridge::verbShown(v) && !PanelBridge::over()) continue;
+				PanelBridge::select(v);
+				return kind;
+			}
+		return 0;
+	};
+	for (int g = 0; g < worldGameCount(); ++g) {
+		const WorldMap *map = worldMap(g);
+		if (!map) continue;
+		loadThings(g);
+		if (!PanelBridge::thingsTouch(g)) continue;
+		// (Each door's first record that makes it touchable: "again".)
+		Common::HashMap<int, int> makes;
+		for (int k = 0; k < PanelBridge::effectCount(g); ++k) {
+			int room, id, kind, from, with = 0, touched[3 * 64], count, self;
+			if (!PanelBridge::effectAt(g, k, room, id, kind, from, &with) || !PanelBridge::answerTouches(g, room, id, kind, from, with, touched, count, 64, self)) continue;
+			for (int t = 0; t < count + (self ? 1 : 0); ++t) {
+				const int r = t < count ? touched[3 * t] : room, door = t < count ? touched[3 * t + 1] : id, touch = t < count ? touched[3 * t + 2] : self;
+				if (touch == kTouchedTouchable && worldLinkFrom(g, r, door) && !makes.contains(thingKey(g, r, door))) makes[thingKey(g, r, door)] = k;
+			}
+		}
+		for (int k = 0; k < PanelBridge::effectCount(g); ++k) {
+			int room, id, kind, from, with = 0, touched[3 * 64], count, self;
+			if (!PanelBridge::effectAt(g, k, room, id, kind, from, &with) || !PanelBridge::answerTouches(g, room, id, kind, from, with, touched, count, 64, self)) continue;
+			for (int t = 0; t < count + (self ? 1 : 0); ++t) {
+				const int r = t < count ? touched[3 * t] : room, door = t < count ? touched[3 * t + 1] : id, touch = t < count ? touched[3 * t + 2] : self;
+				const WorldLink *link = worldLinkFrom(g, r, door);
+				if (!link || link->target == r || !installed(g, r) || !installed(g, link->target)) continue;
+				_pictures = keptPictures; _touched = keptTouched;
+				_touched.erase(thingKey(g, r, door));
+				if (!enter(g, r, 0, problem)) { fail(g, r, door, "its place not shown"); continue; }
+				_wayBack = WayBack(); _noWayOn = false;
+				int o = -1;
+				for (int i = 0; i < StageBridge::objectCount() && o < 0; ++i) {
+					int oid, ox, oy, w, h, wx, wy, state;
+					if (StageBridge::object(i, oid, ox, oy, w, h, wx, wy, state) && oid == door) o = i;
+				}
+				if (o < 0 || insideShut(o) || !isDoor(o)) continue;
+				++c.records;
+				doors[thingKey(g, r, door)] = true;
+				const int index = link - map->links;
+				bool apart = false;
+				for (const Apart &a : kApart) apart = apart || (sameId(kWorldGames[g].gameid, a.gameid) && a.room == r && a.object == door);
+				const bool blocks = touch == kTouchedUntouchable && !apart, thing = isThing(o);
+				auto toward = [&]() { return _door == index || _room == link->target; };
+				// Before: a walking tap where a tap takes it, on its way through it.
+				double x = 0, y = 0;
+				bool spot = spotOf(o, x, y);
+				if (spot) {
+					tapAt(x, y);
+					spot = toward(); // (someone in front of it here: no tap on it)
+					settleBack(g, r);
+				}
+				// After.
+				touchesAfter(g, room, id, kind, from, with);
+				if (isDoor(o) == blocks) {
+					fail(g, r, door, blocks ? "a door still once an answer made it untouchable" : apart && touch == kTouchedUntouchable ?
+						"no door once an answer made it untouchable in a state this engine does not play" : "no door once an answer made it touchable");
+					continue;
+				}
+				if (apart && isThing(o) != thing) fail(g, r, door, "a thing or not otherwise once an answer made it untouchable in a state this engine does not play");
+				if (spot) {
+					tapAt(x, y);
+					const bool went = toward();
+					settleBack(g, r);
+					if (went == blocks) fail(g, r, door, blocks ? "a tap there on its way through it once an answer made it untouchable" : "a tap there not on its way through it once an answer made it touchable");
+				}
+				if (verbs && spot && (blocks || apart) && pickVerb()) {
+					c.verbTaps += blocks;
+					tapAt(x, y);
+					const bool used = _target == o && _action, went = toward();
+					settleBack(g, r);
+					if (blocks && (used || went)) fail(g, r, door, "with a verb chosen, a tap there used it on it or went on its way through it once an answer made it untouchable");
+					if (!blocks && !used && !went) fail(g, r, door, "with a verb chosen, a tap there neither used it on it nor went on its way through it");
+				}
+				if (!blocks) { if (apart) ++c.apart; else ++c.opened; continue; }
+				++c.blocked;
+				// (No way through it: travel refuses; on the tour's way still.)
+				if (doorAllowed(r, door) || travel(index) || _room != r) { fail(g, r, door, "gone through once an answer made it untouchable"); settleBack(g, r); }
+				{
+					const bool on = _touring.on, paused = _touring.paused;
+					_touring.on = true; _touring.paused = false;
+					const bool onTheWay = isDoor(o);
+					_touring.on = on; _touring.paused = paused;
+					if (!onTheWay) fail(g, r, door, "off the tour's way once an answer made it untouchable");
+				}
+				// (Kept so through a save and a load: once a door.)
+				if (!saved.contains(thingKey(g, r, door))) {
+					saved[thingKey(g, r, door)] = true;
+					const Common::Array<Carried> carried = _carried, away = _carriedAway;
+					const Common::HashMap<int, int> now = _touched;
+					saveState();
+					_touched.clear(); _carried.clear(); _carriedAway.clear(); PanelBridge::clearItems();
+					int sg, sr;
+					double sx, sy;
+					if (!loadState(sg, sr, sx, sy) || isDoor(o) || !_touched.contains(thingKey(g, r, door))) fail(g, r, door, "not kept untouchable through a save and a load");
+					else ++c.kept;
+					// (Carried as before.)
+					_touched = now; _carried.clear(); PanelBridge::clearItems();
+					for (const Carried &a : carried) carry(a.game, a.room, a.id, a.name, a.picture, false);
+					_carriedAway = away;
+				}
+				// (A door again once another answer makes it touchable.)
+				if (makes.contains(thingKey(g, r, door))) {
+					int aRoom, aId, aKind, aFrom, aWith = 0;
+					PanelBridge::effectAt(g, makes[thingKey(g, r, door)], aRoom, aId, aKind, aFrom, &aWith);
+					touchesAfter(g, aRoom, aId, aKind, aFrom, aWith);
+					bool again = isDoor(o);
+					if (again && spot) {
+						tapAt(x, y);
+						again = toward();
+						settleBack(g, r);
+					}
+					if (again) ++c.restored;
+					else fail(g, r, door, "no door, or a tap there not on its way through it, once another answer made it touchable again");
+				}
+			}
+		}
+	}
+	c.doors = doors.size();
+	_pictures = keptPictures; _touched = keptTouched;
+	return c;
+}
