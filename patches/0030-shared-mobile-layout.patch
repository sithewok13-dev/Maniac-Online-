diff --git a/common/scummverse_layout.h b/common/scummverse_layout.h
new file mode 100644
index 00000000..f5015ad8
--- /dev/null
+++ b/common/scummverse_layout.h
@@ -0,0 +1,23 @@
+// Scummverse portable portrait layout contract v1. GPL-3.0-or-later.
+#ifndef COMMON_SCUMMVERSE_LAYOUT_H
+#define COMMON_SCUMMVERSE_LAYOUT_H
+namespace Scummverse {
+struct PortraitLayout {
+ double gameHeight, toolbarTop, toolbarHeight, chatTop, chatHeight;
+};
+// All dimensions are host-view points, after the platform applies top/side
+// safe areas. bottomInset is the larger of the keyboard overlap and safe bottom.
+// The engine fits the original aspect ratio inside gameHeight. No world state.
+inline PortraitLayout portraitLayout(double height, double bottomInset) {
+ if (!(height > 0)) return {0, 0, 0, 0, 0};
+ if (!(bottomInset > 0)) bottomInset = 0;
+ if (bottomInset > height) bottomInset = height;
+ const double available = height - bottomInset;
+ const double chatMinimum = available < 160 ? available : 160;
+ double top = available - chatMinimum;
+ if (top > height / 2) top = height / 2;
+ const double toolbar = top < 88 ? top / 2 : 44;
+ return {top - toolbar, top - toolbar, toolbar, top, available - top};
+}
+}
+#endif
