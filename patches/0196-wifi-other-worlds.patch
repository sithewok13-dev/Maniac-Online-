+// A player's room is the mansion's own (1..255) or, from 0196, a place in
+// another world: kWorldPlace + game * 1024 + that game's room (each device
+// keeps such a place in a slot room of its own, so the place is sent).
+enum { kWorldPlace = 4096 };
+inline int worldPlace(int game, int room) { return kWorldPlace + game * 1024 + room; }
+inline bool isWorldPlace(int room) { return room >= kWorldPlace && room < 65536; }
