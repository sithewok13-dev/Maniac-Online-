+// (kWorldStoryWants: films, voices, music), in words for Story mode's list
+// ("films and voices"); empty when nothing is missing.
+inline Common::String storyLacks(const char *gameid, const Common::Path &path) {
+	const WorldCatalog::WorldStoryWants *wants = WorldCatalog::worldStoryWants(gameid);
+	if (!wants) return Common::String();
+	Common::FSList top;
+	if (!Common::FSNode(path).getChildren(top, Common::FSNode::kListAll)) return Common::String();
+	bool voices = !wants->voices, music = !wants->music, films = !wants->films;
+	// (In its folder or one of its data, video or resource folders, as the
+	// engine looks: The Curse keeps its voices and music with its films.)
+	Common::FSList files;
+	for (const Common::FSNode &entry : top) {
+		const Common::String name = entry.getName();
+		if (!entry.isDirectory()) { files.push_back(entry); continue; }
+		if (!name.equalsIgnoreCase("data") && !name.equalsIgnoreCase("video") && !name.equalsIgnoreCase("resource")) continue;
+		Common::FSList inner;
+		if (!entry.getChildren(inner, Common::FSNode::kListFilesOnly)) continue;
+		for (const Common::FSNode &f : inner) {
+			files.push_back(f);
+			films = films || (name.equalsIgnoreCase(wants->films) && f.getName().hasSuffixIgnoreCase(".san"));
+		}
+	}
+	for (const Common::FSNode &f : files) {
+		voices = voices || f.getName().equalsIgnoreCase(wants->voices);
+		music = music || f.getName().equalsIgnoreCase(wants->music);
+	}
+	Common::StringArray missing;
+	if (!films) missing.push_back("films");
+	if (!voices) missing.push_back("voices");
+	if (!music) missing.push_back("music");
+	Common::String words;
+	for (uint i = 0; i < missing.size(); ++i) words += (i == 0 ? "" : i + 1 == missing.size() ? " and " : ", ") + missing[i];
+	return words;
+}
