+// Story mode's home (common/scummverse_story.h: Story mode and Explore mode
+// kept apart): the list of the stories found here (Continue where one has a
+// save, Start where not, or what it still needs), and the way to Explore
+// mode. The phone's own list (scummversePlaces*, over no game); without one
+// (the desktop's builds), the configuration's scummverse_story_choices, game
+// ids or "explore" taken in turn (the tests), else Explore. next is what is
+// chosen: a story (from its newest save, as it starts) or the mansion (where
+// it was, its slot 100), Explore mode then set; empty if the app is stopping.
+static Common::Path scummverseManiacPath; // (the mansion's folder, as it started: its own story's)
+static void scummverseStoryList(const Common::String &maniacTarget, Common::String &next, int &slot) {
+	using namespace Scummverse::WorldCatalog;
+	next.clear();
+	slot = -1;
+	// (Nothing to go on in at the next start: the list, until a game is
+	// chosen and played a while.)
+	if (ConfMan.hasKey(Scummverse::kStoryPlayingKey, Common::ConfigManager::kApplicationDomain)) {
+		ConfMan.removeKey(Scummverse::kStoryPlayingKey, Common::ConfigManager::kApplicationDomain);
+		ConfMan.flushToDisk();
+	}
+	Common::Array<int> games;
+	Common::StringArray labels;
+	Common::Array<bool> ready;
+	Common::SaveFileManager *saves = g_system->getSavefileManager();
+	for (int g = 0; g < worldGameCount(); ++g) {
+		const Common::String target = Common::String(kWorldStoryPrefix) + kWorldGames[g].gameid;
+		// (A folder added since the app started gets its target now.)
+		Scummverse::addStoryTarget(kWorldGames[g], scummverseManiacPath);
+		if (!ConfMan.hasGameDomain(target) || !ConfMan.hasKey("path", target)) continue;
+		const Common::Path path = ConfMan.getPath("path", target);
+		const Common::FSNode folder(path);
+		if (!folder.exists() || !folder.isDirectory()) continue;
+		Common::String title = kWorldGames[g].title;
+		if (sameId(kWorldGames[g].gameid, "maniac")) title += " (original story)";
+		Common::String missing = Scummverse::storyMissing(kWorldGames[g].gameid, path);
+		missing.toUppercase();
+		Common::ScopedPtr<Common::InSaveFile> story(saves->openForLoading(target + Common::String::format(".s%02d", kWorldStorySlot)));
+		Common::ScopedPtr<Common::InSaveFile> autosave(story ? nullptr : saves->openForLoading(target + ".s00"));
+		// (A copy without its films, voices or music plays on without them: said.)
+		const Common::String lacks = Scummverse::storyLacks(kWorldGames[g].gameid, path);
+		labels.push_back(!missing.empty() ? Common::String::format("%s (needs %s)", title.c_str(), missing.c_str()) :
+			Common::String::format("%s %s%s", story || autosave ? "Continue" : "Start", title.c_str(), lacks.empty() ? "" : (" (no " + lacks + ")").c_str()));
+		if (!lacks.empty()) warning("SCUMMVERSE: %s plays without its %s", target.c_str(), lacks.c_str());
+		games.push_back(g);
+		ready.push_back(missing.empty());
+	}
+	int chosen = -1; // (a catalog index; -1 Explore)
+	bool stopping = false;
+#ifdef SCUMMVERSE_LOCAL_AI
+	scummverseStoryPlaying(kWorldStoryListShowing);
+	scummverseWorldPoll(); // (a request left from a game: not for the list)
+	for (;;) {
+		scummversePlacesBegin("Story mode");
+		for (uint i = 0; i < games.size(); ++i) scummversePlacesItem(labels[i].c_str(), kWorldStoryRequest + games[i]);
+		scummversePlacesItem("Explore mode (the mansion, other worlds)", kWorldStoryExploreRequest);
+		scummversePlacesCancel(kWorldStoryHomeRequest);
+		scummversePlacesShow();
+		int request = 0;
+		while (!stopping && !(request = scummverseWorldPoll())) {
+			Common::Event event;
+			while (g_system->getEventManager()->pollEvent(event)) {}
+			stopping = g_system->getEventManager()->shouldQuit();
+			g_system->delayMillis(30);
+		}
+		if (stopping || request == kWorldStoryExploreRequest) break;
+		for (uint i = 0; i < games.size(); ++i)
+			if (kWorldStoryRequest + games[i] == request && ready[i]) chosen = games[i];
+		if (chosen >= 0) break;
+		// (Closed unchosen, or a game that needs files: the list again.)
+		g_system->delayMillis(300);
+	}
+	// (Withdrawn, chosen or not: a list still coming up never appears later.)
+	scummversePlacesHide();
+	scummverseStoryPlaying(-1);
+#else
+	Common::StringArray choices = Common::StringTokenizer(ConfMan.get("scummverse_story_choices", Common::ConfigManager::kApplicationDomain), ",").split();
+	if (!choices.empty()) {
+		for (uint i = 0; i < games.size(); ++i)
+			if (ready[i] && choices[0].equalsIgnoreCase(kWorldGames[games[i]].gameid)) chosen = games[i];
+		choices.remove_at(0);
+		Common::String rest;
+		for (uint i = 0; i < choices.size(); ++i) rest += (i ? "," : "") + choices[i];
+		ConfMan.set("scummverse_story_choices", rest, Common::ConfigManager::kApplicationDomain);
+	}
+#endif
+	if (stopping) return;
+	if (chosen < 0) {
+		warning("SCUMMVERSE: Explore mode");
+		Scummverse::setStoryMode(false);
+		scummverseStoryHome(maniacTarget, next, slot);
+		return;
+	}
+	next = Common::String(kWorldStoryPrefix) + kWorldGames[chosen].gameid;
+	warning("SCUMMVERSE: Story mode: %s", next.c_str());
+}
+
+// What follows a run that left nothing to start: in Story mode its list; a
+// story in Explore mode (the tests' way, the mansion's own menu) brings the
+// mansion back where it was.
+static bool scummverseNothingNext(const Common::String &maniacTarget, bool storyRun, Common::String &next, int &slot) {
+	if (Scummverse::storyMode()) scummverseStoryList(maniacTarget, next, slot);
+	else if (storyRun) scummverseStoryHome(maniacTarget, next, slot);
+	return !next.empty();
+}
