+// Story mode or Explore mode: the app's two ways to play, kept apart. Story
+// mode plays the original games, each as it was made, from a list of them
+// (its home, base/main.cpp); Explore mode is the mansion, the other worlds
+// and the new engine. Kept in the application domain; Explore when unset.
+static const char *const kModeKey = "scummverse_mode";
+inline bool storyMode() {
+	return ConfMan.hasKey(kModeKey, Common::ConfigManager::kApplicationDomain) &&
+		ConfMan.get(kModeKey, Common::ConfigManager::kApplicationDomain) == "story";
+}
+inline void setStoryMode(bool story) {
+	ConfMan.set(kModeKey, story ? "story" : "explore", Common::ConfigManager::kApplicationDomain);
+	ConfMan.flushToDisk();
+}
+
