+		for (const char *addition : {"scummverse_roaming", "scummverse_exploration_doors", "scummverse_exploration_safety"})
+			ConfMan.setBool(addition, false, target);
+	}
 	return true;
 }
 
+// A file a game's story cannot go on without (kWorldStoryNeeds) missing
+// from its folder (as the engine looks: there, or in its data, video or
+// resource folder, any case): its name, else empty. (Such a game's engine
+// would stop the app as it starts.)
+inline Common::String storyMissing(const char *gameid, const Common::Path &path) {
+	const char *const *needs = WorldCatalog::worldStoryNeeds(gameid);
+	if (!needs) return Common::String();
+	Common::FSList files, top;
+	const Common::FSNode folder(path);
+	if (!folder.getChildren(top, Common::FSNode::kListAll)) return Common::String(needs[0]);
+	for (const Common::FSNode &entry : top) {
+		const Common::String name = entry.getName();
+		if (!entry.isDirectory()) files.push_back(entry);
+		else if (name.equalsIgnoreCase("data") || name.equalsIgnoreCase("video") || name.equalsIgnoreCase("resource")) {
+			Common::FSList inner;
+			if (entry.getChildren(inner, Common::FSNode::kListFilesOnly)) for (const Common::FSNode &f : inner) files.push_back(f);
+		}
+	}
+	for (int i = 0; needs[i]; ++i) {
+		bool found = false;
+		for (const Common::FSNode &entry : files) found = found || entry.getName().equalsIgnoreCase(needs[i]);
+		if (!found) return Common::String(needs[i]);
+	}
+	return Common::String();
+}
+
+// The story playing when the app was put away or stopped (its target), so
+// the next start goes on in it; set once a story has played a few seconds
+// (a game that stops the app as it starts is not opened again and again),
+// cleared when the mansion starts again.
+static const char *const kStoryPlayingKey = "scummverse_story_playing";
+
+// The story to go on in at this start: its target, else empty (none, or
+// its folder or a file it needs is gone).
+inline Common::String storyToResume() {
+	if (!ConfMan.hasKey(kStoryPlayingKey, Common::ConfigManager::kApplicationDomain)) return Common::String();
+	const Common::String target = ConfMan.get(kStoryPlayingKey, Common::ConfigManager::kApplicationDomain);
+	if (!target.hasPrefixIgnoreCase(WorldCatalog::kWorldStoryPrefix) || !ConfMan.hasGameDomain(target)) return Common::String();
+	const Common::ConfigManager::Domain *domain = ConfMan.getDomain(target);
+	if (!domain->contains("scummverse_story") || !domain->contains("gameid") || !domain->contains("path")) return Common::String();
+	const Common::Path path = ConfMan.getPath("path", target);
+	const Common::FSNode folder(path);
+	if (!folder.exists() || !folder.isDirectory()) return Common::String();
+	if (!storyMissing(domain->getVal("gameid").c_str(), path).empty()) return Common::String();
+	return target;
+}
+
 } // End of namespace Scummverse
 
 #endif
