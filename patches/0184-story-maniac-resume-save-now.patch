-inline bool addStoryTarget(const WorldCatalog::WorldGame &game) {
-	if (WorldCatalog::sameId(game.gameid, "maniac")) return false;
-	const Common::FSNode folder = worldFolder(game.folder);
+// found (false when it is not). The mansion's own story is the mansion's
+// data (maniacPath: the folder the mansion itself plays from, its edition
+// the one the mansion checks) with none of the mansion's additions; it is
+// left as it was when that folder is not known.
+inline bool addStoryTarget(const WorldCatalog::WorldGame &game, const Common::Path &maniacPath = Common::Path()) {
+	const bool mansion = WorldCatalog::sameId(game.gameid, "maniac");
+	if (mansion && maniacPath.empty()) return false;
+	const Common::FSNode folder = mansion ? Common::FSNode(maniacPath) : worldFolder(game.folder);
 	if (!folder.exists() || !folder.isDirectory()) return false;
 	const Common::String target = Common::String(WorldCatalog::kWorldStoryPrefix) + game.gameid;
 	if (!ConfMan.hasGameDomain(target)) ConfMan.addGameDomain(target);
 	ConfMan.set("engineid", "scumm", target);
