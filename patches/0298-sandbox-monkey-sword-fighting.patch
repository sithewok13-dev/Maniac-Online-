+// ---- Choices (from 0298) ----
+
+Panel::ChoiceLayout Panel::choiceLayout(int screenWidth, int screenHeight) const {
+	ChoiceLayout l;
+	if (!_loaded || _choices.empty() || screenWidth <= 0 || screenHeight <= 0) return l;
+	l.font = _source.fonts[0].height > 0 ? 0 : 1;
+	// (At the panel's scale, as its verbs; laid out not yet, the screen's.)
+	l.colScale = _colScale > 0 && _screenWidth == screenWidth ? _colScale : (double)screenWidth / std::max(1, _source.screenWidth);
+	l.rowScale = _rowScale > 0 && _screenWidth == screenWidth ? _rowScale : l.colScale;
+	l.lineHeight = std::max(1, (int)std::lround((_source.fonts[l.font].height + 1) * l.rowScale));
+	const int least = std::max(1, screenHeight / kChoiceRows), most = std::max(least, screenHeight / 2);
+	// (Its text 4 of the panel's columns in, 2 of its rows apart.)
+	const int margin = std::max(1, (int)std::lround(4 * l.colScale)), gap = std::max(1, (int)std::lround(2 * l.rowScale));
+	// (A row's height for its lines; with arrows, the text narrower by them.)
+	auto linesOf = [&](const std::string &text, int width) {
+		std::vector<std::string> lines = wrap(l.font, text, std::max(8, (int)((width - 2 * margin) / l.colScale)));
+		if (lines.empty()) lines.push_back("");
+		if (lines.size() > 2) { lines.resize(2); lines[1] += "..."; }
+		return lines;
+	};
+	auto heightOf = [&](size_t lines) { return std::max(least, (int)lines * l.lineHeight + 2 * gap); };
+	// (Across the panel's own columns, as its verbs: on a phone in landscape
+	// clear of what covers its sides, the notch.)
+	const bool laid = _colScale > 0 && _screenWidth == screenWidth && _columns > 0;
+	const int left = laid ? std::max(0, std::min(_left, screenWidth - 1)) : 0, across = laid ? std::min(_columns, screenWidth - left) : screenWidth;
+	int total = 0;
+	for (const std::string &c : _choices) total += heightOf(linesOf(c, across).size());
+	const bool arrows = total > most;
+	const int arrowWidth = arrows ? std::min(across / 4, std::max(least, (int)std::lround(24 * l.colScale))) : 0, width = across - arrowWidth;
+	const int first = arrows ? std::max(0, std::min(_choiceFirst, (int)_choices.size() - 1)) : 0;
+	int height = 0;
+	for (int k = first; k < (int)_choices.size(); ++k) {
+		const std::vector<std::string> lines = linesOf(_choices[k], width);
+		const int h = heightOf(lines.size());
+		if (!l.rows.empty() && height + h > most) break;
+		l.rows.push_back(Rect(left, height, width, h)); l.index.push_back(k); l.lines.push_back(lines);
+		height += h;
+	}
+	// (As tall as the panel at least: its verbs not shown meanwhile.)
+	height = std::max(height, std::min(screenHeight, _screenRows));
+	const int top = screenHeight - height;
+	l.box = Rect(left, top, across, height);
+	for (Rect &r : l.rows) r.y += top;
+	if (arrows) {
+		if (first > 0) l.up = Rect(left + width, top, arrowWidth, height / 2);
+		if (l.index.back() + 1 < (int)_choices.size()) l.down = Rect(left + width, top + height / 2, arrowWidth, height - height / 2);
+	}
+	return l;
+}
+
+int Panel::choiceAt(int screenX, int screenY, int screenWidth, int screenHeight) const {
+	const ChoiceLayout l = choiceLayout(screenWidth, screenHeight);
+	if (!l.box.contains(screenX, screenY)) return kChoiceOff;
+	if (l.up.contains(screenX, screenY)) return kChoiceUp;
+	if (l.down.contains(screenX, screenY)) return kChoiceDown;
+	for (size_t k = 0; k < l.rows.size(); ++k) if (l.rows[k].contains(screenX, screenY)) return l.index[k];
+	return kChoiceNone;
+}
+
+void Panel::scrollChoices(int by, int screenWidth, int screenHeight) {
+	const ChoiceLayout l = choiceLayout(screenWidth, screenHeight);
+	if (l.rows.empty() || (by < 0 && !l.up.width) || (by > 0 && !l.down.width)) return;
+	_choiceFirst = std::max(0, std::min((int)_choices.size() - 1, _choiceFirst + (by < 0 ? -1 : 1)));
+	++_choiceStamp;
+}
+
+Rect Panel::choiceOnScreen(int index, int screenWidth, int screenHeight) const {
+	const ChoiceLayout l = choiceLayout(screenWidth, screenHeight);
+	for (size_t k = 0; k < l.rows.size(); ++k) if (l.index[k] == index) return l.rows[k];
+	return Rect();
+}
+
+Rect Panel::choicesOnScreen(int screenWidth, int screenHeight) const { return choiceLayout(screenWidth, screenHeight).box; }
+
+void Panel::renderChoices(uint32_t *screen, int pitch, int screenWidth, int screenHeight) const {
+	const ChoiceLayout l = choiceLayout(screenWidth, screenHeight);
+	if (!screen || l.box.width <= 0) return;
+	for (int y = std::max(0, l.box.y); y < std::min(screenHeight, l.box.y + l.box.height); ++y)
+		for (int x = std::max(0, l.box.x); x < std::min(screenWidth, l.box.x + l.box.width); ++x) screen[(size_t)y * pitch + x] = 0xFF000000u;
+	const uint32_t ink = color(_source.sentenceColor), lit = color(_source.talkColor);
+	const int margin = std::max(1, (int)std::lround(4 * l.colScale));
+	for (size_t k = 0; k < l.rows.size(); ++k) {
+		const Rect &r = l.rows[k];
+		int y = r.y + (r.height - (int)l.lines[k].size() * l.lineHeight) / 2;
+		for (const std::string &each : l.lines[k]) {
+			line(screen, pitch, std::min(screenWidth, r.x + r.width), screenHeight, l.font, each, r.x + margin, y, l.rowScale, l.colScale, l.index[k] == _choiceLit ? lit : ink);
+			y += l.lineHeight;
+		}
+	}
+	// (Its arrows: triangles in their halves, pointing their way.)
+	for (int a = 0; a < 2; ++a) {
+		const Rect &r = a ? l.down : l.up;
+		if (r.width <= 0 || r.height <= 0) continue;
+		const int side = std::min(r.width, r.height) / 2, cx = r.x + r.width / 2, cy = r.y + r.height / 2;
+		for (int y = 0; y < side; ++y) {
+			const int half = (a ? side - 1 - y : y) / 2;
+			const int row = cy - side / 2 + y;
+			if (row < 0 || row >= screenHeight) continue;
+			for (int x = cx - half; x <= cx + half; ++x) if (x >= 0 && x < screenWidth) screen[(size_t)row * pitch + x] = ink;
+		}
+	}
+}
+
 } // End of namespace Panel
 
