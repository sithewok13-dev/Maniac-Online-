+		if (actor == ego) s.speaker = Duel::kSpeakerPlayed;
+		else if (actor == other && actor > 0 && actor < _numActors) { s.speaker = Duel::kSpeakerOpponent; s.color = _actors[actor]->_talkColor; }
+		else { s.speaker = Duel::kSpeakerNone; s.color = actor > 0 && actor < _numActors ? _actors[actor]->_talkColor : _string[0].color; }
+		r.lines.back().push_back(s);
+	};
+	auto frame = [&]() {
+		VAR(VAR_HAVE_MSG) = 0;
+		_talkDelay = 0; _drawObjectQueNr = 0;
+		for (uint s = 0; s < NUM_SCRIPT_SLOT; ++s) if (vm.slot[s].status == ssPaused) { vm.slot[s].delay = 0; vm.slot[s].status = ssRunning; }
