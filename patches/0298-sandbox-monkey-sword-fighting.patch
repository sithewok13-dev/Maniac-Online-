+	};
+	auto lines = [&](const Run &r, uint segment) { return segment < r.lines.size() ? r.lines[segment] : Common::Array<Said>(); };
+	auto file1 = [&](int kind, int which, const Common::Array<Said> &said) {
+		for (const Said &s : said) DuelBridge::addLine(kind, which, s.speaker, s.color, s.text.c_str());
+	};
+	const uint32 seed = 0x5D0E1;
+	// ---- The numbers. ----
+	// (The comebacks each insult takes, as the fight's script sets string 29
+	// up (its setup, to its first break), and its target with each opponent.)
+	int accepted[3 * Duel::kMostInsults] = {};
+	int targets[2] = {0, 0};
