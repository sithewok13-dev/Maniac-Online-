+// Someone here to talk to so: the master in her place (not yet beaten, not
+// gone into her house), or a pirate met on the map.
+bool SandboxEngine::duelOpponent(int person) const {
+	const WorldDuel *w = _game >= 0 ? worldDuel(_game) : nullptr;
+	if (!w || person < 0 || person >= (int)_onStage.size() || person == _player || StageBridge::hidden(person)) return false;
+	for (int p : _duelPirates) if (p == person) return true;
+	return _room == w->masterRoom && !_duelGone && !keptValue(_game, w->won) && _onStage[person] == worldAppearanceKey(_game, w->masterCostume);
+}
