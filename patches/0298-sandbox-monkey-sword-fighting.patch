+		}
+		if (!r.ended || r.menus.size() != feed.size()) mismatch("a pirate's talk", r.menus.size(), c);
+		if (trained && (readVar(kMode) != kModePirate || readVar(kTurnOf) != ego)) mismatch("a pirate's fight, the one played first", readVar(kMode), readVar(kTurnOf));
+		if (c == 0 && (readVar(w->secondAsked) != 1 || readVar(w->met) != 4)) mismatch("a pirate's talk's values", readVar(w->secondAsked), readVar(w->met));
+	}
+	// ---- The trainer (57): trained already; the training, paid for with
+	// the sword carried (its first knock, the asking and the paying done:
+	// bits 74, 106 and 107), its cut-scene skipped as a player skips it. ----
+	{
+		fresh(seed);
+		scene(w->trainRoom, false);
+		writeVar(w->trained, 1); bit(kKnocked, 1);
+		play(w->trainScript, {}, kTrainer, Common::Array<int>(), false, -1, r);
+		file1(Duel::kLineTrained, 0, lines(r, 0));
+		if (!r.ended || lines(r, 0).empty()) mismatch("the trainer, trained already", lines(r, 0).size(), 0);
+		fresh(seed);
+		scene(w->trainRoom, false);
+		writeVar(w->trained, 0); bit(kKnocked, 1); bit(kAskedTraining, 1); bit(kPaidTraining, 1);
+		putOwner(w->sword, ego); writeVar(kPurse, 100);
+		for (int n = 1; n < w->fallbackFrom; ++n) bit(w->insultBits + n, 0);
+		for (int n = 1; n < w->loseFrom; ++n) bit(w->comebackBits + n, 0);
+		Common::Array<int> feed;
+		feed.push_back(120);
+		play(w->trainScript, {}, kTrainer, feed, true, -1, r);
+		file1(Duel::kLineTraining, 0, lines(r, 0));
+		if (!r.menus.empty() && !r.menus[0].ids.empty() && r.menus[0].ids[0] == 120) DuelBridge::addLine(Duel::kLineTraining, 0, Duel::kSpeakerPlayed, -1, r.menus[0].texts[0].c_str());
+		else mismatch("the trainer's choice to train", r.menus.size(), 0);
+		file1(Duel::kLineTraining, 0, lines(r, 1));
+		bool taught = r.ended && readVar(w->trained) == 1;
+		for (int n = 1; n < w->fallbackFrom; ++n) taught = taught && bitOf(w->insultBits + n) == (n == w->taught[0] || n == w->taught[1]);
+		for (int n = 1; n < w->loseFrom; ++n) taught = taught && bitOf(w->comebackBits + n) == (n == w->taught[0] || n == w->taught[1]);
+		if (!taught) mismatch("the trainer's teaching", readVar(w->trained), r.ended);
+	}
+	// ---- The map: a pirate from the visit after `mapVisits` on (the map's
+	// entry, its local script 202 each), three once trained. ----
+	for (int c = 0; c < 3 && !shouldQuit(); ++c) {
+		fresh(seed);
+		writeVar(w->visits, c == 0 ? w->mapVisits : w->mapVisits + 1); writeVar(w->trained, c == 2); writeVar(w->trialsVar, 0);
+		writeVar(kCameFrom, 0);
+		if (VAR_DEBUGMODE != 0xFF) VAR(VAR_DEBUGMODE) = 0;
+		scene(w->mapRoom, true);
+		int pirates = 0;
+		for (uint s = 0; s < NUM_SCRIPT_SLOT; ++s) pirates += vm.slot[s].status != ssDead && vm.slot[s].number == kWanders;
+		if (pirates != (c == 0 ? 0 : c == 1 ? 1 : 3)) mismatch("pirates on the map", pirates, c);
+	}
+	quiet();
+	scummverseRestore(kept);
+	_sentenceNum = 0; _drawObjectQueNr = 0;
+	if (shouldQuit()) { problem = "stopped"; return false; }
+	const int size = DuelBridge::written(nullptr, 0);
+	if (size <= 0) { problem = "not a whole fight file"; return false; }
+	Common::Array<byte> bytes;
+	bytes.resize(size);
+	DuelBridge::written(bytes.data(), size);
+	Common::DumpFile *dump = new Common::DumpFile();
+	if (!dump->open(file, true)) { delete dump; problem = "cannot write cache"; return false; }
+	Common::ScopedPtr<Common::WriteStream> compressed(Common::wrapCompressedWriteStream(dump));
+	compressed->write(bytes.data(), bytes.size());
+	compressed->finalize();
+	if (compressed->err()) { problem = "cannot write cache"; return false; }
+	if (mismatches) warning("SCUMMVERSE world duel: %s %d not as its script has it", kWorldGames[gameIndex].gameid, mismatches);
+	debug(1, "SCUMMVERSE world duel: %s %d bytes", kWorldGames[gameIndex].gameid, size);
+	return true;
+}
