+		_cursor.state = cursorState; _userPut = userPut;
+	};
+	auto bit = [&](int n, int value) { writeVar(0x8000 | n, value); };
+	auto bitOf = [&](int n) { return readVar(0x8000 | n); };
+	// (Printable, as an answer's line: a new line or a wait a space, a code's
+	// bytes passed over.)
+	auto printable = [&](const byte *s, int most) {
+		Common::String line;
+		for (int c = 0; s && c < most && s[c] && line.size() < 255; ++c) {
+			const byte b = s[c];
+			if (b == 0xFF && c + 1 < most) {
+				const byte code = s[++c];
+				if (code >= 9 && code <= 14) c += 2;
+			}
+			if (b >= 32 && b < 127) line += (char)b;
+			else if (!line.empty() && line.lastChar() != ' ') line += ' ';
+		}
+		while (!line.empty() && line.lastChar() == ' ') line.deleteLastChar();
+		return line;
+	};
+	auto sizeOf = [&](ResType type, int n) { return n >= 0 && n < (int)_res->_types[type].size() ? (int)_res->_types[type][n]._size : 0; };
+	auto stringText = [&](int n) { const byte *s = getStringAddress(n); return s ? printable(s, sizeOf(rtString, n)) : Common::String(); };
+	auto stringByte = [&](int n, int at) { const byte *s = getStringAddress(n); return s && at >= 0 && at < sizeOf(rtString, n) ? (int)s[at] : -1; };
+	auto run = [&](int script, std::initializer_list<int> args) {
+		int a[NUM_SCRIPT_LOCAL];
+		memset(a, 0, sizeof(a));
+		int k = 0;
+		for (int v : args) if (k < NUM_SCRIPT_LOCAL) a[k++] = v;
+		runScript(script, false, false, a);
+	};
+	// (A place loaded as its scripts load it, nothing of its entry's left
+	// running unless asked (the map's).)
+	auto scene = [&](int room, bool entry) {
+		quiet();
