+		scummverseRestore(kept);
+		_sentenceNum = 0; _drawObjectQueNr = 0;
+		_rnd.setSeed(seed);
+	};
+	// ---- A run: its lines by segment (0 before the first choice, k after the
+	// k-th), its menus' verbs and texts, how it ended. ----
+	struct Said { int speaker = 0, color = -1; Common::String text; };
+	struct Menu { Common::Array<int> ids; Common::Array<Common::String> texts; };
+	struct Run { Common::Array<Common::Array<Said> > lines; Common::Array<Menu> menus; bool ended = false, atMenu = false; };
+	auto menuUp = [&]() {
+		for (int i = 1; i < _numVerbs; ++i) if (_verbs[i].verbid >= 120 && _verbs[i].verbid <= 128 && _verbs[i].curmode == 1 && _verbs[i].saveid == 0) return true;
+		return false;
+	};
+	// (In the order shown: down the screen, as its script places them.)
+	auto menuOf = [&]() {
+		Menu m;
+		Common::Array<int> tops;
+		for (int id = 120; id <= 128; ++id) {
+			const int slot = getVerbSlot(id, 0);
+			if (!slot || _verbs[slot].curmode != 1) continue;
+			const byte *t = getResourceAddress(rtVerb, slot);
+			uint at = 0;
+			while (at < tops.size() && tops[at] <= _verbs[slot].curRect.top) ++at;
+			tops.insert_at(at, _verbs[slot].curRect.top);
+			m.ids.insert_at(at, id); m.texts.insert_at(at, t ? printable(t, sizeOf(rtVerb, slot)) : Common::String());
+		}
+		return m;
+	};
+	auto menuOff = [&]() { for (int i = 1; i < _numVerbs; ++i) if (_verbs[i].verbid >= 120 && _verbs[i].verbid <= 128) _verbs[i].curmode = 0; };
+	auto heard = [&](Run &r, int other) {
