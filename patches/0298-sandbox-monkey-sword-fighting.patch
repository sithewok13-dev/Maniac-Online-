+// A game's fight file, read once (none: no fights). One that could not be
+// read (none, emptied by an export that skipped it, or damaged) is not read
+// again until the worlds are scanned again (scan).
+bool SandboxEngine::duelLoad(int game) {
+	if (game < 0 || game >= worldGameCount() || !worldDuel(game) || _duelUnread.contains(game)) return false;
+	if (DuelBridge::loaded(game)) return true;
+	Common::Array<byte> data;
+	char error[128];
+	if (!read(Common::String::format("%s-duel.svd", kWorldGames[game].gameid), data)) { _duelUnread[game] = true; return false; }
+	if (!DuelBridge::load(game, data.data(), data.size(), error, sizeof(error))) {
+		warning("SCUMMVERSE sandbox: %s fights not read (%s)", kWorldGames[game].gameid, error);
+		_duelUnread[game] = true;
+		return false;
+	}
+	return true;
+}
