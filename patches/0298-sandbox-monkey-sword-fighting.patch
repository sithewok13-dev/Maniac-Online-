+		Common::Array<int> things;
+		for (int i = 0; i < StageBridge::objectCount(); ++i) if (isThing(i)) things.push_back(i);
+		const int thing = StageBridge::objectAt(x, y, things.data(), things.size(), 2);
+		int id, ox, oy, ow, oh, wx, wy, state;
+		if (thing >= 0 && StageBridge::object(thing, id, ox, oy, ow, oh, wx, wy, state) && id == w->masterObject)
+			for (uint n = 0; n < _onStage.size() && person < 0; ++n) if (duelOpponent((int)n)) person = (int)n;
+	}
+	if (person < 0) return false;
+	if (!PanelBridge::over()) PanelBridge::select(-1);
+	const WorldGuest *who = worldAppearance(_onStage[person]);
+	char verbName[40];
+	PanelBridge::verbName(verb, verbName, sizeof(verbName));
+	Pair p;
+	p.kind = kWorldVerbTalk; p.verb = verb;
+	// (A walk to a door under way let go, as any tap lets it go.)
+	_door = -1; _doorGoalLink = -1; _opening = 0;
+	walkBeside(person, p, Common::String::format("%s %s", verbName, who ? who->name : ""));
+	return true;
+}
+
+// A tap while a duel is under way: a choice chosen (or its list's page
+// turned), else the line said ended (the next said at once).
+bool SandboxEngine::duelTapWhile(int screenX, int screenY) {
+	if (_duel.phase == kDuelChoosing) {
+		const int at = PanelBridge::choiceAt(screenX, screenY, _width, _height);
+		if (at >= 0) duelChoose(at);
+		else if (at == PanelBridge::kChoiceUp || at == PanelBridge::kChoiceDown) PanelBridge::scrollChoices(at == PanelBridge::kChoiceUp ? -1 : 1, _width, _height);
+		_dirty = true;
+		return true;
+	}
+	if (_duel.phase == kDuelSaying) {
+		if (_speechClock > 1) _speechClock = 1;
+		if (_noticeClock > 1) _noticeClock = 1;
+		return true;
+	}
+	return false;
+}
+
+// A line of the fight's said: by the one played, the opponent (in their
+// type's colour), or no one (told over the place, in its own).
+void SandboxEngine::duelSaid(const Common::String &text, int speaker, int color) {
+	if (text.empty()) return;
+	Said s;
+	s.text = text;
+	if (speaker == Duel::kSpeakerPlayed) s.actor = _player;
+	else if (speaker == Duel::kSpeakerOpponent) { s.actor = _duel.opponent; s.color = _duel.color >= 0 ? _duel.color : color; _duel.heard = text; }
+	else s.color = color;
+	_saying.push_back(s);
+}
+
+void SandboxEngine::duelLines(int kind, int which, bool clear) {
+	if (clear) _saying.clear();
+	for (int k = 0; k < DuelBridge::lines(_duel.game, kind, which); ++k) {
+		int speaker, color;
+		char text[256];
+		if (DuelBridge::line(_duel.game, kind, which, k, speaker, color, text, sizeof(text))) duelSaid(text, speaker, color);
+	}
+}
+
+// What a talk's case leaves kept, and its flags.
+void SandboxEngine::duelLeaves(int kind, int which, int &flags) {
+	int leaves[2 * Duel::kMostLeaves], count = 0;
+	if (!DuelBridge::outcome(_duel.game, kind, which, flags, leaves, count, Duel::kMostLeaves)) flags = 0;
+	for (int k = 0; k < count; ++k) if (worldDuelValue(_duel.game, leaves[2 * k])) _kept[_duel.game * 65536 + leaves[2 * k]] = leaves[2 * k + 1];
+}
+
+// Talked to (pairUp, walked up to them): the master's talk (her start, the
+// first time, then her choices; once fought, at once her fight), or a
+// pirate's (met: its greeting, then its options).
+bool SandboxEngine::duelBegin(int person) {
+	const WorldDuel *w = _game >= 0 ? worldDuel(_game) : nullptr;
+	if (!w || (_room != w->masterRoom && _room != w->mapRoom) || !duelOpponent(person) || !duelLoad(_game)) return false;
+	const int g = _game;
+	bool master = true;
+	for (int p : _duelPirates) master = master && p != person;
+	_duel = DuelPlay();
+	_duel.game = g; _duel.master = master; _duel.opponent = person; _duel.phase = kDuelSaying;
+	_saying.clear();
+	if (master) _duel.type = w->masterType;
+	else {
+		// (Script 111: one of the map's pirates at random, not the last met.)
+		int type = w->pirateFirst;
+		for (int t = 0; t < 20; ++t) {
+			type = w->pirateFirst + (int)_random.getRandomNumber(w->pirateLast - w->pirateFirst);
+			if (type != keptValue(g, w->lastType)) break;
+		}
+		_duel.type = type;
+		_kept[g * 65536 + w->lastType] = type;
+	}
+	int costume;
+	if (!DuelBridge::type(g, _duel.type, _duel.skill, _duel.color, costume)) { _duel = DuelPlay(); return false; }
+	double px, py, ox, oy;
+	StageBridge::position(_player, px, py);
+	StageBridge::position(person, ox, oy);
+	StageBridge::face(_player, ox, oy);
+	StageBridge::face(person, px, py);
+	if (master) {
+		const int fought = keptValue(g, w->fought);
+		if (!fought) {
+			duelLines(Duel::kLineIntro, keptValue(g, w->introSeen) ? 1 : 0, false);
+			_kept[g * 65536 + w->introSeen] = 1;
+			_duel.next = kDuelThenMasterMenu;
+		} else {
+			// (Her script's lines by how often, the last for more.)
+			int which = MIN(fought, 8);
+			while (which > 1 && !DuelBridge::lines(g, Duel::kLineAgain, which)) --which;
+			duelLines(Duel::kLineAgain, which, false);
+			_kept[g * 65536 + w->fought] = fought + 1;
+			_duel.next = kDuelThenFight;
+		}
+	} else {
+		// (Room 49's script 200: met one more time, to three; one of its
+		// greetings.)
+		if (keptValue(g, w->met) < 3) _kept[g * 65536 + w->met] = keptValue(g, w->met) + 1;
+		const int greetings = DuelBridge::variants(g, Duel::kLineGreeting);
+		if (greetings) duelLines(Duel::kLineGreeting, _random.getRandomNumber(greetings - 1), false);
+		_duel.next = kDuelThenPirateMenu;
+	}
+	if (!_saying.empty() && _speechClock <= 0 && _noticeClock <= 0) sayNext();
+	_dirty = true;
+	return true;
+}
+
+// Its lines said: what follows (each step).
+void SandboxEngine::duelStep(int ticks) {
+	if (_duel.phase != kDuelSaying || !_saying.empty() || _speechClock > 0 || _noticeClock > 0) return;
+	if (_duel.opponent >= 0 && _duel.opponent < (int)_onStage.size() && StageBridge::moving(_duel.opponent)) return; // (walking home)
+	if (_duel.wait > 0) { _duel.wait -= ticks; return; }
+	duelNext();
+}
+
+// The opponent's insult (script 80), said; then the one played's comebacks.
+void SandboxEngine::duelInsult() {
+	unsigned long long insults = duelInsults();
+	unsigned comebacks = duelComebacks();
+	const int n = DuelBridge::opponentInsult(insults, comebacks);
+	duelLearned(insults, comebacks);
+	duelLines(Duel::kLineInsult, n);
+	_duel.phase = kDuelSaying; _duel.next = kDuelThenComebacks;
+	if (!_saying.empty() && _speechClock <= 0 && _noticeClock <= 0) sayNext();
+}
+
+// The choices up: the master's talk's, a pirate's options (as its script
+// builds them), the comebacks or the insults the one played may use.
+void SandboxEngine::duelList(int list) {
+	const WorldDuel *w = worldDuel(_duel.game);
+	if (!w) { duelEnd(); return; }
+	const int g = _duel.game;
+	_duel.listed.clear();
+	Common::Array<Common::String> texts;
+	auto add = [&](int number, int kind, int which) {
+		int speaker, color;
+		char text[256];
+		if (!DuelBridge::line(g, kind, which, 0, speaker, color, text, sizeof(text))) return;
+		_duel.listed.push_back(number); texts.push_back(text);
+	};
+	int numbers[64];
+	unsigned long long insults = duelInsults();
+	unsigned comebacks = duelComebacks();
+	if (list == kDuelListTalk) for (int c = 0; c < w->choices; ++c) add(c, Duel::kLineChoice, c);
+	if (list == kDuelListPirate) {
+		const bool trained = keptValue(g, w->trained) != 0;
+		const bool poor = !isCarried(g, w->moneyRoom, w->money) && !isCarried(g, w->creditRoom, w->credit);
+		if (!_duel.asked) add(0, Duel::kLineOption, 0);
+		if (_duel.asked && !keptValue(g, w->secondAsked)) add(2, Duel::kLineOption, 2);
+		if (keptValue(g, w->met) == 3) add(5, Duel::kLineOption, 5);
+		if (trained) add(7, Duel::kLineOption, 7);
+		else if (poor) add(6, Duel::kLineOption, 6);
+		add(4, Duel::kLineOption, 4);
+	}
+	if (list == kDuelListComebacks) {
+		const int n = MIN<int>(DuelBridge::comebacks(insults, comebacks, numbers, ARRAYSIZE(numbers)), ARRAYSIZE(numbers));
+		for (int k = 0; k < n; ++k) add(numbers[k], Duel::kLineComeback, numbers[k]);
+	}
+	if (list == kDuelListInsults) {
+		const int n = MIN<int>(DuelBridge::insults(insults, comebacks, numbers, ARRAYSIZE(numbers)), ARRAYSIZE(numbers));
+		for (int k = 0; k < n; ++k) add(numbers[k], Duel::kLineInsult, numbers[k]);
+	}
+	if (_duel.listed.empty()) { duelEnd(); return; }
+	Common::Array<const char *> pointers;
+	for (const Common::String &t : texts) pointers.push_back(t.c_str());
+	PanelBridge::setChoices(pointers.data(), pointers.size());
+	_duel.list = list; _duel.phase = kDuelChoosing;
+	_dirty = true;
+}
+
+// A choice chosen: said by the one played, then what it does.
+void SandboxEngine::duelChoose(int index) {
+	const WorldDuel *w = worldDuel(_duel.game);
+	if (!w || _duel.phase != kDuelChoosing || index < 0 || index >= (int)_duel.listed.size()) return;
+	const int g = _duel.game, chosen = _duel.listed[index];
+	PanelBridge::clearChoices();
+	_duel.phase = kDuelSaying;
+	_saying.clear();
+	int speaker, color;
+	char text[256];
+	switch (_duel.list) {
+	case kDuelListTalk: {
+		// (Her answer to it in the state she reads: the sword carried, the
+		// training, her long answer heard, the fights won.)
+		if (DuelBridge::line(g, Duel::kLineChoice, chosen, 0, speaker, color, text, sizeof(text))) duelSaid(text, Duel::kSpeakerPlayed, -1);
+		const int state = !isCarried(g, w->swordRoom, w->sword) ? 0 : !keptValue(g, w->trained) ? (keptValue(g, w->heardLong) ? 2 : 1) : 3 + MIN(keptValue(g, w->wins), 3);
+		duelLines(Duel::kLineAnswer, chosen * 8 + state, false);
+		int flags;
+		duelLeaves(Duel::kLineAnswer, chosen * 8 + state, flags);
+		if (flags & Duel::kFights) _kept[g * 65536 + w->fought] = keptValue(g, w->fought) + 1;
+		_duel.next = flags & Duel::kFights ? kDuelThenFight : flags & Duel::kGoesHome ? kDuelThenHome : kDuelThenDone;
+		break;
+	}
+	case kDuelListPirate: {
+		if (DuelBridge::line(g, Duel::kLineOption, chosen, 0, speaker, color, text, sizeof(text))) duelSaid(text, Duel::kSpeakerPlayed, -1);
+		duelLines(Duel::kLineReply, chosen, false);
+		int flags;
+		duelLeaves(Duel::kLineReply, chosen, flags);
+		if (chosen == 0) _duel.asked = true;
+		_duel.next = flags & Duel::kFights ? kDuelThenFight : flags & Duel::kTalkEnds ? kDuelThenDone : kDuelThenPirateMenu;
+		break;
+	}
+	case kDuelListComebacks: {
+		if (DuelBridge::line(g, Duel::kLineComeback, chosen, 0, speaker, color, text, sizeof(text))) duelSaid(text, Duel::kSpeakerPlayed, -1);
+		const int insult = DuelBridge::insultNow(), result = DuelBridge::answer(chosen);
+		if (result == DuelBridge::kRepeated) {
+			// (Asked again: its line round the insult, then the comebacks again.)
+			Common::String again;
+			for (int part = 0; part < 2; ++part) {
+				if (DuelBridge::line(g, Duel::kLineRepeat, part, 0, speaker, color, text, sizeof(text))) again += text;
+				if (!part && DuelBridge::line(g, Duel::kLineInsult, insult, 0, speaker, color, text, sizeof(text))) again += text;
+			}
+			duelSaid(again, Duel::kSpeakerOpponent, -1);
+			_duel.next = kDuelThenComebacks;
+		} else {
+			_duel.next = kDuelThenPoint;
+			_duel.wait = result == DuelBridge::kGaveUp ? 0 : kDuelExchangePause;
+		}
+		break;
+	}
+	case kDuelListInsults: {
+		if (DuelBridge::line(g, Duel::kLineInsult, chosen, 0, speaker, color, text, sizeof(text))) duelSaid(text, Duel::kSpeakerPlayed, -1);
+		unsigned long long insults = duelInsults();
+		unsigned comebacks = duelComebacks();
+		int reply = 0;
+		const int result = DuelBridge::insult(chosen, insults, comebacks, reply);
+		duelLearned(insults, comebacks);
+		if (result != DuelBridge::kGaveUp) {
+			const int kind = reply >= DuelBridge::kReplyMaster ? Duel::kLineMasterReply : reply >= DuelBridge::kReplyFallback ? Duel::kLineFallback : Duel::kLineComeback;
+			const int which = reply >= DuelBridge::kReplyMaster ? 0 : reply >= DuelBridge::kReplyFallback ? reply - DuelBridge::kReplyFallback : reply;
+			if (DuelBridge::line(g, kind, which, 0, speaker, color, text, sizeof(text))) duelSaid(text, Duel::kSpeakerOpponent, color);
+		}
+		_duel.next = kDuelThenPoint;
+		_duel.wait = result == DuelBridge::kGaveUp ? 0 : kDuelExchangePause;
+		break;
+	}
+	default:
+		duelEnd();
+		return;
+	}
+	if (!_saying.empty() && _speechClock <= 0 && _noticeClock <= 0) sayNext();
+	_dirty = true;
+}
+
+// What follows its lines (see the fight's rules: common/scummverse_duel.h).
+void SandboxEngine::duelNext() {
+	const WorldDuel *w = worldDuel(_duel.game);
+	if (!w || _duel.game != _game) { duelEnd(); return; }
+	const int g = _duel.game;
+	switch (_duel.next) {
+	case kDuelThenMasterMenu: duelList(kDuelListTalk); return;
+	case kDuelThenPirateMenu: duelList(kDuelListPirate); return;
+	case kDuelThenComebacks: duelList(kDuelListComebacks); return;
+	case kDuelThenInsults: duelList(kDuelListInsults); return;
+	case kDuelThenFight:
+		// (Script 87: against the master she insults; against a pirate the
+		// one played first.)
+		if (!DuelBridge::start(g, _duel.master, _duel.skill, _random.getRandomNumber(0x7FFFFFFE) + 1)) { duelEnd(); return; }
+		if (DuelBridge::turn() == DuelBridge::kOpponentInsults) duelInsult();
+		else duelList(kDuelListInsults);
+		return;
+	case kDuelThenPoint: {
+		const int turn = DuelBridge::turn();
+		if (turn == DuelBridge::kOpponentInsults) { duelInsult(); return; }
+		if (turn == DuelBridge::kPlayerInsults) { duelList(kDuelListInsults); return; }
+		// (Script 71: won or lost, counted, and its line: the opponent's
+		// won; the one played's lost, the first time its own. Given up: no
+		// line.)
+		const bool won = DuelBridge::won();
+		const int wins = keptValue(g, w->wins) + (won ? 1 : 0);
+		if (won) _kept[g * 65536 + w->wins] = wins;
+		else _kept[g * 65536 + w->losses] = keptValue(g, w->losses) + 1;
+		_saying.clear();
+		if (!DuelBridge::gaveUp()) {
+			if (won) duelLines(Duel::kLineWon, wins >= 3 ? (_duel.master ? 0 : 1) : 2, false);
+			else if (!keptValue(g, w->lostOnce)) { duelLines(Duel::kLineLostFirst, 0, false); _kept[g * 65536 + w->lostOnce] = 1; }
+			else if (DuelBridge::variants(g, Duel::kLineLost)) duelLines(Duel::kLineLost, DuelBridge::draw(DuelBridge::variants(g, Duel::kLineLost) - 1), false);
+		}
+		_duel.phase = kDuelSaying; _duel.next = kDuelThenEnded;
+		if (!_saying.empty() && _speechClock <= 0 && _noticeClock <= 0) sayNext();
+		return;
+	}
+	case kDuelThenEnded:
+		// (Script 113 after the master's: won, her lines, the T-shirt given,
+		// the trial counted (68), her bit; lost, her line; either way she goes
+		// into her house.)
+		if (_duel.master) {
+			const bool won = DuelBridge::won();
+			duelLines(Duel::kLineAfter, won ? 0 : 1);
+			if (won) {
+				_kept[g * 65536 + w->won] = 1;
+				if (!isCarried(g, w->duelRoom, w->shirt)) carry(g, w->duelRoom, w->shirt, "", 0);
+				_kept[g * 65536 + w->trialsVar] = keptValue(g, w->trialsVar) + 1;
+				_kept[g * 65536 + 0x8000 + w->trialBit] = 1;
+			}
+			_duel.phase = kDuelSaying; _duel.next = kDuelThenHome;
+			if (!_saying.empty() && _speechClock <= 0 && _noticeClock <= 0) sayNext();
+			return;
+		}
+		duelEnd();
+		return;
+	case kDuelThenHome: {
+		// (Script 113 (and 58's 0A25): she walks to her door and goes in.)
+		double x, y;
+		for (int o = 0; o < StageBridge::objectCount(); ++o) {
+			int id, ox, oy, ow, oh, wx, wy, state;
+			if (StageBridge::object(o, id, ox, oy, ow, oh, wx, wy, state) && id == w->masterDoor && doorPoint(o, x, y) && _duel.opponent >= 0 && _duel.opponent < (int)_onStage.size()) {
+				StageBridge::walkable(x, y);
+				StageBridge::walkTo(_duel.opponent, x, y);
+			}
+		}
+		_duel.phase = kDuelSaying; _duel.next = kDuelThenGone;
+		return;
+	}
+	case kDuelThenGone:
+		if (_duel.opponent >= 0 && _duel.opponent < (int)_onStage.size()) StageBridge::hide(_duel.opponent, true);
+		_duelGone = true;
+		duelEnd();
+		return;
+	default:
+		duelEnd();
+		return;
+	}
+}
+
+// A duel over (or let go): a pirate met goes on its way (off the map until
+// it is entered again), its choices put away; kept.
+void SandboxEngine::duelEnd() {
+	PanelBridge::clearChoices();
+	if (_duel.phase && !_duel.master)
+		for (uint k = 0; k < _duelPirates.size(); ++k)
+			if (_duelPirates[k] == _duel.opponent) { if (_duel.opponent < (int)_onStage.size()) StageBridge::hide(_duel.opponent, true); _duelPirates.remove_at(k); break; }
+	_duel = DuelPlay();
+	_dirty = true;
+	if (!_testing) saveState();
+}
+
+// The trainer's door opened (his script 57): trained already, his line;
+// with the sword and the money carried, trained as his training ends when a
+// player skips it (its lines before it said; trained, and taught his
+// insults and comebacks); else as its things file answers it.
+bool SandboxEngine::duelTrain(int id, int kind) {
+	const WorldDuel *w = _game >= 0 ? worldDuel(_game) : nullptr;
+	if (!w || _room != w->trainRoom || id != w->trainObject || kind != kWorldVerbOpen || !duelLoad(_game)) return false;
+	const int g = _game;
+	const bool trained = keptValue(g, w->trained) != 0;
+	if (!trained && !(isCarried(g, w->swordRoom, w->sword) && isCarried(g, w->moneyRoom, w->money))) return false;
+	_duel = DuelPlay();
+	_duel.game = g;
+	for (uint n = 0; n < _onStage.size(); ++n) if (_onStage[n] == worldAppearanceKey(g, w->trainerCostume) && !StageBridge::hidden((int)n)) _duel.opponent = (int)n;
+	duelLines(trained ? Duel::kLineTrained : Duel::kLineTraining, 0);
+	if (!trained) {
+		_kept[g * 65536 + w->trained] = 1;
+		for (int n : w->taught) { _kept[g * 65536 + 0x8000 + w->insultBits + n] = 1; _kept[g * 65536 + 0x8000 + w->comebackBits + n] = 1; }
+	}
+	_duel = DuelPlay();
+	if (!_saying.empty()) sayNext();
+	if (!_testing) saveState();
+	return true;
+}
+
+// The map entered (its entry script and local 202): from the visit after
+// `mapVisits` on, with the trials not all done, a pirate on its way between
+// two of its places, three once trained; each visit counted. (Each where
+// it covers none of the map's places: a tap there goes on to the place.)
+void SandboxEngine::duelMap() {
+	_duelPirates.clear();
+	const WorldDuel *w = _game >= 0 ? worldDuel(_game) : nullptr;
+	if (!w || _room != w->mapRoom || !duelLoad(_game)) return;
+	const int g = _game, visits = keptValue(g, w->visits);
+	_kept[g * 65536 + w->visits] = visits + 1;
+	const int key = worldAppearanceKey(g, w->pirateCostume);
+	if (visits <= w->mapVisits || keptValue(g, w->trialsVar) >= 3 || !hasCharacter(key)) return;
+	Common::Array<int> spots;
+	for (int o = 0; o < StageBridge::objectCount(); ++o) {
+		int id, ox, oy, ow, oh, wx, wy, state;
+		if (!StageBridge::object(o, id, ox, oy, ow, oh, wx, wy, state)) continue;
+		for (short s : w->spots) if (s == id) spots.push_back(o);
+	}
+	auto covers = [&](int n) {
+		int x0, y0, x1, y1;
+		if (!StageBridge::drawnRect(n, x0, y0, x1, y1)) return true;
+		double sx0, sy0, sx1, sy1;
+		StageBridge::toScene(x0, y0, sx0, sy0);
+		StageBridge::toScene(x1, y1, sx1, sy1);
+		for (int o = 0; o < StageBridge::objectCount(); ++o) {
+			int id, ox, oy, ow, oh, wx, wy, state;
+			if (isDoor(o) && StageBridge::object(o, id, ox, oy, ow, oh, wx, wy, state) && sx0 < ox + ow && ox < sx1 && sy0 < oy + oh && oy < sy1) return true;
+		}
+		for (int p : _duelPirates) {
+			int px0, py0, px1, py1;
+			if (StageBridge::drawnRect(p, px0, py0, px1, py1) && x0 < px1 && px0 < x1 && y0 < py1 && py0 < y1) return true;
+		}
+		return false;
+	};
+	const int count = keptValue(g, w->trained) ? 3 : 1;
+	for (int k = 0; k < count && spots.size() > 1; ++k) {
+		const int n = addPerson(key);
