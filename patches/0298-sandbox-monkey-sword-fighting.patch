+// What the one played has learned, as kept (bit n: number n).
+unsigned long long SandboxEngine::duelInsults() const {
+	const WorldDuel *w = _game >= 0 ? worldDuel(_game) : nullptr;
+	unsigned long long bits = 0;
+	for (int n = 1; w && n < w->fallbackFrom && n < 64; ++n) if (keptValue(_game, 0x8000 + w->insultBits + n)) bits |= 1ULL << n;
+	return bits;
+}
+
+unsigned SandboxEngine::duelComebacks() const {
+	const WorldDuel *w = _game >= 0 ? worldDuel(_game) : nullptr;
+	unsigned bits = 0;
+	for (int n = 1; w && n < w->loseFrom && n < 32; ++n) if (keptValue(_game, 0x8000 + w->comebackBits + n)) bits |= 1u << n;
+	return bits;
+}
+
+void SandboxEngine::duelLearned(unsigned long long insults, unsigned comebacks) {
+	const WorldDuel *w = _game >= 0 ? worldDuel(_game) : nullptr;
+	for (int n = 1; w && n < w->fallbackFrom && n < 64; ++n) if (insults >> n & 1) _kept[_game * 65536 + 0x8000 + w->insultBits + n] = 1;
+	for (int n = 1; w && n < w->loseFrom && n < 32; ++n) if (comebacks >> n & 1) _kept[_game * 65536 + 0x8000 + w->comebackBits + n] = 1;
+}
