+// SPDX-License-Identifier: GPL-3.0-or-later
+// Scummverse: insult sword fighting by a game's own rules (from 0298). See
+// scummverse_duel.h.
+#define FORBIDDEN_SYMBOL_ALLOW_ALL
+
+#include "common/scummverse_duel.h"
+#include "common/scummverse_duel_engine.h"
+
+#include <cstring>
+#include <map>
+
+namespace Scummverse {
+namespace Duel {
+
+bool Rules::accepts(int insult, int comeback) const {
+	if (insult <= 0 || insult > insults || comeback <= 0 || 3 * insult + 2 >= (int)accepted.size()) return false;
+	for (int k = 0; k < 3; ++k) if (accepted[3 * insult + k] == comeback) return true;
+	return false;
+}
+
+bool Rules::valid() const {
+	auto in = [](int v, int lo, int hi) { return v >= lo && v <= hi; };
+	if (!in(insults, 1, kMostInsults) || !in(comebacks, 1, kMostComebacks) || (int)accepted.size() != 3 * (insults + 1)) return false;
+	if (!in(ownFirst, 1, insults) || !in(ownLast, ownFirst, insults) || !in(masterFirst, 1, insults) || !in(masterLast, masterFirst, insults)) return false;
+	// (Learned insults below the fallbacks, comebacks below those that lose.)
+	if (!in(fallbackFrom, 2, insults) || ownLast >= fallbackFrom || masterLast >= fallbackFrom || !in(insultGiveUp, fallbackFrom, insults)) return false;
+	if (!in(loseFrom, 2, comebacks) || !in(repeat, loseFrom, comebacks) || !in(giveUp, loseFrom, comebacks) || repeat == giveUp) return false;
+	if (!in(masterTarget, 1, 99) || !in(pirateTarget, 1, 99) || !in(tries, 1, 99) || !in(skillRange, 1, 99) || !in(wrongCount, 1, comebacks - loseFrom + 1) ||
+		!in(fallbackLines, 0, 16)) return false;
+	for (int n = 0; n <= insults; ++n)
+		for (int k = 0; k < 3; ++k) if (!in(accepted[3 * n + k], 0, comebacks) || (n == 0 && accepted[k])) return false;
+	return true;
+}
+
+std::vector<const Line *> Data::said(int kind, int which) const {
+	std::vector<const Line *> out;
+	for (const Line &l : lines) if (l.kind == kind && l.which == which) out.push_back(&l);
+	return out;
+}
+
+int Data::variants(int kind) const {
+	int n = 0;
+	while (!said(kind, n).empty()) ++n;
+	return n;
+}
+
+const Type *Data::type(int t) const {
+	for (const Type &x : types) if (x.type == t) return &x;
+	return nullptr;
+}
+
+const Outcome *Data::outcome(int kind, int which) const {
+	for (const Outcome &o : outcomes) if (o.kind == kind && o.which == which) return &o;
+	return nullptr;
+}
+
+// ---- The file ("SVD1", little-endian) ----
+// "SVD1"; u8 insults, comebacks, ownFirst, ownLast, masterFirst,
+// masterLast, loseFrom, repeat, giveUp, fallbackFrom, insultGiveUp,
+// masterTarget, pirateTarget, tries, skillRange, wrongCount, fallbackLines;
+// per insult 1..insults three u8 comebacks it takes (0 none); u8 types, per
+// type u8 type, skill, colour, u16 costume; u16 lines, per line u8 kind,
+// which, speaker, colour (255: the speaker's own), u8 length and its bytes;
+// u16 outcomes, per outcome u8 kind, which, flags, u8 leaves and per leave
+// u16 variable, s16 value. Nothing after.
+
+namespace {
+struct Reader {
+	const uint8_t *p, *end;
+	bool ok;
+	int u8() { if (p >= end) { ok = false; return 0; } return *p++; }
+	int u16() { const int lo = u8(); return lo | u8() << 8; }
+	int s16() { const int v = u16(); return v >= 0x8000 ? v - 0x10000 : v; }
+};
+}
+
+bool parse(const uint8_t *data, size_t size, Data &out, std::string &error) {
+	out = Data();
+	if (!data || size < 4 || std::memcmp(data, "SVD1", 4)) { error = "not a fight file"; return false; }
+	Reader r = {data + 4, data + size, true};
+	Rules &u = out.rules;
+	int *fields[] = {&u.insults, &u.comebacks, &u.ownFirst, &u.ownLast, &u.masterFirst, &u.masterLast, &u.loseFrom, &u.repeat, &u.giveUp,
+		&u.fallbackFrom, &u.insultGiveUp, &u.masterTarget, &u.pirateTarget, &u.tries, &u.skillRange, &u.wrongCount, &u.fallbackLines};
+	for (int *f : fields) *f = r.u8();
+	if (!r.ok || u.insults < 1 || u.insults > kMostInsults) { error = "its insults"; out = Data(); return false; }
+	u.accepted.assign(3 * (u.insults + 1), 0);
+	for (int n = 1; n <= u.insults; ++n) for (int k = 0; k < 3; ++k) u.accepted[3 * n + k] = r.u8();
+	if (!r.ok || !u.valid()) { error = "its rules"; out = Data(); return false; }
+	const int types = r.u8();
+	for (int i = 0; i < types && r.ok; ++i) {
+		Type t;
+		t.type = r.u8(); t.skill = r.u8(); t.color = r.u8(); t.costume = r.u16();
+		if (out.type(t.type) || t.skill > u.skillRange + 1) { error = "its types"; out = Data(); return false; }
+		out.types.push_back(t);
+	}
+	const int lines = r.u16();
+	if (!r.ok || lines > kMostLines) { error = "its lines"; out = Data(); return false; }
+	for (int i = 0; i < lines && r.ok; ++i) {
+		Line l;
+		l.kind = r.u8(); l.which = r.u8(); l.speaker = r.u8();
+		const int color = r.u8();
+		l.color = color == 255 ? -1 : color;
+		const int length = r.u8();
+		if (r.end - r.p < length) { r.ok = false; break; }
+		l.text.assign((const char *)r.p, length);
+		r.p += length;
+		if (l.kind < kLineInsult || l.kind >= kLineKinds || (l.speaker != kSpeakerPlayed && l.speaker != kSpeakerOpponent && l.speaker != kSpeakerNone) ||
+			l.text.empty() || l.text.find('\0') != std::string::npos ||
+			(l.kind == kLineInsult && (l.which < 1 || l.which > u.insults)) || (l.kind == kLineComeback && (l.which < 1 || l.which > u.comebacks))) {
+			error = "a line"; out = Data(); return false;
+		}
+		out.lines.push_back(l);
+	}
+	const int outcomes = r.ok ? r.u16() : 0;
+	if (!r.ok || outcomes > kMostOutcomes) { error = "its outcomes"; out = Data(); return false; }
+	for (int i = 0; i < outcomes && r.ok; ++i) {
+		Outcome o;
+		o.kind = r.u8(); o.which = r.u8(); o.flags = r.u8();
+		const int leaves = r.u8();
+		if (leaves > kMostLeaves || o.flags > (kFights | kGoesHome | kTalkEnds) || out.outcome(o.kind, o.which)) { error = "an outcome"; out = Data(); return false; }
+		for (int k = 0; k < leaves; ++k) { o.leaves.push_back(r.u16()); o.leaves.push_back(r.s16()); }
+		out.outcomes.push_back(o);
+	}
+	if (!r.ok) { error = "cut short"; out = Data(); return false; }
+	if (r.p != r.end) { error = "more after its end"; out = Data(); return false; }
+	return true;
+}
+
+std::vector<uint8_t> write(const Data &d) {
+	std::vector<uint8_t> o = {'S', 'V', 'D', '1'};
+	auto u8 = [&](int v) { o.push_back((uint8_t)v); };
+	auto u16 = [&](int v) { u8(v & 0xFF); u8((v >> 8) & 0xFF); };
+	const Rules &u = d.rules;
+	for (int v : {u.insults, u.comebacks, u.ownFirst, u.ownLast, u.masterFirst, u.masterLast, u.loseFrom, u.repeat, u.giveUp, u.fallbackFrom, u.insultGiveUp,
+		u.masterTarget, u.pirateTarget, u.tries, u.skillRange, u.wrongCount, u.fallbackLines}) u8(v);
+	for (int n = 1; n <= u.insults; ++n) for (int k = 0; k < 3; ++k) u8(3 * n + k < (int)u.accepted.size() ? u.accepted[3 * n + k] : 0);
+	u8((int)d.types.size());
+	for (const Type &t : d.types) { u8(t.type); u8(t.skill); u8(t.color); u16(t.costume); }
+	u16((int)d.lines.size());
+	for (const Line &l : d.lines) {
+		const size_t length = l.text.size() < (size_t)kMostLineBytes ? l.text.size() : (size_t)kMostLineBytes;
+		u8(l.kind); u8(l.which); u8(l.speaker); u8(l.color < 0 ? 255 : l.color); u8((int)length);
+		o.insert(o.end(), l.text.begin(), l.text.begin() + length);
+	}
+	u16((int)d.outcomes.size());
+	for (const Outcome &c : d.outcomes) {
+		u8(c.kind); u8(c.which); u8(c.flags); u8((int)c.leaves.size() / 2);
+		for (size_t k = 0; k + 1 < c.leaves.size(); k += 2) { u16(c.leaves[k]); u16(c.leaves[k + 1] & 0xFFFF); }
+	}
+	return o;
+}
+
+// ---- The fight ----
+
+int Draws::upTo(int n) {
+	// (xorshift32: the same on every platform.)
+	_state ^= _state << 13; _state ^= _state >> 17; _state ^= _state << 5;
+	return n <= 0 ? 0 : (int)(_state % (uint32_t)(n + 1));
+}
+
+void Fight::start(const Rules &rules, bool master, int skill, uint32_t seed) {
+	_rules = &rules;
+	_master = master; _skill = skill;
+	_over = !rules.valid(); _won = _gaveUp = false;
+	_player = _opponent = _insult = 0;
+	_usedByPlayer = _usedByOpponent = 0;
+	// (Script 87's mode 2 against the master: she insults; mode 3 against a
+	// pirate, the one played first, as its talk's choice to fight sets it.)
+	_playerTurn = !master;
+	_draws.reseed(seed);
+}
+
+Fight::Turn Fight::turn() const {
+	return _over ? kOver : _playerTurn ? kPlayerInsults : kOpponentInsults;
+}
+
+int Fight::target() const {
+	return !_rules ? 0 : _master ? _rules->masterTarget : _rules->pirateTarget;
+}
+
+// (Script 80: theirs at random, one not used yet this fight, `tries` times;
+// heard the first time, learned, and kept off the one played's list until
+// the next fight.)
+int Fight::opponentInsult(Learned &learned) {
+	if (turn() != kOpponentInsults) return 0;
+	if (_insult) return _insult; // (asked again)
+	const int first = _master ? _rules->masterFirst : _rules->ownFirst, last = _master ? _rules->masterLast : _rules->ownLast;
+	int n = first;
+	for (int t = 0; t < _rules->tries; ++t) {
+		n = first + _draws.upTo(last - first);
+		if (!(_usedByOpponent >> n & 1)) break;
+	}
+	if (n < _rules->fallbackFrom && !learned.insult(n)) { learned.learnInsult(n); _usedByPlayer |= (uint64_t)1 << n; }
+	if (n < _rules->fallbackFrom) _usedByOpponent |= (uint64_t)1 << n;
+	return _insult = n;
+}
+
+std::vector<int> Fight::comebacks(const Learned &learned) const {
+	std::vector<int> out;
+	if (!_rules) return out;
+	for (int n = 1; n <= _rules->comebacks; ++n) if (n >= _rules->loseFrom || learned.comeback(n)) out.push_back(n);
+	return out;
+}
+
+std::vector<int> Fight::insults(const Learned &learned) const {
+	std::vector<int> out;
+	if (!_rules) return out;
+	for (int n = 1; n <= _rules->insults; ++n)
+		if (n >= _rules->fallbackFrom || (learned.insult(n) && !(_usedByPlayer >> n & 1))) out.push_back(n);
+	return out;
+}
+
+// (Script 71: a point, the one who won it insults next (the master insults
+// each exchange: script 87's mode 2); the first to the target wins.)
+Fight::Result Fight::point(bool player) {
+	_insult = 0;
+	if (player) ++_player; else ++_opponent;
+	_playerTurn = player && !_master;
+	if (_opponent >= target()) { _over = true; _won = false; }
+	if (_player >= target()) { _over = true; _won = true; }
+	return player ? kPlayerPoint : kOpponentPoint;
+}
+
+// (Scripts 76, 78 and 84.)
+Fight::Result Fight::answer(int comeback) {
+	if (turn() != kOpponentInsults || !_insult) return kNone;
+	const Rules &u = *_rules;
+	if (comeback == u.repeat) return kRepeated;
+	if (comeback == u.giveUp) { _over = true; _won = false; _gaveUp = true; _insult = 0; return kGaveUp; }
+	if (comeback <= 0 || comeback > u.comebacks) return kNone;
+	return point(comeback < u.loseFrom && u.accepts(_insult, comeback));
+}
+
+// (Scripts 77, 79, 81 and 84.)
+Fight::Result Fight::insult(int insult, Learned &learned, int &reply) {
+	reply = 0;
+	if (turn() != kPlayerInsults || insult <= 0 || insult > _rules->insults) return kNone;
+	const Rules &u = *_rules;
+	if (insult == u.insultGiveUp) { _over = true; _won = false; _gaveUp = true; return kGaveUp; }
+	if (insult < u.fallbackFrom) _usedByPlayer |= (uint64_t)1 << insult;
+	if (insult >= u.fallbackFrom) { reply = kReplyFallback + (u.fallbackLines > 0 ? _draws.upTo(u.fallbackLines - 1) : 0); return point(false); }
+	// (One of the master's, on a pirate: its own line, and the exchange won.)
+	if (insult > u.ownLast) { reply = kReplyMaster; return point(true); }
+	const int comeback = _draws.upTo(u.skillRange) < _skill ? insult : u.loseFrom + _draws.upTo(u.wrongCount - 1);
+	if (comeback < u.loseFrom) learned.learnComeback(comeback);
+	reply = comeback;
+	return point(!(comeback < u.loseFrom && u.accepts(insult, comeback)));
+}
+
+} // End of namespace Duel
+
+// ---- The engine's bridge (scummverse_duel_engine.h) ----
+
+namespace DuelBridge {
+namespace {
+std::map<int, Duel::Data> &files() { static std::map<int, Duel::Data> f; return f; }
+struct Under { int game = -1; Duel::Fight fight; };
+Under &under() { static Under u; return u; }
+Duel::Data &building() { static Duel::Data d; return d; }
+bool &begun() { static bool b = false; return b; }
+const Duel::Data *file(int game) {
+	auto it = files().find(game);
+	return it == files().end() ? nullptr : &it->second;
+}
+void copy(const std::string &from, char *text, int capacity) {
+	if (!text || capacity <= 0) return;
+	const size_t n = from.size() < (size_t)capacity - 1 ? from.size() : (size_t)capacity - 1;
+	std::memcpy(text, from.data(), n);
+	text[n] = 0;
+}
+Duel::Learned learnedOf(unsigned long long insults, unsigned comebacks) {
+	Duel::Learned l;
+	l.insults = insults; l.comebacks = comebacks;
+	return l;
+}
+int listed(const std::vector<int> &v, int *out, int capacity) {
+	for (size_t i = 0; out && i < v.size() && (int)i < capacity; ++i) out[i] = v[i];
+	return (int)v.size();
+}
+} // End of anonymous namespace
+
+// (Read into one of its own first; the game's file replaced only when it
+// is whole, none kept when it is not. A fight under way of that game ended
+// either way: it points at the rules it replaces.)
+bool load(int game, const unsigned char *data, size_t size, char *error, int capacity) {
+	if (under().game == game) under() = Under();
+	Duel::Data d;
+	std::string why;
+	if (!Duel::parse(data, size, d, why)) { files().erase(game); copy(why, error, capacity); return false; }
+	files()[game] = d;
+	return true;
+}
+
+bool loaded(int game) { return file(game) != nullptr; }
+
+void clear() { files().clear(); under() = Under(); }
+
+int rule(int game, const char *name) {
+	const Duel::Data *d = file(game);
+	if (!d || !name) return -1;
+	const Duel::Rules &u = d->rules;
+	const struct { const char *name; int value; } rules[] = {{"insults", u.insults}, {"comebacks", u.comebacks}, {"ownFirst", u.ownFirst},
+		{"ownLast", u.ownLast}, {"masterFirst", u.masterFirst}, {"masterLast", u.masterLast}, {"loseFrom", u.loseFrom}, {"repeat", u.repeat},
+		{"giveUp", u.giveUp}, {"fallbackFrom", u.fallbackFrom}, {"insultGiveUp", u.insultGiveUp}, {"masterTarget", u.masterTarget},
+		{"pirateTarget", u.pirateTarget}};
+	for (const auto &r : rules) if (!std::strcmp(r.name, name)) return r.value;
+	return -1;
+}
+
+bool accepts(int game, int insult, int comeback) {
+	const Duel::Data *d = file(game);
+	return d && d->rules.accepts(insult, comeback);
+}
+
+bool type(int game, int t, int &skill, int &color, int &costume) {
+	const Duel::Data *d = file(game);
+	const Duel::Type *x = d ? d->type(t) : nullptr;
+	if (!x) return false;
+	skill = x->skill; color = x->color; costume = x->costume;
+	return true;
+}
+
+int lines(int game, int kind, int which) {
+	const Duel::Data *d = file(game);
+	return d ? (int)d->said(kind, which).size() : 0;
+}
+
+bool line(int game, int kind, int which, int index, int &speaker, int &color, char *text, int capacity) {
+	const Duel::Data *d = file(game);
+	if (!d) return false;
+	const std::vector<const Duel::Line *> said = d->said(kind, which);
+	if (index < 0 || index >= (int)said.size()) return false;
+	speaker = said[index]->speaker; color = said[index]->color;
+	copy(said[index]->text, text, capacity);
+	return true;
+}
+
+int variants(int game, int kind) {
+	const Duel::Data *d = file(game);
+	return d ? d->variants(kind) : 0;
+}
+
+bool outcome(int game, int kind, int which, int &flags, int *leaves, int &count, int capacity) {
+	const Duel::Data *d = file(game);
+	const Duel::Outcome *o = d ? d->outcome(kind, which) : nullptr;
+	count = 0; flags = 0;
+	if (!o) return false;
+	flags = o->flags;
+	for (size_t k = 0; k + 1 < o->leaves.size() && count < capacity; k += 2, ++count) { leaves[2 * count] = o->leaves[k]; leaves[2 * count + 1] = o->leaves[k + 1]; }
+	return true;
+}
+
+bool start(int game, bool master, int skill, unsigned seed) {
+	const Duel::Data *d = file(game);
+	under() = Under();
+	if (!d) return false;
+	under().game = game;
+	under().fight.start(d->rules, master, skill, seed);
+	return !under().fight.over();
+}
+
+int turn() { return under().game < 0 ? kOver : (int)under().fight.turn(); }
+
+int opponentInsult(unsigned long long &insults, unsigned &comebacks) {
+	if (under().game < 0) return 0;
+	Duel::Learned l = learnedOf(insults, comebacks);
+	const int n = under().fight.opponentInsult(l);
+	insults = l.insults; comebacks = l.comebacks;
+	return n;
+}
+
+int insultNow() { return under().game < 0 ? 0 : under().fight.insultNow(); }
+
+int comebacks(unsigned long long insults, unsigned comebacks, int *out, int capacity) {
+	return under().game < 0 ? 0 : listed(under().fight.comebacks(learnedOf(insults, comebacks)), out, capacity);
+}
+
+int insults(unsigned long long insults, unsigned comebacks, int *out, int capacity) {
+	return under().game < 0 ? 0 : listed(under().fight.insults(learnedOf(insults, comebacks)), out, capacity);
+}
+
+int answer(int comeback) { return under().game < 0 ? kNone : (int)under().fight.answer(comeback); }
+
+int insult(int n, unsigned long long &insults, unsigned &comebacks, int &reply) {
+	reply = 0;
+	if (under().game < 0) return kNone;
+	Duel::Learned l = learnedOf(insults, comebacks);
+	const int result = (int)under().fight.insult(n, l, reply);
+	insults = l.insults; comebacks = l.comebacks;
+	return result;
+}
+
+int playerScore() { return under().game < 0 ? 0 : under().fight.playerScore(); }
+int opponentScore() { return under().game < 0 ? 0 : under().fight.opponentScore(); }
+int target() { return under().game < 0 ? 0 : under().fight.target(); }
+bool won() { return under().game >= 0 && under().fight.playerWon(); }
+bool gaveUp() { return under().game >= 0 && under().fight.gaveUp(); }
+int draw(int n) { return under().game < 0 ? 0 : under().fight.draw(n); }
+
+void begin(const int *rules, const int *accepted) {
+	Duel::Data &d = building();
+	d = Duel::Data();
+	begun() = rules && accepted;
+	if (!begun()) return;
+	Duel::Rules &u = d.rules;
+	int *fields[] = {&u.insults, &u.comebacks, &u.ownFirst, &u.ownLast, &u.masterFirst, &u.masterLast, &u.loseFrom, &u.repeat, &u.giveUp,
+		&u.fallbackFrom, &u.insultGiveUp, &u.masterTarget, &u.pirateTarget, &u.tries, &u.skillRange, &u.wrongCount, &u.fallbackLines};
+	for (int k = 0; k < 17; ++k) *fields[k] = rules[k];
+	if (u.insults < 1 || u.insults > Duel::kMostInsults) { begun() = false; return; }
+	u.accepted.assign(3 * (u.insults + 1), 0);
+	for (int n = 1; n <= u.insults; ++n) for (int k = 0; k < 3; ++k) u.accepted[3 * n + k] = accepted[3 * (n - 1) + k];
+}
+
+void addType(int t, int skill, int color, int costume) {
+	if (!begun()) return;
+	Duel::Type x;
+	x.type = t; x.skill = skill; x.color = color; x.costume = costume;
+	building().types.push_back(x);
+}
+
+void addLine(int kind, int which, int speaker, int color, const char *text) {
+	if (!begun() || !text || !*text) return;
+	Duel::Line l;
+	l.kind = kind; l.which = which; l.speaker = speaker; l.color = color; l.text = text;
+	building().lines.push_back(l);
+}
+
+void addOutcome(int kind, int which, int flags, const int *leaves, int count) {
+	if (!begun()) return;
+	Duel::Outcome o;
+	o.kind = kind; o.which = which; o.flags = flags;
+	for (int k = 0; k < count && leaves; ++k) { o.leaves.push_back(leaves[2 * k]); o.leaves.push_back(leaves[2 * k + 1]); }
+	building().outcomes.push_back(o);
+}
+
+int written(unsigned char *out, int capacity) {
+	if (!begun()) return 0;
+	const std::vector<uint8_t> bytes = Duel::write(building());
+	Duel::Data check;
+	std::string why;
+	if (!Duel::parse(bytes.data(), bytes.size(), check, why)) return 0;
+	if (out && capacity >= (int)bytes.size()) std::memcpy(out, bytes.data(), bytes.size());
+	return (int)bytes.size();
+}
+
+} // End of namespace DuelBridge
+} // End of namespace Scummverse
diff --git a/common/scummverse_duel.h b/common/scummverse_duel.h
new file mode 100644
index 00000000..37328c71
--- /dev/null
+++ b/common/scummverse_duel.h
@@ -0,0 +1,155 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Scummverse: insult sword fighting by a game's own rules (from 0298;
+// Monkey Island's: its global scripts 71, 72, 76 to 81, 84, 86, 87, 97, 157
+// and 158, read with descumm, nothing copied), for the new engine
+// (engines/scummverse). Plain C++, no ScummVM types; tools/test_duel.cpp.
+//
+// What a fight file holds ("<game>-duel.svd", "SVD1", written by the
+// game's own SCUMM engine as it exports its places, from its scripts: see
+// ScummEngine::scummverseExportDuel) is read by parse(); its lines are the
+// game's own, from its data at export time (none are written here).
+//
+// A fight, as its scripts play it (Fight): the score of each side is the
+// exchanges it has won; the first to its target wins (`masterTarget`
+// against the master, `pirateTarget` against a pirate). Against the master
+// she insults each exchange (script 87, its mode 2); against a pirate the
+// one played insults first and then whoever won the last exchange (mode 3).
+// - Insulted (scripts 80, 76, 78): the opponent's insult is one of theirs
+//   (the master's `masterFirst` to `masterLast`, a pirate's `ownFirst` to
+//   `ownLast`) not used yet in this fight, tried at random up to `tries`
+//   times (else the last tried); heard for the first time it is learned,
+//   but not listed until the next fight. The one played answers from the
+//   comebacks learned (in their numbers' order) and those from `loseFrom`
+//   on (always listed): `repeat` has it said again (no exchange), `giveUp`
+//   loses the fight at once, any other from `loseFrom` on loses the
+//   exchange; else the exchange is theirs if the insult takes that comeback
+//   (up to three, `accepted`; script 84), the opponent's if not.
+// - Insulting (scripts 77, 79, 81): from the insults learned not used yet in
+//   this fight (nor learned during it) and those from `fallbackFrom` on;
+//   `insultGiveUp` loses the fight at once, any other from `fallbackFrom` on
+//   loses the exchange (the opponent says one of its lines for it). One of
+//   the master's used on a pirate wins it (the pirate's own line). Else the
+//   pirate answers right with a chance of its skill in `skillRange` + 1
+//   (script 79: a draw from 0 to skillRange below its skill), and the
+//   comeback it answers with is learned; else with one of `wrongCount` from
+//   `loseFrom` on, and the exchange is the one played's.
+// The draws are its game's getRandomNr: 0 to n, both included, from a
+// seeded generator of its own (the same seed, the same fight).
+#ifndef COMMON_SCUMMVERSE_DUEL_H
+#define COMMON_SCUMMVERSE_DUEL_H
+
+#include "common/scummverse_duel_engine.h"
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string>
+#include <vector>
+
+namespace Scummverse {
+namespace Duel {
+
+struct Rules {
+	int insults = 0, comebacks = 0;
+	int ownFirst = 0, ownLast = 0, masterFirst = 0, masterLast = 0;
+	int loseFrom = 0, repeat = 0, giveUp = 0, fallbackFrom = 0, insultGiveUp = 0;
+	int masterTarget = 0, pirateTarget = 0;
+	int tries = 0, skillRange = 0, wrongCount = 0, fallbackLines = 0;
+	// accepted[3 * n + k]: the k-th comeback insult n takes (0 none); n from 1.
+	std::vector<int> accepted;
+	bool accepts(int insult, int comeback) const;
+	bool valid() const; // (numbers in range, as parse checks)
+};
+
+// What the one played has learned (bit n: number n), kept between fights.
+struct Learned {
+	uint64_t insults = 0;
+	uint32_t comebacks = 0;
+	bool insult(int n) const { return n > 0 && n < 64 && (insults >> n & 1); }
+	bool comeback(int n) const { return n > 0 && n < 32 && (comebacks >> n & 1); }
+	void learnInsult(int n) { if (n > 0 && n < 64) insults |= (uint64_t)1 << n; }
+	void learnComeback(int n) { if (n > 0 && n < 32) comebacks |= (uint32_t)1 << n; }
+};
+
+struct Line { int kind = 0, which = 0, speaker = kSpeakerNone, color = -1; std::string text; };
+struct Outcome { int kind = 0, which = 0, flags = 0; std::vector<int> leaves; };
+// A pirate's (or the master's) type: its skill, talk colour and costume.
+struct Type { int type = 0, skill = 0, color = 0, costume = 0; };
+
+struct Data {
+	Rules rules;
+	std::vector<Type> types;
+	std::vector<Line> lines;
+	std::vector<Outcome> outcomes;
+	// (Lines of a kind and which, in order; one type, one outcome; null none.)
+	std::vector<const Line *> said(int kind, int which) const;
+	int variants(int kind) const; // (how many `which` a kind of variants has: 0..n-1)
+	const Type *type(int type) const;
+	const Outcome *outcome(int kind, int which) const;
+};
+// Bytes of a "SVD1" file (uncompressed); false (with `error`) when malformed.
+bool parse(const uint8_t *data, size_t size, Data &out, std::string &error);
+// And written so (the export's and the tests'): parse(write(d)) gives d.
+std::vector<uint8_t> write(const Data &d);
+
+// Its game's getRandomNr: 0 to n, both included; seeded.
+class Draws {
+public:
+	explicit Draws(uint32_t seed = 1) { reseed(seed); }
+	void reseed(uint32_t seed) { _state = seed ? seed : 0x9E3779B9u; }
+	int upTo(int n);
+	uint32_t state() const { return _state; }
+private:
+	uint32_t _state;
+};
+
+class Fight {
+public:
+	enum Turn { kOver, kOpponentInsults, kPlayerInsults };
+	// An exchange's end: none yet, a point each way, the insult asked again,
+	// or the fight given up.
+	enum Result { kNone, kPlayerPoint, kOpponentPoint, kRepeated, kGaveUp };
+	// What the opponent answers an insult with: a comeback's number, or one
+	// of its lines for a fallback insult (kReplyFallback + its variant), or
+	// its line for one of the master's.
+	static const int kReplyFallback = 1000, kReplyMaster = 2000;
+
+	// Against the master (she insults each exchange) or a pirate of `skill`
+	// (the one played insults first).
+	void start(const Rules &rules, bool master, int skill, uint32_t seed);
+	Turn turn() const;
+	bool master() const { return _master; }
+	int target() const;
+	int playerScore() const { return _player; }
+	int opponentScore() const { return _opponent; }
+	bool over() const { return _over; }
+	bool playerWon() const { return _over && _won; }
+	bool gaveUp() const { return _over && _gaveUp; }
+	// The opponent insults (kOpponentInsults): its insult, learned by the one
+	// played the first time heard. Asked again (kRepeated) it is the same.
+	int opponentInsult(Learned &learned);
+	int insultNow() const { return _insult; }
+	// The comebacks the one played may answer with (script 158), and the
+	// insults they may use (157), in order.
+	std::vector<int> comebacks(const Learned &learned) const;
+	std::vector<int> insults(const Learned &learned) const;
+	// Answered with a comeback: the exchange's end (kRepeated: answered again).
+	Result answer(int comeback);
+	// Insulted with one of theirs: the opponent's reply (`reply`) and the
+	// exchange's end; a comeback it answers right with is learned.
+	Result insult(int insult, Learned &learned, int &reply);
+	// A draw of the fight's own (the lines its scripts pick at random).
+	int draw(int n) { return _draws.upTo(n); }
+
+private:
+	Result point(bool player);
+	const Rules *_rules = nullptr;
+	bool _master = false, _over = true, _won = false, _gaveUp = false, _playerTurn = false;
+	int _skill = 0, _player = 0, _opponent = 0, _insult = 0;
+	uint64_t _usedByPlayer = 0, _usedByOpponent = 0; // (their bits: 181 + n and 263 + n)
+	Draws _draws;
+};
+
+} // End of namespace Duel
+} // End of namespace Scummverse
+
+#endif
diff --git a/common/scummverse_duel_engine.h b/common/scummverse_duel_engine.h
new file mode 100644
index 00000000..462a7d41
--- /dev/null
+++ b/common/scummverse_duel_engine.h
@@ -0,0 +1,113 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Scummverse: insult sword fighting, engine-facing bridge (plain types only;
+// from 0298) for the new engine (engines/scummverse) and the export
+// (engines/scumm). Holds a game's fight file and the fight under way. See
+// common/scummverse_duel.h.
+#ifndef COMMON_SCUMMVERSE_DUEL_ENGINE_H
+#define COMMON_SCUMMVERSE_DUEL_ENGINE_H
+
+#include <stddef.h>
+
+namespace Scummverse {
+// (The file's numbers, for the new engine, the export and the module.)
+namespace Duel {
+
+// The most insults and comebacks a file has (their numbers 1..).
+static const int kMostInsults = 63, kMostComebacks = 31, kMostLineBytes = 255, kMostLines = 1024, kMostOutcomes = 256, kMostLeaves = 8;
+
+// A line of the file: who says it (kSpeakerPlayed, kSpeakerOpponent, or
+// kSpeakerNone: no one, its game's own), in a colour of its game's (-1:
+// the speaker's own) and the line.
+static const int kSpeakerPlayed = 0, kSpeakerOpponent = 1, kSpeakerNone = 255;
+// A line's kinds (`which` as each says):
+enum {
+	kLineInsult = 1,      // insult `which` (its text)
+	kLineComeback,        // comeback `which`
+	kLineRepeat,          // `repeat` answered: the opponent's line, `which` 0 before the insult, 1 after
+	kLineLostFirst,       // the one played lost a fight, the first time (they say it)
+	kLineLost,            // lost, after: its variants (`which` 0..)
+	kLineWon,             // won: the opponent's line (`which` 0 the master; 1 a pirate, the third won; 2 before)
+	kLineFallback,        // an insult from fallbackFrom on: the pirate's line (variants)
+	kLineMasterReply,     // one of the master's insults used on a pirate: the pirate's line
+	kLineAfter,           // the master after the fight (`which` 0 won, 1 lost): her lines, in order
+	kLineIntro,           // her talk's start (`which`: its own bit, 0 the first time): lines in order
+	kLineChoice,          // her talk's choices (`which` 0..): their text, said by the one played
+	kLineAnswer,          // her answer to choice c in state s (`which` c * 8 + s): lines in order
+	kLineAgain,           // her talk once fought (`which` how often, 1.. the last for more): lines
+	kLineGreeting,        // a pirate's greeting (variants)
+	kLineOption,          // a pirate's talk's choices (`which` its own index): their text
+	kLineReply,           // a pirate's answer to option `which`: lines in order
+	kLineTrained,         // the trainer, the one played trained already: lines
+	kLineTraining,        // the trainer's lines before the training
+	kLineShirt,           // the name of the thing the master gives (its game's, as carried)
+	kLineKinds
+};
+// What a talk's case leaves (kLineAnswer, kLineAgain, kLineReply by kind and
+// which): a fight (kFights), the master gone into her house (kGoesHome), the
+// talk at its end (kTalkEnds: a pirate's left), and values its game keeps,
+// as (variable, value) pairs.
+static const int kFights = 1, kGoesHome = 2, kTalkEnds = 4;
+} // End of namespace Duel
+
+namespace DuelBridge {
+
+// A game's fight file (bytes of its "-duel.svd", uncompressed), kept per
+// game; false (with `error`), and none, when malformed.
+bool load(int game, const unsigned char *data, size_t size, char *error, int capacity);
+bool loaded(int game);
+void clear();
+// Its rules (Scummverse::Duel::Rules, by name: "insults", "comebacks",
+// "ownFirst", "ownLast", "masterFirst", "masterLast", "loseFrom", "repeat",
+// "giveUp", "fallbackFrom", "insultGiveUp", "masterTarget",
+// "pirateTarget"; -1 none) and whether an insult takes a comeback.
+int rule(int game, const char *name);
+bool accepts(int game, int insult, int comeback);
+// A type's skill, talk colour and costume (false: none).
+bool type(int game, int type, int &skill, int &color, int &costume);
+// Its lines of a kind (Duel::kLine...) and which: how many, and each (in
+// order): who says it (Duel::kSpeakerPlayed, kSpeakerOpponent, kSpeakerNone),
+// its colour (-1: the speaker's own) and its text. How many `which` a kind
+// of variants has.
+int lines(int game, int kind, int which);
+bool line(int game, int kind, int which, int index, int &speaker, int &color, char *text, int capacity);
+int variants(int game, int kind);
+// What a talk's case leaves (false: none): its flags (Duel::kFights,
+// kGoesHome) and up to `capacity` (variable, value) pairs in `leaves`.
+bool outcome(int game, int kind, int which, int &flags, int *leaves, int &count, int capacity);
+
+// The fight under way (one at a time), of a game loaded: against the master
+// or a pirate of `skill`, seeded; what the one played has learned is kept
+// by the caller (bit n: number n) and passed in and out.
+static const int kOver = 0, kOpponentInsults = 1, kPlayerInsults = 2;
+static const int kNone = 0, kPlayerPoint = 1, kOpponentPoint = 2, kRepeated = 3, kGaveUp = 4;
+static const int kReplyFallback = 1000, kReplyMaster = 2000;
+bool start(int game, bool master, int skill, unsigned seed);
+int turn();
+int opponentInsult(unsigned long long &insults, unsigned &comebacks);
+int insultNow();
+int comebacks(unsigned long long insults, unsigned comebacks, int *out, int capacity);
+int insults(unsigned long long insults, unsigned comebacks, int *out, int capacity);
+int answer(int comeback);
+int insult(int insult, unsigned long long &insults, unsigned &comebacks, int &reply);
+int playerScore();
+int opponentScore();
+int target();
+bool won();
+bool gaveUp();
+int draw(int n);
+
+// The export's (a file built up, then its bytes): begun with its rules (the
+// numbers as Duel::Rules lists them, in the file's order: insults to
+// fallbackLines, 17) and each insult's three comebacks (from insult 1);
+// types, lines and outcomes added; written into `out` (returns its size,
+// copied when `capacity` takes it; 0: none begun or not a whole file).
+void begin(const int *rules, const int *accepted);
+void addType(int type, int skill, int color, int costume);
+void addLine(int kind, int which, int speaker, int color, const char *text);
+void addOutcome(int kind, int which, int flags, const int *leaves, int count);
+int written(unsigned char *out, int capacity);
+
+} // End of namespace DuelBridge
+} // End of namespace Scummverse
+
+#endif
