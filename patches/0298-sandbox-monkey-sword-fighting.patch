+		file1(Duel::kLineAfter, c, lines(r, 0));
+		if (!r.ended || _actors[w->masterActor]->_room != 0) mismatch("the master gone into her house after a fight", c, _actors[w->masterActor]->_room);
+		if (c == 0 && (readVar(w->won) != 1 || getOwner(w->shirt) != ego || readVar(w->trialsVar) != 1 || bitOf(w->trialBit) != 1)) mismatch("the master's trial won", w->trial, readVar(w->trialsVar));
+		// (What she gives, by its name as carried: its place lists no thing.)
+		if (c == 0) {
+			const byte *name = getObjOrActorName(w->shirt);
+			const Common::String text = name ? printable(name, 255) : Common::String();
+			if (text.empty()) mismatch("the master's gift with no name", w->shirt, 0);
+			DuelBridge::addLine(Duel::kLineShirt, 0, Duel::kSpeakerNone, -1, text.c_str());
+		}
+		if (c == 1 && (readVar(w->won) != 0 || getOwner(w->shirt) == ego)) mismatch("the master's fight lost", 0, readVar(w->won));
+	}
+	// ---- Her talk (58), as 113 starts it in the place of the fight. ----
+	// (Its states: 0 no sword; 1 untrained, her long answer not heard (518);
+	// 2 heard; 3 to 6 trained, with 0, 1, 2 or 3 fights won.)
+	auto atMaster = [&](int state, int fought) {
+		fresh(seed);
+		scene(w->duelRoom, false);
+		fighters(w->duelRoom, w->masterType, w->masterActor);
+		writeVar(kMode, 0); writeVar(w->fought, fought);
+		putOwner(w->sword, state ? ego : 0);
+		writeVar(w->trained, state >= 3); writeVar(w->heardLong, state == 2); writeVar(w->wins, state >= 3 ? state - 3 : 0);
+	};
+	for (int intro = 0; intro < 2 && !shouldQuit(); ++intro) {
+		atMaster(6, 0);
+		writeVar(w->introSeen, intro);
+		play(w->talkScript, {}, w->masterActor, Common::Array<int>(), false, -1, r);
+		file1(Duel::kLineIntro, intro, lines(r, 0));
+		const bool shown = r.atMenu && !r.menus.empty() && (int)r.menus[0].ids.size() == w->choices;
+		for (int k = 0; shown && k < w->choices; ++k) {
+			if (r.menus[0].ids[k] != 120 + k) mismatch("the master's choice", k, r.menus[0].ids[k]);
+			if (intro) DuelBridge::addLine(Duel::kLineChoice, k, Duel::kSpeakerPlayed, -1, r.menus[0].texts[k].c_str());
+		}
+		if (!shown || readVar(w->introSeen) != 1) mismatch("the master's choices", r.menus.empty() ? 0 : r.menus[0].ids.size(), intro);
+	}
+	for (int c = 0; c < w->choices && !shouldQuit(); ++c)
+		for (int state = 0; state < 7; ++state) {
+			atMaster(state, 0);
+			writeVar(w->introSeen, 1);
+			const int heardBefore = readVar(w->heardLong);
+			Common::Array<int> feed;
+			feed.push_back(120 + c);
+			play(w->talkScript, {}, w->masterActor, feed, false, -1, r);
+			if (!r.ended || r.menus.size() != 1) mismatch("the master's answer", c * 8 + state, r.menus.size());
+			file1(Duel::kLineAnswer, c * 8 + state, lines(r, 1));
+			const int flags = (readVar(kMode) == kModeMaster ? Duel::kFights : 0) | (_actors[w->masterActor]->_room == 0 ? Duel::kGoesHome : 0);
+			const int leaves[2] = {w->heardLong, readVar(w->heardLong)};
+			DuelBridge::addOutcome(Duel::kLineAnswer, c * 8 + state, flags, leaves, readVar(w->heardLong) != heardBefore ? 1 : 0);
+		}
+	for (int fought = 1; fought <= 4 && !shouldQuit(); ++fought) {
+		atMaster(6, fought);
+		play(w->talkScript, {}, w->masterActor, Common::Array<int>(), false, -1, r);
+		file1(Duel::kLineAgain, fought, lines(r, 0));
+		if (!r.ended || !r.menus.empty() || readVar(kMode) != kModeMaster) mismatch("the master's talk once fought", fought, readVar(kMode));
+		DuelBridge::addOutcome(Duel::kLineAgain, fought, readVar(kMode) == kModeMaster ? Duel::kFights : 0, nullptr, 0);
+	}
+	// ---- A pirate's talk (room 49's), as 111 starts it there. ----
+	auto atPirate = [&](uint32 s, int met, bool trained) {
+		fresh(s);
+		scene(w->fightRoom, false);
+		fighters(w->fightRoom, w->pirateFirst, w->opponentActor);
+		writeVar(kMode, 0); writeVar(w->met, met); writeVar(w->trained, trained);
+		writeVar(kPurse, 0); putOwner(w->credit, 0); bit(kAside, 0); writeVar(w->secondAsked, 0);
+	};
+	{
+		Common::Array<Common::String> seen;
+		for (int k = 0; k < 200 && (int)seen.size() < kGreetings && !shouldQuit(); ++k) {
+			atPirate(seed + 17 * k, 0, false);
+			play(w->pirateTalk, {}, w->opponentActor, Common::Array<int>(), false, -1, r);
+			for (const Said &said : lines(r, 0)) {
+				bool known = false;
+				for (const Common::String &t : seen) known = known || t == said.text;
+				if (!known) { DuelBridge::addLine(Duel::kLineGreeting, seen.size(), said.speaker, said.color, said.text.c_str()); seen.push_back(said.text); }
+			}
+		}
+		if ((int)seen.size() != kGreetings) mismatch("a pirate's greetings", seen.size(), kGreetings);
+	}
+	// (Untrained, met for the third time: its options in turn, the last of
+	// them ending its talk; untrained, leaving at once; trained: the fight,
+	// the one played insulting first. An option after which its talk goes on
+	// leaves the menu again, else ends it.)
+	Common::HashMap<int, bool> optionKnown;
+	for (int c = 0; c < 3 && !shouldQuit(); ++c) {
+		const bool trained = c == 2;
+		atPirate(seed, c == 0 ? 2 : 0, trained);
+		Common::Array<int> feed;
+		if (c == 0) for (int id : {120, 122, 125, 126}) feed.push_back(id);
+		else feed.push_back(c == 1 ? 124 : 127);
+		play(w->pirateTalk, {}, w->opponentActor, feed, false, -1, r);
+		// (Each menu as the new engine builds it: duelPirateOptions.)
+		bool asked = false, second = false;
+		int met = c == 0 ? 3 : 1;
+		for (uint m = 0; m < r.menus.size(); ++m) {
+			int want[8], wanted = 0;
+			if (!asked) want[wanted++] = 120;
+			if (asked && !second) want[wanted++] = 122;
+			if (met == 3) want[wanted++] = 125;
+			want[wanted++] = trained ? 127 : 126;
+			want[wanted++] = 124;
+			bool same = (int)r.menus[m].ids.size() == wanted;
+			for (int k = 0; same && k < wanted; ++k) same = r.menus[m].ids[k] == want[k];
+			if (!same) mismatch("a pirate's options", m, c);
+			for (uint k = 0; k < r.menus[m].ids.size(); ++k) {
+				const int id = r.menus[m].ids[k];
+				if (optionKnown.contains(id)) continue;
+				optionKnown[id] = true;
+				DuelBridge::addLine(Duel::kLineOption, id - 120, Duel::kSpeakerPlayed, -1, r.menus[m].texts[k].c_str());
