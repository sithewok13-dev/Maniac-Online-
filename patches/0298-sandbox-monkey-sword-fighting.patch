+	ScummverseKept kept;
+	scummverseKeep(kept);
+	const int ego = VAR(VAR_EGO), cursorState = _cursor.state, userPut = _userPut;
+	int mismatches = 0;
+	auto mismatch = [&](const char *what, int a, int b) {
+		warning("SCUMMVERSE world duel: %s %s %d (%d) not as its script has it", kWorldGames[gameIndex].gameid, what, a, b);
+		++mismatches;
+	};
+	auto quiet = [&]() {
