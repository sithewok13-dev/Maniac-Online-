+	// and the map's pirates (its local 202);
+	// the lost lines' variants (5) and the greetings' (4).)
+	static const int kInsultNow = 239, kComebackNow = 240, kTheirScore = 261, kOwnScore = 262, kTarget = 350, kMode = 284, kTurnOf = 287, kSkill = 267, kEnded = 282;
