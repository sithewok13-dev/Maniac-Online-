+// From 0281, an answer's others but what it gives: each thing given (`given`,
+// as above) and the picture it leaves that thing's place in (an answer of two
+// lists that too from 0281), not one it makes touchable or untouchable. A
+// usual answer gives nothing: before, its others were only those not given.
+static void scummverseUngiven(Common::Array<int> &others, int given) {
+	Common::Array<int> kept;
+	for (uint k = 0; k + 2 < others.size(); k += 3) {
+		bool gone = others[k + 2] == given;
