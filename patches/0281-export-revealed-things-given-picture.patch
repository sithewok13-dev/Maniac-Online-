+bool SandboxEngine::carryGiven(int game, const int *others, int count, int k) {
+	const int r = others[4 * k], o = others[4 * k + 1];
+	if (!carry(game, r, o, "", pictureOf(r, o))) return false;
+	for (int i = 0; i < count; ++i) if (others[4 * i] == r && others[4 * i + 1] == o && !others[4 * i + 3]) return true;
