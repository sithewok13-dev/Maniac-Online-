@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#ifndef SCUMM_SCUMMVERSE_PLANE_H
+#define SCUMM_SCUMMVERSE_PLANE_H
+namespace ScummverseZakPlane {
+// Audited English DOS V1 cabin: repeated original chairs, actor coordinates.
+static const int seatX[] = {63,52,41,30,19,74};
+// Only the source player's chair is foreground-masked. Reuse its original mask
+// for matching chairs; no source pixels or mask bytes are embedded here.
+inline bool extendChairMasks(unsigned char *map, int columns, int rows) {
+ if(columns<81 || rows!=16 || columns*rows>4096) return false;
+ for(int seat : seatX) if(seat!=63)
+  for(int dx=-1;dx<=5;++dx) for(int y=10;y<rows;++y)
+   map[(seat+dx)*rows+y]=map[(63+dx)*rows+y];
+ return true;
+}
+}
+#endif
