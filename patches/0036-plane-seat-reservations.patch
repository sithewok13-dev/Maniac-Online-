+// SPDX-License-Identifier: GPL-3.0-or-later
+#ifndef COMMON_SCUMMVERSE_SEATS_H
+#define COMMON_SCUMMVERSE_SEATS_H
+namespace ScummverseTransport {
+// Signed reservations: positive seated, negative standing, zero absent.
+// Pure transaction: failure leaves the caller's assignments untouched.
+inline bool allocateSeats(unsigned passengers, int *seats, int count, int capacity) {
+ if (count < 1 || count > 31 || capacity < 1 || capacity > 30) return false;
+ int next[31] = {}; unsigned used = 0; int total = 0;
+ for (int id = 0; id < count; ++id) if (passengers & (1u << id)) ++total;
+ if (total > capacity || (passengers >> count)) return false;
+ for (int id = 0; id < count; ++id) if (passengers & (1u << id)) {
+  const int value = seats[id];
+  if (value < -capacity || value > capacity || !value) continue;
+  const int slot = value < 0 ? -value : value;
+  if (!(used & (1u << slot))) { next[id] = value; used |= 1u << slot; }
+ }
+ for (int id = 0; id < count; ++id) if ((passengers & (1u << id)) && !next[id]) {
+  for (int slot = 1; slot <= capacity; ++slot) if (!(used & (1u << slot))) {
+   next[id] = slot; used |= 1u << slot; break;
+  }
+ }
+ for (int id = 0; id < count; ++id) seats[id] = next[id];
+ return true;
+}
+}
+#endif
