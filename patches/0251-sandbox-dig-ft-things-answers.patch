+// From 0251, The Dig's and Full Throttle's things as their own verbs answer
+// (their things files' effects, "SVO7" as Sam & Max's from 0247): each verb
+// of the game's own controls (The Dig's tap, its click: kWorldOwnVerbs; Full
+// Throttle's coin: the skull's eyes, its teeth, the hand, the boot) on every
+// touchable thing of the places exported, from its picture 0 and 1, as a
+// player uses it there: the place set up as on arriving (its entry scripts
+// and what they start, cut-scenes skipped), nothing running then; the one
+// played at the thing's walk-to point, the thing in that picture; the game's
+// own sentence for the verb (its sentence script: the thing's own script for
+// it, else the game's answer for a thing without one) run until it ends: the
+// first line said, its picture after, whether the one played took it, the
+// pictures after of the things of the places exported it set and those
+// given (picture 2). None for a door (the new engine opens those), one away
+// there, one with no name there (none a player touches) or in a picture
+// past 1; none where the one played is taken elsewhere, the thing is left in
+// a picture past 1, nothing is said or changed, or its scripts ran on past
+// the steps a run is given (see executeScript); an other in a picture past
+// 1, or a tram's car (the new engine's to show), is left out. Lines need no
+// waiting, nor animations (taken as drawn as each frame animates them). What
+// each run changes is put back after it: the game's variables, states,
+// owners, classes and things carried, and its arrays (where its own scripts
+// keep what is carried: one changed, let go or made anew put back as it
+// was), the pointer, the player's hold on the game and the one played's
+// clothes (the place's entry scripts dress them for it). (A film is passed
+// over while exporting: ScummEngine_v7::o6_kernelSetFunctions.)
+void ScummEngine::scummverseExportOwnAnswers(int gameIndex, const Common::Array<int> &rooms, const Common::Array<Common::Array<int> > &things, Common::Array<ScummverseAnswer> &answers) {
+	const int ego = VAR(VAR_EGO);
+	const Common::Array<int32> vars(_scummVars, _numVariables), roomVars(_roomVars, _roomVars ? _numRoomVariables : 0);
+	const Common::Array<byte> bits(_bitVars, _numBitVariables >> 3), states(_objectStateTable, _numGlobalObjects), owners(_objectOwnerTable, _numGlobalObjects);
+	const Common::Array<uint32> classes(_classData, _numGlobalObjects);
+	const Common::Array<uint16> inventory(_inventory, _numInventory);
+	Common::Array<Common::Array<byte> > arrays(MAX(_numArray, 1));
+	Common::Array<bool> held(MAX(_numArray, 1), false);
+	for (int i = 1; i < _numArray; ++i)
+		if (_res->isResourceLoaded(rtString, i)) { held[i] = true; arrays[i] = Common::Array<byte>(_res->_types[rtString][i]._address, _res->_types[rtString][i]._size); }
+	const int cursorState = _cursor.state, userPut = _userPut, egoCostume = _actors[ego]->_costume;
+	auto putBack = [&]() {
+		memcpy(_scummVars, vars.data(), vars.size() * sizeof(int32));
+		if (_roomVars) memcpy(_roomVars, roomVars.data(), roomVars.size() * sizeof(int32));
+		memcpy(_bitVars, bits.data(), bits.size());
+		memcpy(_objectStateTable, states.data(), states.size());
+		memcpy(_objectOwnerTable, owners.data(), owners.size());
+		memcpy(_classData, classes.data(), classes.size() * sizeof(uint32));
+		memcpy(_inventory, inventory.data(), inventory.size() * sizeof(uint16));
+		for (int i = 1; i < _numArray; ++i) {
+			if (_res->isResourceLoaded(rtString, i) && (!held[i] || _res->_types[rtString][i]._size != arrays[i].size())) _res->nukeResource(rtString, i);
+			if (!held[i]) continue;
+			if (!_res->isResourceLoaded(rtString, i)) _res->createResource(rtString, i, arrays[i].size());
+			memcpy(_res->_types[rtString][i]._address, arrays[i].data(), arrays[i].size());
+		}
+		_sentenceNum = 0; _drawObjectQueNr = 0;
+	};
+	auto quiet = [&]() {
+		for (uint s = 0; s < NUM_SCRIPT_SLOT; ++s) { vm.slot[s].status = ssDead; vm.slot[s].freezeCount = 0; vm.slot[s].cutsceneOverride = 0; }
+		_currentScript = 0xFF; vm.numNestedScripts = 0; vm.cutSceneStackPointer = 0; _sentenceNum = 0;
+		stopTalk(); _sound->stopAllSounds(); scummverseDropAnimCommands();
+		_cursor.state = cursorState; _userPut = userPut;
+	};
+	// (Its line: a new line or a wait a space; an animation's, a sound's,
+	// a colour's or a lettering's code passed over with its two bytes.)
+	auto lineOf = [&]() {
+		Common::String line;
+		for (uint c = 0; c < sizeof(_charsetBuffer) && _charsetBuffer[c] && line.size() < 255; ++c) {
+			const byte b = _charsetBuffer[c];
+			if (b == 0xFF && c + 1 < sizeof(_charsetBuffer)) {
+				const byte code = _charsetBuffer[++c];
+				if (code >= 9 && code <= 14) c += 2;
+			}
+			if (b >= 32 && b < 127) line += (char)b;
+			else if (!line.empty() && line.lastChar() != ' ') line += ' ';
+		}
+		while (!line.empty() && line.lastChar() == ' ') line.deleteLastChar();
+		return line;
+	};
+	auto arrive = [&](int room) {
+		quiet();
+		// (In the clothes they had; the place's entry scripts dress them for
+		// it, as on arriving: The Dig's space suit.)
+		if (_actors[ego]->_costume != egoCostume) _actors[ego]->setActorCostume(egoCostume);
+		// (From no place: no exit scripts.)
+		_EXCD_offs = 0;
+		const int exitScript = VAR_EXIT_SCRIPT != 0xFF ? VAR(VAR_EXIT_SCRIPT) : 0, exitScript2 = VAR_EXIT_SCRIPT2 != 0xFF ? VAR(VAR_EXIT_SCRIPT2) : 0;
+		if (VAR_EXIT_SCRIPT != 0xFF) VAR(VAR_EXIT_SCRIPT) = 0;
+		if (VAR_EXIT_SCRIPT2 != 0xFF) VAR(VAR_EXIT_SCRIPT2) = 0;
+		startScene(room, nullptr, 0);
+		if (VAR_EXIT_SCRIPT != 0xFF) VAR(VAR_EXIT_SCRIPT) = exitScript;
+		if (VAR_EXIT_SCRIPT2 != 0xFF) VAR(VAR_EXIT_SCRIPT2) = exitScript2;
+		for (int cycle = 0; cycle < 16 && _currentRoom == room; ++cycle) {
+			bool running = false;
+			for (uint s = 0; s < NUM_SCRIPT_SLOT; ++s) {
+				if (vm.slot[s].status == ssPaused) { vm.slot[s].delay = 0; vm.slot[s].status = ssRunning; }
+				running = running || vm.slot[s].status == ssRunning;
+			}
+			if (!running) break;
+			scummverseSkipCutscene();
+			if (VAR_HAVE_MSG != 0xFF) VAR(VAR_HAVE_MSG) = 0;
+			_talkDelay = 0; _sentenceNum = 0; _drawObjectQueNr = 0;
+			runAllScripts(); _sound->stopAllSounds();
+		}
+		quiet();
+		return _currentRoom == room;
+	};
+	// (Each kind of the game's controls, its own verb for it.)
+	Common::Array<int> kinds, verbs;
+	for (const WorldVerb &v : kWorldVerbs) {
+		if (v.game != gameIndex || v.kind == kWorldVerbWalk) continue;
+		int verb = v.verb;
+		for (const WorldOwnVerb &own : kWorldOwnVerbs) if (own.game == gameIndex && own.kind == v.kind) verb = own.verb;
+		kinds.push_back(v.kind); verbs.push_back(verb);
+	}
+	Common::HashMap<int, int> placeOf;
+	for (uint k = 0; k < rooms.size() && k < things.size(); ++k)
+		for (uint i = 0; i + 4 < things[k].size(); i += 5) if (!placeOf.contains(things[k][i])) placeOf[things[k][i]] = rooms[k];
+	// (A tram's car and its pictures are the new engine's to show, as it
+	// rides: an answer that calls one (The Dig's platforms) is not theirs.)
+	Common::HashMap<int, bool> ridden;
+	for (const WorldTramLine &line : kWorldTramLines)
+		for (const WorldTramStop &stop : line.ends)
+			if (line.game == gameIndex) for (int o : {(int)stop.car, (int)stop.picture[0], (int)stop.picture[1]}) if (o) ridden[o] = true;
+	// (Each run's script steps, its arrival's and its sentence's, nested
+	// scripts' too: one spent, its scripts stop and it is none; see
+	// executeScript.)
+	const int32 kRunSteps = 4000000;
+	int runs = 0, left = 0, beyond = 0, silent = 0, past = 0, overran = 0, unnamed = 0;
+	Common::HashMap<int, int> byKind;
+	for (uint k = 0; k < rooms.size() && k < things.size() && !shouldQuit(); ++k) {
+		const int room = rooms[k];
+		for (uint i = 0; i + 4 < things[k].size() && !shouldQuit(); i += 5) {
+			const int obj = things[k][i];
+			if (worldLinkFrom(gameIndex, room, obj) || (things[k][i + 2] & Scummverse::PanelBridge::kThingAway)) continue;
+			if (things[k][i + 1] > 1) { ++beyond; continue; }
+			for (uint v = 0; v < kinds.size(); ++v)
+				for (int from = 0; from < 2 && !shouldQuit(); ++from) {
+					putBack();
+					_rnd.setSeed(0x5C0BE + room);
+					_scummverseStepBudget = kRunSteps;
+					const int at = arrive(room) ? getObjectIndex(obj) : -1;
+					// (One with no name there is none a player can touch.)
+					if (at <= 0 || scummverseObjectName(obj).empty()) { unnamed += at > 0; _scummverseStepBudget = -1; continue; }
+					++runs;
+					putState(obj, from);
+					// (Where its game walks them to it: its picture's own point.)
+					int x = 0, y = 0, dir = 0;
+					getObjectXYPos(obj, x, y, dir);
+					Actor *a = _actors[ego];
+					a->putActor(x, y, room);
+					const Common::Array<byte> owned(_objectOwnerTable, _numGlobalObjects);
+					Common::Array<int> set;
+					_scummverseStatesSet = &set;
+					_charsetBuffer[0] = 0;
+					doSentence(verbs[v], obj, 0);
+					ScummverseAnswer e;
+					e.room = room; e.id = obj; e.kind = kinds[v]; e.from = from;
+					for (int frame = 0; frame < 600 && _currentRoom == room && !shouldQuit(); ++frame) {
+						checkAndRunSentenceScript();
+						bool running = _sentenceNum > 0;
+						for (uint s = 0; s < NUM_SCRIPT_SLOT; ++s) {
+							if (vm.slot[s].status == ssPaused) { vm.slot[s].delay = 0; vm.slot[s].status = ssRunning; }
+							running = running || vm.slot[s].status == ssRunning;
+						}
+						if (e.line.empty()) e.line = lineOf();
+						if (!running && frame > 1) break;
+						// (Lines need no waiting, nor animations: the actors
+						// here animated on as a frame does, and taken as drawn
+						// (else what waits for one to end waits for ever on
+						// one that goes round: The Dig's sentence, its lead
+						// standing); nothing here draws the objects queued.)
+						if (VAR_HAVE_MSG != 0xFF) VAR(VAR_HAVE_MSG) = 0;
+						_talkDelay = 0; _drawObjectQueNr = 0;
+						runAllScripts(); walkActors(); _sound->stopAllSounds();
+						for (int n = 1; n < _numActors; ++n)
+							if (_actors[n]->isInCurrentRoom() && _actors[n]->_costume) { _actors[n]->animateCostume(); _actors[n]->_needRedraw = false; }
+						scummverseDropAnimCommands();
+					}
+					if (e.line.empty()) e.line = lineOf();
+					_scummverseStatesSet = nullptr;
+					const bool spent = _scummverseStepBudget == 0;
+					_scummverseStepBudget = -1;
+					const int after = getState(obj);
+					e.after = after & 1;
+					e.taken = getOwner(obj) != owned[obj] && getOwner(obj) == ego;
+					const bool gone = _currentRoom != room || a->_room != room;
+					Common::HashMap<int, bool> listed;
+					for (int other : set) {
+						if (gone || other == obj || listed.contains(other) || !placeOf.contains(other) || ridden.contains(other) || e.others.size() >= 3 * 64) continue;
+						listed[other] = true;
+						if (_objectStateTable[other] > 1) { ++past; continue; }
+						e.others.push_back(placeOf[other]); e.others.push_back(other); e.others.push_back(_objectStateTable[other]);
+					}
+					for (int o = 1; o < (int)owned.size() && !gone && e.others.size() < 3 * 64; ++o)
+						if (o != obj && owned[o] != ego && getOwner(o) == ego && placeOf.contains(o) && !ridden.contains(o)) { e.others.push_back(placeOf[o]); e.others.push_back(o); e.others.push_back(2); }
+					quiet();
+					if (spent) ++overran;
+					else if (gone) ++left;
+					else if (after > 1 && !e.taken) ++beyond;
+					else if (e.line.empty() && e.after == from && !e.taken && e.others.empty()) ++silent;
+					else { answers.push_back(e); byKind[e.kind] = (byKind.contains(e.kind) ? byKind[e.kind] : 0) + 1; }
+				}
+		}
+	}
