+// The mansion's things one of its things changes, as its game's script does
+// (the original's: turning the basement's water valve, object 66 in room 29,
+// open or on drains the pool, 139 on the pool deck, room 6, to its second
+// picture, and closed or off fills it), and the doors its game keeps shut
+// until one is so (the pool's ladder, 172, goes down to the pit, room 2, only
+// with the pool drained). Maniac's own rooms and object numbers.
+struct ManiacFollows { short room, object, otherRoom, other; };
+static const ManiacFollows kManiacFollows[] = {{29, 66, 6, 139}};
+struct ManiacDoorNeeds { short room, door, needRoom, needObject, needPicture; };
+static const ManiacDoorNeeds kManiacDoorNeeds[] = {{6, 172, 6, 139, 1}};
+
+int SandboxEngine::pictureOf(int room, int id) const {
+	if (room == _room)
+		for (int o = 0; o < StageBridge::objectCount(); ++o) {
+			int oid, ox, oy, w, h, wx, wy, state;
+			if (StageBridge::object(o, oid, ox, oy, w, h, wx, wy, state) && oid == id) return StageBridge::objectShown(o);
+		}
+	const Common::HashMap<int, int>::const_iterator kept = _pictures.find(thingKey(_game, room, id));
+	if (kept != _pictures.end()) return kept->_value;
+	int picture, answers;
+	return PanelBridge::gameThing(_game, room, id, picture, answers) ? picture : 0;
+}
+
+void SandboxEngine::setPicture(int room, int id, int picture) {
+	if (room == _room)
+		for (int o = 0; o < StageBridge::objectCount(); ++o) {
+			int oid, ox, oy, w, h, wx, wy, state;
+			if (StageBridge::object(o, oid, ox, oy, w, h, wx, wy, state) && oid == id) { showPicture(o, id, picture); return; }
+		}
+	_pictures[thingKey(_game, room, id)] = picture;
+}
+
+void SandboxEngine::thingFollows(int id, int picture) {
+	if (_game < 0 || strcmp(kWorldGames[_game].gameid, "maniac")) return;
+	for (const ManiacFollows &f : kManiacFollows) if (f.room == _room && f.object == id) setPicture(f.otherRoom, f.other, picture);
+}
+
+bool SandboxEngine::doorAllowed(int room, int door) const {
+	if (_game < 0 || strcmp(kWorldGames[_game].gameid, "maniac")) return true;
+	for (const ManiacDoorNeeds &n : kManiacDoorNeeds) if (n.room == room && n.door == door && pictureOf(n.needRoom, n.needObject) != n.needPicture) return false;
+	return true;
+}
+
+bool SandboxEngine::meetDoorNeed(int room, int door) {
+	if (doorAllowed(room, door)) return false;
+	for (const ManiacDoorNeeds &n : kManiacDoorNeeds) if (n.room == room && n.door == door) setPicture(n.needRoom, n.needObject, n.needPicture);
+	return true;
+}
