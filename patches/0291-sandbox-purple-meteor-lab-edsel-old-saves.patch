+// From 0291 one of the cast who is a thing of a place (kWorldCastThings)
+// there while that thing lies there (not gone, nor taken away: takenAway),
+// as its game keeps them (the Purple Meteor never leaves the lab): put
+// first on the stage there, wherever the wanderers had them, as the Purple
+// Tentacle at his post (guardPosted), and on no other stage (castThingAway).
+// Before, with everyone out he was hardly ever in the lab, and the book
+// contract, whose film is given to him there only, had nobody to go to.
+void SandboxEngine::castThingPosted(int game, int room, Common::Array<int> &keys) const {
+	for (const WorldCastThing &t : kWorldCastThings) {
+		const int key = t.game >= 0 && t.game < worldGameCount() ? worldAppearanceKey(t.game, t.costume) : 0;
+		if (!key || t.game != game || t.room != room || !hasCharacter(key) || takenAway(key)) continue;
+		const Common::Array<int>::iterator at = Common::find(keys.begin(), keys.end(), key);
+		if (at != keys.end()) keys.erase(at);
+		keys.insert_at(0, key);
+	}
+}
+
+bool SandboxEngine::castThingAway(int key) const {
+	if (!key || key == _playerKey) return false;
+	for (const WorldCastThing &t : kWorldCastThings)
+		if (t.game >= 0 && t.game < worldGameCount() && worldAppearanceKey(t.game, t.costume) == key && !(_game == t.game && _room == t.room) && !takenAway(key)) return true;
+	return false;
+}
