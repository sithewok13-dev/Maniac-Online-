+
+void ScummEngine::scummverseRestoreSceneNavigation(bool restoreActors) {
+	if (!_scummverseRoaming) return;
+	bool audited=false;
+	for (int room : zakOriginalWalkboxRooms) if (room==_currentRoom) audited=true;
+	if (!audited || !scummverseMountExtra(_currentRoom)) return;
+	const auto &data=_scummverseExtraRooms[_currentRoom-56];
+	const uint offset=data[21];
+	if (offset>=data.size() || offset+1+data[offset]*8>data.size() || data[offset]!=getNumBoxes()) return;
+	for (int box=0;box<getNumBoxes();++box) setBoxFlags(box,data[offset+1+box*8+7]);
+	for (const auto &rule : zakWalkboxOverrides)
+		if (rule.room==_currentRoom && rule.box<getNumBoxes()) setBoxFlags(rule.box,rule.flags);
+	if (!restoreActors) return;
+	// Older sandbox saves may contain actors standing inside aerial boxes.
+	for (int id : mansionCast) {
+		Actor *a=derefActor(id,"restored walking actor");
+		if (a->_room!=_currentRoom) continue;
+		const auto pos=a->getRealPos();
+		const auto point=a->adjustXYToBeInBox(pos.x,pos.y);
+		a->stopActorMoving();
+		a->putActor(point.x,point.y,_currentRoom);
+	}
+}
