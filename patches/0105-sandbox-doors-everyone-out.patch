+// "SVS1", the place and the one played, where they stand, then (when the
+// cast is the same) where everyone is.
+void SandboxEngine::saveState() const {
+	if (_game < 0 || _player < 0) return;
+	Common::ScopedPtr<Common::OutSaveFile> out(g_system->getSavefileManager()->openForSaving(kStateFile, false));
+	if (!out) return;
+	double x, y;
+	StageBridge::position(_player, x, y);
+	out->writeUint32BE(MKTAG('S', 'V', 'S', '1'));
+	out->writeSint16LE(_game); out->writeSint16LE(_room); out->writeSint32LE(_playerKey);
+	out->writeSint32LE((int32)(x * 16)); out->writeSint32LE((int32)(y * 16));
+	const int values = _wanderers ? WanderBridge::packedCount() : 0;
+	out->writeUint32LE(_wanderers ? WanderBridge::signature() : 0);
+	out->writeUint16LE(values);
+	for (int i = 0; i < values; ++i) out->writeSint32LE(WanderBridge::packed(i));
+	out->finalize();
+}
+
+bool SandboxEngine::loadState(int &game, int &room, double &x, double &y) {
+	Common::ScopedPtr<Common::InSaveFile> in(g_system->getSavefileManager()->openForLoading(kStateFile));
+	if (!in || in->readUint32BE() != MKTAG('S', 'V', 'S', '1')) return false;
+	game = in->readSint16LE(); room = in->readSint16LE();
+	const int key = in->readSint32LE();
+	x = in->readSint32LE() / 16.0; y = in->readSint32LE() / 16.0;
+	const uint32 signature = in->readUint32LE();
+	const int values = in->readUint16LE();
+	if (in->err() || in->eos() || !installed(game, room) || !hasCharacter(key)) return false;
+	_playerKey = key;
+	if (_wanderers) {
+		buildWanderers(); // (without the one played)
+		if (signature == WanderBridge::signature() && values == WanderBridge::packedCount()) {
+			Common::Array<int32> packed(values);
+			for (int i = 0; i < values; ++i) packed[i] = in->readSint32LE();
+			if (!in->err() && !in->eos()) for (int i = 0; i < values; ++i) WanderBridge::unpack(i, packed[i]);
+		}
+	}
+	return true;
+}
