+// through one of the room's doors (else from the roomiest spot) and walks on.
+void SandboxEngine::arrivals() {
+	if (!_wanderers || !place(_game, _room)) return;
+	int found[512];
+	const int count = MIN<int>(WanderBridge::at(place(_game, _room), found, ARRAYSIZE(found)), ARRAYSIZE(found));
+	for (int i = 0; i < count; ++i) {
+		bool here = false;
+		for (int key : _onStage) here = here || key == found[i];
+		if (here || found[i] == _playerKey || _broken.contains(found[i])) continue;
+		const int n = addPerson(found[i]);
+		if (n < 0) continue;
+		_onStage.push_back(found[i]);
+		Common::Array<int> doors;
+		for (int o = 0; o < StageBridge::objectCount(); ++o) if (isDoor(o)) doors.push_back(o);
+		double xs[12], ys[12], x, y;
+		const int spots = StageBridge::spots(12, xs, ys);
+		if (!doors.empty()) {
+			doorPoint(doors[_random.getRandomNumber(doors.size() - 1)], x, y);
+		} else {
+			x = spots ? xs[0] : 0; y = spots ? ys[0] : 0;
+		}
+		StageBridge::place(n, x, y);
+		if (spots) { const int to = _random.getRandomNumber(spots - 1); StageBridge::walkTo(n, xs[to], ys[to]); }
+	}
+	_people = _onStage.size();
+}
+
+void SandboxEngine::stroll(int ticks) {
+	if ((_strollClock -= ticks) > 0 || _onStage.size() < 2) return;
+	_strollClock = 180 + _random.getRandomNumber(420);
+	const int n = 1 + _random.getRandomNumber(_onStage.size() - 2);
+	if (n == _player || StageBridge::moving(n)) return;
+	double xs[12], ys[12];
+	const int spots = StageBridge::spots(12, xs, ys);
+	if (spots) { const int to = _random.getRandomNumber(spots - 1); StageBridge::walkTo(n, xs[to], ys[to]); }
+}
+
+void SandboxEngine::step(int ticks) {
+	StageBridge::update(ticks);
+	if (_door >= 0 && !StageBridge::moving(_player)) reachDoor();
+	if (_wanderers && WanderBridge::advance(ticks, place(_game, _room))) arrivals();
+	stroll(ticks);
+}
