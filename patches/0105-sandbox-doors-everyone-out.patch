+	if (enter(game, room, 0, problem)) return;
+	warning("SCUMMVERSE sandbox: %s not shown (%s)", kWorldGames[game].gameid, problem.c_str());
+	if (fromGame >= 0) enter(fromGame, fromRoom, 0, problem);
+}
