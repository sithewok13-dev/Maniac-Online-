+		if (best >= 0) {
+			if (bestUnder != under) { if (bestUnder) continue; }
+			else if (!under && away != bestAway) { if (away > bestAway) continue; }
+			else if (area >= bestArea) continue;
+		}
+		best = i; bestUnder = under; bestArea = area; bestAway = away;
+	}
