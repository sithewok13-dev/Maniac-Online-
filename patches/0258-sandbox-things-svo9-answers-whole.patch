+// (From 0258: an answer whole, its own to that second, else its usual one.)
+static const Panel::ThingEffect *answerOf(int game, int room, int id, int kind, int from, int with) {
+	for (const auto &g : gameThings()) {
+		if (g.first != game) continue;
+		const Panel::ThingEffect *e = g.second.effect(room, id, kind, from, with);
+		return e || !with ? e : g.second.effect(room, id, kind, from, Panel::kAnyOther);
+	}
+	return nullptr;
+}
+bool thingAnswer(int game, int room, int id, int kind, int from, int with, int &after, int &flags, int *others, int &count, int capacity, int &lines) {
+	count = 0; flags = 0; lines = 0;
+	const Panel::ThingEffect *e = answerOf(game, room, id, kind, from, with);
+	if (!e) return false;
+	after = e->after;
+	flags = (e->taken ? 1 : 0) | (e->firstGone ? 2 : 0) | (e->secondGone ? 4 : 0) | (with && e->with == with ? 8 : 0);
+	for (const Panel::ThingPart &part : e->others) {
+		if (count >= capacity) break;
+		others[count * 4] = part.room; others[count * 4 + 1] = part.id; others[count * 4 + 2] = part.given ? 0 : part.picture; others[count * 4 + 3] = part.given;
+		++count;
+	}
+	lines = (int)e->lines.size();
+	return true;
+}
+bool answerLine(int game, int room, int id, int kind, int from, int with, int line, int &speaker, int &costume, int &color, char *text, int capacity) {
+	const Panel::ThingEffect *e = answerOf(game, room, id, kind, from, with);
+	if (!e || line < 0 || line >= (int)e->lines.size()) return false;
+	const Panel::ThingLine &l = e->lines[line];
+	speaker = l.speaker; costume = l.costume; color = l.color;
+	copy(l.text, text, capacity);
+	return true;
+}
+bool addIcon(int game, int id, const char *name) {
+	for (const auto &g : gameThings()) {
+		if (g.first != game) continue;
+		const Panel::ThingIcon *c = g.second.icon(id);
+		if (!c) return false;
+		Panel::Item item;
+		item.name = name ? name : c->name;
+		item.width = c->width; item.height = c->height; item.picture = c->picture;
+		std::vector<Panel::Item> items = panel().items();
+		items.push_back(item);
+		panel().setItems(items);
+		return true;
+	}
+	return false;
+}
