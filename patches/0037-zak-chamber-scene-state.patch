+void ScummEngine::scummverseRestoreSceneObjects() {
+ if(!_scummverseRoaming || _currentRoom<56 || _currentRoom>98) return;
+ bool configured=false;
+ for(const auto &rule : zakSceneObjectStates) if(rule.room==_currentRoom) configured=true;
+ if(!configured || !scummverseMountExtra(_currentRoom)) return;
+ // Imported puzzle objects are immutable sightseeing state. Repair old saves
+ // with the same edition-specific setup used on normal entry, without touching
+ // other scenes sharing the source resource or actor positions.
+ const auto &room=_scummverseExtraRooms[_currentRoom-56];
+ for(int i=0;i<room[20];++i) putState(732+i,_scummverseExtraStates[_currentRoom-56][i]);
+ _fullRedraw=true;
+}
