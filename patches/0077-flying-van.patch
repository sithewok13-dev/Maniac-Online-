+// A scene's object state: an audited setup's, else the imported room's, with
+// a logical scene's own rules (the van's windshield in flight).
+int ScummEngine::scummverseSceneState(int room, int i) const {
+ const int slot=zakSceneSlotRoom(room);
+ if(!slot || i<0 || i>=33) return 0;
+ if(zakLogicalRoom(room)) if(const auto *scene=zakSceneSetup(room)) return scene->objects[i].state;
+ int state=_scummverseExtraStates[slot-56][i];
+ if(zakLogicalRoom(room)) for(const auto &rule : zakSceneObjectStates)
+  if(rule.room==room && rule.object==_scummverseOriginalObjects[slot-56][i]) state=(state|rule.setBits)&~rule.clearBits;
