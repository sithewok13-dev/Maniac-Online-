+++ b/engines/scumm/scummverse_van.inc
@@ -0,0 +1,306 @@
+// SCUMMVERSE: Melissa and Leslie's van, the Shuttle Bug. GPL-3.0-or-later.
+// Original Zak: the van stands on Mars at the landing site (painted into
+// its background; object 454 is the empty sand drawn once it has gone), its
+// door (452) opens into the cockpit (room 30, sandbox 81), and the controls
+// (490) launch it: countdown, the windshield's stars (494), flight colors.
+// The original never lands. Here it flies like the plane: one van per game,
+// saved where it is parked, boarded wherever it stands, flown from the
+// controls with everyone in the cockpit, endlessly until Arrive, and landed
+// at any outdoor site (catalog kWorldVanSites). Away from Mars it is drawn
+// from the landing site's own art: the background with the van less the
+// background with the sand. Lines are newly written.
+//
+// Saved: 613 site (catalog index; -1 in flight), 614/615 where it stands
+// (room pixels: left, bottom), 616 phase (0 parked, counting down until
+// kVanLiftoff, then kVanFlying), 617 riders, 618 its scale there (x100).
+
+static const int kVanObject = 454, kVanDoor = 452, kVanCockpitDoor = 488, kVanControls = 490, kVanMeters = 491;
+// A Zak kid's height in the original's art, against which the van is scaled;
+// the van's own size there (object 454) until its picture is taken.
+static const double kVanKidHeight = 62.0;
+static const int kVanWidth = 144, kVanHeight = 72;
+
+bool ScummEngine::scummverseVanFlying() const {
+	return _scummverseRoaming && _scummVars && _scummVars[kVanPhaseVar] > 0;
+}
+bool ScummEngine::scummverseInVan() const {
+	return scummverseVanFlying() && (_scummVars[kVanRidersVar] & (1u << _scummVars[VAR_EGO]));
+}
+
+// The site the van stands at now, or -1 (in flight).
+int ScummEngine::scummverseVanSite() const {
+	if (!_scummVars || _scummVars[kVanPhaseVar] >= kVanLiftoff) return -1;
+	const int site = _scummVars[kVanSiteVar];
+	return site >= 0 && site < kWorldVanSiteCount ? site : 0;
+}
+
+// Whether the viewed room is a site's room.
+bool ScummEngine::scummverseVanSiteHere(int site) const {
+	if (site < 0 || site >= kWorldVanSiteCount) return false;
+	const WorldVanSite &s = kWorldVanSites[site];
+	if (s.game < 0) return _currentRoom == s.room;
+	int source;
+	return scummverseWorldGameOf(_currentRoom, source) == s.game && source == s.room;
+}
+
+// The van parked in this room away from its own landing site (room pixels).
+bool ScummEngine::scummverseVanRect(int &x, int &y, int &w, int &h) {
+	const int site = scummverseVanSite();
+	if (site <= 0 || !scummverseVanSiteHere(site)) return false;
+	const bool picture = scummverseLoadVan();
+	const double scale = MAX(10, _scummVars[kVanScaleVar] ? _scummVars[kVanScaleVar] : 100) / 100.0;
+	w = MAX(1, (int)((picture ? _scummverseVanW : kVanWidth) * scale)); h = MAX(1, (int)((picture ? _scummverseVanH : kVanHeight) * scale));
+	x = _scummVars[kVanXVar]; y = _scummVars[kVanYVar] - h;
+	return true;
+}
+
+static Common::Path scummverseVanFile(const Common::Path &cache) { return cache.appendComponent("zak-van.svv"); }
+
+// The van's picture, kept beside the other worlds' cache once taken.
+bool ScummEngine::scummverseLoadVan() {
+	if (!_scummverseVanSprite.empty()) return true;
+	const Common::FSNode node(scummverseVanFile(scummverseWorldCache()));
+	Common::ScopedPtr<Common::SeekableReadStream> in(node.exists() ? node.createReadStream() : nullptr);
+	if (!in || in->readUint32BE() != MKTAG('S', 'V', 'V', '1')) return false;
+	const int w = in->readUint16LE(), h = in->readUint16LE();
+	if (w <= 0 || h <= 0 || w > 640 || h > 256) return false;
+	_scummverseVanSprite.resize(w * h);
+	if (in->read(_scummverseVanSprite.data(), w * h) != (uint32)(w * h)) { _scummverseVanSprite.clear(); return false; }
+	_scummverseVanW = w; _scummverseVanH = h;
+	return true;
+}
+
+// At the landing site: the background with the van, less the background with
+// the sand drawn over it, is the van (255: none). Drawn off screen in one go.
+void ScummEngine::scummverseCaptureVan() {
+	if (!_scummverseVanSprite.empty() || _currentRoom != kVanLandingSite || scummverseLoadVan()) return;
+	int obj = 0;
+	for (int i = 0; i < 33 && !obj; ++i) if (scummverseOriginalObject(_currentRoom, 732 + i) == kVanObject) obj = 732 + i;
+	const int index = obj ? getObjectIndex(obj) : -1;
+	if (index < 0) return;
+	const int ox = _objs[index].x_pos, oy = _objs[index].y_pos, ow = _objs[index].width, oh = _objs[index].height;
+	if (ow <= 0 || oh <= 0 || ow > _screenWidth) return;
+	VirtScreen &vs = _virtscr[kMainVirtScreen];
+	if (!vs.hasTwoBuffers || oy + oh > vs.h) return;
+	const int state = getState(obj);
+	const Common::Point cameraAt = camera._cur, cameraTo = camera._dest, cameraWas = camera._last;
+	auto aim = [&](int x) { camera._cur.x = camera._dest.x = CLIP<int>(x, VAR(VAR_CAMERA_MIN_X), VAR(VAR_CAMERA_MAX_X)); cameraMoved(); };
+	Common::Array<byte> with, without;
+	auto grab = [&](int shown, Common::Array<byte> &out) {
+		putState(obj, shown); updateObjectStates();
+		aim(ox + ow / 2);
+		_fullRedraw = true; redrawBGAreas();
+		out.resize(ow * oh);
+		for (int y = 0; y < oh; ++y) for (int x = 0; x < ow; ++x) {
+			const int sx = ox - vs.xstart + x;
+			out[y * ow + x] = sx >= 0 && sx < _screenWidth ? *(const byte *)vs.getBackPixels(sx, oy + y) : 255;
+		}
+	};
+	grab(state & ~(kObjectStateIntrinsic | kObjectStateUntouchable), with);
+	grab(state | kObjectStateIntrinsic, without);
+	putState(obj, state); updateObjectStates();
+	camera._cur = cameraAt; camera._dest = cameraTo; cameraMoved(); camera._last = cameraWas; _fullRedraw = true;
+	int drawn = 0;
+	_scummverseVanSprite.resize(ow * oh);
+	for (int i = 0; i < ow * oh; ++i) {
+		const bool van = with[i] != without[i] && with[i] != 255;
+		_scummverseVanSprite[i] = van ? with[i] : 255; drawn += van;
+	}
+	if (drawn < ow * oh / 8) { _scummverseVanSprite.clear(); return; } // Not the van after all.
+	_scummverseVanW = ow; _scummverseVanH = oh;
+	Common::DumpFile out;
+	if (out.open(scummverseVanFile(scummverseWorldCache()), true)) {
+		out.writeUint32BE(MKTAG('S', 'V', 'V', '1')); out.writeUint16LE(ow); out.writeUint16LE(oh);
+		out.write(_scummverseVanSprite.data(), _scummverseVanSprite.size()); out.finalize();
+	}
+}
+
+// Part of the background where it stands: drawn in every redrawn strip,
+// into both buffers, so people walk in front of it.
+void ScummEngine::scummverseDrawVan() {
+	int vx, vy, vw, vh;
+	if (!_scummverseRoaming || !scummverseVanRect(vx, vy, vw, vh) || _scummverseVanSprite.empty()) return;
+	VirtScreen &vs = _virtscr[kMainVirtScreen];
+	const double sx = (double)_scummverseVanW / vw, sy = (double)_scummverseVanH / vh;
+	for (int x = 0; x < vw; ++x) {
+		const int screenX = vx + x - vs.xstart;
+		if (screenX < 0 || screenX >= _screenWidth || !testGfxUsageBit(_screenStartStrip + screenX / 8, USAGE_BIT_DIRTY)) continue;
+		const int px = MIN(_scummverseVanW - 1, (int)(x * sx));
+		for (int y = 0; y < vh; ++y) {
+			const int screenY = vy + y;
+			if (screenY < 0 || screenY >= vs.h) continue;
+			const byte c = _scummverseVanSprite[MIN(_scummverseVanH - 1, (int)(y * sy)) * _scummverseVanW + px];
+			if (c == 255) continue;
+			*(byte *)vs.getPixels(screenX, screenY) = c;
+			if (vs.hasTwoBuffers) *(byte *)vs.getBackPixels(screenX, screenY) = c;
+		}
+	}
+}
+
+// At its landing site the van is the original's: there, or the sand.
+void ScummEngine::scummverseApplyVanState() {
+	if (!_scummverseRoaming || _currentRoom != kVanLandingSite) return;
+	const bool here = scummverseVanSite() == 0;
+	for (int i = 0; i < 33; ++i) {
+		if (scummverseOriginalObject(_currentRoom, 732 + i) != kVanObject) continue;
+		const int state = getState(732 + i);
+		const int want = here ? state & ~(kObjectStateIntrinsic | kObjectStateUntouchable) : state | kObjectStateIntrinsic | kObjectStateUntouchable;
+		if (state != want) { putState(732 + i, want); updateObjectStates(); _fullRedraw = true; }
+	}
+}
+
+// Tapping the van where it stands: aboard, into the cockpit.
+bool ScummEngine::scummverseVanTap(int x, int y) {
+	int vx, vy, vw, vh;
+	if (!scummverseVanRect(vx, vy, vw, vh) || x < vx || x >= vx + vw || y < vy || y >= vy + vh) return false;
+	scummverseTravel(kVanCockpit - 50, kVanCockpitDoor);
+	return true;
+}
+
+// Interactions in and at the van; true when handled.
+bool ScummEngine::scummverseVanObject(int object, int verb) {
+	if (verb != 13 && verb != 11 && verb != 1) return false;
+	const int original = scummverseOriginalObject(_currentRoom, object);
+	const int ego = VAR(VAR_EGO);
+	if (_currentRoom == kVanLandingSite && (original == kVanObject || original == kVanDoor) && scummverseVanSite() != 0) {
+		scummverseSay(ego, "The van isn't parked here right now."); return true;
+	}
+	if (_currentRoom == kVanFlightRoom) {
+		if (original == kVanCockpitDoor) { scummverseSay(ego, "Not while we're flying! Choose Arrive to land."); return true; }
+		if (original == kVanControls) { scummverseSay(ego, "We're on autopilot. Choose Arrive to land."); return true; }
+		return false;
+	}
+	if (_currentRoom != kVanCockpit) return false;
+	if (original == kVanCockpitDoor) {
+		if (scummverseVanFlying()) { scummverseSay(ego, "We're about to lift off!"); return true; }
+		const int site = scummverseVanSite();
+		if (site == 0) return false; // The original door to the landing site.
+		scummverseVanStepOut(site);
+		return true;
+	}
+	if (original == kVanControls) {
+		if (scummverseVanFlying()) return true;
+		// Everyone in the cockpit flies along.
+		unsigned riders = 0;
+		for (int id : mansionCast) if (!scummverseRemoteActor(id) && derefActor(id, "van rider")->_room == kVanCockpit) riders |= 1u << id;
+		_scummVars[kVanRidersVar] = riders; _scummVars[kVanPhaseVar] = 1;
+		scummverseAnnounce("All systems go. Hold on to something!");
+		return true;
+	}
+	return false;
+}
+
+// Out of the cockpit at the van's site, beside it.
+void ScummEngine::scummverseVanStepOut(int site) {
+	const WorldVanSite &s = kWorldVanSites[site];
+	const int x = MAX(1, (_scummVars[kVanXVar] - 16) / 8), y = _scummVars[kVanYVar] / 2;
+	if (s.game >= 0) {
+		const int room = scummverseWorldRoomFor(s.game, s.room);
+		if (room) scummverseTravelWorld(room, x, y);
+	} else if (s.room <= 52) {
+		const int key = travellerReturnKey(VAR(VAR_EGO));
+		_scummVars[key] = s.room; _scummVars[key + 1] = x; _scummVars[key + 2] = y;
+		scummverseTravel(2);
+	} else scummverseTravel(s.room == 55 ? 5 : s.room == 54 ? 1 : s.room - 50, 0, x, y);
+}
+
+void ScummEngine::scummverseServiceVan(int delta) {
+	if (!_scummverseRoamingReady || !_scummVars || VAR(VAR_EGO) < 1 || VAR(VAR_EGO) >= kScummverseManiacActors) return;
+	if (_currentRoom == kVanLandingSite) { scummverseCaptureVan(); scummverseApplyVanState(); }
+	const int previous = _scummVars[kVanPhaseVar];
+	if (!previous) return;
+	const unsigned riders = _scummVars[kVanRidersVar];
+	if (previous < kVanLiftoff) {
+		const int phase = _scummVars[kVanPhaseVar] = MIN(kVanLiftoff, previous + MIN(delta, 60));
+		// The countdown, the meters blinking.
+		static const char *const counts[] = {"Five...", "Four...", "Three...", "Two...", "One..."};
+		for (int n = 0; n < 5; ++n) if (previous < 60 * (n + 1) && phase >= 60 * (n + 1) && _currentRoom == kVanCockpit) scummverseAnnounce(counts[n]);
+		if (_currentRoom == kVanCockpit) for (int i = 0; i < 33; ++i) if (scummverseOriginalObject(_currentRoom, 732 + i) == kVanMeters) {
+			const int want = (phase / 15) % 2 ? kObjectStateIntrinsic : 0;
+			if ((getState(732 + i) & kObjectStateIntrinsic) != want) { putState(732 + i, (getState(732 + i) & ~kObjectStateIntrinsic) | want); updateObjectStates(); _fullRedraw = true; }
+		}
+		if (phase < kVanLiftoff) return;
+		// Liftoff: everyone aboard into the flight, the player looking out.
+		const bool fromMars = scummverseVanSite() == 0;
+		_scummVars[kVanSiteVar] = -1; _scummVars[kVanPhaseVar] = kVanFlying;
+		if (riders & (1u << VAR(VAR_EGO))) {
+			_scummverseLanding = true; scummverseTravel(kVanFlightRoom - 50); _scummverseLanding = false;
+		}
+		for (int id : mansionCast) if (riders & (1u << id)) {
+			Actor *a = derefActor(id, "van flyer"); a->stopActorMoving(); a->putActor(20, 60, kVanFlightRoom); a->hideActor();
+		}
+		scummverseAnnounce(fromMars ? "Liftoff! So long, Mars!" : "Liftoff!");
+		return;
+	}
+	// In flight: aboard is unseen, also after a load showed them.
+	if (_currentRoom == kVanFlightRoom)
+		for (int id : mansionCast) if (riders & (1u << id)) {
+			Actor *a = derefActor(id, "van unseen");
+			if (a->_room == _currentRoom && a->_visible) { a->stopActorMoving(); a->hideActor(); }
+		}
+}
+
+// Arrive: where to land.
+void ScummEngine::scummverseVanArrive() {
+	if (_currentRoom != kVanFlightRoom || _scummVars[kVanPhaseVar] < kVanLiftoff) return;
+#ifdef SCUMMVERSE_LOCAL_AI
+	::scummverseAirportOffer(((_currentRoom * 32 + VAR(VAR_EGO)) << 8) | (1 << 29));
+#else
+	GUI::ChooserDialog dialog(Common::U32String("Where should the van land?"));
+	Common::U32StringArray sites;
+	for (const auto &site : kWorldVanSites) sites.push_back(Common::U32String(site.label));
+	dialog.setList(sites);
+	const int choice = runDialog(dialog);
+	if (choice >= 0 && choice < kWorldVanSiteCount) scummverseVanLand(choice);
+#endif
+}
+
+// Down at a site: the van parks, everyone aboard steps out beside it.
+bool ScummEngine::scummverseVanLand(int site) {
+	if (site < 0 || site >= kWorldVanSiteCount || _scummVars[kVanPhaseVar] < kVanLiftoff) return false;
+	const WorldVanSite &s = kWorldVanSites[site];
+	const unsigned riders = _scummVars[kVanRidersVar];
+	const int ego = VAR(VAR_EGO);
+	Actor *player = derefActor(ego, "van pilot");
+	_scummverseLanding = true;
+	bool landed;
+	if (site == 0) {
+		_scummVars[kVanSiteVar] = 0; _scummVars[kVanPhaseVar] = 0;
+		landed = scummverseTravel(kVanLandingSite - 50, kVanDoor);
+	} else if (s.game >= 0) {
+		const int room = scummverseWorldRoomFor(s.game, s.room);
+		landed = room && scummverseTravelWorld(room);
+	} else if (s.room <= 52) {
+		const int key = travellerReturnKey(ego);
+		_scummVars[key] = s.room; _scummVars[key + 1] = 30; _scummVars[key + 2] = 60;
+		landed = scummverseTravel(2);
+	} else landed = scummverseTravel(s.room == 55 ? 5 : s.room - 50);
+	_scummverseLanding = false;
+	if (!landed) {
+		if (site == 0) { _scummVars[kVanSiteVar] = -1; _scummVars[kVanPhaseVar] = kVanFlying; }
+		scummverseSay(ego, "We can't land there. Let's pick another spot."); return false;
+	}
+	if (site) {
+		// Parked beside the player, on the side with more room, as tall as
+		// people standing there.
+		double scale = 1.0;
+		if (s.game >= 0) scale = kWorldGames[s.game].heroHeight * WorldBridge::sceneScale() * scummverseWorldDepth(player) / kVanKidHeight;
+		const int w = (int)((_scummverseVanW ? _scummverseVanW : kVanWidth) * scale), px = player->getRealPos().x * 8, py = player->getRealPos().y * 2;
+		int left = px * 2 > _roomWidth ? px - 12 - w : px + 12;
+		left = CLIP(left, 0, MAX(0, _roomWidth - w));
+		_scummVars[kVanSiteVar] = site; _scummVars[kVanPhaseVar] = 0;
+		_scummVars[kVanXVar] = left; _scummVars[kVanYVar] = py; _scummVars[kVanScaleVar] = (int)(scale * 100 + 0.5);
+	}
+	int k = 0;
+	for (int id : mansionCast) if ((riders & (1u << id)) && id != ego) {
+		Actor *a = derefActor(id, "van passenger");
+		const AdjustBoxResult at = a->adjustXYToBeInBox(player->getRealPos().x - 3 - 3 * (k++ % 4), player->getRealPos().y);
+		a->stopActorMoving(); a->putActor(at.x, at.y, _currentRoom); a->showActor(); a->startAnimActor(a->_standFrame);
+		_scummverseRoamers[id] = Roamer(); _scummverseRoamers[id].wait = 600;
+	}
+	player->showActor();
+	_scummVars[kVanRidersVar] = 0;
+	_fullRedraw = true;
+	scummverseAnnounce("Touchdown!");
+	return true;
+}
