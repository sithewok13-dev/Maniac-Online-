+// ---- The camera ----
+
+// The first shot waits a moment once everyone is posed; each stays on the
+// screen a little (the iPhone's flash goes off over it); the last a little
+// longer (as Maniac's).
+static const uint32 kSelfieSettle = 400, kSelfieNext = 300, kSelfieShow = 900;
+
+bool SandboxEngine::cameraStep() {
+	if (Camera::held()) return true;
+	if (_selfie.on) {
+		if ((int32)(g_system->getMillis() - _selfie.due) < 0) return true;
+		if (_selfie.showing) { selfieEnd(); return true; }
+		if (!selfieShoot()) {
+			Camera::note(_selfie.shot ? "Took only some of the selfie" : "Couldn't take the selfie");
+			_selfie.showing = true; _selfie.due = g_system->getMillis();
+			return true;
+		}
+		if (++_selfie.shot < _selfie.shots) {
+			selfiePose();
+			_selfie.due = g_system->getMillis() + kSelfieNext;
+		} else {
+			_selfie.showing = true;
+			_selfie.due = g_system->getMillis() + kSelfieShow;
+		}
+		return true;
+	}
+	Camera::Request request;
+	if (!Camera::takeRequest(request)) return false;
+	if (request.kind == Camera::kSelfie) return selfieBegin(request.shots);
+	if (!photo(request.kind)) Camera::note("Couldn't take the photo");
+	return false;
+}
+
+// The scene alone as it is now (no panel, no lines over heads), else the
+// screen as shown; its pixels already square, enlarged by whole pixels only.
+bool SandboxEngine::photo(int kind) {
+	if (_player < 0) return false;
+	Camera::Rect crop;
+	if (kind == Camera::kFull) {
+		present();
+		crop.w = _width; crop.h = _height;
+	} else {
+		StageBridge::render(_frame.data(), _width);
+		int left, top, width, height;
+		double rowScale, colScale;
+		StageBridge::view(left, top, width, height, rowScale, colScale);
+		crop.x = left; crop.y = top; crop.w = width; crop.h = height;
+		_dirty = true; // (the screen as it was, next)
+	}
+	return Camera::shootTrue(_frame.data(), _width, _width, _height, crop, kind, 0, 1);
+}
+
+bool SandboxEngine::selfieBegin(int shots) {
+	int x0, y0, x1, y1;
+	if (_player < 0 || !StageBridge::drawnRect(_player, x0, y0, x1, y1)) {
+		Camera::note("No selfie here");
+		return false;
+	}
+	_selfie = Selfie();
+	_selfie.on = true;
+	_selfie.shots = CLIP(shots, 1, (int)Camera::kMaxSelfies);
+	_selfie.seed = g_system->getMillis() * 2654435761u ^ (uint32)(_game * 1024 + _room) * 40503u ^ (uint32)_playerKey;
+	Camera::setBusy(true);
+	selfiePose();
+	_selfie.due = g_system->getMillis() + kSelfieSettle;
+	return true;
+}
+
+// Everyone faces the camera and strikes a pose from their own frames:
+// standing, mid-step or talking (now and then one hasn't noticed, or they
+// all stare at the one played); drawn so, the place held still.
+void SandboxEngine::selfiePose() {
+	const int count = StageBridge::actorCount();
+	Common::Array<int> xs(count);
+	Common::Array<Camera::Choice> choices(count);
+	for (int n = 0; n < count; ++n) {
+		double x, y;
+		int sy;
+		StageBridge::position(n, x, y);
+		StageBridge::toScreen(x, y, xs[n], sy);
+	}
+	Camera::planShot(_selfie.seed, _selfie.shot, _player, xs.data(), count, choices.data());
+	for (int n = 0; n < count; ++n) {
+		const Camera::Choice &c = choices[n];
+		const int dir = c.facing == Camera::kFaceViewer ? 2 : c.facing == Camera::kFaceLeft ? 0 : c.facing == Camera::kFaceRight ? 1 : -1;
+		const int kind = c.pose == Camera::kStand ? 0 : c.pose == Camera::kStep ? 1 : c.pose == Camera::kTalk ? 2 : -1;
+		StageBridge::pose(n, dir, kind, c.pose == Camera::kStep ? c.step : c.pose == Camera::kTalk ? _selfie.shot + n : 0);
+	}
+	StageBridge::render(_frame.data(), _width);
+	show();
+}
+
+// One shot: framed (the first time, then kept) on the one played and
+// whoever is near, from the scene as posed.
+bool SandboxEngine::selfieShoot() {
+	int left, top, width, height;
+	double rowScale, colScale;
+	StageBridge::view(left, top, width, height, rowScale, colScale);
+	Camera::Rect view;
+	view.x = left; view.y = top; view.w = width; view.h = height;
+	if (!_selfie.w) {
+		Camera::Rect player;
+		Common::Array<Camera::Rect> others;
+		for (int n = 0; n < StageBridge::actorCount(); ++n) {
+			int x0, y0, x1, y1;
+			if (!StageBridge::drawnRect(n, x0, y0, x1, y1)) continue;
+			Camera::Rect r;
+			r.x = x0; r.y = y0; r.w = x1 - x0; r.h = y1 - y0;
+			r = Camera::intersect(r, view);
+			if (r.empty()) continue;
+			if (n == _player) player = r;
+			else others.push_back(r);
+		}
+		if (player.empty()) player = view;
+		// (The stage's pixels are shown square.)
+		const Camera::Rect f = Camera::frameSelfie(player, others.data(), others.size(), view, 1.0);
+		_selfie.x = f.x; _selfie.y = f.y; _selfie.w = f.w; _selfie.h = f.h;
+	}
+	Camera::Rect frame;
+	frame.x = _selfie.x; frame.y = _selfie.y; frame.w = _selfie.w; frame.h = _selfie.h;
+	return Camera::shootTrue(_frame.data(), _width, _width, _height, frame, Camera::kSelfie, _selfie.shot, _selfie.shots);
+}
+
+// Everyone as they were (drawn again next).
+void SandboxEngine::selfieEnd() {
+	for (int n = 0; n < StageBridge::actorCount(); ++n) StageBridge::unpose(n);
+	_selfie = Selfie();
+	Camera::setBusy(false);
