+}
+static void sink(const uint8_t *rgba, int width, int height, int kind, int shot, int count, void *) {
+	shots.push_back({width, height, kind, shot, count, at(rgba, width, 0, 0), at(rgba, width, width / 2, height / 2), at(rgba, width, width - 1, height - 1)});
+	if (kind == Scummverse::Camera::kSelfie && selfie.empty()) { selfie = Common::Array<byte>(rgba, (size_t)width * height * 4); selfieWidth = width; selfieHeight = height; }
+}
+} // End of namespace FakeCamera
+
+// Photos and selfies through the camera's own requests (as the iPhone's
+// button makes them), in a place of the first game with someone else there:
+// a clean photo is the scene alone, whole pixels of it (its corners and
+// middle as drawn); a full one the screen with its panel; a selfie of three
+// holds the place still (nobody moves), poses everyone for each shot, takes
+// three of one frame (the one played in it, 4:5 to 4:3), and leaves everyone
+// as they were; while iOS asks for Photos the place holds still, then goes
+// on. Pictures: camera-full.png (the screen photographed), camera-selfie.png
+// (the first shot as saved).
+Common::Error SandboxEngine::cameraTest() {
+	Camera::reset();
+	Camera::setPlainSink(FakeCamera::sink, nullptr);
+	_wanderers = false;
+	int failed = 0;
+	auto fail = [&](const char *what) { ++failed; warning("SCUMMVERSE sandbox camera: %s-%d: %s", _game >= 0 ? kWorldGames[_game].gameid : "?", _room, what); };
+	Common::String problem;
+	bool entered = false;
+	for (int g = 0; g < worldGameCount() && !entered; ++g) {
+		if (!someoneToPlay(g)) continue;
+		for (int r = 1; r < 1024 && !entered; ++r) {
+			if (!installed(g, r) || !walkable(g, r)) continue;
+			bool others = false;
+			for (const WorldCastGuest &cast : kWorldCast)
+				others = others || (cast.game == g && cast.room == r && worldAppearanceKey(g, cast.guest.costume) != _playerKey && hasCharacter(worldAppearanceKey(g, cast.guest.costume)));
+			entered = others && enter(g, r, 0, problem) && _onStage.size() >= 2;
+		}
+	}
+	if (!entered) return Common::Error(Common::kNoGameDataFoundError, "sandbox selftest: no place with people");
+	step(1);
+	present();
+	int left, top, width, height, k;
+	double rowScale, colScale;
+	StageBridge::view(left, top, width, height, rowScale, colScale);
+	// A clean photo: the scene alone, each pixel k by k.
+	Camera::requestPhoto(false);
+	if (cameraStep() || FakeCamera::shots.size() != 1) fail("no clean photo");
+	else {
+		const FakeCamera::Shot &c = FakeCamera::shots[0];
+		Camera::squareFactor(width, height, k);
+		if (c.kind != Camera::kClean || c.width != width * k || c.height != height * k) fail("a clean photo not the scene's size");
+		if (c.first != _frame[top * _width + left] || c.last != _frame[(top + height - 1) * _width + left + width - 1] ||
+			c.middle != _frame[(top + c.height / 2 / k) * _width + left + c.width / 2 / k]) fail("a clean photo not the scene as drawn");
+	}
+	// A full photo: the screen as shown, its panel too.
+	Camera::requestPhoto(true);
+	if (cameraStep() || FakeCamera::shots.size() != 2) fail("no full photo");
+	else {
+		const FakeCamera::Shot &f = FakeCamera::shots[1];
+		Camera::squareFactor(_width, _height, k);
+		if (f.kind != Camera::kFull || f.width != _width * k || f.height != _height * k) fail("a full photo not the screen's size");
+		if (f.last != _frame[(_height - 1) * _width + _width - 1] || f.middle != _frame[(f.height / 2 / k) * _width + f.width / 2 / k]) fail("a full photo not the screen as shown");
+	}
+	shot("camera-full.png");
+	// A selfie of three: nobody moves, everyone posed for each shot, one frame.
+	const int count = StageBridge::actorCount();
+	Common::Array<double> xs(count), ys(count);
+	double spotX[4], spotY[4];
+	const int spots = StageBridge::spots(4, spotX, spotY);
+	for (int n = 1; n < count && spots; ++n) StageBridge::walkTo(n, spotX[n % spots], spotY[n % spots]);
+	for (int n = 0; n < count; ++n) StageBridge::position(n, xs[n], ys[n]);
+	Camera::requestSelfie(3);
+	if (!cameraStep() || !_selfie.on || !Camera::busy()) fail("no selfie begun");
+	bool allPosed = true;
+	for (int n = 0; n < count; ++n) allPosed = allPosed && StageBridge::posed(n);
+	if (!allPosed) fail("someone not posed");
+	const uint32 began = g_system->getMillis();
+	while (_selfie.on && g_system->getMillis() - began < 10000) {
+		// (As the run loop: nothing else while the camera holds.)
+		if (!cameraStep()) step(1);
+		g_system->delayMillis(5);
+	}
+	const uint32 took = g_system->getMillis() - began;
+	Common::Array<FakeCamera::Shot> selfies;
+	for (uint i = 2; i < FakeCamera::shots.size(); ++i) selfies.push_back(FakeCamera::shots[i]);
+	if (_selfie.on || selfies.size() != 3) fail("not three shots");
+	for (uint i = 0; i < selfies.size(); ++i) {
+		const FakeCamera::Shot &e = selfies[i];
+		if (e.kind != Camera::kSelfie || e.shot != (int)i || e.shots != 3 || e.width != selfies[0].width || e.height != selfies[0].height) fail("a shot out of turn or of another frame");
+		if (e.width * 3 > e.height * 4 + 3 * k || e.width * 5 < e.height * 4 - 5 * k) fail("a shot not 4:5 to 4:3");
+	}
+	if (took < kSelfieSettle + 2 * kSelfieNext + kSelfieShow) fail("a selfie quicker than its shots are shown");
+	for (int n = 0; n < count; ++n) {
+		double x, y;
+		StageBridge::position(n, x, y);
+		if (x != xs[n] || y != ys[n]) { fail("someone moved during the selfie"); break; }
+		if (StageBridge::posed(n)) { fail("someone left posed"); break; }
+	}
+	if (Camera::busy()) fail("the camera left busy");
+#ifdef USE_PNG
+	if (ConfMan.hasKey("scummverse_shots") && !FakeCamera::selfie.empty()) {
+		// (Its RGBA bytes as the stage's words.)
+		Common::Array<uint32> words((size_t)FakeCamera::selfieWidth * FakeCamera::selfieHeight);
+		for (uint i = 0; i < words.size(); ++i) words[i] = FakeCamera::at(FakeCamera::selfie.data(), 1, i, 0);
+		Graphics::Surface surface;
+		surface.init(FakeCamera::selfieWidth, FakeCamera::selfieHeight, FakeCamera::selfieWidth * 4, words.data(), kStageFormat);
+		Common::DumpFile out;
+		if (out.open(ConfMan.getPath("scummverse_shots").appendComponent("camera-selfie.png"), true)) Image::writePNG(out, surface);
+	}
+#endif
+	// Held (iOS asking for Photos): the one played, sent the farthest way,
+	// does not move; let go, they walk on.
+	double hx, hy, px, py;
+	StageBridge::position(_player, hx, hy);
+	int far = -1;
+	for (int i = 0; i < spots; ++i)
+		if (far < 0 || (spotX[i] - hx) * (spotX[i] - hx) + (spotY[i] - hy) * (spotY[i] - hy) > (spotX[far] - hx) * (spotX[far] - hx) + (spotY[far] - hy) * (spotY[far] - hy)) far = i;
+	if (far >= 0) StageBridge::walkTo(_player, spotX[far], spotY[far]);
+	if (!StageBridge::moving(_player)) fail("no way to walk to hold");
+	else {
+		Camera::setHold(true);
+		for (int t = 0; t < 30; ++t) if (!cameraStep()) step(1);
+		StageBridge::position(_player, px, py);
+		if (px != hx || py != hy) fail("walked while held");
+		Camera::setHold(false);
+		for (int t = 0; t < 30; ++t) if (!cameraStep()) step(1);
+		StageBridge::position(_player, px, py);
+		if (px == hx && py == hy) fail("not walking once let go");
+	}
+	Camera::setPlainSink(nullptr, nullptr);
+	g_system->updateScreen();
+	warning("SCUMMVERSE sandbox selftest camera: clean %dx%d, full %dx%d, selfie %d shots %dx%d in %u ms, %d failed",
+		FakeCamera::shots.size() > 0 ? FakeCamera::shots[0].width : 0, FakeCamera::shots.size() > 0 ? FakeCamera::shots[0].height : 0,
+		FakeCamera::shots.size() > 1 ? FakeCamera::shots[1].width : 0, FakeCamera::shots.size() > 1 ? FakeCamera::shots[1].height : 0,
+		(int)selfies.size(), selfies.empty() ? 0 : selfies[0].width, selfies.empty() ? 0 : selfies[0].height, took, failed);
+	if (failed) return Common::Error(Common::kUnknownError, "sandbox selftest failed");
+	warning("SCUMMVERSE sandbox selftest PASS");
+	return Common::kNoError;
+}
