+// the session (never written to disk).
+static const char *const kScummverseStoryWaitingKey = "scummverse_story_waiting";
+
+// Day of the Tentacle's computer (startManiac) in its story: Maniac Mansion's
+// own story (the mansion's data, as Story mode's list opens it), not a Maniac
+// target inside Tentacle's folder. Its target, on its way (the computer's
+// temporary save next, then scummverseStoryHandOver); false, and why for the
+// player, when it is not here.
+bool ScummEngine::scummverseStoryManiac(Common::String &target) {
+	target.clear();
+	if (!ChainedGamesMan.empty()) return false; // (on its way already)
+	int maniac = -1;
+	for (int g = 0; g < worldGameCount(); ++g)
+		if (sameId(kWorldGames[g].gameid, "maniac")) maniac = g;
+	const Common::String story = maniac >= 0 ? Common::String(kWorldStoryPrefix) + kWorldGames[maniac].gameid : Common::String();
+	bool here = maniac >= 0 && scummverseStoryReady(maniac) && ConfMan.hasKey("path", story);
+	if (here) {
+		const Common::FSNode folder(ConfMan.getPath("path", story));
+		here = folder.exists() && folder.isDirectory() && ::Scummverse::storyMissing(kWorldGames[maniac].gameid, folder.getPath()).empty();
+	}
+	if (!here) {
+		warning("SCUMMVERSE story: %s's computer: Maniac Mansion's own story is not here", _targetName.c_str());
+		GUI::MessageDialog dialog(_("Usually, Maniac Mansion would start now: Maniac Mansion's own story. For that, its files must be in the folder the mansion plays from (Documents/maniac on the phone)."));
+		runDialog(dialog);
+		return false;
+	}
+	// (Left from a hand-over before, never read: not this one's.)
+	if (ConfMan.hasKey(kScummverseStoryWaitingKey, Common::ConfigManager::kSessionDomain))
+		ConfMan.removeKey(kScummverseStoryWaitingKey, Common::ConfigManager::kSessionDomain);
+	_scummverseStoryHandover = true;
+	target = story;
+	warning("SCUMMVERSE story: %s's computer opens %s", _targetName.c_str(), story.c_str());
+	return true;
+}
+
+// Its computer's temporary save written (slot 100, where it comes back from
+// when Maniac's story ends): the same place, at once, in its story save too,
+// so it is kept however Maniac's story is left (its Worlds menu: another
+// game, the list, Explore mode) or the app stopped in it; it goes on from
+// there next time. (Within the main loop's own save, which runs a v6 game's
+// scripts before and after it.) Then the story it opens is told so.
+void ScummEngine::scummverseStoryHandOver() {
+	if (!_scummverseStory || !_scummverseStoryHandover) return;
+	_scummverseStoryHandover = false;
+	if (!scummverseSaveNow(kWorldStorySlot, "Story", false)) {
+		warning("SCUMMVERSE story: %s waits in its temporary save only", _targetName.c_str());
+		return;
+	}
+	_scummverseStorySaved = true;
+	ConfMan.set(kScummverseStoryWaitingKey, _targetName, Common::ConfigManager::kSessionDomain);
+	warning("SCUMMVERSE story: %s saved, waiting for Maniac Mansion's own story", _targetName.c_str());
+}
+
+// As a story starts: opened by another game, which waits behind it in its
+// temporary save (ScummVM's chained games, the only way a story starts with
+// games still to come: Day of the Tentacle's computer). Its own Quit, or
+// ScummVM's menu, goes back there, saved first; its Worlds menu's ways go
+// where they say once that game's place is in its story save too
+// (scummverseStoryHandOver), else back there first.
+void ScummEngine::scummverseStoryChainedIn() {
+	_scummverseStoryChained = !ChainedGamesMan.empty();
+	if (ConfMan.hasKey(kScummverseStoryWaitingKey, Common::ConfigManager::kSessionDomain)) {
+		if (_scummverseStoryChained)
+			_scummverseStoryWaiting = ConfMan.get(kScummverseStoryWaitingKey, Common::ConfigManager::kSessionDomain);
+		ConfMan.removeKey(kScummverseStoryWaitingKey, Common::ConfigManager::kSessionDomain);
+	}
+	if (_scummverseStoryChained)
+		warning("SCUMMVERSE story: %s opened by %s", _targetName.c_str(), _scummverseStoryWaiting.empty() ? "a game kept in its temporary save only" : _scummverseStoryWaiting.c_str());
+}
+
+// On its way to another game already: a chain it set up itself (another
+// game's story, its computer's Maniac), not the one it was opened in front of.
+bool ScummEngine::scummverseStoryOnItsWay() {
+	return !ChainedGamesMan.empty() && !_scummverseStoryChained;
+}
