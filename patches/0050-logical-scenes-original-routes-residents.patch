+			memcpy(_res->createResource(rtActorName, kZakResidentActor, 1), "", 1);
+		}
+		_scummVars[768] = 0;
+	}
+	if (!resident || _scummVars[768] == _currentRoom || (a->_room != 0 && !zakResident(a->_room))) return;
+	if (!scummverseMountZakCast()) return;
+	_scummVars[769] = a->_costume;
+	a->stopActorMoving(); a->setActorCostume(resident->costume);
+	a->setPalette(1, resident->color); a->_talkColor = resident->talkColor;
+	const size_t length = strlen(resident->name) + 1;
+	memcpy(_res->createResource(rtActorName, kZakResidentActor, length), resident->name, length);
+	a->putActor(resident->x, resident->y, _currentRoom); a->animateActor(resident->animation);
+	_scummVars[768] = _currentRoom;
+}
