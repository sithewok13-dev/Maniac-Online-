diff --git a/engines/scumm/scummverse_wander.inc b/engines/scumm/scummverse_wander.inc
new file mode 100644
index 00000000..e8190416
--- /dev/null
+++ b/engines/scumm/scummverse_wander.inc
@@ -0,0 +1,442 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Scummverse wanderers (included by scumm.cpp): characters from the other
+// games out of their home rooms, roaming every place the player can stand
+// in (Maniac Mansion's rooms, Zak's, the other games'), so they turn up in
+// odd places (the user: "I just want more actors roaming outside their home
+// games"). The bookkeeping is common/scummverse_wander.h: forty out at once,
+// who and where saved in the game's variables, moving on through doors now
+// and then (sometimes far, sometimes to where another one is), taking turns
+// to go home. Those in the viewed place are shown here as visitors, as many
+// as its floor has room for: actors of their own, drawn from their exported
+// frames, walking about a little and greeting the player once. Meanwhile
+// they are not at home (never two of anyone).
+
+namespace WanderBridge = ::Scummverse::WanderBridge;
+namespace Wander = ::Scummverse::Wander;
+
+// Out at once (the user's number).
+static const int kWanderCount = 40;
+// A visitor stands at least this far (pixels) from everyone else.
+static const int kVisitorSpacing = 40;
+
+// Zak's rooms a character can stand in (the tour's list): his airport,
+// apartment and street, the imported places but the plane's cabin and the
+// van's cockpit, and the logical scenes.
+static bool wanderZakRoom(int room) {
+	if (room >= 53 && room < ScummverseContent::kRoomCount)
+		return room != 56 && room != 81 && !zakRetiredRoomReplacement(room); // (81: the van's cockpit)
+	for (const auto &scene : zakLogicalScenes) if (scene.room == room) return true;
+	return false;
+}
+
+static bool wanderWorldRoom(int game, int room) {
+	const int kind = worldRoomKind(game, room);
+	return kind != kWorldMapRoom && kind != kWorldFloorPlan;
+}
+
+// The places (with their doors) and the cast, once a game is under way:
+// every room of the mansion and Zak's world (when his files are here), the
+// other games' exported rooms but their maps and floor plans (a door to a
+// map leads on to where the map's doors go), and everyone whose frames are
+// exported, living where their game has them.
+void ScummEngine::scummverseWanderBuild() {
+	if (_scummverseWanderBuilt) return;
+	_scummverseWanderBuilt = true;
+	// (Off with scummverse_wanderers=false: the engine tests keep their
+	// rooms as they were.)
+	_scummverseWanderersOn = !ConfMan.hasKey("scummverse_wanderers") || ConfMan.getBool("scummverse_wanderers");
+	if (!_scummverseWanderersOn) return;
+	WanderBridge::reset(_rnd.getRandomNumber(0x7FFFFFFE) + 1);
+	auto maniac = [](int room) { return Wander::placeCode(Wander::kManiac, 0, room); };
+	for (const auto &r : kTourManiacRooms) WanderBridge::addPlace(maniac(r.room));
+	for (const MansionPassage &p : mansionPassages) if (!p.transit) WanderBridge::addDoor(maniac(p.room), maniac(p.destination));
+	if (scummverseMountZak()) {
+		auto zak = [](int room) { return Wander::placeCode(Wander::kZak, 0, room); };
+		for (int room = 53; room < ScummverseContent::kRoomCount; ++room) if (wanderZakRoom(room)) WanderBridge::addPlace(zak(room));
+		for (const auto &scene : zakLogicalScenes) WanderBridge::addPlace(zak(scene.room));
+		for (const ZakLink &link : zakLinks) WanderBridge::addDoor(zak(link.room), zak(link.destination));
+	}
+	for (int game = 0; game < worldGameCount(); ++game) {
+		const WorldMap *map = worldMap(game);
+		auto installed = [&](int room) {
+			return Common::FSNode(scummverseWorldCache().appendComponent(Common::String::format("%s-%d.svw", kWorldGames[game].gameid, room))).exists();
+		};
+		auto place = [&](int room) { return Wander::placeCode(Wander::kWorld, game, room); };
+		for (int i = 0; i < kWorldGames[game].sceneCount; ++i) {
+			const int room = kWorldGames[game].scenes[i].room;
+			if (wanderWorldRoom(game, room) && installed(room)) WanderBridge::addPlace(place(room));
+		}
+		if (!map) continue;
+		for (int i = 0; i < map->roomCount; ++i) {
+			const int room = map->rooms[i].room;
+			if (wanderWorldRoom(game, room) && installed(room)) WanderBridge::addPlace(place(room));
+		}
+		for (int i = 0; i < map->linkCount; ++i) {
+			const WorldLink &l = map->links[i];
+			if (wanderWorldRoom(game, l.target)) { WanderBridge::addDoor(place(l.room), place(l.target)); continue; }
+			for (int j = 0; j < map->linkCount; ++j)
+				if (map->links[j].room == l.target && map->links[j].target != l.room) WanderBridge::addDoor(place(l.room), place(map->links[j].target));
+		}
+	}
+	for (const auto &cast : kWorldCast)
+		if (scummverseCharacterInstalled(cast.game, cast.guest.costume))
+			WanderBridge::addCast(worldAppearanceKey(cast.game, cast.guest.costume), Wander::placeCode(Wander::kWorld, cast.game, cast.room));
+	debug(1, "SCUMMVERSE wanderers: %d places, %d characters", WanderBridge::places(), WanderBridge::cast());
+}
+
+// The place a room shows (0: none: the plane, the van's cockpit, a map).
+int ScummEngine::scummverseWanderPlace(int room) const {
+	int source;
+	const int game = scummverseWorldGameOf(room, source);
+	if (game >= 0) return wanderWorldRoom(game, source) ? Wander::placeCode(Wander::kWorld, game, source) : 0;
+	if (wanderZakRoom(room)) return _scummverseZakMounted ? Wander::placeCode(Wander::kZak, 0, room) : 0;
+	for (const auto &r : kTourManiacRooms) if (r.room == room) return Wander::placeCode(Wander::kManiac, 0, room);
+	return 0;
+}
+
+// Out wandering (so not at home).
+bool ScummEngine::scummverseWandering(int key) const {
+	return _scummverseWanderBuilt && _scummverseWanderersOn && key && WanderBridge::where(key) != 0;
+}
+
+int ScummEngine::scummverseVisitorSlot(const Actor *a) const {
+	if (!a || a->_number) return -1;
+	for (int s = 0; s < kScummverseVisitorSlots; ++s) if (_scummverseVisitors[s].actor == a) return s;
+	return -1;
+}
+
+void ScummEngine::scummverseClearVisitors() {
+	for (ScummverseVisitor &v : _scummverseVisitors) {
+		if (v.actor && v.actor->_room) { v.actor->stopActorMoving(); v.actor->hideActor(); v.actor->_room = 0; }
+		v.who = 0; v.sprite = 0; v.placed = false; v.frames.clear();
+	}
+	if (_scummverseVisitorTalking >= 0 && getTalkingActor() == 0xFF && VAR(VAR_HAVE_MSG)) stopTalk();
+	_scummverseVisitorTalking = -1;
+	_scummverseVisitorsPlace = _scummverseVisitorsRoom = 0; _scummverseVisitorsSig = 0;
+	_scummverseCharactersKey.clear();
+	// Chat sees them all leave once, so a slot given to someone else is never
+	// taken for whoever had it.
+	_scummverseVisitorsLeft = true;
+}
+
+// Time passes for the wanderers; the ones in the viewed place are shown
+// (on arriving there, as many as its floor has room for; later arrivals
+// walk in while there is room).
+void ScummEngine::scummverseUpdateWanderers(int delta) {
+	if (!_scummverseRoaming || !_scummVars || _numVariables < kScummverseWanderVar + 2 * Wander::kMostWanderers) return;
+	scummverseWanderBuild();
+	if (!_scummverseWanderersOn) return;
+	int32 *who = _scummVars + kScummverseWanderVar, *where = who + Wander::kMostWanderers;
+	WanderBridge::bind(who, where);
+	// Out for the first time, or more of the cast than are out (games
+	// exported since): up to forty.
+	int out = 0;
+	for (int i = 0; i < Wander::kMostWanderers; ++i) out += who[i] != 0;
+	if (out < kWanderCount && out < WanderBridge::cast()) WanderBridge::start(kWanderCount);
+	const int here = scummverseWanderPlace(_currentRoom);
+	if (delta > 0) WanderBridge::advance(delta, here);
+	_scummverseVisitorQuiet = MAX(0, _scummverseVisitorQuiet - delta);
+	const bool entering = here != _scummverseVisitorsPlace || _currentRoom != _scummverseVisitorsRoom;
+	if (entering) {
+		scummverseClearVisitors();
+		_scummverseVisitorsPlace = here; _scummverseVisitorsRoom = _currentRoom;
+		if (!here) return;
+		// Room on the floor: a visitor for about every kVisitorSpacing pixels
+		// of it, fewer for the characters already here.
+		int source;
+		const int gameIndex = scummverseWorldGameOf(_currentRoom, source);
+		const bool inWorld = gameIndex >= 0 && WorldBridge::mounted() && _scummverseWorldRoom == _currentRoom;
+		int residents = 0;
+		for (int id = 1; id < kScummverseManiacActors; ++id) residents += _actors[id]->_room == _currentRoom && _actors[id]->_visible;
+		for (int k = 0; inWorld && k < kScummverseGuestSlots; ++k) {
+			const WorldGuest *guest = worldGuestAt(worldPlaceKey(gameIndex, source), k);
+			residents += guest && !scummverseWandering(worldAppearanceKey(gameIndex, guest->costume));
+		}
+		const int floor = inWorld ? WorldBridge::contentRight() - WorldBridge::contentLeft() : _roomWidth;
+		_scummverseVisitorCapacity = Wander::capacity(floor, residents, kScummverseVisitorSlots, kVisitorSpacing);
+	}
+	if (!here) return;
+	int there[Wander::kMostWanderers];
+	const int count = MIN<int>(Wander::kMostWanderers, WanderBridge::at(here, there, Wander::kMostWanderers));
+	uint32 sig = (uint32)here;
+	for (int i = 0; i < count; ++i) sig = sig * 31 + (uint32)there[i];
+	if (!entering && sig == _scummverseVisitorsSig) return;
+	_scummverseVisitorsSig = sig;
+	// Gone from here (a save loaded): away. Then the new ones, while there
+	// is room.
+	int shown = 0;
+	for (ScummverseVisitor &v : _scummverseVisitors) {
+		if (!v.who) continue;
+		bool still = false;
+		for (int i = 0; i < count; ++i) still = still || there[i] == v.who;
+		if (still) { ++shown; continue; }
+		if (v.actor && v.actor->_room) { v.actor->stopActorMoving(); v.actor->hideActor(); v.actor->_room = 0; }
+		v.who = 0; v.sprite = 0; v.placed = false; v.frames.clear();
+	}
+	for (int i = 0; i < count && shown < _scummverseVisitorCapacity; ++i) {
+		bool known = false;
+		for (const ScummverseVisitor &v : _scummverseVisitors) known = known || v.who == there[i];
+		if (known) continue;
+		const int game = worldAppearanceGame(there[i]), costume = worldAppearanceCostume(there[i]);
+		if (!worldAppearance(there[i]) || !scummverseCharacterInstalled(game, costume)) continue;
+		int s = 0;
+		while (s < kScummverseVisitorSlots && _scummverseVisitors[s].who) ++s;
+		if (s == kScummverseVisitorSlots) break;
+		ScummverseVisitor &v = _scummverseVisitors[s];
+		v.frames = scummverseCharacterFrames(game, costume);
+		// (A damaged file would keep everyone here from being drawn.)
+		if (v.frames.empty() || !WorldBridge::spriteParses(v.frames.data(), v.frames.size())) { v.frames.clear(); continue; }
+		v.who = there[i];
+		scummversePlaceVisitor(s, !entering);
+		++shown;
+	}
+}
+
+// Where a visitor stands: a spot on the floor clear of everyone else, at a
+// person's depth here (the arrival point's in another world, the player's
+// elsewhere); arriving, it walks in from a side of the room.
+void ScummEngine::scummversePlaceVisitor(int slot, bool arriving) {
+	ScummverseVisitor &v = _scummverseVisitors[slot];
+	if (!v.actor) { v.actor = new Actor_v2(this, 0); v.actor->initActor(-1); }
+	Actor *a = v.actor;
+	const Actor *player = derefActor(VAR(VAR_EGO), "visitor spacing");
+	// Any V1 costume keeps the actor in the draw list; the frames replace it.
+	a->setActorCostume(player->_costume ? player->_costume : 1);
+	if (const WorldGuest *who = worldAppearance(v.who)) a->_talkColor = who->talkColor;
+	int source;
+	const bool inWorld = scummverseWorldGameOf(_currentRoom, source) >= 0 && WorldBridge::mounted() && _scummverseWorldRoom == _currentRoom;
+	int left = 2, right = MAX(2, _roomWidth / 8 - 3), baseY = 60;
+	if (inWorld) {
+		left = WorldBridge::contentLeft() / 8 + 2; right = MAX(left, WorldBridge::contentRight() / 8 - 3);
+		baseY = WorldBridge::spawnY();
+	} else if (player->_room == _currentRoom) {
+		baseY = player->getRealPos().y;
+	} else {
+		for (const auto &r : kTourManiacRooms) if (r.room == _currentRoom) baseY = r.y;
+	}
+	a->putActor(CLIP<int>(player->getRealPos().x, left, right), baseY, _currentRoom);
+	Common::Array<Common::Point> taken;
+	if (player->_room == _currentRoom) taken.push_back(player->getRealPos());
+	for (int id = 1; id < _numActors; ++id)
+		if (id != VAR(VAR_EGO) && _actors[id]->_room == _currentRoom && _actors[id]->_visible) taken.push_back(_actors[id]->getRealPos());
+	for (int s = 0; s < kScummverseVisitorSlots; ++s)
+		if (s != slot && _scummverseVisitors[s].placed && _scummverseVisitors[s].actor->_room == _currentRoom) taken.push_back(_scummverseVisitors[s].actor->getRealPos());
+	// The clearest spot; of those clear enough, one chosen by who it is (the
+	// same again after a save is loaded).
+	AdjustBoxResult best = a->adjustXYToBeInBox(a->getRealPos().x, baseY);
+	int bestScore = INT_MIN;
+	for (int x = left; x <= right; ++x)
+		for (int dy = -6; dy <= 6; dy += 6) {
+			const AdjustBoxResult spot = a->adjustXYToBeInBox(x, baseY + dy);
+			int clear = kVisitorSpacing;
+			for (const Common::Point &t : taken) clear = MIN(clear, ABS(spot.x - t.x) * 8 + ABS(spot.y - t.y) * 2);
+			const uint32 pick = ((uint32)v.who * 2654435761u) ^ ((uint32)(x * 64 + dy + 6) * 40503u);
+			const int score = clear * 100 + (int)((pick >> 16) % 100);
+			if (score > bestScore) { bestScore = score; best = spot; }
+		}
+	// (Arriving, it walks in from a side once its frames are mounted:
+	// scummverseUpdateVisitors.)
+	a->putActor(best.x, best.y, _currentRoom);
+	a->setDirection(180); a->startAnimActor(a->_standFrame); a->showActor();
+	v.tick = 0; v.shown = -1; v.hop = 0; v.greeted = false; v.placed = true;
+	v.arriving = arriving; v.edges[0] = left; v.edges[1] = right;
+	v.idle = 180 + 60 * slot + (int)_rnd.getRandomNumber(240);
+	a->_needRedraw = true;
+}
+
+// Whether a mounted character's frames walk (two or more steps to a side;
+// a bouncer hops whatever its frames): the others would slide, so they stand.
+static bool visitorWalks(int sprite, bool bouncer) {
+	return bouncer || WorldBridge::guestFrames(sprite, 1, 1) >= 2 || WorldBridge::guestFrames(sprite, 0, 1) >= 2;
+}
+
+// Animation, a short stroll now and then, one greeting each (one at a time,
+// with a pause between), standing still while chatting.
+void ScummEngine::scummverseUpdateVisitors(int delta, uint64 chatting) {
+	if (_scummverseVisitorTalking >= 0 && (!VAR(VAR_HAVE_MSG) || getTalkingActor() != 0xFF)) {
+		if (Actor *a = _scummverseVisitors[_scummverseVisitorTalking].actor) a->_needRedraw = true;
+		_scummverseVisitorTalking = -1;
+	}
+	Actor *player = derefActor(VAR(VAR_EGO), "visitor greeting");
+	int source;
+	const bool inWorld = scummverseWorldGameOf(_currentRoom, source) >= 0 && WorldBridge::mounted() && _scummverseWorldRoom == _currentRoom;
+	for (int s = 0; s < kScummverseVisitorSlots; ++s) {
+		ScummverseVisitor &v = _scummverseVisitors[s];
+		Actor *a = v.actor;
+		if (!v.who || !v.sprite || !a || !a->isInCurrentRoom()) continue;
+		const int game = worldAppearanceGame(v.who), costume = worldAppearanceCostume(v.who);
+		const bool bouncer = worldBouncer(game, costume) != nullptr;
+		if (v.arriving) {
+			// In from a side of the room, to its spot.
+			v.arriving = false;
+			if (visitorWalks(v.sprite - 1, bouncer)) {
+				const Common::Point spot = a->getRealPos();
+				const bool fromLeft = _rnd.getRandomNumber(1) == 0;
+				const AdjustBoxResult edge = a->adjustXYToBeInBox(v.edges[fromLeft ? 0 : 1], spot.y);
+				a->putActor(edge.x, edge.y, _currentRoom);
+				a->setDirection(fromLeft ? 90 : 270);
+				a->startWalkActor(spot.x, spot.y, -1);
+			}
+		}
+		v.tick += delta;
+		if (bouncer && worldHop(v.hop, a->_moving, delta)) a->_needRedraw = true;
+		int index;
+		const int kind = worldGuestPose(a, s == _scummverseVisitorTalking, v.tick, index);
+		if ((worldGuestDirection(a->getFacing()) * 3 + kind) * 64 + index % 64 != v.shown) a->_needRedraw = true;
+		// (Arriving or chatting, no greeting.)
+		const bool near = player->_room == _currentRoom && ABS(a->getPos().x - player->getPos().x) < 72 && ABS(a->getPos().y - player->getPos().y) < 32 &&
+			!(chatting & ((uint64)1 << (kScummverseTalkVisitor + s)));
+		const WorldGuest *who = worldAppearance(v.who);
+		if (near && !v.greeted && who && !_scummverseVisitorQuiet && !VAR(VAR_HAVE_MSG) && !_scummverseAIActor && delta) {
+			v.greeted = true;
+			a->stopActorMoving();
+			a->setDirection(player->getPos().x < a->getPos().x ? 270 : 90);
+			scummverseVisitorSay(s, who->lines[_rnd.getRandomNumber(2)]);
+			v.idle = 240; _scummverseVisitorQuiet = 600;
+			continue;
+		}
+		if (chatting & ((uint64)1 << (kScummverseTalkVisitor + s))) {
+			if (a->_moving) { a->stopActorMoving(); a->startAnimActor(a->_standFrame); }
+			continue;
+		}
+		if (s == _scummverseVisitorTalking) continue;
+		if (a->_moving || (v.idle -= delta) > 0) continue;
+		if (!visitorWalks(v.sprite - 1, bouncer)) { v.idle = 600; continue; }
+		v.idle = 300 + _rnd.getRandomNumber(600);
+		const int width = inWorld ? WorldBridge::width() : _roomWidth, height = inWorld ? WorldBridge::height() : _roomHeight;
+		const int x = CLIP<int>(a->getRealPos().x + (int)_rnd.getRandomNumber(16) - 8, 1, MAX(1, width / 8 - 2));
+		const int y = CLIP<int>(a->getRealPos().y + (int)_rnd.getRandomNumber(8) - 4, 1, MAX(1, height / 2 - 1));
+		const AdjustBoxResult target = a->adjustXYToBeInBox(x, y);
+		a->startWalkActor(target.x, target.y, -1);
+	}
+}
+
+// A visitor's line over its head, in its colour (as the narrator: it is no
+// actor of the game's).
+void ScummEngine::scummverseVisitorSay(int slot, const char *line) {
+	ScummverseVisitor &v = _scummverseVisitors[slot];
+	const WorldGuest *who = worldAppearance(v.who);
+	if (!v.actor || !line) return;
+	const int color = _string[0].color;
+	_string[0].color = who ? who->talkColor : 15;
+	scummverseSpeak(v.actor, 0xFF, line);
+	_string[0].color = color;
+	_scummverseVisitorTalking = slot;
+	v.actor->_needRedraw = true;
+}
+
+bool ScummEngine::scummverseDrawVisitor(Actor *a) {
+	const int s = scummverseVisitorSlot(a);
+	if (s < 0) return false;
+	ScummverseVisitor &v = _scummverseVisitors[s];
+	if (!v.sprite || a->_room != _currentRoom) { a->_needRedraw = false; return true; }
+	int source;
+	const bool inWorld = scummverseWorldGameOf(_currentRoom, source) >= 0 && WorldBridge::mounted();
+	const int game = worldAppearanceGame(v.who), costume = worldAppearanceCostume(v.who);
+	const WorldGlider *glider = worldGlider(game, costume);
+	const WorldBouncer *bouncer = worldBouncer(game, costume);
+	ScummverseSpriteStyle style;
+	style.hover = worldHovers(game, costume);
+	style.glide = glider != nullptr; style.dressUp = glider && glider->dressUp; style.oneWay = glider && glider->oneWay;
+	style.hop = bouncer ? v.hop : -1; style.jaw = bouncer ? bouncer->jaw : 0;
+	style.talking = s == _scummverseVisitorTalking ? 1 : 0;
+	style.drawn = &v.drawn;
+	int numerator = 1, denominator = 1;
+	const double scale = inWorld ? scummverseWorldDepth(a) :
+		scummverseDistantScene(&numerator, &denominator) ? (double)numerator / denominator : 1.0;
+	return scummverseDrawSprite(a, v.sprite - 1, v.tick, v.shown, scale, style);
+}
+
+int ScummEngine::scummverseAddVisitors(Actor **list) {
+	int n = 0;
+	for (const ScummverseVisitor &v : _scummverseVisitors)
+		if (v.who && v.sprite && v.actor && v.actor->_visible && v.actor->isInCurrentRoom()) list[n++] = v.actor;
+	return n;
+}
+
+void ScummEngine::scummverseWalkVisitors() {
+	for (const ScummverseVisitor &v : _scummverseVisitors)
+		if (v.who && v.actor && v.actor->isInCurrentRoom()) v.actor->walkActor();
+}
+
+// Before the actors' backgrounds are put back (resetActorBgs): visitors
+// drawn over have no strips marking them, so here each one to be drawn
+// again (moved, animated, gone) gets its background back, and whoever shares
+// a strip with what is put back (a visitor or an actor) is drawn again, as
+// the engine does for actors sharing strips.
+void ScummEngine::scummverseResetVisitorBgs() {
+	const int strips = MIN(_gdi->_numStrips, 200);
+	bool restored[200] = {};
+	auto span = [&](const Common::Rect &r, int &from, int &to) {
+		from = MAX(0, r.left / 8 - _screenStartStrip); to = MIN(strips - 1, (r.right - 1) / 8 - _screenStartStrip);
+	};
+	const bool cameraMoved = camera._cur.x != _scummverseVisitorCamera;
+	_scummverseVisitorCamera = camera._cur.x;
+	auto shown = [&](const ScummverseVisitor &v) { return v.who && v.sprite && v.actor->_visible && v.actor->isInCurrentRoom(); };
+	// Strips the engine draws again this frame (an object's state, a line of
+	// speech gone) take visitors there with them.
+	for (int i = 0; i < strips; ++i)
+		if (testGfxUsageBit(_screenStartStrip + i, USAGE_BIT_DIRTY) || testGfxUsageBit(_screenStartStrip + i, USAGE_BIT_RESTORED)) restored[i] = true;
+	auto resets = [&](const ScummverseVisitor &v) { return !v.drawn.isEmpty() && (!shown(v) || v.actor->_needRedraw); };
+	for (ScummverseVisitor &v : _scummverseVisitors) {
+		if (!v.actor) continue;
+		if (shown(v) && (_fullRedraw || cameraMoved)) v.actor->_needRedraw = true;
+	}
+	for (bool changed = true; changed;) {
+		changed = false;
+		for (const ScummverseVisitor &v : _scummverseVisitors) {
+			if (!v.actor || !resets(v)) continue;
+			int from, to; span(v.drawn, from, to);
+			// (A strip either side: a visitor on the move is drawn a step
+			// over.)
+			for (int i = MAX(0, from - 1); i <= MIN(strips - 1, to + 1); ++i) restored[i] = true;
+		}
+		for (int j = 1; j < _numActors; ++j) {
+			const Actor *b = _actors[j];
+			if (!((b->_top != 0x7fffffff && b->_needRedraw) || b->_needBgReset)) continue;
+			for (int i = 0; i < strips; ++i) if (testGfxUsageBit(_screenStartStrip + i, j)) restored[i] = true;
+		}
+		for (ScummverseVisitor &v : _scummverseVisitors) {
+			if (!v.actor || !shown(v) || v.actor->_needRedraw || v.drawn.isEmpty()) continue;
+			int from, to; span(v.drawn, from, to);
+			for (int i = from; i <= to; ++i) if (restored[i]) { v.actor->_needRedraw = true; changed = true; break; }
+		}
+		for (int j = 1; j < _numActors; ++j) {
+			Actor *b = _actors[j];
+			if (b->_needRedraw || !b->isInCurrentRoom()) continue;
+			for (int i = 0; i < strips; ++i)
+				if (restored[i] && testGfxUsageBit(_screenStartStrip + i, j)) { b->_needRedraw = true; changed = true; break; }
+		}
+	}
+	for (ScummverseVisitor &v : _scummverseVisitors) {
+		if (!v.actor || !resets(v)) continue;
+		int from, to; span(v.drawn, from, to);
+		for (int i = from; i <= to; ++i) _gdi->resetBackground(v.drawn.top, v.drawn.bottom, i);
+		v.drawn = Common::Rect();
+	}
+}
+
+// Visitors in view, as talk IDs (kScummverseTalkVisitor + slot); chat learns
+// who each one is.
+uint64 ScummEngine::scummverseVisitorMask() {
+	uint64 mask = 0;
+	const bool left = _scummverseVisitorsLeft;
+	_scummverseVisitorsLeft = false;
+	for (int s = 0; s < kScummverseVisitorSlots; ++s) {
+		const ScummverseVisitor &v = _scummverseVisitors[s];
+		const bool here = !left && v.who && v.sprite && v.actor && v.actor->_visible && v.actor->isInCurrentRoom();
+		::scummverseTalkVisitor(s, here ? v.who : 0);
+		if (here) mask |= (uint64)1 << (kScummverseTalkVisitor + s);
+	}
+	return mask;
+}
+
+// Who a tap on the room picks to talk to: an actor, or a visitor drawn there.
+int ScummEngine::scummverseTalkTarget(int x, int y) {
+	if (const int actor = getActorFromPos(x, y)) return actor;
+	for (int s = 0; s < kScummverseVisitorSlots; ++s) {
+		const ScummverseVisitor &v = _scummverseVisitors[s];
+		if (v.who && v.sprite && v.actor && v.actor->isInCurrentRoom() && v.drawn.contains(x, y)) return kScummverseTalkVisitor + s;
+	}
+	return 0;
+}
