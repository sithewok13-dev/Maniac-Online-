diff --git a/common/scummverse_wander.cpp b/common/scummverse_wander.cpp
new file mode 100644
index 00000000..c41b37b8
--- /dev/null
+++ b/common/scummverse_wander.cpp
@@ -0,0 +1,188 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Scummverse wanderers (see scummverse_wander.h). Plain C++, unit-tested by
+// tools/test_wander.cpp.
+#include "common/scummverse_wander.h"
+
+#include <algorithm>
+
+namespace Scummverse {
+namespace Wander {
+
+int Map::add(int code) {
+	const int known = find(code);
+	if (known >= 0) return known;
+	places.push_back(code);
+	doors.push_back(std::vector<int>());
+	return (int)places.size() - 1;
+}
+
+void Map::link(int from, int to) {
+	const int a = find(from), b = find(to);
+	if (a < 0 || b < 0 || a == b) return;
+	if (std::find(doors[a].begin(), doors[a].end(), b) == doors[a].end()) doors[a].push_back(b);
+}
+
+int Map::find(int code) const {
+	for (size_t i = 0; i < places.size(); ++i) if (places[i] == code) return (int)i;
+	return -1;
+}
+
+uint32_t Random::next() {
+	state ^= state << 13; state ^= state >> 17; state ^= state << 5;
+	return state;
+}
+
+int Random::below(int n) { return n > 0 ? (int)(next() % (uint32_t)n) : 0; }
+
+bool Wanderers::started() const {
+	for (int i = 0; i < kMostWanderers; ++i) if (_who[i]) return true;
+	return false;
+}
+
+bool Wanderers::out(int character) const { return character && where(character) != 0; }
+
+int Wanderers::where(int character) const {
+	for (int i = 0; character && i < kMostWanderers; ++i) if (_who[i] == character) return _where[i];
+	return 0;
+}
+
+int Wanderers::at(int place, int *characters, int most) const {
+	int count = 0;
+	for (int i = 0; place && i < kMostWanderers; ++i)
+		if (_who[i] && _where[i] == place) { if (count < most) characters[count] = _who[i]; ++count; }
+	return count;
+}
+
+bool Wanderers::send(int character, int place) {
+	if (!character || !place || out(character)) return false;
+	for (int i = 0; i < kMostWanderers; ++i)
+		if (!_who[i]) { _who[i] = character; _where[i] = place; _clock[i] = -1; return true; }
+	return false;
+}
+
+void Wanderers::start(const std::vector<int> &cast, const Map &map, int count, Random &random) {
+	if (map.places.empty()) return;
+	std::vector<int> pool;
+	for (int c : cast) if (c && !out(c)) pool.push_back(c);
+	int free = 0;
+	for (int i = 0; i < kMostWanderers; ++i) free += !_who[i];
+	count = std::min(count, free);
+	for (int i = 0; i < count && !pool.empty(); ++i) {
+		const int pick = random.below((int)pool.size());
+		send(pool[pick], map.places[random.below((int)map.places.size())]);
+		pool.erase(pool.begin() + pick);
+	}
+}
+
+// Where wanderer i goes next: through a door of its place, else (or now and
+// then) anywhere, or to another wanderer.
+int Wanderers::moveFrom(int i, const Map &map, const Rules &rules, Random &random) const {
+	const int roll = random.below(100);
+	if (roll < rules.join) {
+		std::vector<int> others;
+		for (int j = 0; j < kMostWanderers; ++j) if (j != i && _who[j] && _where[j] != _where[i] && map.find(_where[j]) >= 0) others.push_back(_where[j]);
+		if (!others.empty()) return others[random.below((int)others.size())];
+	}
+	const int here = map.find(_where[i]);
+	if (roll >= rules.join + rules.jump && here >= 0 && !map.doors[here].empty())
+		return map.places[map.doors[here][random.below((int)map.doors[here].size())]];
+	return map.places[random.below((int)map.places.size())];
+}
+
+bool Wanderers::advance(int ticks, int here, const std::vector<int> &cast, const std::vector<int> &homes, const Map &map,
+		const Rules &rules, Random &random) {
+	if (map.places.empty() || ticks <= 0) return false;
+	bool changed = false;
+	const int hop = std::max(1, rules.hop);
+	for (int i = 0; i < kMostWanderers; ++i) {
+		if (!_who[i]) continue;
+		if (_clock[i] < 0 || _clock[i] > hop + hop / 2) _clock[i] = hop / 2 + random.below(hop);
+		if (_where[i] == here) continue;
+		if ((_clock[i] -= ticks) > 0) continue;
+		_clock[i] = hop / 2 + random.below(hop);
+		const int next = moveFrom(i, map, rules, random);
+		if (next != _where[i]) { _where[i] = next; changed = true; }
+	}
+	// Taking turns: one (not where the player is) goes home, and someone not
+	// out yet, who does not live where the player is, sets out from home.
+	const int turn = std::max(1, rules.turn);
+	if (_turnClock < 0 || _turnClock > turn) _turnClock = turn;
+	if ((_turnClock -= ticks) > 0) return changed;
+	_turnClock = turn;
+	// (Nor one who lives there: they would appear at home in front of the
+	// player.)
+	std::vector<int> leaving, setting;
+	for (int i = 0; i < kMostWanderers; ++i) {
+		if (!_who[i] || _where[i] == here) continue;
+		const std::vector<int>::const_iterator c = std::find(cast.begin(), cast.end(), _who[i]);
+		const size_t at = (size_t)(c - cast.begin());
+		if (here && at < homes.size() && homes[at] == here) continue;
+		leaving.push_back(i);
+	}
+	for (size_t c = 0; c < cast.size() && c < homes.size(); ++c) if (!out(cast[c]) && homes[c] != here && homes[c]) setting.push_back((int)c);
+	if (leaving.empty() || setting.empty()) return changed;
+	const int i = leaving[random.below((int)leaving.size())];
+	const int c = setting[random.below((int)setting.size())];
+	_who[i] = cast[c]; _where[i] = homes[c]; _clock[i] = -1;
+	return true;
+}
+
+int capacity(int floorWidth, int residents, int pool, int spacing) {
+	if (spacing < 1 || floorWidth <= 0) return 0;
+	return std::max(0, std::min(pool, floorWidth / spacing - std::max(0, residents)));
+}
+
+} // End of namespace Wander
+
+// ---- The game's one set of wanderers ----
+namespace WanderBridge {
+namespace {
+struct Bridge {
+	Wander::Map map;
+	std::vector<int> cast, homes;
+	Wander::Random random;
+	Wander::Rules rules;
+	int *who = nullptr, *where = nullptr;
+	std::vector<Wander::Wanderers> wanderers; // one, once bound
+};
+Bridge &bridge() { static Bridge b; return b; }
+} // End of anonymous namespace
+
+void reset(unsigned seed) {
+	Bridge &b = bridge();
+	b.map = Wander::Map(); b.cast.clear(); b.homes.clear(); b.wanderers.clear();
+	b.random = Wander::Random(seed); b.rules = Wander::Rules(); b.who = b.where = nullptr;
+}
+void addPlace(int code) { if (code > 0) bridge().map.add(code); }
+void addDoor(int from, int to) { bridge().map.link(from, to); }
+void addCast(int character, int home) {
+	Bridge &b = bridge();
+	if (character <= 0 || std::find(b.cast.begin(), b.cast.end(), character) != b.cast.end()) return;
+	b.cast.push_back(character); b.homes.push_back(home);
+}
+int places() { return (int)bridge().map.places.size(); }
+int cast() { return (int)bridge().cast.size(); }
+void bind(int *who, int *where) {
+	Bridge &b = bridge();
+	if (b.who == who && b.where == where && !b.wanderers.empty()) return;
+	b.who = who; b.where = where; b.wanderers.clear();
+	if (who && where) b.wanderers.push_back(Wander::Wanderers(who, where));
+}
+void start(int count) {
+	Bridge &b = bridge();
+	if (!b.wanderers.empty()) b.wanderers[0].start(b.cast, b.map, count, b.random);
+}
+bool advance(int ticks, int here) {
+	Bridge &b = bridge();
+	return !b.wanderers.empty() && b.wanderers[0].advance(ticks, here, b.cast, b.homes, b.map, b.rules, b.random);
+}
+int at(int place, int *characters, int most) {
+	Bridge &b = bridge();
+	return b.wanderers.empty() ? 0 : b.wanderers[0].at(place, characters, most);
+}
+int where(int character) {
+	Bridge &b = bridge();
+	return b.wanderers.empty() ? 0 : b.wanderers[0].where(character);
+}
+} // End of namespace WanderBridge
+} // End of namespace Scummverse
diff --git a/common/scummverse_wander.h b/common/scummverse_wander.h
new file mode 100644
index 00000000..ab81206b
--- /dev/null
+++ b/common/scummverse_wander.h
@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Scummverse wanderers: characters from the other games out of their home
+// rooms, roaming every place there is (Maniac Mansion's rooms, Zak's, the
+// other games'), a few dozen at a time, taking turns (the user: "more actors
+// roaming outside their home games. It'll be more interesting to find them in
+// odd places"). Off-screen a wanderer is only a note, who and where: now and
+// then it moves on through a door of its place, sometimes somewhere far away,
+// sometimes to where another wanderer is (so a few gather); every so often
+// one goes home and someone else sets out. The wanderers in the player's
+// place stay put while the player is there. The game shows those
+// (engines/scumm/scummverse_wander.inc). Plain types; the same seed moves
+// them the same way.
+#ifndef COMMON_SCUMMVERSE_WANDER_H
+#define COMMON_SCUMMVERSE_WANDER_H
+
+#include "common/scummverse_wander_engine.h"
+
+#include <cstdint>
+#include <vector>
+
+namespace Scummverse {
+namespace Wander {
+
+// The places and the doors between them.
+struct Map {
+	std::vector<int> places;             // place codes
+	std::vector<std::vector<int>> doors; // per place, the places (indices) its doors lead to
+	int add(int code);                   // its index (added if new)
+	void link(int from, int to);         // a door between two added places (codes), once
+	int find(int code) const;            // its index, or -1
+};
+
+// A small random source (xorshift): the same seed, the same moves.
+struct Random {
+	uint32_t state;
+	explicit Random(uint32_t seed = 1) : state(seed ? seed : 1) {}
+	uint32_t next();
+	int below(int n); // 0..n-1 (0 when n <= 0)
+};
+
+// How they move, in game ticks (60 a second).
+struct Rules {
+	int hop = 60 * 90;   // a wanderer moves on about this often (half as long to half as long again)
+	int turn = 60 * 150; // one goes home and someone else sets out this often
+	int jump = 12;       // percent of moves that go anywhere at all
+	int join = 8;        // percent of moves to where another wanderer is
+};
+
+// The wanderers, kept in the game's saved arrays (kMostWanderers each): who
+// (a character's number, 0: nobody) and where (a place code). The cast is
+// everyone who may wander, with their home places (the same order).
+class Wanderers {
+public:
+	Wanderers(int *who, int *where) : _who(who), _where(where), _clock(kMostWanderers, -1), _turnClock(-1) {}
+	// Sets out up to `count` of the cast not out yet (as many as there are
+	// free places among the wanderers), each at a random place of the map.
+	void start(const std::vector<int> &cast, const Map &map, int count, Random &random);
+	bool started() const;
+	// Time passes: the wanderers elsewhere move on now and then; one goes
+	// home and another, not out yet, sets out from home. Nobody in the place
+	// `here` moves or goes home, and nobody living there goes home or sets
+	// out (the player is watching). True when anyone moved, went home or set
+	// out.
+	bool advance(int ticks, int here, const std::vector<int> &cast, const std::vector<int> &homes, const Map &map,
+		const Rules &rules, Random &random);
+	bool out(int character) const;
+	int where(int character) const; // its place, or 0
+	// The wanderers in a place, in order (at most `most`); how many there are.
+	int at(int place, int *characters, int most) const;
+	// Sets one out somewhere (a test, or the game placing one): false when
+	// all are out already or it is out.
+	bool send(int character, int place);
+
+private:
+	int moveFrom(int i, const Map &map, const Rules &rules, Random &random) const;
+	int *_who, *_where;
+	std::vector<int> _clock; // ticks until each moves on (-1: not counted yet)
+	int _turnClock;
+};
+
+} // End of namespace Wander
+} // End of namespace Scummverse
+
+#endif
diff --git a/common/scummverse_wander_engine.h b/common/scummverse_wander_engine.h
new file mode 100644
index 00000000..dd4f0e6b
--- /dev/null
+++ b/common/scummverse_wander_engine.h
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// The game's side of the wanderers (common/scummverse_wander.h): places as
+// numbers, and one set of wanderers kept in the game's saved arrays. Plain
+// types only (no library headers), for the engine
+// (engines/scumm/scummverse_wander.inc).
+#ifndef COMMON_SCUMMVERSE_WANDER_ENGINE_H
+#define COMMON_SCUMMVERSE_WANDER_ENGINE_H
+
+namespace Scummverse {
+namespace Wander {
+
+// A place: a room of Maniac Mansion, of Zak McKracken or of another game
+// (which), as one positive number (0: nowhere).
+enum PlaceKind { kManiac = 0, kZak = 1, kWorld = 2 };
+inline int placeCode(int kind, int game, int room) { return 1 + kind * 16384 + game * 1024 + room; }
+inline int placeKind(int code) { return (code - 1) / 16384; }
+inline int placeGame(int code) { return (code - 1) % 16384 / 1024; }
+inline int placeRoom(int code) { return (code - 1) % 1024; }
+
+static const int kMostWanderers = 40;
+
+// How many visitors a place shows at once: one for about every `spacing`
+// pixels of its floor's width, fewer for those living there, at most `pool`.
+int capacity(int floorWidth, int residents, int pool, int spacing = 40);
+
+} // End of namespace Wander
+
+namespace WanderBridge {
+
+// Forgets the places, the cast and the clocks (a game starting); moves are
+// drawn from `seed`.
+void reset(unsigned seed);
+void addPlace(int code);
+void addDoor(int from, int to); // between added places
+void addCast(int character, int home);
+int places();
+int cast();
+// The game's saved arrays of who and where (Wander::kMostWanderers each).
+void bind(int *who, int *where);
+// Up to `count` of the cast not out yet set out (into free places) at
+// random places.
+void start(int count);
+// Time passes (ticks, 60 a second); nobody in the place `here` moves, goes
+// home, or (living there) sets out. True when anyone moved.
+bool advance(int ticks, int here);
+// The wanderers in a place, in order (at most `most`); how many there are.
+int at(int place, int *characters, int most);
+// Where a character is out, or 0 (at home, or never out).
+int where(int character);
+
+} // End of namespace WanderBridge
+} // End of namespace Scummverse
+
+#endif
