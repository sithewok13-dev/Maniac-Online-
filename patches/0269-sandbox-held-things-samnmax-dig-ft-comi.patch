+void Panel::heldPointer(uint32_t *screen, int pitch, int screenWidth, int screenHeight, int pointerX, int pointerY, Rect *bounds) const {
+	const Item &item = _items[_held];
+	if (item.width <= 0 || item.height <= 0 || item.picture.size() != (size_t)item.width * item.height || _rowScale <= 0 || _colScale <= 0) return;
