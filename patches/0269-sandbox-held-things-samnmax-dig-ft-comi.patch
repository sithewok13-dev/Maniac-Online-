+		const int ry = std::min(item.height - 1, (int)((sy - y) * (double)item.height / h));
+		for (int sx = std::max(0, x); sx < std::min(screenWidth, x + w); ++sx) {
+			const uint32_t c = item.picture[(size_t)ry * item.width + std::min(item.width - 1, (int)((sx - x) * (double)item.width / w))];
+			if (c >> 24) screen[(size_t)sy * pitch + sx] = c;
+		}
+	}
