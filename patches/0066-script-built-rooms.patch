+	const double depth = scummverseWorldDepth(a);
 	if (scummverseGuestSlot(a) >= 0) return scummverseDrawGuest(a, depth);
 	return scummverseDrawScaledActor(a, kWorldGames[gameIndex].heroHeight * WorldBridge::sceneScale() * depth / kWorldManiacHeight);
 }
