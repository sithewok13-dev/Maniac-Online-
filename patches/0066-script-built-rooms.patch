+// Where a supplied game stands. Its folder in Documents is matched like
+// base/main.cpp does: the catalog name, ignoring case and stray spaces.
+enum ScummverseWorldSetup { kWorldNoFolder, kWorldNotSetUp, kWorldSetupStopped, kWorldReady };
+static ScummverseWorldSetup scummverseWorldSetup(const Scummverse::WorldCatalog::WorldGame &game) {
+	NSString *documents = NSSearchPathForDirectoriesInDomains(NSDocumentDirectory, NSUserDomainMask, YES).firstObject;
+	NSFileManager *fm = [NSFileManager defaultManager];
+	NSString *wanted = [NSString stringWithUTF8String:game.folder];
+	BOOL found = NO;
+	for (NSString *entry in [fm contentsOfDirectoryAtPath:documents error:nil]) {
+		BOOL directory = NO;
+		if ([[entry stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceCharacterSet] caseInsensitiveCompare:wanted] != NSOrderedSame) continue;
+		if ([fm fileExistsAtPath:[documents stringByAppendingPathComponent:entry] isDirectory:&directory] && directory) { found = YES; break; }
+	}
+	if (!found) return kWorldNoFolder;
+	NSString *marker = [NSString stringWithFormat:@"%@/worlds/%s-v%d", documents, game.gameid, Scummverse::WorldCatalog::kWorldExportVersion];
+	if ([fm fileExistsAtPath:[marker stringByAppendingString:@".svx"]]) return kWorldReady;
+	NSData *attempts = [NSData dataWithContentsOfFile:[marker stringByAppendingString:@".try"]];
+	if (attempts.length >= 5 && ((const uint8_t *)attempts.bytes)[4] >= Scummverse::WorldCatalog::kWorldExportAttempts) return kWorldSetupStopped;
+	return kWorldNotSetUp;
+}
+
 // Which build is running (stamped into Info.plist by tools/package_ipa.py)
