+// A game's folder in Documents: its catalog name, ignoring case and stray
+// spaces around it (a folder zipped or renamed as "loom " is still Loom).
+static Common::FSNode scummverseWorldFolder(const char *name) {
+	const Common::FSNode exact{Common::Path(name)};
+	if (exact.exists() && exact.isDirectory()) return exact;
+	Common::FSList entries;
+	if (Common::FSNode(Common::Path(".")).getChildren(entries, Common::FSNode::kListDirectoriesOnly)) {
+		for (const Common::FSNode &entry : entries) {
+			Common::String trimmed = entry.getName(); trimmed.trim();
+			if (trimmed.equalsIgnoreCase(name)) return entry;
+		}
+	}
+	return exact;
+}
 static int scummverseQueueWorldExports(const Common::String &maniacTarget) {
 	const Common::FSNode cache(Common::Path("worlds"));
 	Common::StringArray targets;
 	for (const auto &game : Scummverse::WorldCatalog::kWorldGames) {
-		const Common::FSNode folder(Common::Path(game.folder));
+		const Common::FSNode folder = scummverseWorldFolder(game.folder);
 		if (!folder.exists() || !folder.isDirectory()) continue;
 		// The marker is written once a game's scenes and characters are exported.
 		if (cache.getChild(Common::String::format("%s-v%d.svx", game.gameid, Scummverse::WorldCatalog::kWorldExportVersion)).exists()) continue;
+		// Exports that started but never finished (the app stopped during
+		// them) are retried once, not at every launch; removing the .try file
+		// retries again.
+		const Common::FSNode attempt = cache.getChild(Common::String::format("%s-v%d.try", game.gameid, Scummverse::WorldCatalog::kWorldExportVersion));
+		if (attempt.exists()) {
+			Common::ScopedPtr<Common::SeekableReadStream> in(attempt.createReadStream());
+			if (in && in->size() >= 5 && in->seek(4) && in->readByte() >= Scummverse::WorldCatalog::kWorldExportAttempts) {
+				warning("SCUMMVERSE: setting up %s stopped twice; remove worlds/%s-v%d.try to try again", game.gameid, game.gameid, Scummverse::WorldCatalog::kWorldExportVersion);
+				continue;
+			}
+		}
 		if (!cache.exists() && !cache.createDirectory()) { warning("SCUMMVERSE: cannot create the worlds cache"); return 0; }
 		const Common::String target = Common::String(kScummverseExportPrefix) + game.gameid;
 		ConfMan.addGameDomain(target);
