+// ---- Rides between a game's places ----
+
+
+bool SandboxEngine::rideBoard(int object) {
+	int id, ox, oy, w, h, wx, wy, state;
+	if (!StageBridge::object(object, id, ox, oy, w, h, wx, wy, state)) return false;
+	const WorldRide *ride = worldRideAt(_game, _room, id);
+	if (!ride) return false;
+	_riding = Riding();
+	_riding.ride = ride - kWorldRides;
+	_riding.phase = kRideWalking;
+	_riding.x = wx || wy ? wx : ox + w / 2.0; _riding.y = wx || wy ? wy : oy + h;
+	StageBridge::walkable(_riding.x, _riding.y);
+	StageBridge::walkTo(_player, _riding.x, _riding.y);
+	return true;
+}
+
+void SandboxEngine::rideChosen(int game, int room) {
+	if (_riding.ride < 0 || _riding.phase != kRideChoosing) return;
+	const WorldRide &ride = kWorldRides[_riding.ride];
+	const WorldAirport *to = worldAirport(game, room), *from = worldAirport(ride.game, ride.room);
+	if (!to || !from || to == from || game != ride.game || !installed(game, room) || _game != ride.game || _room != ride.room) return;
+	_riding.target = room; _riding.arrival = to->gate; _riding.phase = 1;
+	announce(Common::String::format("Flight to %s boarding. Departing in 5 seconds.", to->city).c_str());
+}
+
+void SandboxEngine::rideStep(int ticks) {
+	if (_riding.ride < 0 || _player < 0) return;
+	const WorldRide &ride = kWorldRides[_riding.ride];
+	double px, py;
+	StageBridge::position(_player, px, py);
+	const double reach = kDoorReach * screenWidthOf(ride.game) / 320.0;
+	const bool there = (px - _riding.x) * (px - _riding.x) + (py - _riding.y) * (py - _riding.y) <= reach * reach;
+	if (_riding.phase == kRideWalking) {
+		if (StageBridge::moving(_player)) return;
+		if (!there || _game != ride.game || _room != ride.room) { _riding = Riding(); return; }
+		if (ride.kind == kWorldRidePlane) {
+			// Where to: the other airports installed (the iPhone's list).
+			_phone.placesBegin("Fly to");
+			int offered = 0;
+			for (const WorldAirport &a : kWorldAirports)
+				if (a.game == ride.game && a.room != ride.room && installed(a.game, a.room)) { _phone.placesItem(a.city, worldPlaceRequest(a.game, a.room)); ++offered; }
+			if (!offered) { announce("No flights today."); _riding = Riding(); return; }
+			_phone.placesShow();
+			_riding.phase = kRideChoosing;
+			return;
+		}
+		_riding.target = ride.target; _riding.arrival = ride.arrival; _riding.phase = 1;
+		announce(ride.kind == kWorldRideBus ? "The bus leaves in 5 seconds." : "Tram leaving in 5 seconds.");
+		return;
+	}
+	if (_riding.phase == kRideChoosing) return;
+	const int previous = _riding.phase;
+	const int phase = _riding.phase += MIN(ticks, 60);
+	if (previous <= kRideBoarded) {
+		// Walked off before it leaves: it goes without them.
+		if (!there || _game != ride.game || _room != ride.room) {
+			announce(ride.kind == kWorldRidePlane ? "The flight left without you." : ride.kind == kWorldRideBus ? "The bus left without you." : "The tram left without you.");
+			_riding = Riding();
+			return;
+		}
+		if (phase > kRideBoarded) {
+			StageBridge::stop(_player);
+			StageBridge::hide(_player, true);
+			_dirty = true;
+		}
+		return;
+	}
+	if (phase < kRideBoarded + kRideTrip[ride.kind]) return;
+	// There: off at its object.
+	Common::String problem;
+	const int target = _riding.target, arrival = _riding.arrival, kind = ride.kind;
+	_riding = Riding();
+	if (!enter(ride.game, target, arrival, problem)) {
+		warning("SCUMMVERSE sandbox: a ride to %s-%d not shown (%s)", kWorldGames[ride.game].gameid, target, problem.c_str());
+		StageBridge::hide(_player, false);
+		return;
+	}
+	if (kind == kWorldRidePlane) {
+		const WorldAirport *to = worldAirport(ride.game, target);
+		announce(Common::String::format("Welcome to %s.", to ? to->city : "your destination").c_str());
+	}
+}
