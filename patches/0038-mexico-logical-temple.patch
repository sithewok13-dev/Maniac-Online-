+// Sandbox room identities. Append rooms; never renumber persisted identities.
+#ifndef SCUMM_SCUMMVERSE_CONTENT_H
+#define SCUMM_SCUMMVERSE_CONTENT_H
+namespace ScummverseContent {
+enum { kFirstImportedRoom = 56, kRoomCount = 110,
+       kImportedRoomCount = kRoomCount - kFirstImportedRoom };
+inline bool importedRoom(int room) { return room >= kFirstImportedRoom && room < kRoomCount; }
+inline bool foreignRoom(int room) { return room >= 53 && room < kRoomCount; }
+}
+#endif
