+// Resolve source doorway anchors without switching the displayed room. NPCs
+// entering an offscreen logical variant must use that variant's object layout.
+bool ScummEngine::scummverseArrivalPoint(int room, int originalObject, Common::Point &point) {
+ if(!ScummverseContent::importedRoom(room) || !scummverseMountExtra(room)) return false;
+ const auto &data=_scummverseExtraRooms[room-56];
+ for(int i=0;i<data[20];++i) if(_scummverseOriginalObjects[room-56][i]==originalObject) {
+  uint off=READ_LE_UINT16(data.data()+28+data[20]*2+i*2);
+  int x=data[off+11]*8, y=(data[off+12]&31)*8;
+  if(const auto *scene=zakTempleScene(room)) {
+   x+=scene->objects[i].x-data[off+7]*8;
+   y+=scene->objects[i].y-(data[off+8]&127)*8;
+  }
+  point=Common::Point(x/8,y/2);return true;
+ }
+ return false;
+}
