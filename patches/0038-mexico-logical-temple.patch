+void ScummEngine::scummverseRestoreTemple() {
+ if(!_scummverseRoaming) return;
+ // 527 is reserved within the existing 800-variable save layout. Old room 88
+ // contained a different resource; rebuild its geometry before restoring actors.
+ if(_scummVars[527]!=1) {
+  for(int id=1;id<_numActors;++id) {
+   Actor *a=derefActor(id,"temple migration");
+   if(a->_room==88) {a->stopActorMoving();a->putActor(114,60,88);}
+  }
+  _scummVars[527]=1;
+  if(_currentRoom==88) {
+   Actor *a=derefActor(VAR(VAR_EGO),"temple migration player");
+   startScene(88,a,0);
+  }
+ }
+ if(const auto *scene=zakTempleScene(_currentRoom)) {
+  VAR(VAR_CAMERA_MIN_X)=160;VAR(VAR_CAMERA_MAX_X)=scene->cameraMax;
+ }
