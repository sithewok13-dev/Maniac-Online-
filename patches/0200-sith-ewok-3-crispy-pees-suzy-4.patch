+		s.actor = n; s.zap = _random.getRandomNumber(2) == 0; s.swings = s.zap ? 0 : 1 + _random.getRandomNumber(1);
+		s.tookOut = !s.zap && !StageBridge::lit(n);
+		if (!s.tookOut && !s.zap) --s.swings;
+		if (!move(n, s.zap ? kMoveZap : s.tookOut ? kMoveLight : kMoveSwing)) s = ShowOff();
+		return;
