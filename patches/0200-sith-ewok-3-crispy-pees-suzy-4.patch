+	double px, py, x, y;
+	StageBridge::position(_player, px, py);
+	const double near = screenWidthOf(_game) / 2.0;
+	for (int n = 0; n < (int)_onStage.size(); ++n) {
+		if (n == _player || !canMove(n) || StageBridge::moving(n) || StageBridge::switching(n) || StageBridge::acting(n) || StageBridge::posed(n) || StageBridge::hidden(n)) continue;
+		if (following(_onStage[n]) || (actorSlot(n, _player) < kTalkSlots && (_chatting & (1ULL << (kTalkVisitor + actorSlot(n, _player)))))) continue;
+		bool seated = false;
+		for (int s : _seatedActors) seated = seated || s == n;
+		StageBridge::position(n, x, y);
+		if (!seated && fabs(x - px) <= near && fabs(y - py) <= near) return n;
+	}
+	return -1;
+}
