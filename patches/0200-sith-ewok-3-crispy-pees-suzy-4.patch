+		_showOffClock = kShowOffRetry;
+		const int n = showOffActor();
+		if (n < 0) {
+			// (No one here who could: his while begins again once one is left.)
+			bool any = false;
+			for (int k = 0; k < (int)_onStage.size(); ++k) any = any || (k != _player && canMove(k));
+			if (!any) _showOffClock = kShowOffEvery + _random.getRandomNumber(kShowOffEvery / 3);
