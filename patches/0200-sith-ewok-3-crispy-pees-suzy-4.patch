+// by hand; a swing right and left (not lit: taken up instead); lightning
+// from both paws, or the free one with it lit. Heckled, half the time, when
+// over (put away, or one move of a show: not).
+bool SandboxEngine::move(int actor, int what) {
+	if (!canMove(actor) || !readyToMove(actor)) return false;
+	if (actor == _player) haltWalk();
+	else if (StageBridge::moving(actor)) StageBridge::stop(actor);
+	const bool lit = StageBridge::lit(actor);
+	bool done;
+	if (what == kMoveLight || (what == kMoveSwing && !lit)) done = StageBridge::light(actor, !lit, true);
+	else if (what == kMoveSwing) done = StageBridge::act(actor, StageBridge::kPoseSwing, 0);
+	else done = StageBridge::act(actor, lit ? StageBridge::kPoseLitZap : StageBridge::kPoseZap, kZapTicks);
+	if (!done) return false;
+	if (actor == _player) _litKey = StageBridge::lit(actor) ? _playerKey : 0;
+	_dirty = true;
+	const int kind = what == kMoveZap ? kMoveZap : what == kMoveSwing && lit ? kMoveSwing : kMoveLight;
+	if (!(kind == kMoveLight && lit) && actor != _showOff.actor) heckleAfter(actor, kind);
+	return true;
