+		h.phase = 5; h.clock = kHeckleWait;
+		return;
+	}
+	case 3: // the model's heckle, else (slow) a written one
+		if (back) h.said = text;
+		else if (h.clock > 0) return;
+		else {
+			const char *const *lines = h.kind == kMoveZap ? kHeckleZap : h.kind == kMoveSwing ? kHeckleSwing : kHeckleGrab;
+			const int count = h.kind == kMoveZap ? ARRAYSIZE(kHeckleZap) : h.kind == kMoveSwing ? ARRAYSIZE(kHeckleSwing) : ARRAYSIZE(kHeckleGrab);
+			h.said = lines[_random.getRandomNumber(count - 1)];
+		}
+		h.phase = 5; h.clock = kHeckleWait;
+		return;
+	case 5: // said when no one else is talking (a while at most, else none)
+		if (!_speech.empty() && _speaker != h.mover && _speaker != h.heckler) { if (h.clock <= 0) h = Heckle(); return; }
+		break;
+	case 4: // his answer, asked as the heckle shows, said once it has and no one else talks (a while at most)
+		if (back) h.answer = text;
