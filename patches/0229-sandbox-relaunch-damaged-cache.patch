+// (A file an export stopped partway through leaves damaged would otherwise
+// keep the new engine from opening at every launch.) That place first, as
+// someone else (the one played not shown there), then the others; a key
+// that could not be shown is passed over (enter marks it), a place that
+// could not be shown for one who can, the next place.
+bool SandboxEngine::startElsewhere(int game, int room, Common::String &problem) {
+	const int kept = _playerKey;
+	for (int i = -2; i < worldGameCount(); ++i) {
+		if (i == -1 ? !startPlace(game, room) : i >= 0 && !firstPlace(game = i, room)) continue;
+		Common::Array<int> keys;
+		if (kept) keys.push_back(kept);
+		for (const WorldLead &l : kWorldLeads) if (l.game == game) keys.push_back(worldAppearanceKey(l.game, l.costume));
+		for (const WorldLead &l : kWorldLeads) keys.push_back(worldAppearanceKey(l.game, l.costume));
+		for (int key : keys) {
+			Common::Array<byte> data;
+			if (!hasCharacter(key) || _broken.contains(key)) continue;
+			if (!readCharacter(key, data)) { _broken[key] = true; continue; }
+			_playerKey = key;
+			if (enter(game, room, 0, problem)) return true;
+			if (!_broken.contains(key)) break;
+		}
+	}
+	_playerKey = kept;
+	return false;
+}
