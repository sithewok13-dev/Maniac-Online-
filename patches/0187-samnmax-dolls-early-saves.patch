+// SCUMMVERSE: an array's value, for the story's copy-protection answers
+// (-1 if it has none there; never an error).
+int ScummEngine_v6::scummverseArrayAt(int array, int offset) {
+	const ArrayHeader *ah = getArray(array);
+	if (!ah || offset < 0 || offset >= FROM_LE_16(ah->dim1) * FROM_LE_16(ah->dim2)) return -1;
+	if (FROM_LE_16(ah->type) != kIntArray) return ah->data[offset];
+	return _game.version == 8 ? (int32)READ_LE_UINT32(ah->data + offset * 4) : (int16)READ_LE_UINT16(ah->data + offset * 2);
+}
