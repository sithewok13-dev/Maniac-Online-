+void GdiV1::scummverseBusImage(const byte *room, int shift) {
+	const int cols=room[4], rows=room[5];
+	if(cols!=120 || rows!=16) return; // audited DOS street only
+	byte original[3][4096], pavement[22*13*3];
+	for(int layer=0;layer<3;++layer) decodeV1Gfx(room+READ_LE_UINT16(room+12+layer*2),original[layer],cols*rows);
