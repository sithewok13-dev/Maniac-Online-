+	byte *maps[]={_V1.picMap,_V1.colorMap,_V1.maskMap};
+	for(int layer=0;layer<3;++layer) {
+		memcpy(maps[layer],original[layer],cols*rows);
+		for(int x=0;x<22;++x) for(int y=0;y<13;++y)
+			maps[layer][(97+x)*rows+3+y]=pavement[layer*22*13+y*22+x];
+		// Integer tile steps preserve original DOS pixels during motion.
+		for(int x=0;x<22;++x) for(int y=0;y<13;++y) {
+			int target=97+x+shift/8;
+			if(target>=0 && target<cols) maps[layer][target*rows+3+y]=original[layer][(97+x)*rows+3+y];
+		}
+	}
+}
