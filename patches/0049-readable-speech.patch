diff --git a/common/scummverse_text.h b/common/scummverse_text.h
new file mode 100644
index 00000000..1b7ee63d
--- /dev/null
+++ b/common/scummverse_text.h
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Scummverse portable speech wrapping. Breaks between words at most `columns`
+// wide using '\r' (the SCUMM V1 line break); only a word longer than a line
+// is split. Drops bytes >= 128 (V1 fonts are ASCII). Treats '\n'/'\r' as
+// explicit breaks. Always NUL-terminates `out`; returns the number of lines.
+#ifndef COMMON_SCUMMVERSE_TEXT_H
+#define COMMON_SCUMMVERSE_TEXT_H
+namespace Scummverse {
+inline int wrapSpeech(const char *in, char *out, int capacity, int columns) {
+ if (!out || capacity < 1) return 0;
+ out[0] = 0;
+ if (!in || columns < 1) return 0;
+ int length = 0, column = 0, lines = 1;
+ auto put = [&](char c) { if (length < capacity - 1) out[length++] = c; };
+ const char *p = in;
+ while (*p) {
+  const unsigned char c = (unsigned char)*p;
+  if (c == '\n' || c == '\r') { put('\r'); column = 0; ++lines; ++p; continue; }
+  if (c == ' ' || c >= 128) { ++p; continue; }
+  const char *end = p; int word = 0;
+  while (*end && *end != ' ' && *end != '\n' && *end != '\r') { if ((unsigned char)*end < 128) ++word; ++end; }
+  if (column && column + 1 + word > columns) { put('\r'); column = 0; ++lines; }
+  else if (column) { put(' '); ++column; }
+  for (; p < end; ++p) {
+   if ((unsigned char)*p >= 128) continue;
+   if (column == columns) { put('\r'); column = 0; ++lines; }
+   put(*p); ++column;
+  }
+ }
+ out[length] = 0;
+ return lines;
+}
+}
+#endif
