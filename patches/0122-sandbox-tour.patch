+// ---- The tour ----
+
+// In game ticks (as Maniac's): at most this long for each walk; every stop
+// shown at least this long (for its label to be read); a stop that could
+// not be shown says so this long.
+static const int kTourWalk = 600, kTourGlimpse = 60, kTourRefused = 60;
+enum { kTourAcross = 0, kTourToDoor, kTourRefusedStop };
+// Where a resumed tour starts (1 the first; kept between launches).
+static const char *const kTourResumeKey = "scummverse_sandbox_tour_stop";
+
+// A place's name: its landmark's, else its area's on the game's map.
+static Common::String placeName(int game, int room) {
+	if (const WorldScene *scene = worldLandmark(game, room)) return scene->name;
+	if (const WorldMap *map = worldMap(game))
+		for (int i = 0; i < map->areaCount; ++i) if (map->areas[i].room == room) return map->areas[i].name;
+	return "";
+}
+
+// Each game's places in walking order (the mansion's, Zak's, then the
+// others'): from its first place on foot to the nearest not yet visited (the
+// fewest doors, through places visited before), else, where no door leads
+// to one, on to the next not yet visited (a warp).
+void SandboxEngine::tourBuild() {
+	_touring.stops.clear();
+	Common::Array<int> order;
+	for (const char *home : {"maniac", "zak"})
+		for (int g = 0; g < worldGameCount(); ++g) if (!strcmp(kWorldGames[g].gameid, home)) order.push_back(g);
+	for (int g = 0; g < worldGameCount(); ++g) if (!worldHome(g)) order.push_back(g);
+	for (int g : order) {
+		Common::Array<int> rooms;
+		int first = -1;
+		if (firstPlace(g, first)) rooms.push_back(first);
+		for (int r = 1; r < 1024; ++r) if (installed(g, r) && r != first) rooms.push_back(r);
+		const WorldMap *map = worldMap(g);
+		auto at = [&](int room) {
+			for (uint i = 0; i < rooms.size(); ++i) if (rooms[i] == room) return (int)i;
+			return -1;
+		};
+		Common::Array<bool> seen(rooms.size(), false);
+		int current = -1;
+		for (uint placed = 0; placed < rooms.size(); ++placed) {
+			int next = -1;
+			Common::Array<int> legs;
+			if (current >= 0 && map) {
+				// (Breadth first over the doors: the link each place is first reached by.)
+				Common::Array<int> came(rooms.size(), -2), queue;
+				queue.push_back(current); came[current] = -1;
+				for (uint q = 0; q < queue.size() && next < 0; ++q)
+					for (int e = 0; e < map->linkCount && next < 0; ++e) {
+						const WorldLink &l = map->links[e];
+						const int j = l.room == rooms[queue[q]] ? at(l.target) : -1;
+						if (j < 0 || came[j] != -2) continue;
+						came[j] = e; queue.push_back(j);
+						if (!seen[j]) next = j;
+					}
+				for (int j = next; j >= 0 && came[j] >= 0; j = at(map->links[came[j]].room)) legs.insert_at(0, came[j]);
+			}
+			for (uint j = 0; j < rooms.size() && next < 0; ++j) if (!seen[j]) next = j;
+			seen[next] = true;
+			TourStop stop;
+			stop.game = g; stop.room = rooms[next]; stop.legs = legs;
+			_touring.stops.push_back(stop);
+			current = next;
+		}
+	}
+	_touring.built = true;
+}
+
+// "Stop 12/740 · loom 21 · Loom Island" (the mansion's and Zak's as Maniac
+// names them: Maniac 12, Zak 84); warped there, or not shown, it says so.
+Common::String SandboxEngine::tourLabel(int index) const {
+	if (index < 0 || index >= (int)_touring.stops.size()) return "";
+	const TourStop &s = _touring.stops[index];
+	const char *id = kWorldGames[s.game].gameid;
+	const Common::String code = !strcmp(id, "maniac") ? "Maniac" : !strcmp(id, "zak") ? "Zak" : id;
+	Common::String label = Common::String::format("Stop %d/%d \xC2\xB7 %s %d", index + 1, (int)_touring.stops.size(), code.c_str(), s.room);
+	const Common::String name = placeName(s.game, s.room);
+	if (!name.empty()) label += " \xC2\xB7 " + name;
+	if (_touring.phase == kTourRefusedStop) label += " \xC2\xB7 could not be shown";
+	else if (_touring.warped) label += " \xC2\xB7 warped";
+	return label;
+}
+
+void SandboxEngine::tourPublish() {
+	Tour::publish(_touring.on, _touring.on ? tourLabel(_touring.stop).c_str() : "", (_touring.on ? _touring.stop : _touring.resume) + 1, _touring.stops.size());
+}
+
+bool SandboxEngine::tourDoor(int link, double &x, double &y) const {
+	const WorldMap *map = worldMap(_game);
+	if (!map || link < 0 || link >= map->linkCount || map->links[link].room != _room) return false;
+	for (int i = 0; i < StageBridge::objectCount(); ++i) {
+		int id, ox, oy, w, h, wx, wy, state;
+		if (StageBridge::object(i, id, ox, oy, w, h, wx, wy, state) && id == map->links[link].object && isDoor(i)) return doorPoint(i, x, y);
+	}
+	return false;
+}
+
+void SandboxEngine::tourCommand(int command, int number) {
+	if (!_touring.built) tourBuild();
+	const int last = (int)_touring.stops.size() - 1;
+	switch (command) {
+	case Tour::kResume: tourStart(_touring.resume); break;
+	case Tour::kRestart: tourStart(0); break;
+	case Tour::kGoTo:
+		if (_touring.on) tourVisit(CLIP(number - 1, 0, MAX(0, last)), true);
+		else tourStart(number - 1);
+		break;
+	case Tour::kNext: if (_touring.on) tourVisit(MIN(_touring.stop + 1, last), true); break;
+	case Tour::kPrevious: if (_touring.on) tourVisit(MAX(_touring.stop - 1, 0), true); break;
+	case Tour::kStop: tourEnd(true); break;
+	case Tour::kPause:
+		if (!_touring.on || _touring.paused) break;
+		_touring.paused = true;
+		StageBridge::stop(_player);
+		Tour::publishPaused(true);
+		break;
+	case Tour::kPlay:
+		if (!_touring.on || !_touring.paused) break;
+		_touring.paused = false;
+		Tour::publishPaused(false);
+		if (_touring.phase != kTourRefusedStop) tourPlan();
+		break;
+	default: break;
+	}
+}
+
+// From where the one played stands now (kept to go back to), at a stop.
+void SandboxEngine::tourStart(int index) {
+	if (!_touring.built) tourBuild();
+	if (_touring.stops.empty() || _player < 0) { Tour::publish(false, "", 1, 0); return; }
+	if (!_touring.on) {
+		_touring.homeGame = _game; _touring.homeRoom = _room;
+		StageBridge::position(_player, _touring.homeX, _touring.homeY);
+		if (!_testing) saveState(); // (where it began, kept while touring)
+	}
+	_door = -1; _action = 0; _target = -1;
+	_touring.on = true; _touring.paused = false;
+	Tour::publishPaused(false);
+	tourVisit(CLIP(index, 0, (int)_touring.stops.size() - 1), true);
+}
+
+// Home: back where it began (else where the tour is, as when another place
+// is chosen meanwhile); the stop it was at is where it resumes.
+void SandboxEngine::tourEnd(bool home) {
+	if (!_touring.on) return;
+	_touring.on = false; _touring.paused = false;
+	if (_player >= 0) StageBridge::stop(_player);
+	Common::String problem;
+	if (home && _touring.homeGame >= 0 && enter(_touring.homeGame, _touring.homeRoom, 0, problem)) {
+		StageBridge::place(_player, _touring.homeX, _touring.homeY);
+		StageBridge::follow(_player);
+	}
+	tourPublish();
+	Tour::publishPaused(false);
+	if (!_testing) {
+		ConfMan.setInt(kTourResumeKey, _touring.resume + 1);
+		ConfMan.flushToDisk();
+		saveState();
+	}
+}
+
+void SandboxEngine::tourVisit(int index, bool warp) {
+	if (index < 0 || index >= (int)_touring.stops.size()) return;
+	const TourStop &s = _touring.stops[index];
+	_touring.stop = index; _touring.resume = index;
+	_touring.shown = 0; _touring.clock = 0; _touring.leg = 0;
+	_touring.warped = warp;
+	if (warp || _game != s.game || _room != s.room) {
+		Common::String problem;
+		if (!enter(s.game, s.room, 0, problem)) {
+			warning("SCUMMVERSE sandbox tour: %s-%d not shown (%s)", kWorldGames[s.game].gameid, s.room, problem.c_str());
+			_touring.phase = kTourRefusedStop;
+			tourPublish();
+			return;
+		}
+	}
+	_touring.phase = kTourAcross;
+	tourPublish();
+	if (_touring.paused) { StageBridge::stop(_player); return; }
+	tourPlan();
+}
+
+// Straight on to the door out, the next stop's first; first across to the
+// far end (the walkable spot farthest from where it came in) where that door
+// is near where it came in (a dead end, doors side by side: within a quarter
+// of the place's width) or there is none (a warp follows).
+void SandboxEngine::tourPlan() {
+	StageBridge::position(_player, _touring.cameX, _touring.cameY);
+	_touring.clock = 0; _touring.leg = 0;
+	const int next = _touring.stop + 1;
+	double dx, dy;
+	const bool door = next < (int)_touring.stops.size() && !_touring.stops[next].legs.empty() && tourDoor(_touring.stops[next].legs[0], dx, dy);
+	int left, top, width, height;
+	double rowScale, colScale;
+	StageBridge::view(left, top, width, height, rowScale, colScale);
+	if (door && fabs(dx - _touring.cameX) > width / MAX(0.01, colScale) / 4) {
+		_touring.phase = kTourToDoor;
+		StageBridge::walkTo(_player, dx, dy);
+		return;
+	}
+	_touring.phase = kTourAcross;
+	double xs[12], ys[12];
+	const int spots = StageBridge::spots(12, xs, ys);
+	int far = -1;
+	double farthest = -1;
+	for (int i = 0; i < spots; ++i) {
+		const double d = (xs[i] - _touring.cameX) * (xs[i] - _touring.cameX) + (ys[i] - _touring.cameY) * (ys[i] - _touring.cameY);
+		if (d > farthest) { farthest = d; far = i; }
+	}
+	if (far >= 0) StageBridge::walkTo(_player, xs[far], ys[far]);
+}
+
+void SandboxEngine::tourLeave() {
+	if (_touring.stop + 1 >= (int)_touring.stops.size()) { _touring.resume = 0; tourEnd(true); return; }
+	tourVisit(_touring.stop + 1, true);
+}
+
+void SandboxEngine::tourStep(int ticks) {
+	if (!_touring.on || _touring.paused || _player < 0) return;
+	_touring.clock += ticks; _touring.shown += ticks;
+	const bool walking = StageBridge::moving(_player) && _touring.clock < kTourWalk;
+	const int next = _touring.stop + 1;
+	const Common::Array<int> *legs = next < (int)_touring.stops.size() ? &_touring.stops[next].legs : nullptr;
+	double dx, dy;
+	switch (_touring.phase) {
+	case kTourRefusedStop:
+		if (_touring.shown >= kTourRefused) tourLeave();
+		return;
+	case kTourAcross:
+		if (walking) return;
+		StageBridge::stop(_player);
+		if (legs && !legs->empty() && tourDoor((*legs)[0], dx, dy)) {
+			_touring.phase = kTourToDoor; _touring.clock = 0;
+			StageBridge::walkTo(_player, dx, dy);
+			return;
+		}
+		if (_touring.shown >= kTourGlimpse) tourLeave();
+		return;
+	case kTourToDoor: {
+		if (walking || _touring.shown < kTourGlimpse) return;
+		StageBridge::stop(_player);
+		if (!legs || _touring.leg >= (int)legs->size()) { tourLeave(); return; }
+		// Through the door (as a player goes), into the place it leads to:
+		// the next stop, or one passed through on the way there.
+		const Common::Array<int> way = *legs;
+		const int leg = _touring.leg;
+		if (!travel(way[leg])) { tourVisit(next, true); return; }
+		if (leg + 1 < (int)way.size()) {
+			_touring.leg = leg + 1; _touring.clock = 0;
+			if (tourDoor(way[leg + 1], dx, dy)) StageBridge::walkTo(_player, dx, dy);
+			else tourVisit(next, true);
+			return;
+		}
+		tourVisit(next, false);
+		return;
+	}
+	default:
+		return;
+	}
+}
