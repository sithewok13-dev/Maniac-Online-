+		const WorldMap *map = worldMap(t.game);
+		for (int link : t.legs) {
+			if (!map || link < 0 || link >= map->linkCount || map->links[link].room != at) { fail("a way not of doors"); break; }
+			at = map->links[link].target;
+		}
+		if (!t.legs.empty() && at != t.room) fail("a way not ending there");
+	}
+	// Go to stop 3, through the iPhone's request; its label.
+	Tour::request(Tour::kGoTo, 3);
+	pump();
+	bool running = false;
+	char label[200];
+	int next = 0, count = 0;
+	Tour::status(running, label, sizeof(label), next, count);
+	if (!_touring.on || _touring.stop != 2 || _game != _touring.stops[2].game || _room != _touring.stops[2].room) fail("not at stop 3");
+	if (!running || strncmp(label, Common::String::format("Stop 3/%d ", total).c_str(), 8) || count != total || next != 3) fail("not labelled stop 3");
+	// Paused: standing; Next and Previous stay paused; played again, on.
+	Tour::request(Tour::kPause);
+	pump();
+	for (int t = 0; t < 120; ++t) step(1);
+	if (!_touring.paused || StageBridge::moving(_player) || !Tour::paused()) fail("walking while paused");
+	Tour::request(Tour::kNext);
+	pump();
+	for (int t = 0; t < 60; ++t) step(1);
+	if (_touring.stop != 3 || !_touring.paused || StageBridge::moving(_player)) fail("Next while paused not stop 4, standing");
+	Tour::request(Tour::kPrevious);
+	pump();
+	if (_touring.stop != 2 || !_touring.paused) fail("Previous while paused not stop 3");
+	Tour::request(Tour::kPlay);
+	pump();
+	int moved = 0;
+	for (int t = 0; t < 600 && _touring.stop == 2; ++t) { step(1); moved += StageBridge::moving(_player); }
+	if (_touring.paused || (!moved && _touring.stop == 2)) fail("not on again once played");
+	// Stopped: back where it began; resuming at the stop it was at.
+	const int at = _touring.stop;
+	Tour::request(Tour::kStop);
+	pump();
+	double x, y;
+	StageBridge::position(_player, x, y);
+	Tour::status(running, label, sizeof(label), next, count);
+	if (_touring.on || running || _game != homeGame || _room != homeRoom || fabs(x - homeX) > 1 || fabs(y - homeY) > 1) fail("not back where it began");
+	if (next != at + 1 || _touring.resume != at) fail("not resuming at the stop it was at");
+	// The whole tour, 16 times as fast.
+	Tour::request(Tour::kRestart);
+	pump();
+	int visited = 0, onFoot = 0, warped = 0, refused = 0, last = -1, ticks = 0;
+	while (_touring.on && ticks < 4000000) {
+		if (_touring.stop != last) {
+			if (_touring.stop != last + 1) { fail("a stop out of turn"); break; }
+			last = _touring.stop;
+			++visited;
+			if (_touring.phase == kTourRefusedStop) ++refused;
+			else if (_game != _touring.stops[last].game || _room != _touring.stops[last].room) fail("not where its stop is");
+			else if (_touring.warped) ++warped;
+			else ++onFoot;
+		}
+		step(16);
+		ticks += 16;
+	}
+	StageBridge::position(_player, x, y);
+	if (_touring.on) fail("not finished");
+	if (visited != total) fail("not every stop visited");
+	if (_game != homeGame || _room != homeRoom || fabs(x - homeX) > 1 || fabs(y - homeY) > 1) fail("not back where it began at the end");
+	if (_touring.resume != 0) fail("not starting over after the end");
+	if (onFoot * 2 < total) fail("most stops not reached on foot");
+	g_system->updateScreen();
+	warning("SCUMMVERSE sandbox selftest tour: %d stops (%d on foot, %d warped, %d not shown) in %d ticks, commands as asked, back where it began, %d failed",
+		total, onFoot, warped, refused, ticks, failed);
+	if (failed || !total) return Common::Error(Common::kUnknownError, "sandbox selftest failed");
+	warning("SCUMMVERSE sandbox selftest PASS");
+	return Common::kNoError;
+}
