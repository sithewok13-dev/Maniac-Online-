@@ -0,0 +1,62 @@
+// Original-data portraits are rendered by the engine; no bundled game artwork.
+static NSMutableDictionary *scummverseFaces;
+@interface ScummverseRosterController : UIViewController {
+	UIScrollView *_grid;
+	int _token;
+	unsigned _mask;
+}
+- (id)initWithToken:(int)token mask:(unsigned)mask;
+@end
+@implementation ScummverseRosterController
+- (id)initWithToken:(int)token mask:(unsigned)mask {
+	if((self=[super init])) { _token=token; _mask=mask; self.modalPresentationStyle=UIModalPresentationFullScreen; }
+	return self;
+}
+- (void)viewDidLoad {
+	[super viewDidLoad]; self.view.backgroundColor=[UIColor colorWithRed:0.08 green:0.02 blue:0.12 alpha:1];
+	UILabel *title=[[[UILabel alloc] init] autorelease]; title.tag=100; title.text=@"Choose your character"; title.textColor=UIColor.whiteColor; title.font=[UIFont boldSystemFontOfSize:24]; [self.view addSubview:title];
+	UIButton *close=[UIButton buttonWithType:UIButtonTypeSystem]; close.tag=101; [close setTitle:@"Done" forState:UIControlStateNormal]; [close addTarget:self action:@selector(done) forControlEvents:UIControlEventTouchUpInside]; [self.view addSubview:close];
+	_grid=[[[UIScrollView alloc] init] autorelease]; [self.view addSubview:_grid];
+	for(int id=1;id<25;++id) if(_mask&(1u<<id)) {
+		UIButton *tile=[UIButton buttonWithType:UIButtonTypeCustom]; tile.tag=id; tile.backgroundColor=[UIColor colorWithRed:0.22 green:0.05 blue:0.30 alpha:1]; tile.layer.cornerRadius=8;
+		NSString *name=[NSString stringWithUTF8String:ScummverseLocalAI::actorName(id)]; tile.accessibilityLabel=[@"Play as " stringByAppendingString:name];
+		UIImageView *face=[[[UIImageView alloc] initWithImage:scummverseFaces[@(id)]] autorelease]; face.tag=200; face.contentMode=UIViewContentModeScaleAspectFit; face.layer.magnificationFilter=kCAFilterNearest; [tile addSubview:face];
+		UILabel *label=[[[UILabel alloc] init] autorelease]; label.tag=201; label.text=name; label.textAlignment=NSTextAlignmentCenter; label.textColor=UIColor.whiteColor; label.font=[UIFont systemFontOfSize:13 weight:UIFontWeightSemibold]; label.numberOfLines=2; [tile addSubview:label];
+		[tile addTarget:self action:@selector(choose:) forControlEvents:UIControlEventTouchUpInside]; [_grid addSubview:tile];
+	}
+}
+- (void)viewDidLayoutSubviews {
+	[super viewDidLayoutSubviews]; CGRect safe=UIEdgeInsetsInsetRect(self.view.bounds,self.view.safeAreaInsets);
+	[self.view viewWithTag:100].frame=CGRectMake(safe.origin.x+12,safe.origin.y+8,safe.size.width-86,40);
+	[self.view viewWithTag:101].frame=CGRectMake(CGRectGetMaxX(safe)-70,safe.origin.y+8,64,40);
+	_grid.frame=CGRectMake(safe.origin.x+8,safe.origin.y+56,safe.size.width-16,safe.size.height-56);
+	int cols=MAX(3,(int)(_grid.bounds.size.width/120)); CGFloat width=_grid.bounds.size.width/cols; int i=0;
+	for(UIView *tile in _grid.subviews) if([tile isKindOfClass:UIButton.class]) {
+		tile.frame=CGRectMake(i%cols*width+4,i/cols*140+4,width-8,132);
+		[tile viewWithTag:200].frame=CGRectMake(8,6,width-24,88); [tile viewWithTag:201].frame=CGRectMake(3,94,width-14,34); ++i;
+	}
+	_grid.contentSize=CGSizeMake(_grid.bounds.size.width,((i+cols-1)/cols)*140);
+}
+- (void)choose:(UIButton *)button { scummverseWorldRequest(_token | (128+(int)button.tag)); [self done]; }
+- (void)done { [self dismissViewControllerAnimated:NO completion:nil]; }
+@end
+void scummverseRosterFace(int actor,const unsigned char *rgba) {
+	NSData *data=[[NSData alloc] initWithBytes:rgba length:64*64*4];
+	dispatch_async(dispatch_get_main_queue(), ^{
+		if(!scummverseFaces) scummverseFaces=[[NSMutableDictionary alloc] init];
+		CGDataProviderRef provider=CGDataProviderCreateWithCFData((CFDataRef)data); CGColorSpaceRef color=CGColorSpaceCreateDeviceRGB();
+		CGImageRef raw=CGImageCreate(64,64,8,32,64*4,color,kCGBitmapByteOrderDefault|kCGImageAlphaLast,provider,NULL,false,kCGRenderingIntentDefault);
+		if(raw) { scummverseFaces[@(actor)]=[UIImage imageWithCGImage:raw]; CGImageRelease(raw); }
+		CGColorSpaceRelease(color); CGDataProviderRelease(provider); [data release];
+	});
+}
+void scummverseRosterShow(int token,unsigned mask) {
+	dispatch_async(dispatch_get_main_queue(), ^{
+		UIResponder *responder=[iOS7AppDelegate iPhoneView];
+		while(responder && ![responder isKindOfClass:UIViewController.class]) responder=responder.nextResponder;
+		UIViewController *controller=(UIViewController *)responder; if(!controller || controller.presentedViewController) return;
+		ScummverseLocalAI::runtime().endTalk(); [[iOS7AppDelegate iPhoneView] endEditing:YES];
+		ScummverseRosterController *menu=[[[ScummverseRosterController alloc] initWithToken:token mask:mask] autorelease];
+		[controller presentViewController:menu animated:NO completion:nil];
+	});
+}
