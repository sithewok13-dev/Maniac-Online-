+// Exploration presets the exporter applies before drawing a game's rooms,
+// with numbers from the game's own scripts. The Dig's light bridges: a beam
+// object without class 32 (Untouchable) is a bridge switched on and var 430
+// counts them (global script 236); each spire's, the island map's and the
+// hub's own room script then draws its bridges (actors) and opens their walk
+// boxes. Every bridge on, as after the panels' puzzles.
+struct WorldPresetClass { short game, object, cls; };
+static const WorldPresetClass kWorldPresetClassesOff[] = {
+	{8, 252, 32}, {8, 367, 32}, {8, 394, 32}, {8, 427, 32}, {8, 511, 32},
+};
+struct WorldPresetVar { short game, var, value; };
+static const WorldPresetVar kWorldPresetVars[] = {{8, 430, 5}};
+struct WorldPresetScript { short game, room, script; };
+static const WorldPresetScript kWorldPresetScripts[] = {
+	{8, 31, 2000}, {8, 49, 2000}, {8, 56, 2002}, {8, 61, 2002}, {8, 75, 2001},
+	{8, 77, 2000}, {8, 77, 2002}, {8, 91, 2000},
+};
+// Tints a preset room's entry script gives the colors its scripts' actors
+// use (the Dig spires light their bridges' colors 192..207).
+struct WorldPresetTint { short game, room, red, green, blue, start, end; };
+static const WorldPresetTint kWorldPresetTints[] = {
+	{8, 31, 180, 120, 275, 192, 207}, {8, 56, 160, 180, 255, 192, 207},
+};
+// Animation steps run before a preset room is captured.
+static const int kWorldPresetFrames = 60;
+inline bool worldPresetRoom(int game, int room) {
+	for (const auto &p : kWorldPresetScripts) if (p.game == game && p.room == room) return true;
+	return false;
+}
 // Characters who float instead of walking (Murray, the talking skull).
 struct WorldHoverer { short game, costume; };
 static const WorldHoverer kWorldHoverers[] = {{9, 49}};
