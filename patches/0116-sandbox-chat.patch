+static Common::String next;
+static void appearance(int actor, int key) { if (actor == SandboxEngine::kTalkPlayer) player = key; }
+static void visitorOf(int slot, int key) { if (slot >= 0 && slot < SandboxEngine::kTalkSlots) visitors[slot] = key; }
+static unsigned long long scene(int r, int v, unsigned long long a, bool can, int &who, char *line, int capacity) {
+	if (r != room || v != visitor) chatting = 0; // (as the chat's: another place, another conversation)
+	room = r; visitor = v; actors = a; canSpeak = can;
+	chatting &= a;
+	who = 0;
+	if (capacity > 0) line[0] = 0;
+	if (chatting && can && !next.empty()) { who = speaker; Common::strlcpy(line, next.c_str(), capacity); next.clear(); }
