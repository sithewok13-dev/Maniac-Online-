+		for (int t = 0; t < 2000 && _speech != third; ++t) step(1);
+		if (_speech != third || _speaker != _player || !StageBridge::talking(_player) || StageBridge::talking(a)) fail("the one played's line not over them"); else ++lines;
+		for (int t = 0; t < 2000 && !_speech.empty(); ++t) step(1);
+		if (!_speech.empty() || StageBridge::talking(_player) || _speaker >= 0) fail("a line not gone");
+		// Ended; then the chat asks whom: a tap on someone picks them, a tap
+		// on no one does nothing, and after it a tap walks again.
+		FakeTalk::chatting = 0;
+		step(1);
+		if (_chatting) fail("a conversation not ended");
+		const int b = slotActor(_onStage.size() > 2 ? 1 : 0, _player);
+		int px, py;
+		double x0, y0, x1, y1;
+		StageBridge::position(_player, x0, y0);
+		// (Out of view, beside the one played.)
+		for (int side = 0; side < 4 && !pointOn(b, px, py); ++side) StageBridge::place(b, x0 + (side & 1 ? -1 : 1) * (side < 2 ? 40 : 20) * screenWidthOf(g) / 320.0, y0);
+		if (!pointOn(b, px, py)) { fail("no one to tap"); continue; }
+		FakeTalk::picking = true; FakeTalk::picked = -1;
+		tap(px, py);
+		step(1);
+		StageBridge::position(_player, x1, y1);
+		if (FakeTalk::picked != kTalkVisitor + actorSlot(b, _player) || !(_chatting & (1ULL << FakeTalk::picked)) || StageBridge::moving(_player) || x0 != x1 || y0 != y1) fail("a tap not picking someone"); else ++picks;
+		// (At the one played's feet, where no one else is.)
+		int ox, oy, on;
+		StageBridge::toScreen(x0, y0, ox, oy);
+		const bool noOne = !talkIdAt(ox, oy - 1) && (!PanelBridge::loaded() || !PanelBridge::hit(ox, oy - 1, on));
+		FakeTalk::picking = true; FakeTalk::picked = -1;
+		tap(ox, oy - 1);
+		if (noOne && (FakeTalk::picked != 0 || StageBridge::moving(_player) || !FakeTalk::picking)) fail("a tap on no one not kept for picking");
+		FakeTalk::picking = false;
+		tap(px, py);
+		if (!StageBridge::moving(_player) && _door < 0 && !_action) fail("a tap after picking not a walk");
+		StageBridge::stop(_player);
+	}
+	// Closing: no one here, no conversation.
+	talkEnd();
+	bool cleared = FakeTalk::player == 0 && !FakeTalk::actors && !FakeTalk::chatting;
+	for (int s = 0; s < kTalkSlots; ++s) cleared = cleared && !FakeTalk::visitors[s];
+	if (!cleared) { ++failed; warning("SCUMMVERSE sandbox talk: the chat not cleared on leaving"); }
+	g_system->updateScreen();
+	warning("SCUMMVERSE sandbox selftest talk: %d places, %d lines said, %d picked, Maniac's rooms %s, %d failed", places, lines, picks, maniac ? "seen" : "not here", failed);
+	if (!places || failed || lines != places * 3 || picks != places) return Common::Error(Common::kUnknownError, "sandbox selftest failed");
+	warning("SCUMMVERSE sandbox selftest PASS");
+	return Common::kNoError;
+}
