+// A Zak door opens as someone goes through it, when its open picture is
+// right (zakOpenDoors); it stays open until the room is entered again.
+void ScummEngine::scummverseOpenZakDoor(int room, int object) {
+	if (room != _currentRoom || getObjectIndex(object) < 0 || (getState(object) & kObjectStateIntrinsic)) return;
+	bool clean = false;
+	for (const auto &door : zakOpenDoors) clean = clean || (door[0] == room && door[1] == object);
+	if (!clean) return;
+	putState(object, (getState(object) | kObjectStateIntrinsic) & ~kObjectStateLocked);
+	markObjectRectAsDirty(object);
+	clearDrawObjectQueue();
+	_fullRedraw = true;
+}
+
+// Arrived from a Zak room: the door back there opens too.
+void ScummEngine::scummverseOpenZakArrival(int from) {
+	for (const auto &link : zakLinks) if (link.room == _currentRoom && link.destination == from) scummverseOpenZakDoor(link.room, link.object);
+}
+
+// Maniac Mansion's dark rooms start with their lights on (the six the
+// original starts dark: the phone hall, the basement by the reactor, the
+// wall-safe closet, the crawlspace, the medical office and the darkroom),
+// as the light switch in each would; once per game (old saves included).
+// kScummverseLightsVar marks it done.
+void ScummEngine::scummverseLightsOn() {
+	if (!_scummverseRoaming || _scummVars[kScummverseLightsVar]) return;
+	for (int room : {5, 8, 9, 15, 22, 23}) {
+		const int bit = 2816 + room; // the original's "this room's light is off"
+		_scummVars[bit >> 4] &= ~(1 << (bit & 15));
+	}
+	_scummVars[kScummverseLightsVar] = 1;
+	if (_currentRoom >= 1 && _currentRoom <= 52) runScript(55, false, false, nullptr); // the room's lights now
+}
