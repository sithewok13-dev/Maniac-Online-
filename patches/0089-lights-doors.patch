+// The door the guide sets off to opens, as a player would open it (Maniac
+// Mansion's on both sides; Zak's where its open picture is right; other
+// games' rooms are pictures with their doors drawn in).
+void ScummEngine::scummverseTourOpenDoor(int index, int leg) {
+	const ScummverseTourStop &stop = _scummverseTourStops[index];
+	if (leg < 0 || leg >= stop.legs) return;
+	const int door = _scummverseTourLegs[stop.firstLeg + leg].door;
+	if (stop.kind == kTourManiac) scummverseOpenPassage(door - 1, true);
+	else if (stop.kind == kTourZak) scummverseOpenZakDoor(zakLinks[door - 1].room, zakLinks[door - 1].object);
+}
