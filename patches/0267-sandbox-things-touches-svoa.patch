+// whether that is all (its picture not set by it: the one it is in). The
+// thing itself's is an other of its own number (only that), made so.
+static const int kScummverseMadeTouchable = 0x200, kScummverseMadeUntouchable = 0x400, kScummverseTouchOnly = 0x800;
+static const int kScummverseTouchBits = kScummverseMadeTouchable | kScummverseMadeUntouchable | kScummverseTouchOnly;
+// (While exporting: one set or cleared as it was, see scummverseSettleTouches.)
+static const int kScummverseTouchAsWas = 0x1000;
