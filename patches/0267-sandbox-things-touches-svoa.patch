+// From 0267, an answer's touches settled once every run is done: one set or
+// cleared as it was kept only for a thing some answer changes (`changed`, by
+// number; any other's is its start's: nothing to say), the mark of it let
+// go; an other that was only that, none then. (`given`: the others' value
+// for a thing given.)
+static void scummverseSettleTouches(Common::Array<int> &others, const Common::HashMap<int, bool> &changed, int given) {
+	Common::Array<int> kept;
+	for (uint k = 0; k + 2 < others.size(); k += 3) {
+		int value = others[k + 2];
+		if (value != given && (value & kScummverseTouchAsWas)) {
+			value &= ~kScummverseTouchAsWas;
+			if (!changed.contains(others[k + 1])) {
+				if (value & kScummverseTouchOnly) continue;
+				value &= ~kScummverseTouchBits;
+			}
+		}
+		kept.push_back(others[k]); kept.push_back(others[k + 1]); kept.push_back(value);
+	}
+	others = kept;
