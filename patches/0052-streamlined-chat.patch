+	// People chips: tapping someone nearby starts a private conversation,
+	// adds them to the current one, or removes them; removing the last
+	// participant ends the conversation. False when they are not here.
+	bool toggleTalk(int actor) {
+		std::lock_guard<std::mutex> guard(mutex);
+		if (actor <= 0 || actor >= 25 || !(sceneMask & (1u << actor))) return false;
+		pickMode = 0;
+		unsigned mask = conversation.participants();
+		if (!talkActor || !mask) {
+			abortGeneration(); result.clear(); resetTalk(); talkActor = actor; conversation.reset(1u << actor); return true;
+		}
+		mask ^= 1u << actor;
+		if (!mask) { abortGeneration(); result.clear(); resetTalk(); return true; }
+		if (conversation.setParticipants(mask)) { abortGeneration(); chatTicket = 0; }
+		talkActor = (mask & (mask - 1)) ? -2 : __builtin_ctz(mask);
+		return true;
+	}
+	// The composer is always ready: with nobody chosen, a message goes to
+	// everyone nearby (one person directly; several as a group that follows
+	// arrivals and departures). 1 sent, 0 nobody here, -1 rejected (blank,
+	// oversized or three messages already waiting).
+	int sendNearby(const std::string &text) {
+		std::lock_guard<std::mutex> guard(mutex);
+		if (text.empty() || text.size() > Scummverse::Conversation::kMaxText) return -1;
+		if (!conversation.participants()) {
+			if (!sceneMask) return 0;
+			abortGeneration(); result.clear(); resetTalk();
+			talkActor = (sceneMask & (sceneMask - 1)) ? -1 : __builtin_ctz(sceneMask);
+			conversation.reset(sceneMask);
+		}
+		if (!conversation.submit(speechText(text))) return -1;
+		pumpChat(); return 1;
+	}
