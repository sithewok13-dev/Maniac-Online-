+// Characters a game draws from another character's costume with its own
+// animation set (e.g. Monkey Island's cannibals share one costume, each with
+// a different mask): exported as a virtual costume number of that game.
+struct WorldCostumeVariant { short game, costume, real, init, walk, stand, talkStart, talkStop; };
+static const WorldCostumeVariant kWorldCostumeVariants[] = {
+	{0, 906, 9, 6, 7, 8, 9, 8},     // Monkey Island cannibal, second mask
+	{0, 911, 9, 11, 12, 13, 14, 13}, // Monkey Island cannibal, third mask
+};
+inline const WorldCostumeVariant *worldCostumeVariant(int game, int costume) {
+	for (const auto &v : kWorldCostumeVariants) if (v.game == game && v.costume == costume) return &v;
+	return nullptr;
+}
+// Characters who float instead of walking (Murray, the talking skull).
+struct WorldHoverer { short game, costume; };
+static const WorldHoverer kWorldHoverers[] = {{9, 49}};
+inline bool worldHovers(int game, int costume) {
+	for (const auto &h : kWorldHoverers) if (h.game == game && h.costume == costume) return true;
+	return false;
+}
 // Playing as someone from another game: a sandbox character's appearance is
 // a cast member by key game * 1024 + costume + 1 (0: themselves). Keys are
 // saved, and stay valid when the cast is regenerated.
