 namespace ScummverseZakPlane {
 // Audited English DOS V1 cabin: repeated original chairs, actor coordinates.
 static const int seatX[] = {63,52,41,30,19,74};
+// The cabin art paints passengers into chairs 19, 30, 41 and 52; chair 74 is
+// empty. A chair a sandbox rider holds shows the empty chair: its tiles
+// (columns 0..4, rows 6..11 from the chair's column) replace the painted
+// passenger in the picture, color and mask maps alike.
+static const int kEmptyChair = 74;
+inline bool emptyChair(unsigned char *map, int columns, int rows, int seat) {
+ if(columns<kEmptyChair+5 || rows!=16 || seat<0 || seat+5>columns) return false;
+ for(int dx=0;dx<5;++dx) for(int y=6;y<12;++y)
+  map[(seat+dx)*rows+y]=map[(kEmptyChair+dx)*rows+y];
+ return true;
+}
