+// A chair held by any rider (seated, or stood up and keeping the seat) or
+// occupied by another device's player shows empty, never a painted passenger.
+unsigned ScummEngine::scummverseCabinChairs() const {
+ if(!_scummverseRoaming || !_scummVars || !_scummVars[724]) return 0;
+ unsigned slots=0;
+ for(int id=1;id<25;++id) {
+  const int seat=ABS(_scummVars[501+id]);
+  if(seat>=1 && seat<=6) slots|=1u<<(seat-1);
+  const Actor *a=_actors[id];
+  if(a->_room==56 && a->getElevation()==-4 && a->getRealPos().y==52)
+   for(int s=0;s<6;++s) if(ABS(a->getRealPos().x-ScummverseZakPlane::seatX[s])<=1) slots|=1u<<s;
+ }
+ return slots;
+}
+void ScummEngine::scummverseUpdateCabinChairs() {
+ if(!scummversePlaneScene()) return;
+ const unsigned slots=scummverseCabinChairs();
+ if(slots==_scummverseShownChairs) return;
+ _scummverseShownChairs=slots;
+ _gdi->scummverseEmptyChairs(slots);
+ _fullRedraw=true;
+}
