+	auto rank = [](const std::string &name) { return name.compare(0, 2, "en") == 0 ? 0 : name.compare(0, 6, "bridge") == 0 ? 1 : 2; };
+	std::vector<const Interface *> usable;
+	for (const Interface &i : interfaces)
+		if (i.up && i.running && !i.loopback && !i.pointToPoint && i.address && (i.address >> 24) != 127) usable.push_back(&i);
