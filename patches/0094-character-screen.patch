@@ -0,0 +1,201 @@
+// The character screen: a box per game (Maniac Mansion, Zak, then the other
+// worlds), each with its lead's face; a tap plays the lead, a long press
+// lists everyone in that game. The engine draws the faces from the player's
+// own game files (scummverseCastOffer) and decides what each choice does;
+// no bundled artwork. Manual reference counting, like this file.
+
+static NSMutableDictionary *scummverseCastTitles, *scummverseCastFolders, *scummverseCastFaces, *scummverseCastPeople;
+
+static UIImage *scummverseCastImage(NSData *data) {
+	CGDataProviderRef provider = CGDataProviderCreateWithCFData((CFDataRef)data);
+	CGColorSpaceRef color = CGColorSpaceCreateDeviceRGB();
+	CGImageRef raw = CGImageCreate(64, 64, 8, 32, 64 * 4, color, kCGBitmapByteOrderDefault | kCGImageAlphaLast, provider, NULL, false, kCGRenderingIntentDefault);
+	UIImage *image = raw ? [UIImage imageWithCGImage:raw] : nil;
+	if (raw) CGImageRelease(raw);
+	CGColorSpaceRelease(color); CGDataProviderRelease(provider);
+	return image;
+}
+
+@interface ScummverseCastController : UIViewController {
+	UIScrollView *_grid;
+}
+- (void)play:(int)request;
+@end
+
+// Everyone in one game, from a long press: a list, since some games have
+// dozens of people.
+@interface ScummverseCastPeopleController : UITableViewController {
+	NSArray *_people;
+	ScummverseCastController *_screen; // Not retained: it presents this list.
+}
+@end
+
+@implementation ScummverseCastPeopleController
+- (id)initWithPeople:(NSArray *)people title:(NSString *)title screen:(ScummverseCastController *)screen {
+	if ((self = [super initWithStyle:UITableViewStylePlain])) { _people = [people copy]; _screen = screen; self.title = title; }
+	return self;
+}
+- (void)dealloc { [_people release]; [super dealloc]; }
+- (void)viewDidLoad {
+	[super viewDidLoad];
+	self.navigationItem.rightBarButtonItem = [[[UIBarButtonItem alloc] initWithBarButtonSystemItem:UIBarButtonSystemItemCancel target:self action:@selector(cancel)] autorelease];
+}
+- (NSInteger)tableView:(UITableView *)tableView numberOfRowsInSection:(NSInteger)section { return (NSInteger)_people.count; }
+- (UITableViewCell *)tableView:(UITableView *)tableView cellForRowAtIndexPath:(NSIndexPath *)indexPath {
+	UITableViewCell *cell = [tableView dequeueReusableCellWithIdentifier:@"person"];
+	if (!cell) cell = [[[UITableViewCell alloc] initWithStyle:UITableViewCellStyleDefault reuseIdentifier:@"person"] autorelease];
+	cell.textLabel.text = _people[indexPath.row][0];
+	return cell;
+}
+- (void)tableView:(UITableView *)tableView didSelectRowAtIndexPath:(NSIndexPath *)indexPath {
+	[_screen play:[_people[indexPath.row][1] intValue]];
+}
+- (void)cancel { [self dismissViewControllerAnimated:YES completion:nil]; }
+@end
+
+@implementation ScummverseCastController
+- (id)init {
+	if ((self = [super init])) self.modalPresentationStyle = UIModalPresentationFullScreen;
+	return self;
+}
+- (UIStatusBarStyle)preferredStatusBarStyle { return UIStatusBarStyleLightContent; }
+- (void)viewDidLoad {
+	[super viewDidLoad];
+	self.view.backgroundColor = [UIColor colorWithRed:0.08 green:0.02 blue:0.12 alpha:1];
+	UILabel *title = [[[UILabel alloc] init] autorelease]; title.tag = 100; title.text = @"Who do you want to play?";
+	title.textColor = UIColor.whiteColor; title.font = [UIFont boldSystemFontOfSize:22]; title.adjustsFontSizeToFitWidth = YES; title.minimumScaleFactor = 0.6; [self.view addSubview:title];
+	UILabel *note = [[[UILabel alloc] init] autorelease]; note.tag = 102; note.text = @"Long press a game for everyone in it";
+	note.textColor = [UIColor colorWithWhite:0.8 alpha:1]; note.font = [UIFont systemFontOfSize:14]; note.adjustsFontSizeToFitWidth = YES; note.minimumScaleFactor = 0.6; [self.view addSubview:note];
+	UIButton *close = [UIButton buttonWithType:UIButtonTypeSystem]; close.tag = 101; [close setTitle:@"Done" forState:UIControlStateNormal];
+	[close addTarget:self action:@selector(done) forControlEvents:UIControlEventTouchUpInside]; [self.view addSubview:close];
+	_grid = [[[UIScrollView alloc] init] autorelease]; [self.view addSubview:_grid];
+	for (NSNumber *slot in [scummverseCastTitles.allKeys sortedArrayUsingSelector:@selector(compare:)]) {
+		NSArray *people = scummverseCastPeople[slot];
+		const BOOL here = people.count > 0;
+		UIButton *tile = [UIButton buttonWithType:UIButtonTypeCustom]; tile.tag = slot.intValue + 1;
+		tile.backgroundColor = [UIColor colorWithRed:0.22 green:0.05 blue:0.30 alpha:1]; tile.layer.cornerRadius = 8; tile.alpha = here ? 1 : 0.45;
+		UIImageView *face = [[[UIImageView alloc] initWithImage:scummverseCastFaces[slot]] autorelease]; face.tag = 200;
+		face.contentMode = UIViewContentModeScaleAspectFit; face.layer.magnificationFilter = kCAFilterNearest; [tile addSubview:face];
+		UILabel *name = [[[UILabel alloc] init] autorelease]; name.tag = 201; name.textAlignment = NSTextAlignmentCenter; name.textColor = UIColor.whiteColor;
+		name.font = [UIFont systemFontOfSize:13 weight:UIFontWeightSemibold]; name.adjustsFontSizeToFitWidth = YES; name.minimumScaleFactor = 0.6;
+		name.text = here ? people[0][0] : [NSString stringWithFormat:@"Add Documents/%@", scummverseCastFolders[slot]]; [tile addSubview:name];
+		UILabel *game = [[[UILabel alloc] init] autorelease]; game.tag = 202; game.textAlignment = NSTextAlignmentCenter;
+		game.textColor = [UIColor colorWithWhite:0.75 alpha:1]; game.font = [UIFont systemFontOfSize:11]; game.numberOfLines = 2;
+		game.adjustsFontSizeToFitWidth = YES; game.minimumScaleFactor = 0.6;
+		game.text = scummverseCastTitles[slot]; [tile addSubview:game];
+		tile.accessibilityLabel = here ? [NSString stringWithFormat:@"Play as %@, %@", people[0][0], scummverseCastTitles[slot]] : [NSString stringWithFormat:@"%@, not added", scummverseCastTitles[slot]];
+		tile.accessibilityHint = here ? @"Long press for everyone in this game" : nil;
+		[tile addTarget:self action:@selector(choose:) forControlEvents:UIControlEventTouchUpInside];
+		[tile addTarget:self action:@selector(press:) forControlEvents:UIControlEventTouchDown | UIControlEventTouchDragEnter];
+		[tile addTarget:self action:@selector(unpress:) forControlEvents:UIControlEventTouchUpInside | UIControlEventTouchUpOutside | UIControlEventTouchDragExit | UIControlEventTouchCancel];
+		UILongPressGestureRecognizer *hold = [[[UILongPressGestureRecognizer alloc] initWithTarget:self action:@selector(hold:)] autorelease];
+		[tile addGestureRecognizer:hold];
+		[_grid addSubview:tile];
+	}
+}
+- (void)viewDidLayoutSubviews {
+	[super viewDidLayoutSubviews];
+	const CGRect safe = UIEdgeInsetsInsetRect(self.view.bounds, self.view.safeAreaInsets);
+	[self.view viewWithTag:100].frame = CGRectMake(safe.origin.x + 12, safe.origin.y + 6, safe.size.width - 86, 32);
+	[self.view viewWithTag:101].frame = CGRectMake(CGRectGetMaxX(safe) - 70, safe.origin.y, 64, 44);
+	[self.view viewWithTag:102].frame = CGRectMake(safe.origin.x + 12, safe.origin.y + 38, safe.size.width - 24, 20);
+	_grid.frame = CGRectMake(safe.origin.x + 6, safe.origin.y + 62, safe.size.width - 12, safe.size.height - 64);
+	// All twelve on one screen: three across in portrait, six in landscape.
+	int count = 0;
+	for (UIView *tile in _grid.subviews) if ([tile isKindOfClass:UIButton.class]) ++count;
+	const int cols = _grid.bounds.size.width > _grid.bounds.size.height ? 6 : 3, rows = MAX(1, (count + cols - 1) / cols);
+	const CGFloat width = floor(_grid.bounds.size.width / cols), height = MAX(100, MIN(190, floor(_grid.bounds.size.height / rows)));
+	int i = 0;
+	for (UIView *tile in _grid.subviews) {
+		if (![tile isKindOfClass:UIButton.class]) continue;
+		tile.frame = CGRectMake(i % cols * width + 3, i / cols * height + 3, width - 6, height - 6);
+		const CGFloat w = width - 6, h = height - 6;
+		[tile viewWithTag:200].frame = CGRectMake(6, 4, w - 12, h - 50);
+		[tile viewWithTag:201].frame = CGRectMake(3, h - 46, w - 6, 18);
+		[tile viewWithTag:202].frame = CGRectMake(3, h - 28, w - 6, 26);
+		++i;
+	}
+	_grid.contentSize = CGSizeMake(_grid.bounds.size.width, rows * height);
+}
+- (void)play:(int)request {
+	scummverseWorldRequest(request);
+	[self done];
+}
+- (void)press:(UIButton *)tile { tile.backgroundColor = [UIColor colorWithRed:0.38 green:0.12 blue:0.50 alpha:1]; }
+- (void)unpress:(UIButton *)tile { tile.backgroundColor = [UIColor colorWithRed:0.22 green:0.05 blue:0.30 alpha:1]; }
+- (void)choose:(UIButton *)tile {
+	if (self.presentedViewController) return;
+	NSNumber *slot = @(tile.tag - 1);
+	NSArray *people = scummverseCastPeople[slot];
+	if (people.count) { [self play:[people[0][1] intValue]]; return; }
+	UIAlertController *alert = [UIAlertController alertControllerWithTitle:scummverseCastTitles[slot]
+		message:[NSString stringWithFormat:@"Copy your own copy of this game into a folder in Documents named \"%@\", then restart the app.", scummverseCastFolders[slot]]
+		preferredStyle:UIAlertControllerStyleAlert];
+	[alert addAction:[UIAlertAction actionWithTitle:@"OK" style:UIAlertActionStyleCancel handler:nil]];
+	[self presentViewController:alert animated:YES completion:nil];
+}
+- (void)hold:(UILongPressGestureRecognizer *)hold {
+	if (hold.state != UIGestureRecognizerStateBegan || self.presentedViewController) return;
+	[self unpress:(UIButton *)hold.view];
+	NSNumber *slot = @(hold.view.tag - 1);
+	NSArray *people = scummverseCastPeople[slot];
+	if (!people.count) { [self choose:(UIButton *)hold.view]; return; }
+	ScummverseCastPeopleController *list = [[[ScummverseCastPeopleController alloc] initWithPeople:people title:scummverseCastTitles[slot] screen:self] autorelease];
+	UINavigationController *navigation = [[[UINavigationController alloc] initWithRootViewController:list] autorelease];
+	navigation.modalPresentationStyle = UIModalPresentationFormSheet;
+	[self presentViewController:navigation animated:YES completion:nil];
+}
+// Closes the screen and anything over it (the list).
+- (void)done {
+	UIViewController *below = self.presentingViewController;
+	[(below ? below : self) dismissViewControllerAnimated:NO completion:nil];
+}
+@end
+
+// Filled in order on the main queue (slot 0 starts afresh), then shown.
+void scummverseCastGame(int slot, const char *title, const char *folder, const unsigned char *rgba) {
+	NSString *name = [[NSString alloc] initWithUTF8String:title ? title : ""], *place = [[NSString alloc] initWithUTF8String:folder ? folder : ""];
+	NSData *data = rgba ? [[NSData alloc] initWithBytes:rgba length:64 * 64 * 4] : nil;
+	dispatch_async(dispatch_get_main_queue(), ^{
+		if (!scummverseCastTitles) {
+			scummverseCastTitles = [[NSMutableDictionary alloc] init]; scummverseCastFolders = [[NSMutableDictionary alloc] init];
+			scummverseCastFaces = [[NSMutableDictionary alloc] init]; scummverseCastPeople = [[NSMutableDictionary alloc] init];
+		}
+		if (slot == 0) {
+			[scummverseCastTitles removeAllObjects]; [scummverseCastFolders removeAllObjects];
+			[scummverseCastFaces removeAllObjects]; [scummverseCastPeople removeAllObjects];
+		}
+		if (name) scummverseCastTitles[@(slot)] = name;
+		if (place) scummverseCastFolders[@(slot)] = place;
+		if (data) { UIImage *face = scummverseCastImage(data); if (face) scummverseCastFaces[@(slot)] = face; }
+		scummverseCastPeople[@(slot)] = [NSMutableArray array];
+		[name release]; [place release]; [data release];
+	});
+}
+void scummverseCastMember(int slot, const char *name, int request) {
+	if (!name || !*name) return;
+	NSString *person = [[NSString alloc] initWithUTF8String:name];
+	dispatch_async(dispatch_get_main_queue(), ^{
+		NSMutableArray *people = scummverseCastPeople[@(slot)];
+		if (people && person) [people addObject:@[person, @(request)]];
+		[person release];
+	});
+}
+// Shown over the game; if something else is up (an alert at the start), it
+// is tried again for a few seconds rather than lost.
+static void scummverseCastPresent(int tries) {
+	UIResponder *responder = [iOS7AppDelegate iPhoneView];
+	while (responder && ![responder isKindOfClass:UIViewController.class]) responder = responder.nextResponder;
+	UIViewController *controller = (UIViewController *)responder;
+	if (!controller || [controller.presentedViewController isKindOfClass:ScummverseCastController.class]) return;
+	if (controller.presentedViewController) {
+		if (tries > 0) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.6 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ scummverseCastPresent(tries - 1); });
+		return;
+	}
+	ScummverseLocalAI::runtime().endTalk(); [[iOS7AppDelegate iPhoneView] endEditing:YES];
+	ScummverseCastController *screen = [[[ScummverseCastController alloc] init] autorelease];
+	[controller presentViewController:screen animated:NO completion:nil];
+}
+void scummverseCastShow() {
+	dispatch_async(dispatch_get_main_queue(), ^{ scummverseCastPresent(10); });
+}
