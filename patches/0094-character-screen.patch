+// A choice on the character screen: a Maniac or Zak character as
+// themselves, or someone from another game, met where they live.
+void ScummEngine::scummverseCastChoose(int request) {
+	using namespace ::Scummverse::WorldCatalog;
+	if(request>=kWorldCastActorRequest) {
+		const int id=request-kWorldCastActorRequest;
+		if(id==VAR(VAR_EGO) || scummverseSwitchActor(id)) scummverseSetAppearance(id,0);
+		return;
+	}
+	const int key=request-kWorldCastRequest;
+	if(!worldAppearance(key)) return;
+	const int game=worldAppearanceGame(key), costume=worldAppearanceCostume(key);
+	scummverseSetAppearance(VAR(VAR_EGO),key);
+	for(const auto &cast : kWorldCast)
+		if(cast.game==game && cast.guest.costume==costume) { scummverseTravelPlace(game,cast.room); break; }
+	scummverseWorldReport(_scummverseWorldNotice.c_str());
+}
