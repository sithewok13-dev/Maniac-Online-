+// The character screen: a box per game, its lead and everyone in it
+// (Maniac's and Zak's people as themselves, the Maniac looks, the other
+// games' casts as exported here). Shown at the start of a new game and from
+// "Play as someone else". Elsewhere than on the iPhone, the roster.
+void ScummEngine::scummverseCastOffer() {
+#ifdef SCUMMVERSE_LOCAL_AI
+	using namespace ::Scummverse::WorldCatalog;
+	namespace WorldBridge = ::Scummverse::WorldBridge;
+	if(!_scummverseRoamingReady || !_userPut) return;
+	if(scummverseOnBus()) { scummverseSay(VAR(VAR_EGO),"Let's finish this bus ride first."); return; }
+	const bool zak=scummverseMountZak();
+	if(zak) scummverseInitVisitors();
+	// Maniac Mansion (Dave first) and Zak (Zak first): the characters there,
+	// by their own names (not a look they wear).
+	auto ownName=[&](int id) { return (const char *)getResourceAddress(rtActorName,id); };
+	for(int slot=0;slot<2;++slot) {
+		const int lead=slot ? 24 : 3;
+		Actor *first=derefActor(lead,"character screen lead");
+		const bool here=first->_costume && first->_room && (slot==0 || zak) && !scummverseRemoteActor(lead) && ownName(lead);
+		byte face[64*64*4];
+		if(here) scummverseActorFace(first,face);
+		::scummverseCastGame(slot,slot ? "Zak McKracken" : "Maniac Mansion",slot ? "zak" : "maniac",here ? face : nullptr);
+		if(!here) continue;
+		::scummverseCastMember(slot,ownName(lead),kWorldCastActorRequest+lead);
+		for(int id : mansionCast) {
+			const bool zakPerson=id==24 || scummverseZakGuest(id);
+			if(id==lead || zakPerson!=(slot==1) || scummverseRemoteActor(id)) continue;
+			Actor *a=derefActor(id,"character screen");
+			if(!a->_costume || !a->_room || !ownName(id)) continue;
+			::scummverseCastMember(slot,ownName(id),kWorldCastActorRequest+id);
+		}
+		if(slot==0) for(const auto &look : kWorldManiacCast)
+			::scummverseCastMember(slot,look.name,worldAppearanceRequest(worldAppearanceKey(kWorldManiacLooks,look.costume)));
+	}
+	// Every other game: its lead first, then its cast, once each by name.
+	for(int game=0;game<worldGameCount();++game) {
+		const WorldLead *lead=nullptr;
+		for(const auto &l : kWorldLeads) if(l.game==game) lead=&l;
+		byte face[64*64*4];
+		const Common::Array<byte> frames=lead ? scummverseCharacterFrames(game,lead->costume) : Common::Array<byte>();
+		const bool here=!frames.empty() && WorldBridge::spritePortrait(frames.data(),frames.size(),64,face);
+		::scummverseCastGame(2+game,kWorldGames[game].title,kWorldGames[game].folder,here ? face : nullptr);
+		if(!here) continue;
+		Common::Array<Common::String> named;
+		auto add=[&](int costume,const char *name) {
+			for(const auto &n : named) if(n==name) return;
+			if(costume!=lead->costume && !scummverseCharacterInstalled(game,costume)) return;
+			named.push_back(name);
+			::scummverseCastMember(2+game,name,kWorldCastRequest+worldAppearanceKey(game,costume));
+		};
+		for(const auto &cast : kWorldCast) if(cast.game==game && cast.guest.costume==lead->costume) { add(cast.guest.costume,cast.guest.name); break; }
+		for(const auto &cast : kWorldCast) if(cast.game==game) add(cast.guest.costume,cast.guest.name);
+	}
+	::scummverseCastShow();
+#else
+	scummverseRosterOffer();
+#endif
+}
