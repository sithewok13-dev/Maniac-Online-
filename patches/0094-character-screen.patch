+// A Maniac or Zak character standing, facing ahead, as 64x64 RGBA (drawn by
+// their own costume renderer; no bundled artwork).
+void ScummEngine::scummverseActorFace(Actor *a, byte *rgba) {
+	VirtScreen canvas = {}; canvas.create(320,128,Graphics::PixelFormat::createFormatCLUT8());
+	memset(canvas.getPixels(0,0),255,canvas.pitch*canvas.h);
+	auto cost=a->_cost; int facing=a->getFacing();
+	a->setFacing(180); _scummversePortrait=true;
+	// V1 frames update only their masked limbs. Build a complete pose from the
+	// costume's own frames (initial, standing, closed-mouth head) so actors
+	// that were never on screen are not drawn without heads.
+	for(int frame : {a->_initFrame,a->_standFrame,a->_talkStopFrame})
+		_costumeLoader->costumeDecodeData(a,frame,(uint)-1);
+	const int overlay=scummverseOverlayFrame(a,a->_standFrame);
+	if(overlay>=0) _costumeLoader->costumeDecodeData(a,overlay,(uint)-1);
+	ClassicCostumeRenderer renderer(this); a->prepareDrawActorCostume(&renderer);
+	renderer._actorX=160; renderer._actorY=112; renderer._zbuf=0;
+	renderer.drawCostume(canvas,40,a,false);
+	_scummversePortrait=false; a->setFacing(facing); a->_cost=cost;
+	int left=320,right=0,top=128,bottom=0;
+	for(int y=0;y<128;++y) for(int x=0;x<320;++x) if(*(byte *)canvas.getBasePtr(x,y)!=255) { left=MIN(left,x);right=MAX(right,x);top=MIN(top,y);bottom=MAX(bottom,y); }
+	memset(rgba,0,64*64*4);
+	if(right>=left && bottom>=top) {
+		const int width=right-left+1, height=bottom-top+1;
+		const auto fit=ScummversePresentation::fitPortrait(width,height,64,2);
+		for(int y=0;y<fit.height;++y) for(int x=0;x<fit.width;++x) {
+			int sx=left+x*width/fit.width, sy=top+y*height/fit.height;
+			byte c=*(byte *)canvas.getBasePtr(sx,sy); if(c==255) continue;
+			int o=((fit.y+y)*64+fit.x+x)*4; memcpy(rgba+o,_currentPalette+3*c,3);rgba[o+3]=255;
+		}
+	}
+	canvas.free();
+}
