+// Which build is running (stamped into Info.plist by tools/package_ipa.py)
+// and how many supplied games have other worlds exported for it.
+static NSString *scummverseBuildStatus() {
+	NSString *build = [[NSBundle mainBundle] objectForInfoDictionaryKey:@"SCUMMVERSEBuild"];
+	NSString *documents = NSSearchPathForDirectoriesInDomains(NSDocumentDirectory, NSUserDomainMask, YES).firstObject;
+	NSFileManager *fm = [NSFileManager defaultManager];
+	int folders = 0, exported = 0;
+	for (const auto &game : Scummverse::WorldCatalog::kWorldGames) {
+		BOOL directory = NO;
+		if (![fm fileExistsAtPath:[documents stringByAppendingPathComponent:[NSString stringWithUTF8String:game.folder]] isDirectory:&directory] || !directory) continue;
+		++folders;
+		if ([fm fileExistsAtPath:[NSString stringWithFormat:@"%@/worlds/%s-v%d.svx", documents, game.gameid, Scummverse::WorldCatalog::kWorldExportVersion]]) ++exported;
+	}
+	NSString *worlds = folders ? [NSString stringWithFormat:@"\nOther worlds ready: %d of %d games", exported, folders] : @"";
+	return [NSString stringWithFormat:@"Build: %@%@", build.length ? build : @"development", worlds];
+}
