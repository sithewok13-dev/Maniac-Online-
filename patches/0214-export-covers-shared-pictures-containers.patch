+void Scene::layObjects(const std::vector<bool> &hidden, bool laterOnTop, bool opaque) {
+	const int count = (int)_source.objects.size(), width = _source.width;
+	bool any = _shown;
+	for (int o = 0; o < count && o < (int)hidden.size(); ++o) any = any || hidden[o];
+	if (!any || _loaded.size() != _source.pixels.size()) return;
+	auto at = [&](const World::SourceObject &o, int x, int y) { return (size_t)(o.pictureY + y) * width + o.pictureX + x; };
+	// (The place without them: from the one on top down, each the scene
+	// shows taken away where it differs from its picture without it.)
+	if (_bareOrder != (int)laterOnTop) {
+		_bare = _loaded; _bareOrder = laterOnTop;
+		for (int i = 0; i < count; ++i) {
+			const World::SourceObject &o = _source.objects[laterOnTop ? count - 1 - i : i];
+			if (o.pictures.empty() || o.shown <= 0) continue;
+			for (int y = 0; y < o.pictureHeight; ++y)
+				for (int x = 0; x < o.pictureWidth; ++x) {
+					const size_t k = (size_t)y * o.pictureWidth + x;
+					if (o.pictures[o.shown][k] != o.pictures[0][k]) _bare[at(o, x, y)] = o.pictures[0][k];
+				}
+		}
+	}
+	// (Then each from the one under all up, where its picture now differs
+	// from its picture without it, or all of it.)
+	std::vector<uint8_t> laid = _bare;
+	for (int i = 0; i < count; ++i) {
+		const int object = laterOnTop ? i : count - 1 - i;
+		const World::SourceObject &o = _source.objects[object];
+		const int shown = showing(object);
+		if (o.pictures.empty() || shown <= 0 || shown >= (int)o.pictures.size() || (object < (int)hidden.size() && hidden[object])) continue;
+		for (int y = 0; y < o.pictureHeight; ++y)
+			for (int x = 0; x < o.pictureWidth; ++x) {
+				const size_t k = (size_t)y * o.pictureWidth + x;
+				if (opaque || o.pictures[shown][k] != o.pictures[0][k]) laid[at(o, x, y)] = o.pictures[shown][k];
+			}
+	}
+	// (Written where the objects are, as showObject writes one.)
+	bool changed = false;
+	for (const World::SourceObject &o : _source.objects) {
+		if (o.pictures.empty()) continue;
+		bool here = false;
+		for (int y = 0; y < o.pictureHeight; ++y)
+			for (int x = 0; x < o.pictureWidth; ++x) {
+				const size_t a = at(o, x, y);
+				if (_source.pixels[a] != laid[a]) { _source.pixels[a] = laid[a]; here = true; }
+			}
+		if (!here) continue;
+		changed = true;
+		if (_picture.on) {
+			Picture &p = _picture;
+			for (int y = std::max(p.y, o.pictureY); y < std::min(p.y + p.h, o.pictureY + o.pictureHeight); ++y)
+				for (int x = std::max(p.x, o.pictureX); x < std::min(p.x + p.w, o.pictureX + o.pictureWidth); ++x)
+					p.clean[(size_t)(y - p.y) * p.w + x - p.x] = _source.pixels[(size_t)y * width + x];
+		}
+		rescale(o.pictureX, o.pictureY, o.pictureWidth, o.pictureHeight);
+	}
+	if (changed && _picture.on && _picture.applied) showPicture(_picture.dx, _picture.amount);
+}
