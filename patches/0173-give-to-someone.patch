+int SandboxEngine::personAt(int screenX, int screenY) const {
+	int found = -1, front = -1;
+	for (int n = 0; n < (int)_onStage.size(); ++n) {
+		int x0, y0, x1, y1;
+		if (n == _player || !StageBridge::drawnRect(n, x0, y0, x1, y1)) continue;
+		if (screenX >= x0 && screenX < x1 && screenY >= y0 && screenY < y1 && y1 > front) { front = y1; found = n; }
+	}
+	return found;
+}
+
+void SandboxEngine::giveTo(int person) {
+	const Pair p = _holding;
+	_holding = Pair();
+	PanelBridge::select(-1);
+	const WorldGuest *who = person < (int)_onStage.size() ? worldAppearance(_onStage[person]) : nullptr;
+	Common::String text = pairText(p, -1, -1);
+	if (who) text += Common::String(" ") + who->name;
+	sentence(text);
+	// (Walked up beside them, on the side nearer.)
+	double px, py, x, y;
+	StageBridge::position(person, px, py);
+	StageBridge::position(_player, x, y);
+	const double beside = 24 * screenWidthOf(_game) / 320.0;
+	double tx = px + (x < px ? -beside : beside), ty = py;
+	StageBridge::walkable(tx, ty);
+	_pairing = p;
+	_pairing.person = person;
+	_action = p.kind; _target = -1;
+	StageBridge::walkTo(_player, tx, ty);
+}
