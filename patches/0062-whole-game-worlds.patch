+// The door object `object` of a game's room, or null.
+inline const WorldLink *worldLinkFrom(int game, int room, int object) {
+	const WorldMap *map = worldMap(game);
+	if (map) for (int i = 0; i < map->linkCount; ++i)
+		if (map->links[i].room == room && map->links[i].object == object) return &map->links[i];
