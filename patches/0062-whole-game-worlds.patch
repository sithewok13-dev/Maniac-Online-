+// A door in `room` leading to `target`, or null.
+inline const WorldLink *worldLinkTo(int game, int room, int target) {
+	const WorldMap *map = worldMap(game);
+	if (map) for (int i = 0; i < map->linkCount; ++i)
+		if (map->links[i].room == room && map->links[i].target == target) return &map->links[i];
+	return nullptr;
+}
+// A visitable room's kind (0 scene, 1 map), or -1.
+inline int worldRoomKind(int game, int room) {
+	const WorldMap *map = worldMap(game);
+	if (map) for (int i = 0; i < map->roomCount; ++i) if (map->rooms[i].room == room) return map->rooms[i].kind;
