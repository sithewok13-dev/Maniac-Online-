+static const int kWorldPlaceKeyBase = 10000;
+inline int worldGameCount() { return (int)(sizeof(kWorldGames) / sizeof(kWorldGames[0])); }
+inline int worldPlaceKey(int game, int room) { return kWorldPlaceKeyBase + game * 1000 + room; }
+// A menu request to travel to any place: kWorldPlaceRequest + game * 1024
+// + room (above every scene-bound request, which fits in 21 bits).
+static const int kWorldPlaceRequest = 1 << 24;
+inline int worldPlaceRequest(int game, int room) { return kWorldPlaceRequest + game * 1024 + room; }
+inline bool worldPlaceOfKey(int key, int &game, int &room) {
+	if (key < kWorldPlaceKeyBase) return false;
+	game = (key - kWorldPlaceKeyBase) / 1000; room = (key - kWorldPlaceKeyBase) % 1000;
+	return game < worldGameCount() && room > 0;
+}
