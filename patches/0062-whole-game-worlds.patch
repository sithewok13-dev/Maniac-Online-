+// The player's walk targets in other worlds, in V1 units (before snapping
+// into the walk boxes), so a tap on a door can be told from a tap beside it.
+void ScummEngine::scummverseWorldTap(int actor, int x, int y) {
+	int source;
+	if (!_scummverseRoaming || actor != VAR(VAR_EGO) || scummverseWorldGameOf(_currentRoom, source) < 0) return;
+	_scummverseTapX = x; _scummverseTapY = y; _scummverseTapPending = true;
+}
+
+// Doors: when the player reaches a tapped door (or taps a place on a map),
+// travel to the room it leads to. Games without a door map keep the side
+// exits between named places.
+void ScummEngine::scummverseWorldDoors() {
+	int source;
+	const int gameIndex = scummverseWorldGameOf(_currentRoom, source);
+	if (gameIndex < 0 || !WorldBridge::mounted()) return;
+	if (!worldMap(gameIndex)) { scummverseWorldEdges(); return; }
+	Actor *player = derefActor(VAR(VAR_EGO), "door walker");
+	// Some converted box layouts make the V1 walker step back and forth;
+	// a walk without progress for about a second ends where it is.
+	if (player->_moving) {
+		const Common::Point at = player->getRealPos();
+		if (at == _scummverseWalkPos) { if (++_scummverseWalkStill > 60) { player->stopActorMoving(); _scummverseWalkStill = 0; } }
+		else { _scummverseWalkPos = at; _scummverseWalkStill = 0; }
+	} else _scummverseWalkStill = 0;
+	if (!_scummverseTapPending) return;
+	const bool map = worldRoomKind(gameIndex, source) == 1 || getNumBoxes() == 0;
+	if (!map && player->_moving) return;
+	_scummverseTapPending = false;
+	const int px = _scummverseTapX * 8 + 4, py = _scummverseTapY * 2;
+	const int ax = player->getRealPos().x, ay = player->getRealPos().y;
+	// The smallest door under the tap wins (doors can overlap big hotspots).
+	const WorldLink *best = nullptr; long bestArea = 0;
+	for (int i = 0; i < WorldBridge::objectCount(); ++i) {
+		int id, x, y, w, h, wx, wy;
+		WorldBridge::object(i, id, x, y, w, h, wx, wy);
+		const WorldLink *link = worldLinkFrom(gameIndex, source, id);
+		if (!link || px < x - 4 || px >= x + w + 4 || py < y - 4 || py >= y + h + 4) continue;
+		// On foot, the player must have reached the door: as near as the walk
+		// boxes allow to the tap or to the door's walk-to point.
+		bool there = map;
+		if (!there) {
+			const AdjustBoxResult tap = player->adjustXYToBeInBox(_scummverseTapX, _scummverseTapY);
+			const AdjustBoxResult walk = player->adjustXYToBeInBox(wx, wy);
+			there = (ABS(ax - tap.x) <= 2 && ABS(ay - tap.y) <= 4) || (ABS(ax - walk.x) <= 3 && ABS(ay - walk.y) <= 6);
+		}
+		if (!there || (best && (long)w * h >= bestArea)) continue;
+		best = link; bestArea = (long)w * h;
+	}
+	if (best) scummverseFollowLink(gameIndex, source, best->target, best->arrival);
+}
+
+// Through a door: arrive at the named object, else at the target's door
+// back, else at the scene's arrival point.
+bool ScummEngine::scummverseFollowLink(int game, int from, int target, int arrival) {
+	const int room = scummverseWorldRoomFor(game, target);
+	if (!room || !scummverseMountWorld(room)) {
+		scummverseWorldReport(_scummverseWorldNotice.c_str());
+		scummverseSay(VAR(VAR_EGO), "That way isn't installed yet. Export the game again.");
+		return false;
+	}
+	if (!arrival) if (const WorldLink *back = worldLinkTo(game, target, from)) arrival = back->object;
+	int x = -1, y = -1;
+	for (int i = 0; arrival && i < WorldBridge::objectCount(); ++i) {
+		int id, ox, oy, w, h, wx, wy;
+		if (WorldBridge::object(i, id, ox, oy, w, h, wx, wy) && id == arrival) { x = wx; y = wy; }
+	}
+	return scummverseTravelWorld(room, x, y);
+}
+
+// Saves from patches 0057..0060 hold places as rooms 200..255: move every
+// actor there into the slot room for the same place.
+void ScummEngine::scummverseMigrateWorldRooms() {
+	const int legacy = (int)ARRAYSIZE(kWorldLegacyPlaces);
+	for (int id = 1; id < _numActors; ++id) {
+		Actor *a = _actors[id];
+		const int index = a->_room - kWorldLegacyRoom;
+		if (a->_room < kWorldLegacyRoom || index >= legacy) continue;
+		const int room = scummverseWorldRoomFor(kWorldLegacyPlaces[index].game, kWorldLegacyPlaces[index].room);
+		const bool viewed = _currentRoom == a->_room;
+		a->_room = room;
+		if (viewed) _currentRoom = room;
+	}
+	if (_currentRoom >= kWorldLegacyRoom && _currentRoom - kWorldLegacyRoom < legacy) {
+		// Nobody stood in the viewed place; still reopen it.
+		const WorldLegacyPlace &place = kWorldLegacyPlaces[_currentRoom - kWorldLegacyRoom];
+		_currentRoom = scummverseWorldRoomFor(place.game, place.room);
+	}
+	_scummVars[kWorldLayoutVar] = 1;
+}
