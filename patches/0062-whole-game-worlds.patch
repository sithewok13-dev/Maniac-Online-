+// The door map of a game, or null when it has none.
+inline const WorldMap *worldMap(int game) {
+	if (game < 0 || game >= worldGameCount() || game >= (int)(sizeof(kWorldMaps) / sizeof(kWorldMaps[0]))) return nullptr;
