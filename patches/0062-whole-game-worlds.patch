+// SPDX-License-Identifier: GPL-3.0-or-later
+// SCUMMVERSE other worlds: which rooms of each game can be visited and how
+// their doors connect, for the audited editions (room and object numbers
+// only; generated from private analysis of those editions' object scripts,
+// tools/world_maps.py). Plain C++ (no library headers). See
+// scummverse_world_catalog.h for the games' order.
+#ifndef COMMON_SCUMMVERSE_WORLD_MAPS_H
+#define COMMON_SCUMMVERSE_WORLD_MAPS_H
+namespace Scummverse {
+namespace WorldCatalog {
+
+// A door: object `object` in `room` leads to `target`; the traveller arrives
+// at object `arrival` there (0: at the target's door back to `room`, else at
+// the scene's arrival point).
+struct WorldLink { short room, object, target, arrival; };
+// kind: 0 a walkable scene, 1 a map whose hotspots travel directly.
+struct WorldRoom { short room; unsigned char kind; };
+// An entrance to a part of the game its story reaches without doors (a
+// voyage, a ride, a cutscene), named for the menu.
+struct WorldArea { short room; const char *name; };
+struct WorldMap {
+	const WorldRoom *rooms; int roomCount;
+	const WorldLink *links; int linkCount;
+	const WorldArea *areas; int areaCount;
+};
+
+#include "common/scummverse_world_maps.inc"
+
+} // End of namespace WorldCatalog
+} // End of namespace Scummverse
+#endif
