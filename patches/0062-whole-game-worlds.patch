 #define COMMON_SCUMMVERSE_WORLD_CATALOG_H
 namespace Scummverse {
 namespace WorldCatalog {
-// Characters from the same game, shown in their scenes through sandbox guest
+// Characters from the same game, shown in their rooms through sandbox guest
 // actors. Costume numbers refer to the audited editions (matched to names in
-// each game's own scripts where it has them); frames are exported from the
-// player's copy. Personalities and lines are newly authored, not original
-// script text. talkColor is a V1 palette index.
+// each game's own scripts and dialogue where it has them); frames are
+// exported from the player's copy. Personalities and lines are newly
+// authored, not original script text. talkColor is a V1 palette index. The
+// cast is generated (tools/world_cast.py, scummverse_world_cast.inc).
 struct WorldGuest {
 	int costume; const char *name, *personality; int talkColor;
 	const char *lines[3];
 };
 static const int kWorldMaxGuests = 5;
-struct WorldScene { int room; const char *name; const WorldGuest *guests[kWorldMaxGuests]; };
-// Scenes are sandbox logical rooms 200..255 (one-byte room numbers), so the
-// catalog holds at most 56; existing scenes keep their order so saves made
-// inside them stay valid. New games are appended.
-static const int kWorldMaxScenes = 56;
+// A named place: a room of the game listed in the Worlds menu.
+struct WorldScene { int room; const char *name; };
+// A character placed in a room of a game (slot 0..kWorldMaxGuests-1).
+struct WorldCastGuest { short game, room, slot; WorldGuest guest; };
+// Named places shown in the menu. Games only ever append (their index names
+// places in saves); any exported room of a game can be visited.
 // Bumped when the catalog's scenes or characters change, so installed games
 // export once more (marker "<gameid>-v<version>.svx").
-static const int kWorldExportVersion = 2;
+static const int kWorldExportVersion = 3;
 struct WorldGame {
 	const char *gameid, *title, *folder; int version;
 	const WorldScene *scenes; int sceneCount;
 };
