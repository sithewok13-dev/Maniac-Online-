+// Player text for V1 speech bubbles: printable ASCII, each other UTF-8
+// character becomes one '?', and renderer-sensitive bytes become spaces.
+static std::string speechText(const std::string &raw) {
+	std::string out;
+	for (unsigned char c : normalizeTypography(raw)) {
+		if (c >= 0x80) { if (c >= 0xC0) out += '?'; continue; }
+		out += (c < 32 || c == 127 || c == '<' || c == '>' || c == '{' || c == '}' || c == '@' || c == '^') ? ' ' : (char)c;
+	}
+	return out;
+}
