+// SPDX-License-Identifier: GPL-3.0-or-later
+// Scummverse portable conversation contract v1.
+// Owns one shared conversation: an ordered transcript with stable line IDs, a
+// bounded outbox for player messages, and reply scheduling across participants.
+// No threads, models, UI, network or game state; callers serialize access.
+// Reply providers (local model, classic lines, a future server) stay outside.
+#ifndef COMMON_SCUMMVERSE_CONVERSATION_H
+#define COMMON_SCUMMVERSE_CONVERSATION_H
+#include <cstdint>
+#include <deque>
+#include <string>
+#include <vector>
+
+namespace Scummverse {
+
+enum class LineKind { Player, Reply, Classic };
+
+struct ConversationLine {
+	uint32_t id;       // Monotonic within a conversation; never reused.
+	int speaker;       // 0 is the player; 1..31 are participant IDs.
+	LineKind kind;     // Classic marks authored fallback lines, not model output.
+	std::string text;
+};
+
+struct ReplyJob {
+	uint32_t ticket;   // Must be returned to complete(); stale tickets are ignored.
+	int speaker;
+};
+
+class Conversation {
+public:
+	static const size_t kMaxQueued = 3;          // Waiting player messages.
+	static const size_t kMaxLines = 60;          // Bounded visible transcript.
+	static const size_t kRepliesPerMessage = 2;  // At most two NPCs answer.
+	static const size_t kMaxText = 512;
+
+	// Starts a fresh conversation; IDs continue increasing across resets so a
+	// stale reader can never mistake a new line for one it already consumed.
+	void reset(unsigned participants = 0) {
+		_participants = participants & ~1u; _lines.clear(); _outbox.clear();
+		_speakers.clear(); _inFlight = ReplyJob{0, 0}; _lastLead = 0; ++_revision;
+	}
+	unsigned participants() const { return _participants; }
+
+	// Returns true when the in-flight reply's speaker left and was cancelled.
+	// Lines already spoken by departed characters remain in the transcript.
+	bool setParticipants(unsigned mask) {
+		mask &= ~1u;
+		if (mask == _participants) return false;
+		_participants = mask; ++_revision;
+		std::deque<int> kept;
+		for (int id : _speakers) if (present(id)) kept.push_back(id);
+		_speakers.swap(kept);
+		if (_inFlight.ticket && !present(_inFlight.speaker)) { _inFlight = ReplyJob{0, 0}; return true; }
+		return false;
+	}
+
+	// Accepts a message even while replies are pending. Rejection (no one to
+	// talk to, blank, oversized or a full outbox) changes nothing.
+	bool submit(const std::string &text) {
+		if (!_participants || text.size() > kMaxText || _outbox.size() >= kMaxQueued) return false;
+		if (text.find_first_not_of(' ') == std::string::npos) return false;
+		_outbox.push_back(text); ++_revision;
+		return true;
+	}
+
+	// Starts the next reply if none is in flight. Delivers the next waiting
+	// player message into the transcript only after earlier replies finished.
+	bool nextJob(ReplyJob &job) {
+		if (_inFlight.ticket) return false;
+		while (_speakers.empty()) {
+			if (_outbox.empty()) return false;
+			append(0, LineKind::Player, _outbox.front()); _outbox.pop_front();
+			scheduleSpeakers();
+		}
+		_inFlight = ReplyJob{++_nextTicket, _speakers.front()}; _speakers.pop_front();
+		job = _inFlight; ++_revision; return true;
+	}
+
+	// Records a reply. An empty model reply uses the classic line instead;
+	// if both are empty the turn passes silently. Stale tickets change nothing.
+	bool complete(uint32_t ticket, const std::string &reply, const std::string &classic) {
+		if (!ticket || ticket != _inFlight.ticket) return false;
+		const int speaker = _inFlight.speaker; _inFlight = ReplyJob{0, 0};
+		if (!reply.empty()) append(speaker, LineKind::Reply, reply);
+		else if (!classic.empty()) append(speaker, LineKind::Classic, classic);
+		else ++_revision;
+		return true;
+	}
+
+	bool replying() const { return _inFlight.ticket != 0; }
+	int replyingSpeaker() const { return _inFlight.speaker; }
+	bool busy() const { return _inFlight.ticket || !_speakers.empty() || !_outbox.empty(); }
+	const std::deque<std::string> &outbox() const { return _outbox; }
+	const std::deque<ConversationLine> &lines() const { return _lines; }
+	uint32_t revision() const { return _revision; }
+
+	// Most recent model-visible lines, oldest first. Classic fallback lines are
+	// excluded so authored filler never becomes a model's "memory".
+	std::vector<ConversationLine> context(size_t maximum) const {
+		std::vector<ConversationLine> result;
+		for (auto it = _lines.rbegin(); it != _lines.rend() && result.size() < maximum; ++it)
+			if (it->kind != LineKind::Classic) result.insert(result.begin(), *it);
+		return result;
+	}
+
+private:
+	bool present(int id) const { return id > 0 && id < 32 && (_participants & (1u << id)); }
+	void append(int speaker, LineKind kind, const std::string &text) {
+		_lines.push_back(ConversationLine{++_nextId, speaker, kind, text});
+		while (_lines.size() > kMaxLines) _lines.pop_front();
+		++_revision;
+	}
+	// Rotate the leading speaker so every participant gets a turn to answer.
+	void scheduleSpeakers() {
+		std::vector<int> roster;
+		for (int id = 1; id < 32; ++id) if (present(id)) roster.push_back(id);
+		if (roster.empty()) return;
+		size_t start = 0;
+		while (start < roster.size() && roster[start] <= _lastLead) ++start;
+		if (start == roster.size()) start = 0;
+		_lastLead = roster[start];
+		for (size_t n = 0; n < kRepliesPerMessage && n < roster.size(); ++n)
+			_speakers.push_back(roster[(start + n) % roster.size()]);
+	}
+
+	unsigned _participants = 0;
+	std::deque<ConversationLine> _lines;
+	std::deque<std::string> _outbox;
+	std::deque<int> _speakers;
+	ReplyJob _inFlight{0, 0};
+	uint32_t _nextId = 0, _nextTicket = 0, _revision = 0;
+	int _lastLead = 0;
+};
+
+}
+#endif
