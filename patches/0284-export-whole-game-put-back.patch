+// From 0284, a check of the export, for the tests and never a player's
+// (scummverse_export_order=reversed): each loop of runs played in the
+// opposite order, the next runs an answer asks for last asked first. Every
+// run starts from the game put back whole, so its records are the same
+// either way (tools/test_world_setup.py compares them).
+static bool scummverseExportReversed() {
+	return ConfMan.hasKey("scummverse_export_order") && ConfMan.get("scummverse_export_order") == "reversed";
+}
+// From 0284, in the mansion's runs, a script its answer starts that then
+// waits a minute or more of its game's clock (its ticks, 60 a second) is its
+// game's timed event, not the answer: left waiting, as the run's other
+// waits are not. The fridge opened first: Ed hungry a minute later, if he is
+// in his room then (script 87); the tap turned on likewise. Before, played
+// out only where the runs before had moved him elsewhere, it was not.
+static const int kScummverseClockWait = 3600;
+// (In a loop of `count` runs, the n-th played: the n-th, or the n-th from
+// the end.)
+static uint scummverseRunAt(uint n, uint count, bool reversed) { return reversed ? count - 1 - n : n; }
+// (What a loop so played added to `list` from `first` on put in the order
+// its runs have played forwards: `order`, each one's place in that.)
+template<class T> static void scummverseRunOrder(Common::Array<T> &list, uint first, const Common::Array<uint32> &order) {
+	Common::Array<uint> at;
+	for (uint i = 0; i < order.size() && first + i < list.size(); ++i) at.push_back(i);
+	Common::sort(at.begin(), at.end(), [&](uint a, uint b) { return order[a] != order[b] ? order[a] < order[b] : a < b; });
+	Common::Array<T> sorted;
+	for (uint i : at) sorted.push_back(list[first + i]);
+	for (uint i = 0; i < sorted.size(); ++i) list[first + i] = sorted[i];
+}
+
+// From 0284, the game as the export found it, put back whole before each
+// of its runs (scummverseRestore). Before, a run's put-back was only the
+// variables, the things' pictures, owners and classes and what was carried
+// (and some arrays and verbs), so a run found the game as the runs before
+// it had left it in everything else, and what it recorded depended on
+// which ran before it: everyone (where they are, their clothes, walk,
+// frames, talk colour and all else a save keeps of them), the code of what
+// is carried, the arrays' and the verbs' contents, the texts' settings, the
+// scale slots, the camera, a cut-scene's way out, the palette, the pointer
+// and the player's hold on the game. (Zak's room 4: every other run there
+// arrived in room 16, its kid where the run before had put him.) What a
+// place's arrival sets up again (its things there, walk boxes and scripts)
+// is its own.
+struct ScummEngine::ScummverseKept {
+	Common::Array<int32> vars, roomVars;
+	Common::Array<byte> bits, states, owners, objectRooms;
+	Common::Array<uint32> classes;
+	Common::Array<uint16> inventory;
+	// (The arrays, the verbs' names and pictures, and the code of what is
+	// carried: each one's bytes, and whether it is made.)
+	Common::Array<Common::Array<byte> > resources[3];
+	Common::Array<bool> made[3];
+	Common::Array<VerbSlot> verbs;
+	// (Everyone as a save keeps them; their colours 6 to 8 apart, which
+	// reading an older edition's save may swap: Actor::saveLoadWithSerializer.)
+	Common::Array<byte> actors;
+	Common::Array<uint16> actorColors;
+	Common::Array<bool> actorRedraws;
+	StringTab strings[6];
+	ScaleSlot scaleSlots[20];
+	CameraData camera;
+	int screenStartStrip = 0, screenEndStrip = 0;
+	byte charsetColor = 0, charsetColorMap[16] = {}, resourceMapper[128] = {}, palette[3 * 256] = {};
+	Common::Array<byte> shadowPalette;
+	byte userPut = 0, cursorState = 0, actorToPrintStrFor = 0, v1TalkingActor = 0, haveMsg = 0; uint16 userState = 0; int16 talkDelay = 0;
+	bool keepText = false, useTalkAnims = false, haveActorSpeechMsg = false;
+};
+// (Any version past the newest save's: everything the newest saves keep.)
+static const Common::Serializer::Version kScummverseKeptVersion = 0xFFFF;
+static const ResType kScummverseKeptResources[3] = {rtString, rtVerb, rtInventory};
+
+void ScummEngine::scummverseKeep(ScummverseKept &k) {
+	k.vars = Common::Array<int32>(_scummVars, _numVariables);
+	k.roomVars = Common::Array<int32>(_roomVars, _roomVars ? _numRoomVariables : 0);
+	k.bits = Common::Array<byte>(_bitVars, _numBitVariables >> 3);
+	k.states = Common::Array<byte>(_objectStateTable, _numGlobalObjects);
+	k.owners = Common::Array<byte>(_objectOwnerTable, _numGlobalObjects);
+	k.objectRooms = Common::Array<byte>(_objectRoomTable, _objectRoomTable ? _numGlobalObjects : 0);
+	k.classes = Common::Array<uint32>(_classData, _numGlobalObjects);
+	k.inventory = Common::Array<uint16>(_inventory, _numInventory);
+	for (int t = 0; t < 3; ++t) {
+		const ResType type = kScummverseKeptResources[t];
+		const int count = _res->_types[type].size();
+		k.resources[t].clear(); k.resources[t].resize(count);
+		k.made[t] = Common::Array<bool>(count, false);
+		for (int i = 0; i < count; ++i)
+			if (_res->isResourceLoaded(type, i)) { k.made[t][i] = true; k.resources[t][i] = Common::Array<byte>(_res->_types[type][i]._address, _res->_types[type][i]._size); }
+	}
+	k.verbs = Common::Array<VerbSlot>(_verbs, _numVerbs);
+	Common::MemoryWriteStreamDynamic out(DisposeAfterUse::YES);
+	Common::Serializer save(nullptr, &out);
+	save.setVersion(kScummverseKeptVersion);
+	k.actorColors.clear(); k.actorRedraws.clear();
+	for (int n = 0; n < _numActors; ++n) {
+		_actors[n]->saveLoadWithSerializer(save);
+		for (int c = 6; c <= 8; ++c) k.actorColors.push_back(_actors[n]->scummversePalette(c));
+		k.actorRedraws.push_back(_actors[n]->_needRedraw);
+	}
+	k.actors = Common::Array<byte>(out.getData(), out.size());
+	for (int i = 0; i < 6; ++i) k.strings[i] = _string[i];
+	for (int i = 0; i < 20; ++i) k.scaleSlots[i] = _scaleSlots[i];
+	k.camera = camera; k.screenStartStrip = _screenStartStrip; k.screenEndStrip = _screenEndStrip;
+	k.charsetColor = _charsetColor;
+	memcpy(k.charsetColorMap, _charsetColorMap, sizeof(k.charsetColorMap));
+	memcpy(k.resourceMapper, _resourceMapper, sizeof(k.resourceMapper));
+	memcpy(k.palette, _currentPalette, sizeof(k.palette));
+	k.shadowPalette = Common::Array<byte>(_shadowPalette, _shadowPalette ? _shadowPaletteSize : 0);
+	k.userPut = _userPut; k.userState = _userState; k.cursorState = _cursor.state;
+	k.actorToPrintStrFor = _actorToPrintStrFor; k.v1TalkingActor = _V1TalkingActor; k.haveMsg = _haveMsg; k.talkDelay = _talkDelay;
+	k.keepText = _keepText; k.useTalkAnims = _useTalkAnims; k.haveActorSpeechMsg = _haveActorSpeechMsg;
+}
+
+void ScummEngine::scummverseRestore(const ScummverseKept &k) {
+	// (Everyone first: an actor read back clears its class, put back below.)
+	Common::MemoryReadStream in(k.actors.data(), k.actors.size());
+	Common::Serializer load(&in, nullptr);
+	load.setVersion(kScummverseKeptVersion);
+	for (int n = 0; n < _numActors && 3 * n + 2 < (int)k.actorColors.size(); ++n) {
+		_actors[n]->saveLoadWithSerializer(load);
+		for (int c = 6; c <= 8; ++c) _actors[n]->setPalette(c, k.actorColors[3 * n + c - 6]);
+		_actors[n]->_needRedraw = k.actorRedraws[n];
+	}
+	// (An empty copy is none: nothing to copy, from 0271 and 0278.)
+	if (!k.vars.empty()) memcpy(_scummVars, k.vars.data(), k.vars.size() * sizeof(int32));
+	if (_roomVars && !k.roomVars.empty()) memcpy(_roomVars, k.roomVars.data(), k.roomVars.size() * sizeof(int32));
+	if (!k.bits.empty()) memcpy(_bitVars, k.bits.data(), k.bits.size());
+	if (!k.states.empty()) memcpy(_objectStateTable, k.states.data(), k.states.size());
+	if (!k.owners.empty()) memcpy(_objectOwnerTable, k.owners.data(), k.owners.size());
+	if (_objectRoomTable && !k.objectRooms.empty()) memcpy(_objectRoomTable, k.objectRooms.data(), k.objectRooms.size());
+	if (!k.classes.empty()) memcpy(_classData, k.classes.data(), k.classes.size() * sizeof(uint32));
+	if (!k.inventory.empty()) memcpy(_inventory, k.inventory.data(), k.inventory.size() * sizeof(uint16));
+	for (int t = 0; t < 3; ++t) {
+		const ResType type = kScummverseKeptResources[t];
+		for (int i = 0; i < (int)_res->_types[type].size() && i < (int)k.made[t].size(); ++i) {
+			const Common::Array<byte> &bytes = k.resources[t][i];
+			if (_res->isResourceLoaded(type, i) && (!k.made[t][i] || _res->_types[type][i]._size != bytes.size())) _res->nukeResource(type, i);
+			if (!k.made[t][i] || bytes.empty()) continue;
+			byte *to = _res->isResourceLoaded(type, i) ? _res->_types[type][i]._address : _res->createResource(type, i, bytes.size());
+			memcpy(to, bytes.data(), bytes.size());
+		}
+	}
+	for (int i = 0; i < _numVerbs && i < (int)k.verbs.size(); ++i) _verbs[i] = k.verbs[i];
+	for (int i = 0; i < 6; ++i) _string[i] = k.strings[i];
+	for (int i = 0; i < 20; ++i) _scaleSlots[i] = k.scaleSlots[i];
+	camera = k.camera; _screenStartStrip = k.screenStartStrip; _screenEndStrip = k.screenEndStrip;
+	_charsetColor = k.charsetColor;
+	memcpy(_charsetColorMap, k.charsetColorMap, sizeof(k.charsetColorMap));
+	memcpy(_resourceMapper, k.resourceMapper, sizeof(k.resourceMapper));
+	memcpy(_currentPalette, k.palette, sizeof(k.palette));
+	if (_shadowPalette && !k.shadowPalette.empty()) memcpy(_shadowPalette, k.shadowPalette.data(), k.shadowPalette.size());
+	// (No cut-scene, and none to leave: a run starts with nothing running,
+	// where its start may have been in one, so its way out is not kept.)
+	vm.cutSceneStackPointer = 0; vm.cutSceneScriptIndex = 0;
+	memset(vm.cutSceneScript, 0, sizeof(vm.cutSceneScript)); memset(vm.cutScenePtr, 0, sizeof(vm.cutScenePtr)); memset(vm.cutSceneData, 0, sizeof(vm.cutSceneData));
+	_userPut = k.userPut; _userState = k.userState; _cursor.state = k.cursorState;
+	_actorToPrintStrFor = k.actorToPrintStrFor; _V1TalkingActor = k.v1TalkingActor; _haveMsg = k.haveMsg; _talkDelay = k.talkDelay;
+	_keepText = k.keepText; _useTalkAnims = k.useTalkAnims; _haveActorSpeechMsg = k.haveActorSpeechMsg;
+}
