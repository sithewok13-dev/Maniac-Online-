+// Two things (from 0170): Give, Use with a thing carried first; Unlock and
+// Fix (the oldest games' "with") with one here first. Only with the panel
+// under the scene (the others' pointers and coins as before).
+bool SandboxEngine::twoThings(int kind, bool carried) const {
+	if (!PanelBridge::loaded() || PanelBridge::over() || PanelBridge::distaff() || PanelBridge::coin()) return false;
+	if (kind == kWorldVerbGive || kind == kWorldVerbUse) return carried;
+	return (kind == kWorldVerbUnlock || kind == kWorldVerbFix) && !carried;
+}
+
+void SandboxEngine::hold(int kind, int verb, int item, int thing) {
+	_holding.kind = kind; _holding.verb = verb; _holding.item = item; _holding.thing = thing;
+	_action = 0; _target = -1; _pairing = Pair();
+	// (Its verb stays lit until the second is chosen.)
+	PanelBridge::select(verb);
+	sentence(pairText(_holding, -1, -1));
+	_dirty = true;
+}
+
+void SandboxEngine::letGo() {
+	_holding = Pair(); _pairing = Pair();
+	PanelBridge::select(-1);
+	sentence("");
+	_dirty = true;
+}
+
+// "Use the key with", then "Use the key with the door".
+Common::String SandboxEngine::pairText(const Pair &p, int item, int thing) const {
+	char verbName[40], first[80] = "", second[80] = "";
+	PanelBridge::verbName(p.verb, verbName, sizeof(verbName));
+	if (p.item >= 0) PanelBridge::itemName(p.item, first, sizeof(first));
+	else if (p.thing >= 0) StageBridge::objectName(p.thing, first, sizeof(first));
+	if (item >= 0) PanelBridge::itemName(item, second, sizeof(second));
+	else if (thing >= 0) StageBridge::objectName(thing, second, sizeof(second));
+	Common::String text = Common::String::format("%s %s %s", verbName, first, p.kind == kWorldVerbGive ? "to" : "with");
+	if (*second) text += Common::String(" ") + second;
+	return text;
+}
+
+void SandboxEngine::pairWith(int item, int thing) {
+	const Pair p = _holding;
+	_holding = Pair();
+	PanelBridge::select(-1);
+	// (The same thing twice: nothing.)
+	if ((item >= 0 && item == p.item) || (thing >= 0 && thing == p.thing)) { sentence(""); return; }
+	sentence(pairText(p, item, thing));
+	// (Walked to the one here, if either is; two carried, at once.)
+	const int here = p.thing >= 0 ? p.thing : thing;
+	if (here < 0) { pairUp(p.kind, -1, p.item >= 0 ? p.item : item, item >= 0 && p.item >= 0 ? item : -1); return; }
+	_pairing = p;
+	_pairing.item = p.item >= 0 ? p.item : item;
+	_pairing.thing = p.thing >= 0 && thing >= 0 ? thing : -1;
+	_action = p.kind; _target = here;
+	double tx, ty;
+	doorPoint(here, tx, ty);
+	StageBridge::walkTo(_player, tx, ty);
+}
+
+// What two things do together: as their game's script, where it is known
+// (the mansion's, later); else the plain rules: it doesn't work.
+void SandboxEngine::pairUp(int kind, int target, int item, int other) {
+	(void)target; (void)item; (void)other;
+	sentence("");
+	say(kind == kWorldVerbGive ? "I don't think they want it." : "That doesn't seem to work.");
+	if (!_testing) saveState();
+}
