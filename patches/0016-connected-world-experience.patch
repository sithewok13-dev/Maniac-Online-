+	CGRect areas[]={CGRectMake(42,50,238,26),CGRectMake(42,80,238,26),CGRectMake(43,143,72,30),CGRectMake(214,143,67,30)};
+	for (int i=0;i<4;++i) { CGRect r=areas[i]; [_panel viewWithTag:i+1].frame=CGRectMake(r.origin.x*scale,r.origin.y*scale,r.size.width*scale,r.size.height*scale); }
