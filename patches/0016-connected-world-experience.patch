+void ScummEngine::scummverseCompanionCommand(int command) {
+	int id = command >= 96 ? command - 96 : command - 64;
+	bool allowed = id == 24 || id == 23 || id == 14 || id == 13 || id == 11 || id == 10 || id == 9 || (id >= 1 && id <= 7);
+	if (!allowed || id == VAR(VAR_EGO) || (id == 24 && !_scummVars[760])) return;
+	Actor *a = derefActor(id, "companion request");
+	if (a->_room != _currentRoom) return;
+	_scummVars[770 + id] = command >= 96 ? 0 : VAR(VAR_EGO);
+	a->stopActorMoving(); _scummverseRoamers[id] = Roamer();
+	scummverseSay(id, command >= 96 ? "See you around!" : "I'll come with you.");
+}
+void ScummEngine::scummverseUpdateCompanions() {
+	int ego = VAR(VAR_EGO);
+	if (ego < 1 || ego > 7) return;
+	Actor *player = derefActor(ego, "companion leader");
+	unsigned companions = 0;
+	bool arrival = _scummverseCompanionRoom > 0 && _scummverseCompanionEgo == ego && _scummverseCompanionRoom != _currentRoom;
+	if (arrival) { _scummVars[740 + ego] = _scummverseCompanionRoom; _scummVars[750 + ego] = 0; }
+	for (int id : mansionCast) {
+		if (id == ego || _scummVars[770 + id] != ego || (id == 24 && !_scummVars[760])) continue;
+		Actor *a = derefActor(id, "companion");
+		companions |= 1u << id;
+		if (a->_room != _currentRoom) {
+			// Carry companions through the same discrete room transition as the player.
+			a->stopActorMoving();
+			AdjustBoxResult point = player->adjustXYToBeInBox(player->getRealPos().x + (id % 3 - 1) * 2, player->getRealPos().y);
+			a->putActor(point.x, point.y, _currentRoom); a->startAnimActor(a->_standFrame);
+			_scummverseRoamers[id] = Roamer();
+		}
+		if (arrival) _scummVars[750 + ego] |= 1u << id;
+	}
+	_scummverseCompanionRoom = _currentRoom; _scummverseCompanionEgo = ego;
+	scummverseTravelScene(_currentRoom, ego, companions, _scummVars[740 + ego], _scummVars[750 + ego]);
+}
