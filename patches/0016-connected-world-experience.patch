+static NSString *scummverseInstalledWorlds() {
+	NSString *path = [NSString stringWithUTF8String:iOS7_getZakDirectory().c_str()];
+	NSFileManager *fm = [NSFileManager defaultManager];
+	NSDictionary *required = @{@"00.LFL":@"7020931d5a2be0a49d68e7a1882363e4", @"01.LFL":@"2e30571757edc1cd0f2a450ba5c89153", @"03.LFL":@"25a9e059a9df572554ee8ceffc08cb9f", @"08.LFL":@"5337090e7a6ebdbfb698ebda3750d926"};
+	NSArray *names = [fm contentsOfDirectoryAtPath:path error:nil];
+	for (NSString *key in required) {
+		NSString *actual = nil;
+		for (NSString *name in names) if ([name caseInsensitiveCompare:key] == NSOrderedSame) { actual=name; break; }
+		if (!actual) return @"Maniac Mansion: installed\nZak: import game files";
+		NSString *file = [path stringByAppendingPathComponent:actual];
+		unsigned long long size = [[fm attributesOfItemAtPath:file error:nil][NSFileSize] unsignedLongLongValue];
+		if (size < 2 || size > 65535) return @"Maniac Mansion: installed\nZak: files need checking";
+		NSData *data = [NSData dataWithContentsOfFile:file];
+		if (!data) return @"Maniac Mansion: installed\nZak: files unreadable";
+		unsigned char digest[CC_MD5_DIGEST_LENGTH]; CC_MD5(data.bytes,(CC_LONG)data.length,digest);
+		NSMutableString *hash = [NSMutableString string]; for (int i=0;i<CC_MD5_DIGEST_LENGTH;++i) [hash appendFormat:@"%02x",digest[i]];
+		if (![hash isEqualToString:required[key]]) return @"Maniac Mansion: installed\nZak: unsupported edition";
+	}
+	return @"Maniac Mansion: installed\nZak: installed";
+}
