+	scummversePixelText(c,"FREE TRAVEL",126,122,1,UIColor.whiteColor);
+	CGContextSetFillColorWithColor(c,UIColor.blackColor.CGColor); CGContextFillRect(c,CGRectMake(49,153,62,12)); CGContextFillRect(c,CGRectMake(222,153,55,12));
+	CGContextSetFillColorWithColor(c,[UIColor colorWithRed:0 green:0.8 blue:0 alpha:1].CGColor); CGContextFillRect(c,CGRectMake(47,151,62,12));
+	CGContextSetFillColorWithColor(c,UIColor.redColor.CGColor); CGContextFillRect(c,CGRectMake(220,151,55,12));
