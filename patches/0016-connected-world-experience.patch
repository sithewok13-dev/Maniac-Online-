+// Pixel destination computer. GPL-3.0-or-later; no original game assets.
+static void scummversePixelText(CGContextRef context, const char *text, int x, int y, int scale, UIColor *color) {
+	static const byte glyphs[26][7] = {
+		{14,17,17,31,17,17,17},{30,17,17,30,17,17,30},{14,17,16,16,16,17,14},{30,17,17,17,17,17,30},
+		{31,16,16,30,16,16,31},{31,16,16,30,16,16,16},{14,17,16,23,17,17,15},{17,17,17,31,17,17,17},
+		{31,4,4,4,4,4,31},{7,2,2,2,18,18,12},{17,18,20,24,20,18,17},{16,16,16,16,16,16,31},
+		{17,27,21,21,17,17,17},{17,25,21,19,17,17,17},{14,17,17,17,17,17,14},{30,17,17,30,16,16,16},
+		{14,17,17,17,21,18,13},{30,17,17,30,20,18,17},{15,16,16,14,1,1,30},{31,4,4,4,4,4,4},
+		{17,17,17,17,17,17,14},{17,17,17,17,17,10,4},{17,17,17,21,21,21,10},{17,17,10,4,10,17,17},
+		{17,17,10,4,4,4,4},{31,1,2,4,8,16,31}
+	};
+	CGContextSetFillColorWithColor(context, color.CGColor);
+	for (; *text; ++text, x += 6 * scale) {
+		if (*text < 'A' || *text > 'Z') continue;
+		for (int row=0; row<7; ++row) for (int col=0; col<5; ++col)
+			if (glyphs[*text-'A'][row] & (16 >> col)) CGContextFillRect(context, CGRectMake(x+col*scale,y+row*scale,scale,scale));
+	}
+}
