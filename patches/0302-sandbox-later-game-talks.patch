@@ -0,0 +1,106 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Scummverse: a person's or a shop's conversation as its game's scripts play
+// it (from 0302), for the new engine (engines/scummverse). Plain C++, no
+// ScummVM types; tools/test_talks.cpp.
+//
+// A talks file ("<game>-talks.svq", "SVQ1", written by the game's own SCUMM
+// engine as it exports its places, from its scripts: see
+// ScummEngine::scummverseExportTalks) is read by parse(); its lines, choices
+// and names are the game's own, from its data at export time (none are
+// written here).
+//
+// A talk (Talk) is what a verb on a thing of a place opens there (a shop's
+// sale picked up, a bucket asked for; a person's own thing talked to, its
+// `costume` theirs): the ways it begins (Opening: by the value its game keeps
+// that it reads, `reads`, and the money carried, from `moneyFrom` to
+// `moneyTo`), each a step; its menus (Menu: the choices its scripts offer
+// there, in the order they show them, each with its number in its game and
+// its text), each choice a step. A step (Step) is what its game does then
+// until the next menu is up or the talk is over (`next`, kEnd): the lines
+// said in turn (the one played's choice first, where its game has them say
+// it), the values kept it leaves (variable, value: for a value its game only
+// adds to, what it adds), the money it adds (paid: less than 0), the things
+// it gives the one played (their room, number and name) and takes from them,
+// and the things of its place it shows in a picture of their own. Menus are
+// told apart by everything their game has then (two the same are one menu,
+// so a talk that comes back to its questions comes back to the same menu);
+// a file's menus are a graph, never more than kMostMenus.
+//
+// Money (Money): the variable its game counts it in, the thing carried while
+// there is any (its room and number) and that thing's name for one and for
+// more (`manyBefore`, the count, `manyAfter`), as its game names it.
+#ifndef COMMON_SCUMMVERSE_TALKS_H
+#define COMMON_SCUMMVERSE_TALKS_H
+
+#include "common/scummverse_talks_engine.h"
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace Scummverse {
+namespace Talks {
+
+struct Line { int speaker = kSpeakerNone, costume = 0, color = -1; std::string text; };
+struct Given { int room = 0, object = 0; std::string name; };
+struct Step {
+	std::vector<Line> lines;
+	std::vector<std::pair<int, int> > leaves; // (variable, value)
+	int money = 0;
+	std::vector<Given> given;
+	std::vector<int> taken;
+	std::vector<std::pair<int, int> > pictures; // (object, picture)
+	int next = kEnd;
+	bool operator==(const Step &o) const;
+};
+struct Choice { int id = 0; std::string text; Step step; };
+struct Menu { std::vector<Choice> choices; };
+struct Opening { int value = 0, moneyFrom = 0, moneyTo = kNoMost; Step step; };
+struct Talk {
+	int room = 0, object = 0, kind = 0, costume = 0, reads = 0;
+	std::vector<Opening> openings;
+	std::vector<Menu> menus;
+	// The way it begins with `value` read and `money` carried (null: none).
+	const Opening *opening(int value, int money) const;
+};
+struct Money {
+	int var = 0, room = 0, object = 0;
+	std::string one, manyBefore, manyAfter;
+	std::string name(int count) const; // (empty: none, or no money)
+};
+struct Data {
+	Money money;
+	std::vector<Talk> talks;
+	int find(int room, int object, int kind, int costume) const; // (-1: none)
+};
+// Bytes of a "SVQ1" file (uncompressed); false (with `error`) when malformed:
+// cut short, longer than it says, a count past its most, a menu led to that
+// is none, a choice's number twice in a menu, a line by no one known, a text
+// empty where it must not be or holding a zero, ways of beginning that overlap.
+bool parse(const uint8_t *data, size_t size, Data &out, std::string &error);
+// And written so (the export's and the tests'): parse(write(d)) gives d.
+std::vector<uint8_t> write(const Data &d);
+
+// A talk under way: begun (its opening the step just taken), then each choice
+// chosen at the menu up (its step the step just taken), until no menu is up.
+class Play {
+public:
+	bool begin(const Talk &talk, int value, int money);
+	bool active() const { return _talk != nullptr; }
+	const Step *step() const { return _step; }
+	const Menu *menu() const;
+	int menuIndex() const { return _menu; }
+	bool choose(int index);
+	void end() { _talk = nullptr; _step = nullptr; _menu = kEnd; }
+private:
+	const Talk *_talk = nullptr;
+	const Step *_step = nullptr;
+	int _menu = kEnd;
+};
+
+} // End of namespace Talks
+} // End of namespace Scummverse
+
+#endif
