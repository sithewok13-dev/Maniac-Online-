+// SPDX-License-Identifier: GPL-3.0-or-later
+// Scummverse: a person's or a shop's conversation, engine-facing bridge
+// (plain types only; from 0302) for the new engine (engines/scummverse) and
+// the export (engines/scumm). Holds each game's talks file and the talk under
+// way. See common/scummverse_talks.h.
+#ifndef COMMON_SCUMMVERSE_TALKS_ENGINE_H
+#define COMMON_SCUMMVERSE_TALKS_ENGINE_H
+
+#include <stddef.h>
+
+namespace Scummverse {
+// (The file's numbers, for the new engine, the export and the module.)
+namespace Talks {
+
+// The most a file holds: talks, the ways one begins, menus of one, choices
+// of a menu, lines of a step (what an opening or a choice does), the values
+// kept it leaves, things it gives, takes or shows anew, a text's bytes.
+static const int kMostTalks = 64, kMostOpenings = 16, kMostMenus = 256, kMostChoices = 16, kMostStepLines = 48,
+	kMostLeaves = 8, kMostGiven = 8, kMostTaken = 8, kMostPictures = 16, kMostTextBytes = 255;
+// Who says a line: the one played, someone (by their costume, in their talk
+// colour), or no one (told over the place, in its colour); a step that ends
+// the talk leads to no menu.
+static const int kSpeakerPlayed = 0, kSpeakerSomeone = 1, kSpeakerNone = 255, kEnd = -1;
+// (No end to the money a way of beginning takes.)
+static const int kNoMost = -1;
+
+} // End of namespace Talks
+
+namespace TalksBridge {
+
+// A game's talks file (bytes of its "-talks.svq", uncompressed), kept per
+// game; false (with `error`), and none, when malformed.
+bool load(int game, const unsigned char *data, size_t size, char *error, int capacity);
+bool loaded(int game);
+void clear();
+// Its money (none: false): the variable its game keeps it in, the thing that
+// shows it carried (its room and number), and that thing's name for a count
+// (its game's own, from its data at export time; false: none).
+bool money(int game, int &var, int &room, int &object);
+bool moneyName(int game, int count, char *text, int capacity);
+// The talk a verb (its kind) on a thing of a room opens (`costume` the
+// person whose thing it is, talked to; 0 a thing's): its index, -1 none; the
+// value kept it reads (0 none).
+int find(int game, int room, int object, int kind, int costume);
+int count(int game);
+bool talk(int game, int index, int &room, int &object, int &kind, int &costume, int &reads);
+
+// The talk under way (one at a time): begun with the value it reads and the
+// money now (false: none, or no way of beginning so). The step just taken
+// (its opening, then each choice's): its lines in turn, the values kept it
+// leaves (variable, value), the money it adds, the things it gives (room,
+// number, name), takes and shows in a picture of their own (number,
+// picture); then its menu (none: over).
+bool begin(int game, int index, int value, int money);
+bool active();
+int stepLines();
+bool stepLine(int k, int &speaker, int &costume, int &color, char *text, int capacity);
+int stepLeaves();
+bool stepLeave(int k, int &var, int &value);
+int stepMoney();
+int stepGiven();
+bool stepGive(int k, int &room, int &object, char *name, int capacity);
+int stepTaken();
+int stepTake(int k);
+int stepPictures();
+bool stepPicture(int k, int &object, int &picture);
+// The menu up once the step's lines are said (none: the talk over): its
+// choices in order (their numbers in their game and texts), one chosen (its
+// step then the step just taken).
+bool menuUp();
+int menuIndex();
+int choices();
+bool choice(int k, int &id, char *text, int capacity);
+bool choose(int k);
+void end();
+
+// The export's (a file built up, then its bytes): begun with its money (var
+// 0: none); talks added, then their menus and choices; a step built (its
+// parts added in turn) and filed as a talk's way of beginning or a choice's;
+// written into `out` (returns its size, copied when `capacity` takes it; 0:
+// none begun, or not a whole file).
+void fileBegin(int moneyVar, int moneyRoom, int moneyObject, const char *one, const char *manyBefore, const char *manyAfter);
+int fileTalk(int room, int object, int kind, int costume, int reads);
+int fileMenu(int talk);
+int fileChoice(int talk, int menu, int id, const char *text);
+void stepNew();
+void stepAddLine(int speaker, int costume, int color, const char *text);
+void stepAddLeave(int var, int value);
+void stepSetMoney(int money);
+void stepAddGiven(int room, int object, const char *name);
+void stepAddTaken(int object);
+void stepAddPicture(int object, int picture);
+void stepSetNext(int menu);
+bool fileOpening(int talk, int value, int moneyFrom, int moneyTo);
+bool fileChoiceStep(int talk, int menu, int choice);
+int written(unsigned char *out, int capacity);
+
+} // End of namespace TalksBridge
+} // End of namespace Scummverse
+
+#endif
