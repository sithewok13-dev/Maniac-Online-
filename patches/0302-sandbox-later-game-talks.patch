+namespace Scummverse {
+namespace Talks {
+
+bool Step::operator==(const Step &o) const {
+	if (lines.size() != o.lines.size() || leaves != o.leaves || money != o.money || given.size() != o.given.size() || taken != o.taken ||
+		pictures != o.pictures || next != o.next) return false;
+	for (size_t k = 0; k < lines.size(); ++k)
+		if (lines[k].speaker != o.lines[k].speaker || lines[k].costume != o.lines[k].costume || lines[k].color != o.lines[k].color || lines[k].text != o.lines[k].text) return false;
+	for (size_t k = 0; k < given.size(); ++k)
+		if (given[k].room != o.given[k].room || given[k].object != o.given[k].object || given[k].name != o.given[k].name) return false;
+	return true;
+}
+
+const Opening *Talk::opening(int value, int money) const {
+	for (const Opening &o : openings)
+		if (o.value == value && money >= o.moneyFrom && (o.moneyTo == kNoMost || money <= o.moneyTo)) return &o;
+	return nullptr;
+}
+
+std::string Money::name(int count) const {
+	if (!var || count <= 0) return std::string();
+	if (count == 1 && !one.empty()) return one;
+	return manyBefore + std::to_string(count) + manyAfter;
+}
+
+int Data::find(int room, int object, int kind, int costume) const {
+	for (size_t i = 0; i < talks.size(); ++i) {
+		const Talk &t = talks[i];
+		if (t.room == room && t.kind == kind && t.costume == costume && (costume ? true : t.object == object)) return (int)i;
+	}
+	return -1;
+}
+
+// ---- The file ("SVQ1", little-endian) ----
+// "SVQ1"; u16 money variable (0: none), u16 its thing's room, u16 its
+// thing, then its names (each u8 length and its bytes): for one, before the
+// count, after it; u8 talks, per talk u16 room, u16 object, u8 kind, u16
+// costume, u16 the value kept it reads (0: none), u16 menus, u8 openings
+// (per opening s16 value, s32 money from, s32 money to (-1: no end), a
+// step), its menus (per menu u8 choices, per choice u16 its number, its
+// text, a step).
+// A step: u8 lines (per line u8 speaker, u16 costume, s16 colour (-1 the
+// speaker's own), its text), u8 leaves (per leave u16 variable, s32 value),
+// s32 money, u8 given (per thing u16 room, u16 object, its name), u8 taken
+// (u16 each), u8 pictures (per thing u16 object, u8 picture), s16 next
+// (-1: the end). Nothing after.
+
+namespace {
+struct Reader {
+	const uint8_t *p, *end;
+	bool ok;
+	int u8() { if (p >= end) { ok = false; return 0; } return *p++; }
+	int u16() { const int lo = u8(); return lo | u8() << 8; }
+	int s16() { const int v = u16(); return v >= 0x8000 ? v - 0x10000 : v; }
+	int s32() {
+		uint32_t v = 0;
+		for (int k = 0; k < 4; ++k) v |= (uint32_t)u8() << (8 * k);
+		return (int)(int32_t)v;
+	}
+	// (A text: none longer than its byte, no zero in it; `empty` lets it be none.)
+	bool text(std::string &out, bool empty) {
+		const int length = u8();
+		if (!ok || end - p < length) { ok = false; return false; }
+		out.assign((const char *)p, length);
+		p += length;
+		return (empty || length > 0) && out.find('\0') == std::string::npos;
+	}
+};
+
+struct Writer {
+	std::vector<uint8_t> out;
+	void u8(int v) { out.push_back((uint8_t)v); }
+	void u16(int v) { u8(v & 0xFF); u8(v >> 8 & 0xFF); }
+	void s32(int v) { const uint32_t u = (uint32_t)v; for (int k = 0; k < 4; ++k) u8(u >> (8 * k) & 0xFF); }
+	void text(const std::string &t) {
+		const size_t n = t.size() < (size_t)kMostTextBytes ? t.size() : (size_t)kMostTextBytes;
+		u8((int)n);
+		out.insert(out.end(), t.begin(), t.begin() + n);
+	}
+};
+
+bool readStep(Reader &r, Step &s, int menus, std::string &error) {
+	s = Step();
+	const int lines = r.u8();
+	if (!r.ok || lines > kMostStepLines) { error = "a step's lines"; return false; }
+	for (int k = 0; k < lines; ++k) {
+		Line l;
+		l.speaker = r.u8(); l.costume = r.u16(); l.color = r.s16();
+		if (!r.text(l.text, false) || (l.speaker != kSpeakerPlayed && l.speaker != kSpeakerSomeone && l.speaker != kSpeakerNone) || l.color < -1 || l.color > 255 ||
+			(l.speaker == kSpeakerSomeone && !l.costume)) { error = "a line"; return false; }
+		s.lines.push_back(l);
+	}
+	const int leaves = r.u8();
+	if (!r.ok || leaves > kMostLeaves) { error = "a step's values"; return false; }
+	for (int k = 0; k < leaves; ++k) {
+		const int var = r.u16(), value = r.s32();
+		if (!var) { error = "a step's values"; return false; }
+		for (const auto &l : s.leaves) if (l.first == var) { error = "a step's values"; return false; }
+		s.leaves.push_back(std::make_pair(var, value));
+	}
+	s.money = r.s32();
+	const int given = r.u8();
+	if (!r.ok || given > kMostGiven) { error = "a step's things given"; return false; }
+	for (int k = 0; k < given; ++k) {
+		Given g;
+		g.room = r.u16(); g.object = r.u16();
+		if (!r.text(g.name, true) || !g.object) { error = "a thing given"; return false; }
+		s.given.push_back(g);
+	}
+	const int taken = r.u8();
+	if (!r.ok || taken > kMostTaken) { error = "a step's things taken"; return false; }
+	for (int k = 0; k < taken; ++k) {
+		const int object = r.u16();
+		if (!object) { error = "a thing taken"; return false; }
+		s.taken.push_back(object);
+	}
+	const int pictures = r.u8();
+	if (!r.ok || pictures > kMostPictures) { error = "a step's pictures"; return false; }
+	for (int k = 0; k < pictures; ++k) {
+		const int object = r.u16(), picture = r.u8();
+		if (!object) { error = "a step's pictures"; return false; }
+		s.pictures.push_back(std::make_pair(object, picture));
+	}
+	s.next = r.s16();
+	if (!r.ok || s.next < kEnd || s.next >= menus) { error = "a step's menu"; return false; }
+	return true;
+}
+
+void writeStep(Writer &w, const Step &s) {
+	w.u8((int)s.lines.size());
+	for (const Line &l : s.lines) { w.u8(l.speaker); w.u16(l.costume); w.u16(l.color & 0xFFFF); w.text(l.text); }
+	w.u8((int)s.leaves.size());
+	for (const auto &l : s.leaves) { w.u16(l.first); w.s32(l.second); }
+	w.s32(s.money);
+	w.u8((int)s.given.size());
+	for (const Given &g : s.given) { w.u16(g.room); w.u16(g.object); w.text(g.name); }
+	w.u8((int)s.taken.size());
+	for (int t : s.taken) w.u16(t);
+	w.u8((int)s.pictures.size());
+	for (const auto &p : s.pictures) { w.u16(p.first); w.u8(p.second); }
+	w.u16(s.next & 0xFFFF);
+}
+} // End of anonymous namespace
+
+bool parse(const uint8_t *data, size_t size, Data &out, std::string &error) {
+	out = Data();
+	if (!data || size < 4 || std::memcmp(data, "SVQ1", 4)) { error = "not a talks file"; return false; }
+	Reader r = {data + 4, data + size, true};
+	auto fail = [&](const char *why) { error = why; out = Data(); return false; };
+	Money &m = out.money;
+	m.var = r.u16(); m.room = r.u16(); m.object = r.u16();
+	if (!r.text(m.one, true) || !r.text(m.manyBefore, true) || !r.text(m.manyAfter, true) || (m.var && !m.object)) return fail("its money");
+	const int talks = r.u8();
+	if (!r.ok || talks > kMostTalks) return fail("its talks");
+	for (int i = 0; i < talks; ++i) {
+		Talk t;
+		t.room = r.u16(); t.object = r.u16(); t.kind = r.u8(); t.costume = r.u16(); t.reads = r.u16();
+		if (!r.ok || !t.object || t.kind < 1 || t.kind > 63 || out.find(t.room, t.object, t.kind, t.costume) >= 0) return fail("a talk");
+		const int menus = r.u16(), openings = r.u8();
+		if (!r.ok || menus > kMostMenus) return fail("a talk's menus");
+		if (openings < 1 || openings > kMostOpenings) return fail("a talk's openings");
+		for (int k = 0; k < openings; ++k) {
+			Opening o;
+			o.value = r.s16(); o.moneyFrom = r.s32(); o.moneyTo = r.s32();
+			std::string why;
+			if (!readStep(r, o.step, menus, why)) return fail(why.c_str());
+			if (o.moneyFrom < 0 || o.moneyTo < kNoMost || (o.moneyTo != kNoMost && o.moneyTo < o.moneyFrom)) return fail("a talk's openings");
+			for (const Opening &p : t.openings) {
+				const bool apart = (o.moneyTo != kNoMost && o.moneyTo < p.moneyFrom) || (p.moneyTo != kNoMost && p.moneyTo < o.moneyFrom);
+				if (p.value == o.value && !apart) return fail("a talk's openings overlap");
+			}
+			t.openings.push_back(o);
+		}
+		for (int k = 0; k < menus; ++k) {
+			Menu menu;
+			const int choices = r.u8();
+			if (!r.ok || choices < 1 || choices > kMostChoices) return fail("a menu");
+			for (int c = 0; c < choices; ++c) {
+				Choice ch;
+				ch.id = r.u16();
+				if (!r.text(ch.text, false)) return fail("a choice");
+				for (const Choice &x : menu.choices) if (x.id == ch.id) return fail("a choice twice");
+				std::string why;
+				if (!readStep(r, ch.step, menus, why)) return fail(why.c_str());
+				menu.choices.push_back(ch);
+			}
+			t.menus.push_back(menu);
+		}
+		out.talks.push_back(t);
+	}
+	if (!r.ok) return fail("cut short");
+	if (r.p != r.end) return fail("longer than it says");
+	return true;
+}
+
+std::vector<uint8_t> write(const Data &d) {
+	Writer w;
+	w.out.insert(w.out.end(), {'S', 'V', 'Q', '1'});
+	w.u16(d.money.var); w.u16(d.money.room); w.u16(d.money.object);
+	w.text(d.money.one); w.text(d.money.manyBefore); w.text(d.money.manyAfter);
+	w.u8((int)d.talks.size());
+	for (const Talk &t : d.talks) {
+		w.u16(t.room); w.u16(t.object); w.u8(t.kind); w.u16(t.costume); w.u16(t.reads);
+		w.u16((int)t.menus.size());
+		w.u8((int)t.openings.size());
+		for (const Opening &o : t.openings) { w.u16(o.value & 0xFFFF); w.s32(o.moneyFrom); w.s32(o.moneyTo); writeStep(w, o.step); }
+		for (const Menu &m : t.menus) {
+			w.u8((int)m.choices.size());
+			for (const Choice &c : m.choices) { w.u16(c.id); w.text(c.text); writeStep(w, c.step); }
+		}
+	}
+	return w.out;
+}
+
+bool Play::begin(const Talk &talk, int value, int money) {
+	end();
+	const Opening *o = talk.opening(value, money);
+	if (!o) return false;
+	_talk = &talk; _step = &o->step; _menu = o->step.next;
+	return true;
+}
+
+const Menu *Play::menu() const {
+	return _talk && _menu >= 0 && _menu < (int)_talk->menus.size() ? &_talk->menus[_menu] : nullptr;
+}
+
+bool Play::choose(int index) {
+	const Menu *m = menu();
+	if (!m || index < 0 || index >= (int)m->choices.size()) return false;
+	_step = &m->choices[index].step;
+	_menu = _step->next;
+	return true;
+}
+
+} // End of namespace Talks
+
+namespace TalksBridge {
+namespace {
+std::map<int, Talks::Data> &files() { static std::map<int, Talks::Data> f; return f; }
+struct Under { int game = -1; Talks::Play play; };
+Under &under() { static Under u; return u; }
+Talks::Data &building() { static Talks::Data d; return d; }
+bool &begun() { static bool b = false; return b; }
+Talks::Step &built() { static Talks::Step s; return s; }
+const Talks::Data *file(int game) {
+	auto it = files().find(game);
+	return it == files().end() ? nullptr : &it->second;
+}
+void copy(const std::string &from, char *text, int capacity) {
+	if (!text || capacity <= 0) return;
+	const size_t n = from.size() < (size_t)capacity - 1 ? from.size() : (size_t)capacity - 1;
+	std::memcpy(text, from.data(), n);
+	text[n] = 0;
+}
+const Talks::Step *step() { return under().play.active() ? under().play.step() : nullptr; }
+Talks::Menu *buildingMenu(int talk, int menu) {
+	Talks::Data &d = building();
+	if (!begun() || talk < 0 || talk >= (int)d.talks.size() || menu < 0 || menu >= (int)d.talks[talk].menus.size()) return nullptr;
+	return &d.talks[talk].menus[menu];
+}
+} // End of anonymous namespace
+
+// (Read into one of its own first; the game's file replaced only when it
+// is whole, none kept when it is not. A talk under way of that game ended
+// either way: it points at the talks it replaces.)
+bool load(int game, const unsigned char *data, size_t size, char *error, int capacity) {
+	if (under().game == game) under() = Under();
+	Talks::Data d;
+	std::string why;
+	if (!Talks::parse(data, size, d, why)) { files().erase(game); copy(why, error, capacity); return false; }
+	files()[game] = d;
+	return true;
+}
+
+bool loaded(int game) { return file(game) != nullptr; }
+void clear() { files().clear(); under() = Under(); }
+
+bool money(int game, int &var, int &room, int &object) {
+	const Talks::Data *f = file(game);
+	if (!f || !f->money.var) return false;
+	var = f->money.var; room = f->money.room; object = f->money.object;
+	return true;
+}
+
+bool moneyName(int game, int count, char *text, int capacity) {
+	const Talks::Data *f = file(game);
+	const std::string name = f ? f->money.name(count) : std::string();
+	copy(name, text, capacity);
+	return !name.empty();
+}
+
+int find(int game, int room, int object, int kind, int costume) {
+	const Talks::Data *f = file(game);
+	return f ? f->find(room, object, kind, costume) : -1;
+}
+
+int count(int game) {
+	const Talks::Data *f = file(game);
+	return f ? (int)f->talks.size() : 0;
+}
+
+bool talk(int game, int index, int &room, int &object, int &kind, int &costume, int &reads) {
+	const Talks::Data *f = file(game);
+	if (!f || index < 0 || index >= (int)f->talks.size()) return false;
+	const Talks::Talk &t = f->talks[index];
+	room = t.room; object = t.object; kind = t.kind; costume = t.costume; reads = t.reads;
+	return true;
+}
+
+bool begin(int game, int index, int value, int money) {
+	under() = Under();
+	const Talks::Data *f = file(game);
+	if (!f || index < 0 || index >= (int)f->talks.size() || !under().play.begin(f->talks[index], value, money)) return false;
+	under().game = game;
+	return true;
+}
+
+bool active() { return under().play.active(); }
+int stepLines() { return step() ? (int)step()->lines.size() : 0; }
+
+bool stepLine(int k, int &speaker, int &costume, int &color, char *text, int capacity) {
+	if (k < 0 || k >= stepLines()) return false;
+	const Talks::Line &l = step()->lines[k];
+	speaker = l.speaker; costume = l.costume; color = l.color;
+	copy(l.text, text, capacity);
+	return true;
+}
+
+int stepLeaves() { return step() ? (int)step()->leaves.size() : 0; }
+
+bool stepLeave(int k, int &var, int &value) {
+	if (k < 0 || k >= stepLeaves()) return false;
+	var = step()->leaves[k].first; value = step()->leaves[k].second;
+	return true;
+}
+
+int stepMoney() { return step() ? step()->money : 0; }
+int stepGiven() { return step() ? (int)step()->given.size() : 0; }
+
+bool stepGive(int k, int &room, int &object, char *name, int capacity) {
+	if (k < 0 || k >= stepGiven()) return false;
+	const Talks::Given &g = step()->given[k];
+	room = g.room; object = g.object;
+	copy(g.name, name, capacity);
+	return true;
+}
+
+int stepTaken() { return step() ? (int)step()->taken.size() : 0; }
+int stepTake(int k) { return k >= 0 && k < stepTaken() ? step()->taken[k] : 0; }
+int stepPictures() { return step() ? (int)step()->pictures.size() : 0; }
+
+bool stepPicture(int k, int &object, int &picture) {
+	if (k < 0 || k >= stepPictures()) return false;
+	object = step()->pictures[k].first; picture = step()->pictures[k].second;
+	return true;
+}
+
+bool menuUp() { return under().play.menu() != nullptr; }
+int menuIndex() { return menuUp() ? under().play.menuIndex() : Talks::kEnd; }
+int choices() { return menuUp() ? (int)under().play.menu()->choices.size() : 0; }
+
+bool choice(int k, int &id, char *text, int capacity) {
+	if (k < 0 || k >= choices()) return false;
+	const Talks::Choice &c = under().play.menu()->choices[k];
+	id = c.id;
+	copy(c.text, text, capacity);
+	return true;
+}
+
+bool choose(int k) { return under().play.choose(k); }
+void end() { under() = Under(); }
+
+void fileBegin(int moneyVar, int moneyRoom, int moneyObject, const char *one, const char *manyBefore, const char *manyAfter) {
+	building() = Talks::Data();
+	begun() = true;
+	Talks::Money &m = building().money;
+	m.var = moneyVar; m.room = moneyRoom; m.object = moneyObject;
+	m.one = one ? one : ""; m.manyBefore = manyBefore ? manyBefore : ""; m.manyAfter = manyAfter ? manyAfter : "";
+}
+
+int fileTalk(int room, int object, int kind, int costume, int reads) {
+	if (!begun() || (int)building().talks.size() >= Talks::kMostTalks) return -1;
+	Talks::Talk t;
+	t.room = room; t.object = object; t.kind = kind; t.costume = costume; t.reads = reads;
+	building().talks.push_back(t);
+	return (int)building().talks.size() - 1;
+}
+
+int fileMenu(int talk) {
+	Talks::Data &d = building();
+	if (!begun() || talk < 0 || talk >= (int)d.talks.size() || (int)d.talks[talk].menus.size() >= Talks::kMostMenus) return -1;
+	d.talks[talk].menus.push_back(Talks::Menu());
+	return (int)d.talks[talk].menus.size() - 1;
+}
+
+int fileChoice(int talk, int menu, int id, const char *text) {
+	Talks::Menu *m = buildingMenu(talk, menu);
+	if (!m || (int)m->choices.size() >= Talks::kMostChoices) return -1;
+	Talks::Choice c;
+	c.id = id; c.text = text ? text : "";
+	m->choices.push_back(c);
+	return (int)m->choices.size() - 1;
+}
+
+void stepNew() { built() = Talks::Step(); }
+
+void stepAddLine(int speaker, int costume, int color, const char *text) {
+	if ((int)built().lines.size() >= Talks::kMostStepLines || !text || !*text) return;
+	Talks::Line l;
+	l.speaker = speaker; l.costume = costume; l.color = color; l.text = text;
+	if (l.text.size() > (size_t)Talks::kMostTextBytes) l.text.resize(Talks::kMostTextBytes);
+	built().lines.push_back(l);
+}
+
+void stepAddLeave(int var, int value) { if ((int)built().leaves.size() < Talks::kMostLeaves) built().leaves.push_back(std::make_pair(var, value)); }
+void stepSetMoney(int money) { built().money = money; }
+
+void stepAddGiven(int room, int object, const char *name) {
+	if ((int)built().given.size() >= Talks::kMostGiven) return;
+	Talks::Given g;
+	g.room = room; g.object = object; g.name = name ? name : "";
+	built().given.push_back(g);
+}
+
+void stepAddTaken(int object) { if ((int)built().taken.size() < Talks::kMostTaken) built().taken.push_back(object); }
+void stepAddPicture(int object, int picture) { if ((int)built().pictures.size() < Talks::kMostPictures) built().pictures.push_back(std::make_pair(object, picture)); }
+void stepSetNext(int menu) { built().next = menu; }
+
+bool fileOpening(int talk, int value, int moneyFrom, int moneyTo) {
+	Talks::Data &d = building();
+	if (!begun() || talk < 0 || talk >= (int)d.talks.size() || (int)d.talks[talk].openings.size() >= Talks::kMostOpenings) return false;
+	Talks::Opening o;
+	o.value = value; o.moneyFrom = moneyFrom; o.moneyTo = moneyTo; o.step = built();
+	d.talks[talk].openings.push_back(o);
+	return true;
+}
+
+bool fileChoiceStep(int talk, int menu, int choice) {
+	Talks::Menu *m = buildingMenu(talk, menu);
+	if (!m || choice < 0 || choice >= (int)m->choices.size()) return false;
+	m->choices[choice].step = built();
+	return true;
+}
+
+// (Only a whole file: one that reads back as written.)
+int written(unsigned char *out, int capacity) {
+	if (!begun()) return 0;
+	const std::vector<uint8_t> bytes = Talks::write(building());
+	Talks::Data check;
+	std::string why;
+	if (!Talks::parse(bytes.data(), bytes.size(), check, why)) return 0;
+	if (out && capacity >= (int)bytes.size()) std::memcpy(out, bytes.data(), bytes.size());
+	return (int)bytes.size();
+}
+
+} // End of namespace TalksBridge
+} // End of namespace Scummverse
diff --git a/common/scummverse_talks.h b/common/scummverse_talks.h
new file mode 100644
index 00000000..5003ecda
--- /dev/null
