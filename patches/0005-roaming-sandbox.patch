+bool ScummEngine::scummverseOwnsActor(int actor) const {
+	return _scummverseRoamingReady && _currentScript != 0xFF && (actor == 9 || actor == 10 || actor == 11 || actor == 13 || actor == 14 || actor == 23);
+}
