+bool ScummEngine::scummverseBlocksScript(int script) const {
+	// Audited cinematics, their timed launchers, and replaced NPC routines.
+	// Stop before camera switches, input freezes and temporary costume changes.
+	switch (script) {
+	case 6: case 7: case 9: case 12: case 23: case 27:
+	case 35: case 36: case 37: case 38: case 39: case 40:
+	case 42: case 43: case 44: case 47: case 48: case 49: case 51:
+	case 61: case 62: case 63:
+	case 87: case 88: case 89: case 91: case 92: case 93: case 94:
+	case 95: case 96: case 97: case 98: case 99: case 100: case 101:
+	case 105: case 106: case 108: case 111: case 112: case 115:
+	case 117: case 119: case 120: case 123: case 124: case 125:
+	case 126: case 127: case 128: case 129: case 130:
+	case 140: case 142: case 145: case 148: case 151: case 152:
+	case 153: case 155: case 157: case 158: case 160: case 161:
+	case 162: case 163: case 168: case 169: case 170: case 171: case 175:
+		return true;
+	default: return false;
+	}
+}
+
+bool ScummEngine::scummverseDoorPoint(int room, int object, int &x, int &y) {
+	const byte *data = getResourceAddress(rtRoom, room);
+	const int size = getResourceSize(rtRoom, room);
+	if (!data || size < 28) return false;
+	const int count = data[20];
+	if (28 + count * 4 > size) return false;
+	for (int n = 0; n < count; ++n) {
+		const int offset = READ_LE_UINT16(data + 28 + count * 2 + n * 2);
+		if (offset + 15 > size) return false;
+		if (READ_LE_UINT16(data + offset + 4) == object) {
+			x = data[offset + 11];
+			y = (data[offset + 12] & 31) * 4;
+			return true;
+		}
+	}
+	return false;
+}
+
+void ScummEngine::scummverseOpenPassage(int index, bool open) {
+	const MansionPassage &p = mansionPassages[index];
+	if (!p.door) return;
+	const int objects[] = {p.object, p.arrival};
+	for (int object : objects) {
+		int state = getState(object) & ~kObjectStateLocked;
+		state = open ? state | kObjectStateIntrinsic : state & ~kObjectStateIntrinsic;
+		putState(object, state);
+		if (getObjectIndex(object) >= 0) markObjectRectAsDirty(object);
+	}
+	clearDrawObjectQueue();
+	_fullRedraw = true;
+}
+
+bool ScummEngine::scummversePassage(int object, int verb) {
+	if (verb != 1 && verb != 2 && verb != 8 && verb != 10 && verb != 13) return false;
+	for (uint n = 0; n < ARRAYSIZE(mansionPassages); ++n) {
+		const MansionPassage &p = mansionPassages[n];
+		if (p.room != _currentRoom || p.object != object) continue;
+		if (verb != 13) {
+			if (!p.door) return false;
+			scummverseOpenPassage(n, verb != 2);
+			return true;
+		}
+		// Only explicit player traversal may change the camera/current scene.
+		int x, y;
+		if (!scummverseDoorPoint(p.destination, p.arrival, x, y)) return false;
+		scummverseOpenPassage(n, true);
+		Actor *a = derefActor(VAR(VAR_EGO), "sandbox passage");
+		a->putActor(x, y, p.destination);
+		_egoPositioned = false;
+		startScene(p.destination, a, p.arrival);
+		AdjustBoxResult point = a->adjustXYToBeInBox(x, y);
+		a->putActor(point.x, point.y, p.destination);
+		setCameraAt(a->getPos().x, a->getPos().y);
+		setCameraFollows(a);
+		resetSentence();
+		_fullRedraw = true;
+		return true;
+	}
+	return false;
+}
