+	memcpy(_scummverseAirportRoom.data(), source.data(), size);
+	for (uint i = 0; i < count; ++i) {
+		uint offset = READ_LE_UINT16(source.data() + 28 + count * 2 + i * 2);
+		if (offset + 15 > size) return false;
+		uint original = READ_LE_UINT16(source.data() + offset + 4);
+		if (original >= 775) return false;
+		_scummverseAirportStates[i] = index[2 + original] >> 4;
+		WRITE_LE_UINT16(_scummverseAirportRoom.data() + offset + 4, 683 + i);
+	}
+	_scummverseAirportRoom[22] = _scummverseAirportRoom[23] = 0;
+	WRITE_LE_UINT16(_scummverseAirportRoom.data() + 24, 0);
+	WRITE_LE_UINT16(_scummverseAirportRoom.data() + 26, 0);
+	_scummverseAirportMounted = true;
+	return true;
