+		_scummverseWorldNotice = "Airport unavailable. Copy all original English Zak DOS V1 LFL files, including 08.LFL, into Documents/zak.";
+		return false;
+	}
+	uint size = READ_LE_UINT16(source.data()), count = source[20];
+	if (count != 29 || size > source.size() || size < 28 + count * 4) return false;
