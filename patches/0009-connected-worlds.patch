diff --git a/engines/scumm/scummverse_worlds.inc b/engines/scumm/scummverse_worlds.inc
new file mode 100644
index 00000000..94e9bd36
--- /dev/null
+++ b/engines/scumm/scummverse_worlds.inc
@@ -0,0 +1,110 @@
+// First cross-world adapter. GPL-3.0-or-later. No original game data included.
+// Stable identities: maniac:<native room>, zak:apartment, zak:zak.
+// Audited unused Maniac V1 slots keep existing save-array sizes unchanged:
+// room 54, costume 34, actor 24, object IDs 650..682, variables 700..723/760.
+static bool readZakFile(const Common::FSNode &directory, int number, const char *md5, Common::Array<byte> &data) {
+	Common::File file;
+	Common::String name = Common::String::format("%02d.LFL", number);
+	Common::FSNode node = directory.getChild(name);
+	if (!node.exists()) {
+		Common::FSList children;
+		directory.getChildren(children, Common::FSNode::kListFilesOnly);
+		for (const auto &child : children) if (child.getName().equalsIgnoreCase(name)) { node = child; break; }
+	}
+	if (!file.open(node) || file.size() < 2 || file.size() > 65535) return false;
+	if (Common::computeStreamMD5AsString(file) != md5) return false;
+	file.seek(0); data.resize(file.size());
+	if (file.read(data.data(), data.size()) != data.size()) return false;
+	for (uint i = 0; i < data.size(); ++i) data[i] ^= 0xFF;
+	return true;
+}
+
+bool ScummEngine::scummverseMountZak() {
+	if (_scummverseZakMounted) return true;
+	if (!_scummverseRoaming) return false;
+	Common::FSNode directory = ConfMan.hasKey("scummverse_zak_path") ?
+		Common::FSNode(ConfMan.getPath("scummverse_zak_path")) :
+		Common::FSNode(ConfMan.getPath("path")).getParent().getChild("zak");
+	Common::Array<byte> index, source;
+	if (!readZakFile(directory, 0, "7020931d5a2be0a49d68e7a1882363e4", index) ||
+		!readZakFile(directory, 1, "2e30571757edc1cd0f2a450ba5c89153", source)) {
+		_scummverseWorldNotice = "Add the original English Zak DOS V1 files to Documents/zak, then retry Worlds.";
+		return false;
+	}
+	// Read the original apartment and playable Zak costume from the verified
+	// user's files. Numeric offsets are derived from that edition's directory.
+	const uint roomSize = READ_LE_UINT16(source.data());
+	const uint costumeTable = 2 + 775 + 61 * 3;
+	const uint costumeOffset = READ_LE_UINT16(index.data() + costumeTable + 37 + 2);
+	if (index[costumeTable + 1] != 1 || costumeOffset + 2 > source.size()) return false;
+	const uint costumeSize = READ_LE_UINT16(source.data() + costumeOffset);
+	if (roomSize < 28 || roomSize > source.size() || costumeSize < 8 || costumeOffset + costumeSize > source.size()) return false;
+	const uint count = source[20];
+	if (count != 33 || 28 + count * 4 > roomSize) return false;
+	_scummverseZakRoom.resize(roomSize);
+	memcpy(_scummverseZakRoom.data(), source.data(), roomSize);
+	_scummverseZakCostume.resize(costumeSize);
+	memcpy(_scummverseZakCostume.data(), source.data() + costumeOffset, costumeSize);
+	for (uint i = 0; i < count; ++i) {
+		uint offset = READ_LE_UINT16(source.data() + 28 + count * 2 + i * 2);
+		if (offset + 15 > roomSize) return false;
+		uint original = READ_LE_UINT16(source.data() + offset + 4);
+		if (original >= 775) return false;
+		_scummverseZakStates[i] = index[2 + original] >> 4;
+		WRITE_LE_UINT16(_scummverseZakRoom.data() + offset + 4, 650 + i);
+	}
+	// Room art, objects and walkboxes stay authentic. Foreign script/sound
+	// references must never resolve into the mansion's resource namespace.
+	_scummverseZakRoom[22] = _scummverseZakRoom[23] = 0;
+	WRITE_LE_UINT16(_scummverseZakRoom.data() + 24, 0);
+	WRITE_LE_UINT16(_scummverseZakRoom.data() + 26, 0);
+	_scummverseZakMounted = true;
+	return true;
+}
+
+int ScummEngine::scummverseWorldResource(ResType type, ResId id) {
+	if (!_scummverseRoaming || !((type == rtRoom && id == 54) || (type == rtCostume && id == 34))) return -1;
+	if (!scummverseMountZak()) return 0;
+	const Common::Array<byte> &data = type == rtRoom ? _scummverseZakRoom : _scummverseZakCostume;
+	memcpy(_res->createResource(type, id, data.size()), data.data(), data.size());
+	return 1;
+}
+
+bool ScummEngine::scummverseTravel(int destination) {
+	if (!_scummverseRoamingReady || !_userPut || (destination != 1 && destination != 2)) return false;
+	Actor *player = derefActor(VAR(VAR_EGO), "world traveller");
+	if (VAR(VAR_EGO) < 1 || VAR(VAR_EGO) > 7) return false;
+	if (destination == 1 && _currentRoom == 54) return true;
+	if (destination == 2 && _currentRoom != 54) return true;
+	// Validate before touching the current scene, camera or inventory.
+	if (destination == 1 && !scummverseMountZak()) {
+		scummverseSay(VAR(VAR_EGO), _scummverseWorldNotice.c_str()); return false;
+	}
+	const int key = 700 + VAR(VAR_EGO) * 3;
+	int room, x, y;
+	if (destination == 1) {
+		_scummVars[key] = _currentRoom; _scummVars[key + 1] = player->getRealPos().x; _scummVars[key + 2] = player->getRealPos().y;
+		room = 54; x = 21; y = 56;
+		if (!_scummVars[760]) {
+			for (int i = 0; i < 33; ++i) { putState(650 + i, _scummverseZakStates[i]); _objectOwnerTable[650+i] = OF_OWNER_ROOM; }
+			Actor *zak = derefActor(24, "zak:zak");
+			zak->setActorCostume(34); zak->_talkColor = 13; zak->setPalette(1, 13);
+			zak->putActor(30, 56, 54); zak->startAnimActor(zak->_standFrame);
+			const char *name = "Zak McKracken";
+			memcpy(_res->createResource(rtActorName, 24, strlen(name)+1), name, strlen(name)+1);
+			_scummVars[760] = 1;
+		}
+	} else {
+		room = _scummVars[key]; x = _scummVars[key + 1]; y = _scummVars[key + 2];
+		if (room < 1 || room > 52) { room = 10; x = 20; y = 60; }
+	}
+	scummverseAICancel(); _scummverseAIActor = 0; stopTalk();
+	player->stopActorMoving(); player->putActor(x, y, room);
+	startScene(room, player, 0);
+	AdjustBoxResult point = player->adjustXYToBeInBox(x, y);
+	player->putActor(point.x, point.y, room); player->startAnimActor(player->_standFrame);
+	setCameraAt(player->getPos().x, player->getPos().y); setCameraFollows(player);
+	resetSentence(); _fullRedraw = true;
+	_scummverseWorldNotice = room == 54 ? "Zak's apartment. Walk around, or use Talk to meet Zak. Worlds returns you to the mansion." : "Back in Maniac Mansion.";
+	return true;
+}
