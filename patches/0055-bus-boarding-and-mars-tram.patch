+// A system line in the message area (original print(255,...) style).
+void ScummEngine::scummverseAnnounce(const char *text) {
+	if (VAR(VAR_HAVE_MSG)) return;
+	_actorToPrintStrFor = 0xFF;
+	_string[0].xpos = 0; _string[0].ypos = 0; _string[0].right = _screenWidth - 1;
+	_string[0].center = false; _string[0].overhead = false;
+	actorTalk((const byte *)text);
+}
+
+// The parked tram is drawn only at the station where it stands (original
+// states: 0 present, 10 away), in either scene sharing the resource.
+void ScummEngine::scummverseApplyTramState() {
+	const int station = zakTramStation(_currentRoom);
+	if (!_scummverseRoaming || station < 0) return;
+	for (int i = 0; i < 33; ++i) {
+		if (scummverseOriginalObject(_currentRoom, 732 + i) != kZakTramObject) continue;
+		const bool here = (_scummVars[799] & 1) == station && _scummVars[797] <= kTramBoarding;
+		if (getState(732 + i) != (here ? 0 : 10)) { putState(732 + i, here ? 0 : 10); _fullRedraw = true; }
+	}
+}
+
+// Board (or call) the tram at the actor's station. Boarding starts the
+// countdown when the tram is idle here; a call sends it over empty.
+void ScummEngine::scummverseTramRequest(int actor, bool board) {
+	Actor *a = derefActor(actor, "tram request");
+	const int station = zakTramStation(a->_room);
+	if (station < 0 || _scummVars[797] > kTramBoarding) return;
+	const bool here = (_scummVars[799] & 1) == station;
+	const bool player = actor == VAR(VAR_EGO);
+	if (!here) {
+		if (_scummVars[797]) { if (player) scummverseSay(actor, "The tram is boarding at the other station."); return; }
+		// Called: it runs over empty and opens for boarding on arrival.
+		_scummVars[797] = kTramBoarding + 1; _scummVars[798] = 0; _scummVars[799] |= 2;
+		if (player) scummverseSay(actor, "I called the tram. It's on its way.");
+		return;
+	}
+	if (!board) { if (player) scummverseSay(actor, "The tram is right here."); return; }
+	if (!_scummVars[797]) { _scummVars[797] = 1; _scummverseTramBoarded = 0; }
+	_scummVars[798] |= 1u << actor;
+	if (player) for (int id : mansionCast)
+		if (_scummVars[770 + id] == actor && derefActor(id, "tram companion")->_room == a->_room) _scummVars[798] |= 1u << id;
+}
+
+void ScummEngine::scummverseServiceTram(int delta) {
+	const int previous = _scummVars[797];
+	if (!previous) return;
+	_scummVars[797] += MIN(delta, 60);
+	const int phase = _scummVars[797], station = _scummVars[799] & 1;
+	const int origin = kZakTramStations[station], destination = kZakTramStations[1 - station];
+	if (phase <= kTramBoarding) {
+		// Original countdown wording (script 51), shortened to the wait here.
+		if (_currentRoom == origin) {
+			if (previous < 8 && phase >= 8) scummverseAnnounce("Tram leaving in 5 seconds.");
+			else if (previous < kTramBoarding - 90 && phase >= kTramBoarding - 90) scummverseAnnounce("All aboard!");
+		}
