+// Objects as the game draws them, alone, over `area` of the main screen (its
+// own rows and the visible columns): what they draw (mask 1) against what
+// they leave clear, each drawn twice over two fills; the screen as it was
+// after (all of it: an object draws whole, past `area`).
+bool ScummEngine::scummverseCaptureObjects(const Common::Array<int> &objects, const Common::Rect &area, Common::Array<byte> &pixels, Common::Array<byte> &mask) {
+	VirtScreen &vs = _virtscr[kMainVirtScreen];
+	const Common::Rect r(MAX<int>(0, area.left), MAX<int>(0, area.top), MIN<int>(area.right, _screenWidth), MIN<int>(area.bottom, vs.h));
+	if (r.isEmpty() || !vs.hasTwoBuffers || vs.w < _screenWidth) return false;
+	const int w = r.width(), h = r.height(), W = _screenWidth, H = vs.h;
+	Common::Array<byte> front(W * H), back(W * H), pass[2];
+	for (int y = 0; y < H; ++y) {
+		memcpy(&front[y * W], vs.getPixels(0, y), W);
+		memcpy(&back[y * W], vs.getBackPixels(0, y), W);
+	}
+	for (int p = 0; p < 2; ++p) {
+		for (int y = 0; y < h; ++y) {
+			memset(vs.getPixels(r.left, r.top + y), p ? 255 : 254, w);
+			memset(vs.getBackPixels(r.left, r.top + y), p ? 255 : 254, w);
+		}
+		for (int obj : objects) {
+			const int i = getObjectIndex(obj);
+			if (i > 0) drawObject(i, 0);
+		}
+		pass[p].resize(w * h);
+		for (int y = 0; y < h; ++y) memcpy(&pass[p][y * w], vs.getPixels(r.left, r.top + y), w);
+	}
+	for (int y = 0; y < H; ++y) {
+		memcpy(vs.getPixels(0, y), &front[y * W], W);
+		memcpy(vs.getBackPixels(0, y), &back[y * W], W);
+	}
+	pixels.resize(w * h); mask.resize(w * h);
+	for (int i = 0; i < w * h; ++i) { mask[i] = pass[0][i] == pass[1][i]; pixels[i] = mask[i] ? pass[0][i] : 0; }
