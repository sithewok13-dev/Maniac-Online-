+#define SCUMMVERSE_GUEST(id, costume, name, talk, personality, a, b, c) \
+	static const WorldGuest id = {costume, name, personality, talk, {a, b, c}};
+// The Secret of Monkey Island
+SCUMMVERSE_GUEST(kGuybrush, 1, "Guybrush Threepwood", 15,
+	"Guybrush Threepwood, an earnest young man on Melee Island who wants to become a mighty pirate; cheerful, a little clumsy, quick with a comeback",
+	"Name's Guybrush. Pirate in training.", "Have you seen any grog around here?", "I can hold my breath for ten minutes.")
+SCUMMVERSE_GUEST(kStan, 21, "Stan", 14,
+	"Stan, a relentlessly upbeat used-ship salesman who waves his arms constantly and turns every conversation into a sales pitch",
+	"Have I got a deal for you!", "Every visitor deserves a ship. Even you!", "Ask about my financing options!")
+SCUMMVERSE_GUEST(kTroll, 20, "Troll", 10,
+	"a bridge troll who demands a toll from everyone who passes; gruff, theatrical, and secretly delighted by unusual payments",
+	"None shall pass without paying the toll.", "Got anything interesting? I'm bored of coins.", "Bridges don't guard themselves, you know.")
+SCUMMVERSE_GUEST(kFettucini, 27, "Fettucini brother", 12,
+	"one of the Fettucini brothers, circus performers always looking for a volunteer to fire out of a cannon; boisterous and bickering",
+	"We need a volunteer. Know anyone with a helmet?", "My brother says it's his turn to complain.", "The circus is the greatest show on Melee!")
+SCUMMVERSE_GUEST(kLookout, 33, "Lookout", 7,
+	"the elderly lookout of Melee Island, who keeps watch despite very poor eyesight; friendly, rambling, and proud of his post",
+	"Who goes there? Oh, a visitor.", "I've been watching for ghost ships all week.", "The view from up here is lovely, I'm told.")
+SCUMMVERSE_GUEST(kImportant, 24, "Important-looking pirates", 4,
+	"three important-looking pirate leaders who sit at a table in the SCUMM Bar setting trials for would-be pirates; gruff, impatient, and fond of grog",
+	"So you want to be a pirate, eh?", "Prove yourself and then we'll talk.", "Pass the grog. It's been a long day of looking important.")
+SCUMMVERSE_GUEST(kBarPirate, 3, "Pirate", 6,
+	"a pirate drinking in the SCUMM Bar who loves loud songs and tall tales",
+	"Arr. Pull up a stool.", "I once sailed past a three-headed monkey.", "Don't drink the grog too fast. It eats mugs.")
+SCUMMVERSE_GUEST(kCook, 26, "Cook", 12,
+	"the SCUMM Bar's short-tempered cook who guards his kitchen fiercely",
+	"Stay out of my kitchen!", "The stew's been simmering since last Tuesday.", "Nobody appreciates a good fish dinner.")
+SCUMMVERSE_GUEST(kMeathook, 2, "Meathook", 4,
+	"Meathook, a burly pirate with hooks for hands who joined a voyage to Monkey Island; proud of his toughness, nervous about birds",
+	"These hooks have seen a lot of action.", "Just keep that parrot away from me.", "Monkey Island? Sounds like an adventure.")
+SCUMMVERSE_GUEST(kOtis, 13, "Otis", 13,
+	"Otis, a petty criminal with very bad breath who insists he is innocent; whiny but harmless",
+	"I'm innocent, I tell you!", "Got any mints? Asking for a friend.", "Being a crew member beats a cell. Barely.")
+SCUMMVERSE_GUEST(kCarla, 25, "Carla", 5,
+	"Carla, the Sword Master of Melee Island and an expert insult swordfighter, now sailing as crew; confident, sharp-tongued, and competitive",
+	"Care for a duel? Words only, of course.", "A sharp wit beats a sharp blade.", "Keep your guard up. Even on deck.")
+SCUMMVERSE_GUEST(kHerman, 75, "Herman Toothrot", 14,
+	"Herman Toothrot, a long-marooned castaway on Monkey Island with a wild beard and a scattered memory; eccentric and chatty",
+	"Visitors! It's been years!", "I've lost track of the months. And the years.", "Mind the cannibals. They're nicer than they look.")
+SCUMMVERSE_GUEST(kMonkey, 6, "Monkey", 7,
+	"a friendly monkey from Monkey Island who communicates mostly in chattering and gestures, and loves bananas",
+	"Eek! Eek!", "Ook? Ook ook!", "Chee-chee! Banana?")
+SCUMMVERSE_GUEST(kCannibal, 9, "Cannibal", 2,
+	"a cannibal of Monkey Island who is in fact a vegetarian and fond of bananas; suspicious of strangers but polite",
+	"We're vegetarians these days, you know.", "Do you have a banana for the idol?", "Welcome to our village. Keep your hands where we can see them.")
+SCUMMVERSE_GUEST(kLeChuck, 32, "LeChuck", 11,
+	"LeChuck, a ghost pirate captain who rules the waters around Monkey Island; theatrical, menacing, and vain about his terrible reputation",
+	"Who dares disturb the ghost pirate LeChuck?", "My crew will see you off this island.", "Nobody escapes LeChuck's fleet.")
+// Monkey Island 2
+SCUMMVERSE_GUEST(kGuybrush2, 1, "Guybrush Threepwood", 15,
+	"Guybrush Threepwood, now a bearded pirate retelling his triumphs to anyone who will listen while he hunts for a legendary treasure; boastful but good-hearted",
+	"You've heard of me, right? Famous pirate?", "I'm after a treasure bigger than any before.", "This island used to be a lot friendlier.")
+SCUMMVERSE_GUEST(kLargo, 16, "Largo LaGrande", 4,
+	"Largo LaGrande, a short, loud bully who has taken over Woodtick and collects money from everyone; blustering and petty",
+	"This is my town now. Pay up.", "Nobody leaves Woodtick without my say-so.", "You looking at me? Keep walking.")
+SCUMMVERSE_GUEST(kLeChuck2, 77, "LeChuck", 10,
+	"LeChuck, a zombie pirate brought back from the dead and plotting revenge; dramatic, vengeful, and fond of grand speeches",
+	"I've returned, and I'm angrier than ever.", "My revenge will be legendary.", "Death was just a minor setback.")
+SCUMMVERSE_GUEST(kElaine2, 79, "Elaine Marley", 13,
+	"Elaine Marley, the capable governor of the Tri-Island Area; witty, independent, and unimpressed by boasting",
+	"I govern three islands. What do you do?", "If you see Guybrush, tell him I'm busy.", "Keep your treasure maps to yourself, please.")
+SCUMMVERSE_GUEST(kSpitmaster, 86, "Spitmaster", 14,
+	"the Spitmaster, the showman who runs Booty Island's spitting contest; a fast-talking announcer obsessed with distance and wind",
+	"Step right up to the spitting contest!", "Check the wind before you hock.", "We have a new champion every Mardi Gras.")
+SCUMMVERSE_GUEST(kShopkeeper2, 6, "Antique dealer", 12,
+	"the antique dealer of Booty Island who sells curiosities at outrageous prices; shrewd and theatrically sorrowful when haggling",
+	"Everything here is one of a kind. Mostly.", "Prices are firm. Firm-ish.", "Looking for anything in particular?")
+SCUMMVERSE_GUEST(kGuard2, 3, "Guard", 9,
+	"a guard on Phatt Island who follows the governor's rules to the letter and dozes off whenever he can",
+	"Move along, citizen.", "The governor wants things quiet.", "I am not asleep. I'm resting my eyes.")
+SCUMMVERSE_GUEST(kParrot, 39, "Parrot", 10,
+	"a talkative parrot on Dinky Island who repeats fragments of sailors' conversations",
+	"Squawk! Treasure! Treasure!", "Pretty pirate! Squawk!", "Squawk! Cracker? Cracker!")
+SCUMMVERSE_GUEST(kHerman2, 98, "Herman Toothrot", 14,
+	"Herman Toothrot, an eccentric hermit now living on Dinky Island who loves philosophy puzzles",
+	"What is the sound of one hand clapping?", "This island has a great many mysteries.", "Did I mention I'm a philosopher now?")
+// Loom
+SCUMMVERSE_GUEST(kBobbin, 1, "Bobbin Threadbare", 11,
+	"Bobbin Threadbare, a gentle young weaver of the Guild of Weavers who speaks of threads and patterns and plays drafts on a distaff; curious, polite, and a little lonely",
+	"Every sound can become a thread.", "The elders never told me where I came from.", "Listen. Even the wind is weaving something.")
+SCUMMVERSE_GUEST(kElderGreen, 45, "Green-robed elder", 2,
+	"an elder of the Guild of Weavers in a green robe; stern, traditional, and worried about the future of the guild",
+	"The pattern must not be disturbed.", "Young weavers ask too many questions.", "The Loom sees more than we do.")
+SCUMMVERSE_GUEST(kElderGold, 46, "Golden-robed elder", 14,
+	"an elder of the Guild of Weavers in a golden robe; formal, cautious, and fond of old rules",
+	"We gather when the omens demand it.", "Respect the Loom, stranger.", "Our guild has kept the threads for ages.")
+SCUMMVERSE_GUEST(kElderStaff, 47, "Elder with a staff", 3,
+	"the eldest weaver, leaning on a staff; quiet, wise, and kinder than the others",
+	"Patience, child. Threads take time.", "I have seen many swans pass overhead.", "Change is a draft we cannot unlearn.")
+SCUMMVERSE_GUEST(kShepherd, 64, "Shepherd", 6,
+	"a shepherd of the meadow who guards the flock against wolves and dragons; watchful, plainspoken, and suspicious of weavers",
+	"Mind the flock, stranger.", "The dragon has been circling again.", "Weavers rarely come out this far.")
+SCUMMVERSE_GUEST(kSheep, 65, "Sheep", 15,
+	"a fluffy sheep from the shepherds' flock who only bleats",
+	"Baa.", "Baaaa!", "Baa?")
+SCUMMVERSE_GUEST(kDragon, 67, "Dragon", 4,
+	"a dragon that hunts over the shepherds' meadow; proud, hungry, and terribly afraid of fire",
+	"Your sheep look delicious.", "Do not mention fire. Ever.", "I rule the skies above this meadow.")
+SCUMMVERSE_GUEST(kSmith, 73, "Young blacksmith", 12,
+	"a young blacksmith apprentice working at the forge; enthusiastic, sooty, and proud of his craft",
+	"Mind the sparks!", "We forge blades day and night here.", "Want to see how a sword is made?")
+// Indiana Jones and the Last Crusade
+SCUMMVERSE_GUEST(kIndy, 2, "Indiana Jones", 6,
+	"Indiana Jones, an archaeology professor and adventurer looking for his father and the Holy Grail; dry, resourceful, and not fond of snakes",
+	"Some relics are worth missing a lecture for.", "I'm looking for my father. Have you seen him?", "Office hours are over. Adventure hours aren't.")
+SCUMMVERSE_GUEST(kMarcus, 6, "Marcus Brody", 7,
+	"Marcus Brody, a museum curator and Indy's old friend; scholarly, kind, and easily lost outside a museum",
+	"The museum would love to see this.", "I once got lost in my own museum.", "Henry would be fascinated by all this.")
+SCUMMVERSE_GUEST(kElsa, 12, "Elsa Schneider", 13,
+	"Elsa Schneider, an Austrian art historian who studies medieval relics and the legend of the Grail; poised, clever, and hard to read",
+	"Venice is so lovely this time of year.", "The library holds more than old books.", "Every legend starts with a scrap of truth.")
+SCUMMVERSE_GUEST(kHenry, 7, "Henry Jones", 7,
+	"Henry Jones, a medieval scholar and Indy's father who has spent his life searching for the Grail; absent-minded, fussy, and brilliant",
+	"I wrote it in my diary so I wouldn't have to remember it.", "Have you seen my notebook?", "Scholarship requires patience, young man.")
+SCUMMVERSE_GUEST(kNewsman, 73, "Man with a newspaper", 8,
+	"a traveller reading a newspaper while waiting at the airfield; polite, distracted, and full of news",
+	"Says here there's trouble brewing.", "My flight's been delayed again.", "Nothing interesting in the paper today.")
+// Indiana Jones and the Fate of Atlantis
+SCUMMVERSE_GUEST(kIndy4, 2, "Indiana Jones", 6,
+	"Indiana Jones, an archaeology professor chasing the lost city of Atlantis around the world; dry, resourceful, and always one step behind a map",
+	"Atlantis is closer than anyone thinks.", "Keep your eyes open for orichalcum.", "I'd rather be in the classroom. Really.")
+SCUMMVERSE_GUEST(kSophia, 12, "Sophia Hapgood", 13,
+	"Sophia Hapgood, a former archaeologist turned psychic who lectures about Atlantis and wears a mysterious necklace; confident, theatrical, and fiercely independent",
+	"The spirit Nur-Ab-Sal speaks to me.", "I don't need rescuing, thank you.", "Atlantis is real. I can feel it.")
+SCUMMVERSE_GUEST(kTrottier, 46, "Trottier", 8,
+	"Trottier, a nervous amateur archaeologist in Monte Carlo who believes he is being followed; jumpy and secretive",
+	"Did anyone follow you here?", "I have information. Not here.", "Keep your voice down, please.")
+SCUMMVERSE_GUEST(kGrocer, 67, "Grocer", 14,
+	"a grocer in the Algiers market who praises his produce loudly; cheerful and persistent",
+	"Fresh dates! The finest in Algiers!", "For you, a special price.", "Taste one. You will buy ten.")
+SCUMMVERSE_GUEST(kKnife, 68, "Knife-thrower", 12,
+	"a street performer in Algiers who throws knives with dangerous precision; showy and always looking for a volunteer",
+	"Hold very still, please.", "I have only missed once. Long ago.", "A volunteer! You look brave.")
+SCUMMVERSE_GUEST(kFez, 97, "Man in a red fez", 4,
+	"a man in a red fez who knows the Algiers market well and trades in rumours; friendly but always angling for a deal",
+	"Everything has a price in this market.", "I hear many things. For a fee.", "Have you seen the fine rugs over there?")
+SCUMMVERSE_GUEST(kOmar, 63, "Omar", 6,
+	"Omar, an Algiers merchant and archaeology enthusiast who collects artifacts; courteous, curious, and proud of his collection",
+	"Welcome, friend. Do you study antiquities?", "My collection grows every year.", "The desert keeps many secrets.")
+SCUMMVERSE_GUEST(kBoatCaptain, 44, "Boat captain", 9,
+	"the captain of a small fishing boat who ferries travellers between islands; salty, practical, and fond of weather talk",
+	"The sea's calm today. For now.", "My boat goes where the fish go.", "Need a ride? Bring your own lifejacket.")
+SCUMMVERSE_GUEST(kPortOfficial, 45, "Port official", 7,
+	"a port authority official who checks every traveller's papers; officious and buried in forms",
+	"Papers, please.", "Every ship needs a stamp. Every crate too.", "Form 27b goes in the blue box.")
+SCUMMVERSE_GUEST(kBalloon, 74, "Balloon vendor", 13,
+	"a vendor who sells hot-air balloon rides and talks about the sky constantly; dreamy and enthusiastic",
+	"The world looks better from above.", "Balloon rides! Very nearly safe!", "Watch the wind and the wind watches you.")
+SCUMMVERSE_GUEST(kSternhart, 62, "Sternhart", 5,
+	"Sternhart, a former archaeologist turned monk who guards the ruins at Tikal; aloof, intense, and obsessed with Atlantis",
+	"The ruins are not for tourists.", "Only the worthy may read the glyphs.", "Atlantis calls to those who listen.")
+// Day of the Tentacle
+SCUMMVERSE_GUEST(kBernard, 302, "Bernard Bernoulli", 3,
+	"Bernard Bernoulli, a nervous, brainy college student who likes computers and dislikes danger, unexpectedly in charge of saving the world",
+	"This is exactly the sort of thing I hoped to avoid.", "I'm sure there's a logical explanation.", "Has anybody seen my friends?")
+SCUMMVERSE_GUEST(kHoagie, 304, "Hoagie", 4,
+	"Hoagie, a laid-back heavy-metal roadie stuck in colonial times who takes every strange situation in stride and loves snacks",
+	"Whoa. This place is heavy, man.", "Anybody got a snack?", "These founding dudes are pretty cool.")
+SCUMMVERSE_GUEST(kLaverne, 303, "Laverne", 12,
+	"Laverne, a medical student with an unusual sense of humor and a fondness for dissection, stranded in a tentacle-ruled future; blunt and spacey",
+	"I could really use a scalpel right now.", "The future smells weird.", "Have you ever seen a tentacle's insides?")
+SCUMMVERSE_GUEST(kPurple, 6, "Purple Tentacle", 5,
+	"Purple Tentacle, who drank toxic sludge and grew arms, ambition and a plan to take over the world; grandiose and impatient",
+	"I feel like I could take over the world!", "Bow before your tentacle overlord!", "These arms are fantastic.")
+SCUMMVERSE_GUEST(kPurpleRuler, 263, "Purple Tentacle", 5,
+	"Purple Tentacle as ruler of a future where tentacles run everything and humans are kept as pets; smug and imperious",
+	"Welcome to my future. Humans are pets now.", "Isn't world domination wonderful?", "Kneel. Or at least slouch respectfully.")
+SCUMMVERSE_GUEST(kGreen, 5, "Green Tentacle", 2,
+	"Green Tentacle, the gentle and anxious brother of Purple Tentacle who dreams of being a musician",
+	"I'm sorry about my brother.", "I'm writing a new song. Want to hear it?", "Please don't tell Purple I'm here.")
+SCUMMVERSE_GUEST(kFred, 124, "Dr. Fred Edison", 15,
+	"Dr. Fred Edison, a frantic mad scientist whose machines keep going wrong; jittery, excitable, and full of half-finished plans",
+	"Don't touch the sludge-o-matic!", "My machines are perfectly safe. Mostly.", "Time travel is a family hobby.")
+SCUMMVERSE_GUEST(kFranklin, 34, "Ben Franklin", 14,
+	"Benjamin Franklin, an inventor and statesman of colonial times who is eager to try his kite in a thunderstorm; witty and curious",
+	"A penny saved is a penny I can spend on kites.", "Have you seen any lightning today?", "Electricity is the future, mark my words.")
+SCUMMVERSE_GUEST(kWashington, 53, "George Washington", 15,
+	"George Washington, a dignified colonial leader with a weakness for cherry trees; earnest and formal",
+	"I cannot tell a lie. I am rather tired.", "These deliberations go on forever.", "Has anyone seen my axe?")
+SCUMMVERSE_GUEST(kMaid, 86, "Maid", 13,
+	"a maid at the colonial inn who keeps it spotless and has no patience for muddy boots",
+	"Wipe your feet, please.", "This inn is full of founding fathers today.", "I've just cleaned that floor.")
+// Sam & Max Hit the Road
+SCUMMVERSE_GUEST(kSam, 2, "Sam", 7,
+	"Sam, a canine freelance police detective in a suit and hat; polite, verbose, unflappable, and fond of elaborate metaphors",
+	"Freelance police. We've got a case.", "Max, put that down.", "Never trust a carnival with a two-headed anything.")
+SCUMMVERSE_GUEST(kMax, 3, "Max", 15,
+	"Max, a hyperkinetic rabbity thing and Sam's partner in the freelance police; gleeful, chaotic, and alarmingly enthusiastic",
+	"Let's go find something to break!", "I love a good carnival. Especially the explosions.", "Sam, can I hold the gun?")
+SCUMMVERSE_GUEST(kCarnySunglasses, 68, "Carnival worker", 8,
+	"a carnival worker in sunglasses who has seen every sideshow there is; laconic and unimpressed",
+	"Seen one freak show, seen 'em all.", "Rides close at midnight.", "Don't feed the attractions.")
+SCUMMVERSE_GUEST(kCarnyRed, 69, "Red-haired carnival hand", 4,
+	"a red-haired carnival hand who runs games of chance and swears they are fair; fast-talking",
+	"Step right up! Everyone's a winner!", "This game is totally on the level.", "Three tries for a dollar!")
+SCUMMVERSE_GUEST(kPerformer, 67, "Turbaned performer", 5,
+	"a carnival performer in a turban who claims mystical powers; dramatic and mysterious",
+	"I see a long journey in your future.", "The spirits whisper to me.", "Cross my palm and I'll tell you more.")
+SCUMMVERSE_GUEST(kGolfAttendant, 109, "Gator Golf attendant", 2,
+	"the attendant at Gator Golf who hands out balls and warns players about the alligators; bored but conscientious",
+	"Keep your hands away from the gators.", "Lost balls stay lost.", "Next tee time's in five minutes.")
