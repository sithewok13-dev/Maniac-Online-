+// Where a tap takes things before doors (Loom's distaff), a door wholly
+// under things (the dragon's lair's way out, under the dragon, its gold and
+// straw) is taken before them where it lies, when no other door here leads
+// where it does that a tap finds; one that has one (Loom's crystal, a second
+// way to the bell's place) leaves the things to be chosen.
+bool SandboxEngine::tapFinds(int door, bool things) const {
+	Common::Array<int> over, doors;
+	for (int i = 0; i < StageBridge::objectCount(); ++i) {
+		int id, x_, y_, w_, h_, wx, wy, state;
+		if (things && isThing(i) && !isDoor(i)) over.push_back(i);
+		if ((isDoor(i) && !insideShut(i)) || (StageBridge::object(i, id, x_, y_, w_, h_, wx, wy, state) && worldRideAt(_game, _room, id))) doors.push_back(i);
+	}
+	int id, ox, oy, w, h, wx, wy, state;
+	if (!StageBridge::object(door, id, ox, oy, w, h, wx, wy, state)) return false;
+	const int x0 = MAX(0, ox), y0 = MAX(0, oy), x1 = MIN(StageBridge::sceneWidth(), ox + w), y1 = MIN(StageBridge::sceneHeight(), oy + h);
+	for (int a = 0; a <= 8 && x0 < x1 && y0 < y1; ++a)
+		for (int b = 0; b <= 8; ++b) {
+			const double x = x0 + (x1 - x0 - 1) * a / 8.0, y = y0 + (y1 - y0 - 1) * b / 8.0;
+			if (StageBridge::objectAt(x, y, doors.data(), doors.size(), 4) == door && StageBridge::objectAt(x, y, over.data(), over.size(), 2) < 0) return true;
+		}
+	return false;
+}
+
+bool SandboxEngine::otherWay(int door) const {
+	int id, ox, oy, w, h, wx, wy, state;
+	if (!StageBridge::object(door, id, ox, oy, w, h, wx, wy, state)) return false;
+	const WorldLink *link = worldLinkFrom(_game, _room, id);
+	for (int o = 0; link && o < StageBridge::objectCount(); ++o) {
+		int oid;
+		if (o == door || !isDoor(o) || insideShut(o) || !StageBridge::object(o, oid, ox, oy, w, h, wx, wy, state)) continue;
+		const WorldLink *other = worldLinkFrom(_game, _room, oid);
+		if (other && other->target == link->target && tapFinds(o, true)) return true;
+	}
+	return false;
+}
+
+bool SandboxEngine::beforeThings(int door) const {
+	if (_game < 0 || !PanelBridge::distaff() || !isDoor(door) || insideShut(door)) return false;
+	// (Under things, not under other doors: found without them, not with.)
+	return tapFinds(door, false) && !tapFinds(door, true) && !otherWay(door);
+}
+
+bool SandboxEngine::tapsDoorFirst(int door, double x, double y) const {
+	int id, ox, oy, w, h, wx, wy, state;
+	return door >= 0 && StageBridge::object(door, id, ox, oy, w, h, wx, wy, state) && x >= ox && x < ox + w && y >= oy && y < oy + h && beforeThings(door);
+}
