+// The checks' stand-ins let go of their strings as a check ends: a desktop's
+// main destroys the system before static objects go, and a string going
+// then would ask it for its mutex (sanitizers stop there, leaks unchecked).
+static Common::Error letStandInsGo(const Common::Error &result) {
+	FakeTalk::next.clear();
+	FakeCast::boxes.clear(); FakeCast::members.clear();
+	FakePlaces::title.clear(); FakePlaces::items.clear();
+	FakeRemark::event.clear(); FakeRemark::reply.clear();
+	return result;
+}
