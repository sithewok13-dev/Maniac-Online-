diff --git a/engines/scumm/scummverse_story.inc b/engines/scumm/scummverse_story.inc
new file mode 100644
index 00000000..cc695685
--- /dev/null
+++ b/engines/scumm/scummverse_story.inc
@@ -0,0 +1,190 @@
+// SCUMMVERSE story play. GPL-3.0-or-later.
+//
+// The original games, each in its own engine as ScummVM runs it (none of
+// the mansion's additions), opened from Maniac's Worlds menu. Each game
+// has a target of its own, kWorldStoryPrefix + its id (base/main.cpp sets
+// them up from the folders in Documents, common/scummverse_story.h), and
+// keeps its place in its story save (kWorldStorySlot, "Story"): saved there
+// whenever it is left (the Worlds menu's way, its own Quit, ScummVM's menu),
+// loaded from there when it is opened again, unless its autosave is newer
+// (a game left where it could not be saved, or the app stopped in it). A
+// game left with nothing else to start goes back to the mansion where it was
+// saved when the story was opened (base/main.cpp).
+
+// Where a game's story goes on from: the newer of its story save and its
+// autosave (slot 0, ScummVM's own, also made when the phone puts the app
+// away); -1 when it has neither (it starts from the beginning).
+static int scummverseStorySlotOf(const Common::String &target) {
+	int best = -1;
+	uint64 newest = 0;
+	for (int slot : {kWorldStorySlot, 0}) {
+		Common::String desc;
+		Graphics::Surface *thumbnail = nullptr;
+		SaveStateMetaInfos infos;
+		SaveStateMetaInfos *when = &infos;
+		const bool found = ScummEngine::querySaveMetaInfos(target.c_str(), slot, 0, desc, thumbnail, when);
+		if (thumbnail) { thumbnail->free(); delete thumbnail; }
+		if (!found) continue;
+		// (Year, month, day, hour, minute: the story save first when alike.)
+		const uint64 at = !when ? 1 : ((uint64)(infos.date & 0xFFFF) << 32) | ((uint64)((infos.date >> 16) & 0xFF) << 24) |
+			((uint64)(infos.date >> 24) << 16) | infos.time;
+		if (best < 0 || at > newest) { best = slot; newest = at; }
+	}
+	return best;
+}
+
+// A file a game's story cannot go on without (kWorldStoryNeeds) missing
+// from its folder (as the engine looks: there, or in its data, video or
+// resource folder, any case): its name, else empty.
+static Common::String scummverseStoryMissing(const char *gameid, const Common::Path &path) {
+	const char *const *needs = worldStoryNeeds(gameid);
+	if (!needs) return Common::String();
+	Common::FSList files, top;
+	const Common::FSNode folder(path);
+	if (!folder.getChildren(top, Common::FSNode::kListAll)) return Common::String(needs[0]);
+	for (const Common::FSNode &entry : top) {
+		const Common::String name = entry.getName();
+		if (!entry.isDirectory()) files.push_back(entry);
+		else if (name.equalsIgnoreCase("data") || name.equalsIgnoreCase("video") || name.equalsIgnoreCase("resource")) {
+			Common::FSList inner;
+			if (entry.getChildren(inner, Common::FSNode::kListFilesOnly)) for (const Common::FSNode &f : inner) files.push_back(f);
+		}
+	}
+	for (int i = 0; needs[i]; ++i) {
+		bool found = false;
+		for (const Common::FSNode &entry : files) found = found || entry.getName().equalsIgnoreCase(needs[i]);
+		if (!found) return Common::String(needs[i]);
+	}
+	return Common::String();
+}
+
+// Starts a game's story next (this engine leaves at once): false, and why
+// in words for the player, when it cannot.
+bool ScummEngine::scummverseStoryChain(int game, Common::String &refusal) {
+	if (game < 0 || game >= worldGameCount() || !strcmp(kWorldGames[game].gameid, "maniac")) { refusal = "That game has no story here."; return false; }
+	const Common::String target = Common::String(kWorldStoryPrefix) + kWorldGames[game].gameid;
+	// (A folder added since the app started gets its target now.)
+	if (!ConfMan.hasGameDomain(target) && !::Scummverse::addStoryTarget(kWorldGames[game])) {
+		refusal = Common::String::format("I need its files in Documents/%s first.", kWorldGames[game].folder);
+		return false;
+	}
+	Common::String missing = scummverseStoryMissing(kWorldGames[game].gameid, ConfMan.getPath("path", target));
+	if (!missing.empty()) {
+		missing.toUppercase();
+		refusal = Common::String::format("It needs all of its files in Documents/%s: %s is missing.", kWorldGames[game].folder, missing.c_str());
+		return false;
+	}
+	ChainedGamesMan.push(target, scummverseStorySlotOf(target));
+	Common::Event event;
+	event.type = Common::EVENT_RETURN_TO_LAUNCHER;
+	_system->getEventManager()->pushEvent(event);
+	return true;
+}
+
+// From the mansion (its Worlds menu): saved to the temporary slot, as for
+// the sandbox, then the game's story.
+void ScummEngine::scummverseOpenStory(int game) {
+	if (!ChainedGamesMan.empty()) return; // (on its way already)
+	const char *refusal = _scummverseNetOn ? "Not during a WiFi game." : _scummverseTouring ? "Not during the tour." : nullptr;
+	Common::String why;
+	// (Its folder and files looked at before Maniac is saved.)
+	const bool found = game >= 0 && game < worldGameCount() && !sameId(kWorldGames[game].gameid, "maniac") &&
+		(ConfMan.hasGameDomain(Common::String(kWorldStoryPrefix) + kWorldGames[game].gameid) || ::Scummverse::addStoryTarget(kWorldGames[game]));
+	if (!refusal && !found) {
+		why = game >= 0 && game < worldGameCount() ? Common::String::format("I need its files in Documents/%s first.", kWorldGames[game].folder) : "That game has no story here.";
+		refusal = why.c_str();
+	}
+	if (!refusal) {
+		Common::String missing = scummverseStoryMissing(kWorldGames[game].gameid, ConfMan.getPath("path", Common::String(kWorldStoryPrefix) + kWorldGames[game].gameid));
+		if (!missing.empty()) {
+			missing.toUppercase();
+			why = Common::String::format("It needs all of its files in Documents/%s: %s is missing.", kWorldGames[game].folder, missing.c_str());
+			refusal = why.c_str();
+		}
+	}
+	Common::String file;
+	if (!refusal && !saveState(100, true, file)) refusal = "I couldn't save, so I'll stay here.";
+	if (!refusal && !scummverseStoryChain(game, why)) refusal = why.c_str();
+	if (refusal) {
+		warning("SCUMMVERSE story: %s not opened (%s)", game >= 0 && game < worldGameCount() ? kWorldGames[game].gameid : "?", refusal);
+		scummverseSay(VAR(VAR_EGO), refusal);
+	}
+}
+
+// This game's place, in its story save. (Its own sounds and music kept, as
+// an ordinary save keeps them.)
+bool ScummEngine::scummverseStorySave(Common::String &problem) {
+	Common::U32String why;
+	if (!canSaveGameStateCurrently(&why)) { problem = why.empty() ? "it can't be saved just now" : why.encode(); return false; }
+	// (Not while the game's own save or load waits for the next frame, nor
+	// while the game has the controls: its opening, a cutscene. A place
+	// mid-way through one is not where a story should go on from.)
+	if (_saveLoadFlag) { problem = "its own save or load is under way"; return false; }
+	if (_userPut <= 0) { problem = "the game has the controls just now"; return false; }
+	const bool temporary = _saveTemporaryState;
+	const Common::String description = _saveLoadDescription;
+	_saveLoadDescription = "Story";
+	_saveTemporaryState = false;
+	Common::String file;
+	const bool saved = saveState(kWorldStorySlot, false, file);
+	_saveTemporaryState = temporary;
+	_saveLoadDescription = description;
+	if (!saved) { problem = "its save could not be written"; return false; }
+	_lastSaveTime = _system->getMillis();
+	_scummverseStorySaved = true;
+	return true;
+}
+
+// Leaving any other way (the game's own Quit, ScummVM's menu, the app's
+// Return to Launcher): saved on the way out, if it can be (else its
+// autosave may be newer, and is taken next time).
+void ScummEngine::scummverseStoryQuit() {
+	if (!_scummverseStory || _scummverseStorySaved || !ChainedGamesMan.empty()) return;
+	Common::String problem;
+	if (scummverseStorySave(problem)) warning("SCUMMVERSE story: %s saved on quitting", _targetName.c_str());
+	else warning("SCUMMVERSE story: %s not saved on quitting (%s)", _targetName.c_str(), problem.c_str());
+}
+
+// Leaving: for the mansion (-1) or another game's story. Saved first; while
+// the game cannot be saved (a cutscene, a film, its own menus, a question at
+// its start), tried again each frame for a while; then the player chooses:
+// leave anyway (the story save as it was) or stay.
+void ScummEngine::scummverseLeaveStory(int game) {
+	_scummverseStoryLeaving = game;
+	_scummverseStoryTried = 0;
+}
+
+void ScummEngine::scummverseUpdateStory(int delta) {
+	if (!_scummverseStory) return;
+	const int request = scummverseWorldPoll();
+	if (request == kWorldStoryHomeRequest) scummverseLeaveStory(-1);
+	else if (request >= kWorldStoryRequest && request < kWorldStoryRequest + worldGameCount()) scummverseLeaveStory(request - kWorldStoryRequest);
+	if (_scummverseStoryLeaving == -2 || !ChainedGamesMan.empty() || shouldQuit()) return;
+	const int game = _scummverseStoryLeaving;
+	// (This game itself: nothing to do.)
+	if (game >= 0 && _targetName == Common::String(kWorldStoryPrefix) + kWorldGames[game].gameid) { _scummverseStoryLeaving = -2; return; }
+	Common::String problem;
+	if (!scummverseStorySave(problem)) {
+		// (The game's own time: about 8 seconds of it.)
+		if ((_scummverseStoryTried += MAX(delta, 1)) < 8 * 60) return;
+		_scummverseStoryLeaving = -2;
+		warning("SCUMMVERSE story: %s cannot be saved (%s)", _targetName.c_str(), problem.c_str());
+		GUI::MessageDialog dialog(_("This game can't be saved just now. Leave anyway? It starts again where it was last saved."), _("Leave"), _("Stay"));
+		if (runDialog(dialog) != GUI::kMessageOK) return;
+		warning("SCUMMVERSE story: %s left unsaved, for %s", _targetName.c_str(), game >= 0 ? kWorldGames[game].gameid : "the mansion");
+	} else {
+		_scummverseStoryLeaving = -2;
+		warning("SCUMMVERSE story: %s saved, leaving for %s", _targetName.c_str(), game >= 0 ? kWorldGames[game].gameid : "the mansion");
+	}
+	if (game < 0) {
+		Common::Event event;
+		event.type = Common::EVENT_RETURN_TO_LAUNCHER;
+		_system->getEventManager()->pushEvent(event);
+		return;
+	}
+	if (!scummverseStoryChain(game, problem)) {
+		warning("SCUMMVERSE story: %s not opened (%s)", kWorldGames[game].gameid, problem.c_str());
+		GUI::TimedMessageDialog dialog(Common::U32String(problem), 3000);
+		runDialog(dialog);
+	}
+}
