diff --git a/common/scummverse_story.h b/common/scummverse_story.h
new file mode 100644
index 00000000..d0f555b5
--- /dev/null
+++ b/common/scummverse_story.h
@@ -0,0 +1,64 @@
+// SCUMMVERSE story play: each game's own target. GPL-3.0-or-later.
+//
+// The original games, each in its own engine as ScummVM runs it, opened
+// from Maniac's Worlds menu (engines/scumm/scummverse_story.inc). Each game
+// found in Documents (the working directory) has a target of its own,
+// kWorldStoryPrefix + its id, kept from one launch to the next so its saves
+// stay its own; its folder is looked up again each time, its edition found
+// as it starts. Used by base/main.cpp at each launch and by the engine for
+// a folder added while the app runs.
+#ifndef COMMON_SCUMMVERSE_STORY_H
+#define COMMON_SCUMMVERSE_STORY_H
+
+#include "common/config-manager.h"
+#include "common/fs.h"
+#include "common/scummverse_world_catalog.h"
+
+namespace Scummverse {
+
+// A game's folder in Documents: its catalog name, ignoring case and stray
+// spaces around it (a folder zipped or renamed as "loom " is still Loom),
+// or one folder further down (the Files app unzips an archive of several
+// folders into a folder named after it; a Mac adds __MACOSX).
+inline bool worldFolderNamed(const Common::FSNode &entry, const char *name) {
+	Common::String trimmed = entry.getName(); trimmed.trim();
+	return trimmed.equalsIgnoreCase(name);
+}
+inline Common::FSNode worldFolder(const char *name) {
+	const Common::FSNode exact{Common::Path(name)};
+	if (exact.exists() && exact.isDirectory()) return exact;
+	Common::FSList entries;
+	if (Common::FSNode(Common::Path(".")).getChildren(entries, Common::FSNode::kListDirectoriesOnly)) {
+		for (const Common::FSNode &entry : entries)
+			if (worldFolderNamed(entry, name)) return entry;
+		for (const Common::FSNode &entry : entries) {
+			if (entry.getName().hasPrefix("__MACOSX") || entry.getName().hasPrefix(".")) continue;
+			Common::FSList inner;
+			if (!entry.getChildren(inner, Common::FSNode::kListDirectoriesOnly)) continue;
+			for (const Common::FSNode &child : inner)
+				if (worldFolderNamed(child, name)) return child;
+		}
+	}
+	return exact;
+}
+
+// A game's story target, added or brought up to date when its folder is
+// found (false when it is not). Not the mansion: it is the one they open
+// from.
+inline bool addStoryTarget(const WorldCatalog::WorldGame &game) {
+	if (WorldCatalog::sameId(game.gameid, "maniac")) return false;
+	const Common::FSNode folder = worldFolder(game.folder);
+	if (!folder.exists() || !folder.isDirectory()) return false;
+	const Common::String target = Common::String(WorldCatalog::kWorldStoryPrefix) + game.gameid;
+	if (!ConfMan.hasGameDomain(target)) ConfMan.addGameDomain(target);
+	ConfMan.set("engineid", "scumm", target);
+	ConfMan.set("gameid", game.gameid, target);
+	ConfMan.set("description", game.title, target);
+	ConfMan.setPath("path", folder.getPath(), target);
+	ConfMan.setBool("scummverse_story", true, target);
+	return true;
+}
+
+} // End of namespace Scummverse
+
+#endif
diff --git a/common/scummverse_world_catalog.h b/common/scummverse_world_catalog.h
