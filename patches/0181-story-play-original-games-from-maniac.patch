@@ -756,6 +756,34 @@ static const int kWorldSandboxCastRequest = kWorldSandboxRequest + 2;
 static const int kWorldSandboxVanRequest = kWorldSandboxRequest + 3; // (board the Shuttle Bug where it is)
 static const int kWorldSandboxStayRequest = kWorldSandboxRequest + 4;
 static const int kWorldSandboxGameRequest = kWorldSandboxRequest + 16;
+// Story play: the original games, each in its own engine as ScummVM runs
+// it, from Maniac's Worlds menu. kWorldStoryRequest + a game: that game's
+// story (from Maniac, or from another game's); kWorldStoryHomeRequest: back
+// to the mansion. Above the sandbox's games, which it ignores. Each game's
+// target is kWorldStoryPrefix + its id; its place is kept in its story
+// save (kWorldStorySlot, an ordinary save, its own menus list it as
+// "Story").
+static const int kWorldStoryHomeRequest = kWorldSandboxRequest + 63;
+static const int kWorldStoryRequest = kWorldSandboxRequest + 64;
+static const char *const kWorldStoryPrefix = "scummverse-story-";
+static const int kWorldStorySlot = 99;
+static_assert(kWorldSandboxGameRequest + (int)(sizeof(kWorldGames) / sizeof(kWorldGames[0])) <= kWorldStoryHomeRequest,
+	"the sandbox's game requests run into story play's");
+// Files a game's story cannot go on without (its engine stops at the first
+// one missing, and the app with it), looked for in its folder and in its
+// data, video and resource folders, as the engine looks: Full Throttle's
+// bike fights (its DATA folder), The Curse of Monkey Island's lettering
+// (its RESOURCE folder). Its places can be set up without them.
+struct WorldStoryNeeds { const char *gameid; const char *files[12]; };
+static const WorldStoryNeeds kWorldStoryNeeds[] = {
+	{"ft", {"roadrash.rip", "roadrsh2.rip", "roadrsh3.rip", "goglpalt.rip", "tovista1.flu", "tovista2.flu", "toranch.flu",
+	        "minedriv.flu", "minefite.flu", "bensgogg.nut", "bencut.nut", nullptr}},
+	{"comi", {"font0.nut", "font1.nut", "font2.nut", "font3.nut", "font4.nut", nullptr}},
+};
+inline const char *const *worldStoryNeeds(const char *gameid) {
+	for (const auto &n : kWorldStoryNeeds) if (sameId(n.gameid, gameid)) return n.files;
+	return nullptr;
+}
