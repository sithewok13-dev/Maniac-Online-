+// The one played at the Purple Tentacle's door while he guards it: the
+// Green Tentacle's friend saved (he gone for good, told; false: on through
+// it), else barred (his line, by him where he is here; true).
+bool SandboxEngine::guardStops(int door, int kind) {
+	if (kind != kWorldVerbWalk && kind != kWorldVerbOpen && kind != kWorldVerbUnlock && kind != kWorldVerbPush && kind != kWorldVerbPull && kind != kWorldVerbUse) return false;
+	for (const ManiacGuard &g : kManiacGuards) {
+		if (!guarding(_room, door) || g.room != _room || g.door != door) continue;
+		const int kid = playedKid(_game);
+		if (kid && (keptValue(_game, g.friends) & 1 << kid)) {
+			_kept[_game * 65536 + g.gone] = 1;
+			announce("The Green Tentacle comes and leads the Purple Tentacle away.");
+			if (!_testing) saveState();
+			return false;
+		}
+		int guard = -1;
+		for (uint n = 0; n < _onStage.size(); ++n) if ((int)n != _player && _onStage[n] == worldAppearanceKey(_game, g.costume)) guard = n;
+		if (guard >= 0) sayAs(guard, "No one goes past me."); else say("I can't get past.");
+		return true;
+	}
+	return false;
+}
+
+void SandboxEngine::guardPosted(int game, int room, Common::Array<int> &keys) const {
+	for (const ManiacGuard &g : kManiacGuards) {
+		const int key = worldAppearanceKey(game, g.costume);
+		if (g.room != room || !guarding(room, g.door) || !hasCharacter(key)) continue;
+		// (From 0287 the first put on the stage, so that one of his name the
+		// wanderers have here (Day of the Tentacle's Purple Tentacle) steps
+		// aside for him (twinOnStage), not he for them: before, that one
+		// stood there, refusing the badge, the door barred.)
+		const Common::Array<int>::iterator at = Common::find(keys.begin(), keys.end(), key);
+		if (at != keys.end()) keys.erase(at);
+		keys.insert_at(0, key);
+	}
