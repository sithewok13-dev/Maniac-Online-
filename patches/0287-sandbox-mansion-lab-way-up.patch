+// ---- The way up to the mansion's lab (from 0287; kManiacLocked, kManiacGuards) ----
+
+bool SandboxEngine::lockedDoor(int room, int door, const char **line, bool *stays) const {
+	if (line) *line = nullptr;
+	if (stays) *stays = false;
+	if (_game < 0 || strcmp(kWorldGames[_game].gameid, "maniac")) return false;
+	for (const ManiacLocked &l : kManiacLocked) {
+		if (l.room != room || l.door != door) continue;
+		// (The inner door only where its keypad is recorded: else a door as
+		// before, rather than none to the lab at all.)
+		if (!l.line && !keypadOf(room, door)) return false;
+		if (line) *line = l.line;
+		if (stays) *stays = l.stays;
+		return true;
+	}
+	return false;
+}
+
+bool SandboxEngine::keypadOf(int room, int door) const {
+	for (int i = 0; _game >= 0 && i < PanelBridge::closeUpCount(_game); ++i) {
+		int r, thing, kinds, scene, left, keys, presses;
+		if (PanelBridge::closeUpThing(_game, i, r, thing, kinds) && r == room && thing == door && PanelBridge::closeUpScene(_game, i, scene, left, keys, presses) && presses) return true;
+	}
+	return false;
+}
