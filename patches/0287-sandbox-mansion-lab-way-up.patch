+// (Shut, a verb that would open it: refused with its line, true. Its
+// keypad, where it has one, is shown before this: closeUpFor.)
+bool SandboxEngine::lockRefuses(int id, int kind) {
+	const char *line;
+	bool stays;
+	if (!lockedDoor(_room, id, &line, &stays)) return false;
+	const bool opening = kind == kWorldVerbOpen || kind == kWorldVerbUnlock || kind == kWorldVerbPush || kind == kWorldVerbPull || kind == kWorldVerbUse;
+	// (The slab, from the garage: shut or open, it won't move.)
+	if (!(opening && (pictureOf(_room, id) != 1 || stays)) && !(stays && kind == kWorldVerbClose)) return false;
+	if (line) say(line);
+	return true;
+}
+
+bool SandboxEngine::guarding(int room, int door) const {
+	if (_game < 0 || strcmp(kWorldGames[_game].gameid, "maniac") || (_touring.on && !_touring.paused)) return false;
+	for (const ManiacGuard &g : kManiacGuards) {
+		// (Not for himself, played. From 0287 nor for one of his name played
+		// (Day of the Tentacle's Purple Tentacle: never two of anyone, so he
+		// could not be put at his post), nor with him not to be shown (his
+		// character not installed, or one that could not be shown): else his
+		// door barred for good, nobody there to give the badge to.)
+		const int key = worldAppearanceKey(_game, g.costume);
+		if (g.room == room && g.door == door && !keptValue(_game, g.gone) && _playerKey != key && !samePersonKeys(_playerKey, key) && hasCharacter(key) && !_broken.contains(key))
+			return true;
+	}
+	return false;
+}
