+// Actors 20..22 are reserved from the disabled mansion ending sequences.
+// Reusing these slots preserves the 25-actor save layout; costumes get new IDs.
+bool ScummEngine::scummverseMountZakCast() {
+	if (!_scummverseZakCastCostumes[0].empty()) return true;
+	if (!scummverseMountZak()) return false;
+	Common::Array<byte> index, annie, students, costumes[3];
+	Common::String problem;
+	auto directory = scummverseZakDirectory();
+	if (!readZakFile(directory, 0, "7020931d5a2be0a49d68e7a1882363e4", index, problem) ||
+	    !readZakFile(directory, 6, "1a79751f305b2fe6f8ee774de7108304", annie, problem) ||
+	    !readZakFile(directory, 28, "6282c2c0caa99bdbb38ba36051fb57d3", students, problem)) {
+		scummverseZakDiagnostic(directory, problem); return false;
+	}
+	const uint table = 2 + 775 + 61 * 3;
+	for (int i = 0; i < 3; ++i) {
+		const auto &source = i == 0 ? annie : students;
+		const uint id = i + 2, offset = READ_LE_UINT16(index.data() + table + 37 + id * 2);
+		if (index[table + id] != (i == 0 ? 6 : 28) || offset + 2 > source.size()) return false;
+		const uint size = READ_LE_UINT16(source.data() + offset);
+		if (size < 8 || offset + size > source.size()) return false;
+		costumes[i].resize(size); memcpy(costumes[i].data(), source.data() + offset, size);
+	}
+	for (int i = 0; i < 3; ++i) _scummverseZakCastCostumes[i] = costumes[i];
+	return true;
+}
