+static int flightRoom(int destination) { return destination==4 ? 1 : destination==3 ? 53 : destination+50; }
+
+// NPC travellers take the same cabin as everyone else: join the flight on
+// their route at their gate, or start one when the cabin is free (var 796
+// marks an NPC-started flight). Otherwise the NPC waits at the gate.
+bool ScummEngine::scummverseNpcBoard(int id, int origin, int destination) {
+	bool route=false; for(int r : zakFlights) if(r==destination) route=true;
+	const int room=flightRoom(destination);
+	if(!route || !scummverseMountExtra(56) || (room>=56 && !scummverseMountExtra(room))) return false;
+	if(_scummVars[724] && (_scummVars[724]!=destination || _scummVars[726]!=origin) && !scummverseLandUnattendedFlight(true)) return false;
+	if(!scummverseReserveSeats(1u<<id,true)) return false;
+	if(!_scummVars[724]) { _scummVars[724]=destination; _scummVars[725]=0; _scummVars[726]=origin; _scummVars[727]=id; _scummVars[795]=0; _scummVars[796]=1; }
+	_scummVars[725] |= 1u<<id;
+	Actor *a=derefActor(id,"npc passenger"); a->stopActorMoving();
+	a->putActor(35+id%6*3,60,56); a->startAnimActor(a->_standFrame);
+	_scummverseRoamers[id]=Roamer(); scummverseRestoreSeats();
+	return true;
+}
+
+// Land a flight the controlled actor is not on: every rider arrives at the
+// route's destination airport and the cabin is free for the next flight.
+// npcOnly: only a flight NPCs started; a player's flight runs its clock.
+bool ScummEngine::scummverseLandUnattendedFlight(bool npcOnly) {
+	if(!_scummVars[724] || (npcOnly && !_scummVars[796]) || derefActor(VAR(VAR_EGO),"unattended flight")->_room==56) return false;
+	const int room=flightRoom(_scummVars[724]);
+	if(room>=56 && !scummverseMountExtra(room)) return false;
+	for(int id : mansionCast) {
+		Actor *a=derefActor(id,"landing passenger"); if(a->_room!=56) continue;
+		a->stopActorMoving(); a->setElevation(0); a->putActor(20+id%5*2,60,room);
+		a->startAnimActor(a->_standFrame);
+		_scummverseRoamers[id]=Roamer(); _scummverseRoamers[id].wait=600;
+		_scummverseNpcDestination[id]=0; _scummverseNpcBoarding[id]=0;
+	}
+	for(int id=1;id<25;++id) _scummVars[501+id]=0;
+	_scummVars[526]=0; _scummVars[724]=_scummVars[725]=_scummVars[726]=_scummVars[727]=0; _scummVars[795]=_scummVars[796]=0;
+	return true;
+}
