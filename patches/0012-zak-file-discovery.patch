 }
 
+static void scummverseZakDiagnostic(const Common::FSNode &directory, const Common::String &problem) {
+	// Avoid filling the log during automatic optional-data retries.
+	static uint32 previous = 0;
+	Common::String detail = Common::String::format("SCUMMVERSE Zak: %s (game path: %s)", problem.c_str(),
+		ConfMan.getPath("path").toString(Common::Path::kNativeSeparator).c_str());
+	if (directory.isDirectory()) detail += " (Zak folder: " + directory.getPath().toString(Common::Path::kNativeSeparator) + ")";
+	uint32 fingerprint = detail.hash();
+	if (fingerprint != previous) { warning("%s", detail.c_str()); previous = fingerprint; }
+	scummverseWorldReport(problem.c_str());
+}
