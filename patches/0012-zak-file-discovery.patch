+// On iOS the filesystem root already represents this app's Documents folder.
+// Do not derive that location from a saved game path or a prior install UUID.
+static Common::FSNode scummverseZakFolder(const Common::FSNode &parent) {
+	Common::FSNode folder = parent.getChild("zak");
+	if (folder.isDirectory()) return folder;
+	Common::FSList children;
+	parent.getChildren(children, Common::FSNode::kListDirectoriesOnly);
+	for (const auto &child : children)
+		if (child.getName().equalsIgnoreCase("zak")) return child;
+	return folder;
+}
+
+static Common::FSNode scummverseZakDirectory() {
+	if (ConfMan.hasKey("scummverse_zak_path"))
+		return Common::FSNode(ConfMan.getPath("scummverse_zak_path"));
+#ifdef IPHONE
+	return scummverseZakFolder(Common::FSNode(Common::Path("/")));
+#else
+	// Path::getParent handles a bare relative "maniac" as the current directory.
+	// FSNode::getParent can instead return the same node for a relative path.
+	return scummverseZakFolder(Common::FSNode(ConfMan.getPath("path").getParent()));
+#endif
+}
