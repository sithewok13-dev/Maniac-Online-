+// The mansion's lights (its lamps, lights and light switches: what its
+// script turns on and off, not a flashlight), as Maniac's own engine: off,
+// the place is dark (black, everyone in grey), until turned on again; kept.
+bool SandboxEngine::isLight(int object) const {
+	int id, ox, oy, w, h, wx, wy, state, picture, answers;
+	char name[80];
+	if (_game < 0 || strcmp(kWorldGames[_game].gameid, "maniac") || !StageBridge::object(object, id, ox, oy, w, h, wx, wy, state)) return false;
+	if (!PanelBridge::gameThing(_game, _room, id, picture, answers) || answers < 0 || !(answers & 1 << kWorldVerbTurnOn) || !(answers & 1 << kWorldVerbTurnOff)) return false;
+	StageBridge::objectName(object, name, sizeof(name));
+	Common::String lower(name);
+	lower.toLowercase();
+	return (lower.contains("lamp") || lower.contains("light")) && !lower.contains("flash");
+}
+
+void SandboxEngine::lights(bool on) {
+	if (_game < 0) return;
+	if (on) _dark.erase(_game * 1024 + _room); else _dark[_game * 1024 + _room] = true;
+	StageBridge::setDark(!on);
+	_dirty = true;
+	if (_testing) return;
+	ConfMan.set(kDarkKey, lightsKept());
+	ConfMan.flushToDisk();
+}
+
+// (Kept as the places' numbers, in order, between commas.)
+Common::String SandboxEngine::lightsKept() const {
+	Common::Array<int> keys;
+	for (Common::HashMap<int, bool>::const_iterator i = _dark.begin(); i != _dark.end(); ++i) keys.push_back(i->_key);
+	Common::sort(keys.begin(), keys.end());
+	Common::String kept;
+	for (uint i = 0; i < keys.size(); ++i) kept += Common::String::format(i ? ",%d" : "%d", keys[i]);
+	return kept;
+}
+
+void SandboxEngine::lightsRead(const Common::String &kept) {
+	_dark.clear();
+	const char *p = kept.c_str();
+	while (*p) {
+		char *end;
+		const long key = strtol(p, &end, 10);
+		if (end == p) break;
+		if (key > 0 && key < 1024 * 1024) _dark[(int)key] = true;
+		p = *end == ',' ? end + 1 : end;
+	}
+}
